%%[
IF Empty(@buildNavActive) THEN SET @buildNavActive = "manage" ENDIF
IF Empty(@jid) THEN SET @jid = "" ENDIF
IF Empty(@isSurveyBuild) THEN SET @isSurveyBuild = "false" ENDIF
IF Empty(@buildNavContext) THEN SET @buildNavContext = "false" ENDIF
IF Empty(@mode) THEN SET @mode = "" ENDIF
IF Empty(@dispSurveyId) AND NOT Empty(@surveyId) THEN SET @dispSurveyId = @surveyId ENDIF
IF Empty(@HOME_URL) AND NOT Empty(@hubUrl) THEN SET @HOME_URL = @hubUrl ENDIF

SET @editNavRows = LookupRows("bd_sst_page_navigation", "type", "cloudpage")
IF RowCount(@editNavRows) > 0 THEN
  SET @editNavRow = Row(@editNavRows, 1)
  IF Empty(@HOME_URL) THEN SET @HOME_URL = Field(@editNavRow, "ss_home") ENDIF
  IF Empty(@BUILD_PAGE_SELF) THEN SET @BUILD_PAGE_SELF = Field(@editNavRow, "ss_edit") ENDIF
  IF Empty(@PERFORMANCE_URL) THEN SET @PERFORMANCE_URL = Field(@editNavRow, "ss_performance") ENDIF
  IF Empty(@JOURNEY_VIEW_URL) THEN SET @JOURNEY_VIEW_URL = Field(@editNavRow, "ss_build_journey") ENDIF
ENDIF
IF Empty(@SURVEY_ANALYTICS_URL) THEN
  SET @editSurveyUrlRows = LookupRows("SST_SP_Survey_Url_DE", "user", "admin")
  IF RowCount(@editSurveyUrlRows) > 0 THEN
    SET @editSurveyUrlRow = Row(@editSurveyUrlRows, 1)
    SET @SURVEY_ANALYTICS_URL = Trim(Field(@editSurveyUrlRow, "Analytics"))
    IF Empty(@SURVEY_ANALYTICS_URL) THEN
      SET @SURVEY_ANALYTICS_URL = Trim(Field(@editSurveyUrlRow, "analytics"))
    ENDIF
  ENDIF
ENDIF
IF Empty(@HOME_URL) THEN SET @HOME_URL = "#" ENDIF

SET @editShowManage = "false"
IF @buildNavActive != "edit-survey" THEN
  SET @editShowManage = "true"
ELSEIF @buildNavContext == "true" AND @mode == "edit" THEN
  SET @editShowManage = "true"
ENDIF

SET @editNavManageActive = ""
SET @editNavSurveyResultsActive = ""
SET @editNavJourneyActive = ""
SET @editNavPerformanceActive = ""
IF @buildNavActive == "manage" THEN SET @editNavManageActive = " active" ENDIF
IF @buildNavActive == "analytics" THEN SET @editNavSurveyResultsActive = " active" ENDIF
IF @buildNavActive == "journey" THEN SET @editNavJourneyActive = " active" ENDIF
IF @buildNavActive == "performance" THEN SET @editNavPerformanceActive = " active" ENDIF
]%%
<style>
.maker-sidebar{width:280px;background:#fff;border-right:1px solid #e5e7eb;display:flex;flex-direction:column;padding:28px 0;flex-shrink:0;box-shadow:0 1px 2px 0 rgba(0,0,0,0.05);height:100vh;overflow:hidden}
.maker-sidebar .sidebar-logo{padding:0 20px;margin-bottom:12px;border-bottom:1px solid #eee5e5;padding-bottom:10px;align-self:center}
.maker-sidebar .sidebar-logo a{display:inline-block}
.maker-sidebar .sidebar-logo img{height:40px}
.maker-sidebar .nav-section{margin-bottom:8px}
.maker-sidebar .nav-section-title{font-size:11px;font-weight:600;color:#9ca3af;letter-spacing:0.06em;margin-bottom:8px;padding:0 32px;text-transform:uppercase}
.maker-sidebar .sidebar-nav .nav-link{display:flex;align-items:center;gap:12px;padding:12px 32px;color:#4b5563;text-decoration:none;font-weight:500;font-size:14px;border-right:3px solid transparent;transition:background 0.2s ease,color 0.2s ease}
.maker-sidebar .sidebar-nav .nav-link:hover{background:#f9fafb;color:#111827}
.maker-sidebar .sidebar-nav .nav-link.active,.maker-sidebar .sidebar-nav span.nav-link.active{background:linear-gradient(90deg,rgb(119 120 196 / 10%) 0%,rgb(2 3 22 / 5%) 100%);color:#000;border-right-color:#2c2c31}
.maker-sidebar .sidebar-nav span.nav-link.active{cursor:default}
.maker-sidebar .nav-icon{width:20px;height:20px;opacity:0.75;flex-shrink:0}
@media (max-width:768px){
.maker-sidebar{width:100%;flex-direction:row;overflow-x:auto;align-items:center;min-height:0;padding:12px 0;height:auto}
.maker-sidebar .sidebar-logo{margin-bottom:0;flex-shrink:0;padding-right:16px}
.maker-sidebar .sidebar-nav{display:flex;flex-direction:row;gap:4px;padding:8px 0;flex:1;flex-wrap:nowrap}
.maker-sidebar .nav-section-title{display:none}
.maker-sidebar .sidebar-nav .nav-link{white-space:nowrap;padding:8px 16px;border-right:none;border-radius:8px}
}
</style>
