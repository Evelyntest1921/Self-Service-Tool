%%[
  IF Empty(@hubUrl) THEN SET @hubUrl = "#" ENDIF
  IF Empty(@activeNav) THEN SET @activeNav = "" ENDIF
  IF Empty(@envDisplayName) THEN SET @envDisplayName = "" ENDIF
  IF Empty(@envDisplayEmail) THEN SET @envDisplayEmail = "" ENDIF
  IF Empty(@envAvatarLetter) THEN SET @envAvatarLetter = "" ENDIF
  SET @navHomeActive = ""
  SET @navExitActive = ""
  IF @activeNav == "home" THEN SET @navHomeActive = " active" ENDIF
  IF @activeNav == "journey_exit" THEN SET @navExitActive = " active" ENDIF
]%%
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
:root {
  --primary-gradient: linear-gradient(135deg, #000000 0%, #060507 100%);
  --primary-color: #6366f1;
  --primary-dark: #4f46e5;
  --gray-50: #f9fafb;
  --gray-100: #f3f4f6;
  --gray-200: #e5e7eb;
  --gray-300: #d1d5db;
  --gray-400: #9ca3af;
  --gray-500: #6b7280;
  --gray-600: #4b5563;
  --gray-700: #374151;
  --gray-800: #1f2937;
  --gray-900: #111827;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background: var(--gray-50);
  color: var(--gray-900);
  line-height: 1.6;
  margin: 0;
}
.dashboard-layout {
  display: flex;
  height: 100vh;
  min-height: 100vh;
  overflow: hidden;
}
.sidebar {
  width: 280px;
  flex-shrink: 0;
  height: 100vh;
  overflow: hidden;
  background: white;
  border-right: 1px solid var(--gray-200);
  display: flex;
  flex-direction: column;
  padding: 32px 0 0 0;
  box-shadow: var(--shadow-sm);
}
.sidebar-logo {
  padding: 0 20px;
  margin-bottom: 40px;
  border-bottom: 1px solid #ded5d563;
  padding-bottom: 25px;
}
.sidebar-logo img {
  height: 40px;
}
.nav-section-title {
  font-size: 11px;
  font-weight: 600;
  color: var(--gray-400);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  padding: 0 32px;
  margin-bottom: 16px;
  display: block;
}
.sidebar-nav {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 32px;
  color: var(--gray-600);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s ease;
  border-right: 3px solid transparent;
}
.nav-link:hover {
  background: var(--gray-50);
  color: var(--gray-900);
}
.nav-link.active {
  background: linear-gradient(90deg, rgb(119 120 196 / 10%) 0%, rgb(2 3 22 / 5%) 100%);
  color: #000000;
  border-right-color: #2c2c31;
}
.nav-icon {
  width: 20px;
  height: 20px;
  opacity: 0.7;
  flex-shrink: 0;
}
.nav-link.active .nav-icon {
  opacity: 1;
}
.sidebar-footer {
  flex-shrink: 0;
  padding: 24px 32px 20px;
  border-top: 1px solid var(--gray-200);
  background: #fff;
}
.sidebar-user {
  display: flex;
  align-items: center;
  gap: 12px;
}
.user-avatar {
  width: 40px;
  height: 40px;
  background: #000000;
  color: white;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 16px;
}
.user-name {
  font-weight: 600;
  color: var(--gray-900);
  font-size: 14px;
}
.user-email {
  color: var(--gray-500);
  font-size: 12px;
}
.main-content {
  flex: 1;
  min-width: 0;
  height: 100vh;
  padding: 40px;
  overflow-y: auto;
  background: var(--gray-50);
}
@media (max-width: 768px) {
  .dashboard-layout {
    flex-direction: column;
    height: auto;
    min-height: 0;
    overflow: visible;
  }
  .sidebar {
    width: 100%;
    height: auto;
    flex-direction: row;
    padding: 16px 0;
    overflow-x: auto;
    overflow-y: visible;
  }
  .sidebar-logo {
    padding: 0 16px;
    margin-bottom: 0;
  }
  .sidebar-nav {
    display: flex;
    gap: 8px;
    padding: 0 16px;
  }
  .nav-section-title {
    display: none;
  }
  .nav-link {
    white-space: nowrap;
    padding: 8px 16px;
    border-radius: 8px;
    border-right: none;
  }
  .sidebar-footer {
    padding: 0 16px;
    margin-left: auto;
    width: auto;
    position: static;
    border-top: none;
  }
  .main-content {
    height: auto;
    overflow: visible;
    padding: 24px 16px 40px;
  }
}
</style>
<aside class="sidebar" aria-label="Primary">
  <div class="sidebar-logo">
    <a href="%%=v(@hubUrl)=%%">
      <img style="filter: invert(1);" src="https://www.magmutual.com/_next/image?url=%2Fmagmutual-egg.svg&w=640&q=75" alt="MagMutual">
    </a>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">
      <span class="nav-section-title">MENU</span>
    </div>
    <a class="nav-link%%=v(@navHomeActive)=%%" href="%%=v(@hubUrl)=%%">
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
      </svg>
      <span>Builder home</span>
    </a>
%%[ IF @activeNav == "home" THEN ]%%
    <a class="nav-link" href="#" onclick="showAllJourneys(); return false;">
%%[ ELSE ]%%
    <a class="nav-link" href="%%=v(@hubUrl)=%%">
%%[ ENDIF ]%%
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
      </svg>
      <span>Recent builds</span>
    </a>
%%[ IF @activeNav == "home" THEN ]%%
    <a class="nav-link" href="#" onclick="showReports(); return false;">
%%[ ELSE ]%%
    <a class="nav-link" href="%%=v(@hubUrl)=%%">
%%[ ENDIF ]%%
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M9 11H7v6h2v-6zm4 0h-2v6h2v-6zm4 0h-2v6h2v-6zM5 20h14V4H5v16zm14 2H5c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h14c1.1 0 2 .9 2 2v16c0 1.1-.9 2-2 2z"/>
      </svg>
      <span>Performance</span>
    </a>
%%[ IF @activeNav == "home" THEN ]%%
    <a class="nav-link" href="#" onclick="showResponses(); return false;">
%%[ ELSE ]%%
    <a class="nav-link" href="%%=v(@hubUrl)=%%">
%%[ ENDIF ]%%
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10 2 10 2 10 2 9 3 8.18 4H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/>
      </svg>
      <span>Deployment</span>
    </a>
    <div class="nav-section" style="margin-top: 24px;">
      <span class="nav-section-title">MANAGE</span>
    </div>
%%[ IF NOT Empty(@journeyExitUrl) THEN ]%%
    <a class="nav-link%%=v(@navExitActive)=%%" href="%%=v(@journeyExitUrl)=%%">
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
      </svg>
      <span>Journey Exit</span>
    </a>
%%[ ENDIF ]%%
  </nav>
  <div class="sidebar-footer">
    <div class="sidebar-user">
      <div class="user-avatar">%%=v(@envAvatarLetter)=%%</div>
      <div class="user-info">
        <div class="user-name">%%=v(@envDisplayName)=%%</div>
        <div class="user-email">%%=v(@envDisplayEmail)=%%</div>
      </div>
    </div>
  </div>
</aside>
