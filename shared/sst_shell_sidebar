<script>
window.__sstEnvModalSync = function () {
  var check = document.getElementById("sstEnvModalOpen");
  if (!check) {
    return;
  }
  document.body.style.overflow = check.checked ? "hidden" : "";
};
(function () {
  function bindEnvModal() {
    var check = document.getElementById("sstEnvModalOpen");
    var modal = document.getElementById("sidebarEnvModal");
    if (!check || !modal) {
      return;
    }
    check.addEventListener("change", function () {
      window.__sstEnvModalSync();
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && check.checked) {
        check.checked = false;
        window.__sstEnvModalSync();
      }
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bindEnvModal);
  } else {
    bindEnvModal();
  }
})();
</script>
