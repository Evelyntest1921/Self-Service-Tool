%%[
  IF Empty(@hubUrl) THEN SET @hubUrl = "#" ENDIF
  IF Empty(@activeNav) THEN SET @activeNav = "" ENDIF
  IF Empty(@envDisplayName) THEN SET @envDisplayName = "" ENDIF
  IF Empty(@envDisplayEmail) THEN SET @envDisplayEmail = "" ENDIF
  IF Empty(@envAvatarLetter) THEN SET @envAvatarLetter = "" ENDIF
  IF Empty(@environment) THEN SET @environment = "" ENDIF
  IF Empty(@environmentSwitchUrl) THEN SET @environmentSwitchUrl = "" ENDIF
  IF Empty(@envSwitchLabel) THEN SET @envSwitchLabel = "" ENDIF
  SET @envAltDisplayName = ""
  SET @envAltDisplayEmail = ""
  SET @envAltAvatarLetter = ""
  SET @sstNavRows = LookupRows("bd_sst_page_navigation", "type", "cloudpage")
  IF RowCount(@sstNavRows) > 0 THEN
    SET @sstNavRow = Row(@sstNavRows, 1)
    IF Empty(@hubUrl) OR @hubUrl == "#" THEN
      SET @hubUrl = Field(@sstNavRow, "ss_home")
    ENDIF
    SET @sstJourneyExitFromNav = Trim(Field(@sstNavRow, "ss_journey_exit"))
    SET @sstCalendarFromNav = Trim(Field(@sstNavRow, "ss_email_calendar"))
    IF NOT Empty(@sstJourneyExitFromNav) THEN
      SET @journeyExitUrl = @sstJourneyExitFromNav
    ENDIF
    IF NOT Empty(@sstCalendarFromNav) THEN
      SET @calendarUrl = @sstCalendarFromNav
    ENDIF
    IF Empty(@environment) THEN
      SET @environment = Trim(Lowercase(Field(@sstNavRow, "environment")))
    ENDIF
    IF Empty(@environmentSwitchUrl) THEN
      SET @environmentSwitchUrl = Trim(Field(@sstNavRow, "environment_switch"))
    ENDIF
  ENDIF
  IF @environment == "uat" THEN
    IF Empty(@envDisplayName) THEN SET @envDisplayName = "UAT" ENDIF
    IF Empty(@envDisplayEmail) THEN SET @envDisplayEmail = "@magmutual.com" ENDIF
    IF Empty(@envAvatarLetter) THEN SET @envAvatarLetter = "U" ENDIF
    SET @envAltDisplayName = "PROD"
    SET @envAltDisplayEmail = "@magmutual.com"
    SET @envAltAvatarLetter = "P"
    IF Empty(@envSwitchLabel) THEN SET @envSwitchLabel = "Switch to production environment" ENDIF
  ELSEIF @environment == "prod" THEN
    IF Empty(@envDisplayName) THEN SET @envDisplayName = "PROD" ENDIF
    IF Empty(@envDisplayEmail) THEN SET @envDisplayEmail = "@magmutual.com" ENDIF
    IF Empty(@envAvatarLetter) THEN SET @envAvatarLetter = "P" ENDIF
    SET @envAltDisplayName = "UAT"
    SET @envAltDisplayEmail = "@magmutual.com"
    SET @envAltAvatarLetter = "U"
    IF Empty(@envSwitchLabel) THEN SET @envSwitchLabel = "Switch to UAT environment" ENDIF
  ENDIF
  IF NOT Empty(@envDisplayName) THEN
    SET @envDisplayEmail = "@magmutual.com"
  ENDIF
  IF NOT Empty(@envAltDisplayName) THEN
    SET @envAltDisplayEmail = "@magmutual.com"
  ENDIF
  SET @navHomeActive = ""
  SET @navExitActive = ""
  SET @navCalendarActive = ""
  IF @activeNav == "home" THEN SET @navHomeActive = " active" ENDIF
  IF @activeNav == "journey_exit" THEN SET @navExitActive = " active" ENDIF
  IF @activeNav == "email_calendar" THEN SET @navCalendarActive = " active" ENDIF
]%%
