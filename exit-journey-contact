<script runat="server">
Platform.Load("core", "1");

var BATCH_DE = "bd_sst_journey_exit_batch";
var EXIT_QUEUE_DE = "bd_sst_journey_exit";
var TRIGGER_DE = "sst_trigger_automation";
var TRIGGER_TYPE = "exit_automation";
var MAX_CONTACTS_VIEW = 500;
var resultStatus = "";
var resultMessage = "";
var resultDetail = "";
var hubUrl = "";
var journeyExitUrl = "";
var calendarUrl = "";
var journeyOptionsHtml = "";
var selectedJourneyId = "";
var selectedJourneyKey = "";
var selectedJourneyName = "";
var sourceDeNameValue = "";
var alertEmailValue = "";
var createdBatchId = "";
var journeysLoadError = "";
var envDisplayName = "";
var envDisplayEmail = "";
var envAvatarLetter = "";
var automationTriggerNote = "";
var environment = "";
var sourceTypeValue = "dataextension";
var campaignIdValue = "";
var memberStatusValue = "";

function formValue(name) {
  var value = "";
  try {
    value = Platform.Request.GetFormField(name);
  } catch (e) {}
  return value || "";
}

function queryValue(name) {
  var value = "";
  try {
    value = Platform.Request.GetQueryStringParameter(name);
  } catch (e) {}
  return value || "";
}

function asStr(value) {
  if (value === null || typeof value === "undefined") {
    return "";
  }
  try {
    return (value + "").replace(/^\s+|\s+$/g, "");
  } catch (e) {
    return "";
  }
}

function clean(value) {
  return asStr(value);
}

function asLower(value) {
  var s = asStr(value);
  try {
    return s.toLowerCase();
  } catch (e) {
    return s;
  }
}

function htmlSafe(value) {
  return asStr(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function asJson(value) {
  return Platform.Function.Stringify(value);
}

function fromJson(value) {
  try {
    return Platform.Function.ParseJSON(asStr(value) || "{}");
  } catch (e) {
    return {};
  }
}

function lenArrayish(raw) {
  if (raw === null || typeof raw === "undefined") {
    return -1;
  }
  try {
    if (typeof raw.length === "number") {
      return raw.length;
    }
  } catch (e) {}
  return -1;
}

function coerceRows(raw) {
  if (raw === null || typeof raw === "undefined") {
    return [];
  }
  var n = lenArrayish(raw);
  if (n < 0) {
    return [];
  }
  var out = [];
  var i;
  for (i = 0; i < n; i++) {
    out.push(raw[i]);
  }
  return out;
}

function field(row, name) {
  if (!row) return "";
  var direct = row[name] || row[String(name)] || "";
  if (direct !== undefined && direct !== null && String(direct) !== "") {
    return direct;
  }
  try {
    var props = row.Properties;
    if (props && typeof props.length === "number") {
      var want = asLower(name);
      var i;
      for (i = 0; i < props.length; i++) {
        var pname = props[i].Name || props[i].name;
        if (asLower(pname) !== want) {
          continue;
        }
        var pval = props[i].Value;
        if (pval === undefined || pval === null) {
          pval = props[i].value;
        }
        if (pval !== undefined && pval !== null && String(pval) !== "") {
          return pval;
        }
      }
    }
  } catch (propEx) {}
  return "";
}

function fieldAny(row, names) {
  var i;
  for (i = 0; i < names.length; i++) {
    var val = field(row, names[i]);
    if (asStr(val)) {
      return val;
    }
  }
  return "";
}

function parseDateMs(value) {
  if (value === null || typeof value === "undefined" || value === "") {
    return 0;
  }
  try {
    if (value.getTime) {
      var msObj = value.getTime();
      if (!isNaN(msObj)) {
        return msObj;
      }
    }
  } catch (dateObjEx) {}
  var text = asStr(value);
  if (!text) {
    return 0;
  }
  try {
    var parsed = Date.parse(text);
    if (!isNaN(parsed)) {
      return parsed;
    }
  } catch (parseEx) {}
  try {
    var p = Platform.Function.ParseDate(text);
    if (p && p.getTime) {
      var ms = p.getTime();
      if (!isNaN(ms)) {
        return ms;
      }
    }
  } catch (ampEx) {}
  return 0;
}

function formatDisplayDate(value) {
  var ms = parseDateMs(value);
  if (!ms) {
    return asStr(value) || "—";
  }
  try {
    var d = new Date(ms);
    var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    var month = months[d.getMonth()] || "";
    var day = d.getDate();
    var year = d.getFullYear();
    var hour = d.getHours();
    var min = d.getMinutes();
    var ampm = hour >= 12 ? "PM" : "AM";
    var h12 = hour % 12;
    if (!h12) {
      h12 = 12;
    }
    var minText = min < 10 ? "0" + min : String(min);
    return month + " " + day + ", " + year + " " + h12 + ":" + minText + " " + ampm;
  } catch (fmtEx) {
    return asStr(value) || "—";
  }
}

function statusClass(status) {
  var s = asLower(status);
  if (s === "done" || s === "success") {
    return "is-done";
  }
  if (s === "failed" || s === "error") {
    return "is-failed";
  }
  if (s === "processing") {
    return "is-processing";
  }
  if (s === "queued") {
    return "is-active";
  }
  return "is-pending";
}

function contactsProcessedFromRow(row) {
  var direct = asStr(
    fieldAny(row, ["contactsProcessed", "ContactsProcessed", "contactProcessed"])
  );
  if (direct !== "") {
    return direct;
  }
  var message = asStr(fieldAny(row, ["message", "Message"]));
  if (!message) {
    return "";
  }
  try {
    var insertedMatch = message.match(/inserted=(\d+)/i);
    var dupMatch = message.match(/duplicates=(\d+)/i);
    if (insertedMatch) {
      var inserted = parseInt(insertedMatch[1], 10) || 0;
      var dups = dupMatch ? parseInt(dupMatch[1], 10) || 0 : 0;
      return String(inserted + dups);
    }
  } catch (parseEx) {}
  return "";
}

function loadRecentBatches(limit) {
  var max = limit || 5;
  var rows = [];
  var i;
  try {
    var de = DataExtension.Init(BATCH_DE);
    rows = coerceRows(de.Rows.Retrieve());
  } catch (initEx) {
    try {
      var prox = new Script.Util.WSProxy();
      var wsResp = prox.retrieve(
        "DataExtensionObject[" + BATCH_DE + "]",
        [
          "batchId",
          "journeyName",
          "sourceDeName",
          "sourceType",
          "campaignId",
          "memberStatus",
          "requestedAt",
          "status",
          "contactsProcessed",
          "message"
        ],
        { Property: "batchId", SimpleOperator: "notEquals", Value: "" }
      );
      rows = coerceRows(wsResp && wsResp.Results ? wsResp.Results : []);
    } catch (wsEx) {
      return {
        ok: false,
        rows: [],
        error: wsEx.message || String(wsEx)
      };
    }
  }

  var normalized = [];
  for (i = 0; i < rows.length; i++) {
    var row = rows[i];
    var requestedAt = fieldAny(row, ["requestedAt", "RequestedAt"]);
    var contactsProcessed = contactsProcessedFromRow(row);
    var sourceType = asLower(fieldAny(row, ["sourceType", "SourceType"])) || "dataextension";
    var campaignId = asStr(fieldAny(row, ["campaignId", "CampaignId"]));
    var memberStatus = asStr(fieldAny(row, ["memberStatus", "MemberStatus"]));
    var sourceDeName = asStr(fieldAny(row, ["sourceDeName", "SourceDeName", "sourceDEName"])) || "—";
    var audienceLabel = sourceDeName;
    if (sourceType === "campaign") {
      audienceLabel =
        "Campaign " +
        (campaignId || "—") +
        (memberStatus ? " · " + memberStatus : "");
    }
    normalized.push({
      batchId: asStr(fieldAny(row, ["batchId", "BatchId", "BATCHID"])),
      journeyName: asStr(fieldAny(row, ["journeyName", "JourneyName"])) || "Untitled journey",
      sourceDeName: audienceLabel,
      sourceType: sourceType,
      contactsProcessed: contactsProcessed !== "" ? contactsProcessed : "—",
      requestedAt: requestedAt,
      requestedAtMs: parseDateMs(requestedAt),
      status: asStr(fieldAny(row, ["status", "Status"])) || "Pending"
    });
  }

  normalized.sort(function (a, b) {
    return (b.requestedAtMs || 0) - (a.requestedAtMs || 0);
  });

  if (normalized.length > max) {
    normalized = normalized.slice(0, max);
  }
  return { ok: true, rows: normalized, error: "" };
}

function lookupBatchSummary(batchId) {
  var id = clean(batchId);
  if (!id) {
    return null;
  }
  try {
    var rows = Platform.Function.LookupRows(BATCH_DE, "batchId", id);
    if (rows && rows.length) {
      var row = rows[0];
      return {
        batchId: id,
        journeyName:
          asStr(fieldAny(row, ["journeyName", "JourneyName"])) || "Untitled journey",
        sourceDeName:
          asStr(fieldAny(row, ["sourceDeName", "SourceDeName", "sourceDEName"])) ||
          "—",
        status: asStr(fieldAny(row, ["status", "Status"])) || "Pending",
        requestedAt: fieldAny(row, ["requestedAt", "RequestedAt"])
      };
    }
  } catch (lookupEx) {}
  return {
    batchId: id,
    journeyName: "",
    sourceDeName: "",
    status: "",
    requestedAt: ""
  };
}

function normalizeExitContactRow(row) {
  return {
    journeyName: asStr(fieldAny(row, ["journeyName", "JourneyName"])),
    updateDate: fieldAny(row, ["updateDate", "UpdateDate"]),
    updateDateMs: parseDateMs(fieldAny(row, ["updateDate", "UpdateDate"])),
    subscriberKey: asStr(fieldAny(row, ["subscriberKey", "SubscriberKey"])),
    journeyId: asStr(fieldAny(row, ["journeyId", "journeyID", "JourneyId", "JourneyID"])),
    batchID: asStr(fieldAny(row, ["batchID", "batchId", "BatchId", "BATCHID"])),
    status: asStr(fieldAny(row, ["status", "Status"])) || "—"
  };
}

function loadExitContactsByBatch(batchId, limit) {
  var id = clean(batchId);
  if (!id) {
    return { ok: false, rows: [], total: 0, truncated: false, error: "Missing batch ID." };
  }
  var max = limit || MAX_CONTACTS_VIEW;
  var rows = [];
  var errors = [];
  var lookupFields = ["batchID", "batchId", "BatchId"];
  var lf;
  for (lf = 0; lf < lookupFields.length; lf++) {
    try {
      var found = Platform.Function.LookupRows(EXIT_QUEUE_DE, lookupFields[lf], id);
      if (found && found.length) {
        rows = coerceRows(found);
        break;
      }
    } catch (lkEx) {
      errors.push("LookupRows(" + lookupFields[lf] + "): " + (lkEx.message || String(lkEx)));
    }
  }
  if (!rows.length) {
    try {
      var prox = new Script.Util.WSProxy();
      var props = [
        "journeyName",
        "updateDate",
        "subscriberKey",
        "journeyId",
        "batchID",
        "Status",
        "status"
      ];
      var batchFields = ["batchID", "batchId"];
      var bf;
      for (bf = 0; bf < batchFields.length; bf++) {
        try {
          var wsResp = prox.retrieve(
            "DataExtensionObject[" + EXIT_QUEUE_DE + "]",
            props,
            { Property: batchFields[bf], SimpleOperator: "equals", Value: id }
          );
          var wsRows = coerceRows(wsResp && wsResp.Results ? wsResp.Results : []);
          if (wsRows.length) {
            rows = wsRows;
            break;
          }
        } catch (wsEx) {
          errors.push("WSProxy " + batchFields[bf] + ": " + (wsEx.message || String(wsEx)));
        }
      }
    } catch (proxEx) {
      errors.push(proxEx.message || String(proxEx));
    }
  }
  var normalized = [];
  var i;
  for (i = 0; i < rows.length; i++) {
    normalized.push(normalizeExitContactRow(rows[i]));
  }
  normalized.sort(function (a, b) {
    return (b.updateDateMs || 0) - (a.updateDateMs || 0);
  });
  var total = normalized.length;
  var truncated = false;
  if (normalized.length > max) {
    truncated = true;
    normalized = normalized.slice(0, max);
  }
  if (!total) {
    return {
      ok: false,
      rows: [],
      total: 0,
      truncated: false,
      error: errors.join(" | ") || "No contacts found for this batch."
    };
  }
  return {
    ok: true,
    rows: normalized,
    total: total,
    truncated: truncated,
    error: ""
  };
}

function buildExitContactsHtml(contacts, options) {
  if (!contacts || !contacts.length) {
    return '<p class="recent-empty">No exit contacts found for this batch.</p>';
  }
  var parts = ['<div class="contacts-summary">'];
  parts.push(
    "<span>" + htmlSafe(String(contacts.length)) + " contact(s)</span>"
  );
  if (options && options.truncated) {
    parts.push(
      '<span class="contacts-truncated">Showing first ' +
        htmlSafe(String(contacts.length)) +
        " of " +
        htmlSafe(String(options.total || contacts.length)) +
        "</span>"
    );
  }
  parts.push("</div>");
  parts.push('<div class="contacts-table-wrap"><table class="contacts-table">');
  parts.push(
    "<thead><tr>" +
      "<th>Journey</th>" +
      "<th>Updated</th>" +
      "<th>Subscriber key</th>" +
      "<th>Journey ID</th>" +
      "<th>Batch ID</th>" +
      "<th>Status</th>" +
      "</tr></thead><tbody>"
  );
  var i;
  for (i = 0; i < contacts.length; i++) {
    var c = contacts[i];
    parts.push("<tr>");
    parts.push("<td>" + htmlSafe(c.journeyName || "—") + "</td>");
    parts.push("<td>" + htmlSafe(formatDisplayDate(c.updateDate)) + "</td>");
    parts.push('<td class="contacts-mono">' + htmlSafe(c.subscriberKey || "—") + "</td>");
    parts.push('<td class="contacts-mono">' + htmlSafe(c.journeyId || "—") + "</td>");
    parts.push('<td class="contacts-mono">' + htmlSafe(c.batchID || "—") + "</td>");
    parts.push(
      '<td><span class="recent-status ' +
        statusClass(c.status) +
        '">' +
        htmlSafe(c.status) +
        "</span></td>"
    );
    parts.push("</tr>");
  }
  parts.push("</tbody></table></div>");
  return parts.join("");
}

function buildRecentBatchesHtml(batches, selectedBatchId) {
  if (!batches || !batches.length) {
    return '<p class="recent-empty">No recent exit requests yet.</p>';
  }
  var parts = ['<ul class="recent-list">'];
  var i;
  for (i = 0; i < batches.length; i++) {
    var item = batches[i];
    var selected =
      selectedBatchId && item.batchId && selectedBatchId === item.batchId
        ? " is-selected"
        : "";
    var clickable = item.batchId ? " recent-item--clickable" : "";
    var batchAttr = item.batchId
      ? ' data-batch-id="' + htmlSafe(item.batchId) + '"'
      : "";
    var interactiveAttr = item.batchId
      ? ' role="button" tabindex="0" aria-label="View exit contacts for ' +
        htmlSafe(item.journeyName) +
        '"'
      : "";
    parts.push(
      '<li class="recent-item' +
        clickable +
        selected +
        '"' +
        batchAttr +
        interactiveAttr +
        ">" +
        '<div class="recent-journey">' +
        htmlSafe(item.journeyName) +
        "</div>" +
        '<div class="recent-detail">' +
        '<span class="recent-label">Audience</span> ' +
        htmlSafe(item.sourceDeName) +
        "</div>" +
        '<div class="recent-detail">' +
        '<span class="recent-label">Contacts</span> ' +
        htmlSafe(item.contactsProcessed) +
        "</div>" +
        '<div class="recent-meta">' +
        '<span class="recent-date">' +
        htmlSafe(formatDisplayDate(item.requestedAt)) +
        "</span>" +
        '<span class="recent-status ' +
        statusClass(item.status) +
        '">' +
        htmlSafe(item.status) +
        "</span>" +
        "</div>" +
        "</li>"
    );
  }
  parts.push("</ul>");
  return parts.join("");
}

function lookupValue(deName, returnField, lookupField, lookupValue) {
  try {
    return clean(Platform.Function.Lookup(deName, returnField, lookupField, lookupValue));
  } catch (e) {}
  return "";
}

function getAuthConfig() {
  var rows = Platform.Function.LookupRows("SFMC_AUTH", "User", "Admin");
  if (!rows || rows.length < 1) {
    throw "Missing SFMC_AUTH row for User=Admin.";
  }
  var row = rows[0];
  var clientId = clean(field(row, "clientId"));
  var clientSecret = clean(field(row, "clientSecret"));
  var subdomain = clean(field(row, "subdomain"));
  var accountId = clean(field(row, "accountId"));
  if (!clientId || !clientSecret || !subdomain) {
    throw "SFMC_AUTH must include clientId, clientSecret, and subdomain.";
  }
  return {
    clientId: clientId,
    clientSecret: clientSecret,
    subdomain: subdomain,
    accountId: accountId
  };
}

function getAccessToken(auth) {
  var payload = {
    grant_type: "client_credentials",
    client_id: auth.clientId,
    client_secret: auth.clientSecret
  };
  if (auth.accountId) {
    payload.account_id = auth.accountId;
  }
  var req = new Script.Util.HttpRequest(
    "https://" + auth.subdomain + ".auth.marketingcloudapis.com/v2/token"
  );
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.contentType = "application/json";
  req.method = "POST";
  req.postData = asJson(payload);
  var resp = req.send();
  var body = asStr(resp.content);
  if (resp.statusCode != 200) {
    throw "Auth HTTP " + resp.statusCode + ": " + body;
  }
  var parsed = fromJson(body);
  if (!parsed.access_token) {
    throw "Auth response did not include access_token.";
  }
  return asStr(parsed.access_token);
}

function httpJson(auth, token, method, path, payload) {
  var req = new Script.Util.HttpRequest(
    "https://" + auth.subdomain + ".rest.marketingcloudapis.com" + path
  );
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.contentType = "application/json";
  req.setHeader("Authorization", "Bearer " + token);
  req.method = method;
  if (payload !== null && payload !== undefined) {
    req.postData = asJson(payload);
  }
  var resp = req.send();
  return {
    status: resp.statusCode,
    body: asStr(resp.content)
  };
}

function loadActiveJourneys(auth, token) {
  var all = [];
  var page = 1;
  var pageSize = 50;
  var maxPages = 20;
  while (page <= maxPages) {
    var path =
      "/interaction/v1/interactions?$page=" +
      page +
      "&$pagesize=" +
      pageSize +
      "&status=Published&mostRecentVersionOnly=true&$orderBy=Name ASC";
    var resp = httpJson(auth, token, "GET", path, null);
    if (resp.status != 200) {
      throw "Journey list HTTP " + resp.status + ": " + resp.body;
    }
    var parsed = fromJson(resp.body);
    var items = coerceRows(parsed && parsed.items ? parsed.items : []);
    var i;
    for (i = 0; i < items.length; i++) {
      var item = items[i] || {};
      var key = asStr(item.key);
      var id = asStr(item.id);
      var name = asStr(item.name) || "Untitled journey";
      var status = asStr(item.status) || "Published";
      var version = asStr(item.version);
      if (!version) {
        version = asStr(item.versionNumber);
      }
      if (!key && !id) {
        continue;
      }
      all.push({
        id: id || key,
        key: key || id,
        name: name,
        status: status,
        version: version
      });
    }
    var count = 0;
    try {
      count = parseInt(asStr(parsed.count) || "0", 10);
    } catch (countEx) {
      count = 0;
    }
    if (isNaN(count)) {
      count = 0;
    }
    if (!items.length || page * pageSize >= count) {
      break;
    }
    page++;
  }
  return all;
}

function buildPostedJourneyOptions(journeyId, journeyKey, journeyName) {
  var id = clean(journeyId);
  if (!id) {
    return '<option value="">Select a published journey</option>';
  }
  return buildJourneyOptions(
    [
      {
        id: id,
        key: clean(journeyKey) || id,
        name: clean(journeyName) || "Selected journey",
        status: "Published",
        version: ""
      }
    ],
    id
  );
}

function buildJourneyOptions(journeys, selectedId) {
  var parts = ['<option value="">Select a published journey</option>'];
  var i;
  for (i = 0; i < journeys.length; i++) {
    var j = journeys[i];
    var selected = selectedId && selectedId === j.id ? " selected" : "";
    var label = j.name;
    if (j.version) {
      label += " (v" + j.version + ")";
    }
    label += " — " + j.status;
    parts.push(
      '<option value="' +
        htmlSafe(j.id) +
        '"' +
        selected +
        ' data-name="' +
        htmlSafe(j.name) +
        '" data-key="' +
        htmlSafe(j.key) +
        '">' +
        htmlSafe(label) +
        "</option>"
    );
  }
  return parts.join("");
}

function resolveJourneyMeta(journeys, journeyId, fallbackName, fallbackKey) {
  var i;
  for (i = 0; i < journeys.length; i++) {
    if (journeys[i].id === journeyId || journeys[i].key === journeyId) {
      return {
        id: journeys[i].id,
        key: journeys[i].key,
        name: journeys[i].name
      };
    }
  }
  return {
    id: journeyId,
    key: fallbackKey || journeyId,
    name: fallbackName || journeyId
  };
}

function sourceDeExists(deName) {
  var name = clean(deName);
  if (!name) {
    return { ok: false, error: "Enter a source Data Extension name or Customer Key." };
  }
  try {
    var de = DataExtension.Init(name);
    var rows = de.Rows.Retrieve();
    return { ok: true, rowHint: lenArrayish(rows) };
  } catch (deEx) {
    try {
      var prox = new Script.Util.WSProxy();
      var byKey = prox.retrieve(
        "DataExtension",
        ["Name", "CustomerKey", "ObjectID"],
        { Property: "CustomerKey", SimpleOperator: "equals", Value: name }
      );
      if (byKey && byKey.Results && byKey.Results.length) {
        return {
          ok: true,
          resolvedName: asStr(byKey.Results[0].Name),
          resolvedKey: asStr(byKey.Results[0].CustomerKey)
        };
      }
      var byName = prox.retrieve(
        "DataExtension",
        ["Name", "CustomerKey", "ObjectID"],
        { Property: "Name", SimpleOperator: "equals", Value: name }
      );
      if (byName && byName.Results && byName.Results.length) {
        return {
          ok: true,
          resolvedName: asStr(byName.Results[0].Name),
          resolvedKey: asStr(byName.Results[0].CustomerKey)
        };
      }
    } catch (wsEx) {
      return {
        ok: false,
        error:
          "Could not verify DE: " +
          (deEx.message || String(deEx)) +
          " | " +
          (wsEx.message || String(wsEx))
      };
    }
    return {
      ok: false,
      error: "Data Extension not found for name/key: " + name
    };
  }
}

function insertBatchRow(batch) {
  var attempts = [
    {
      cols: [
        "batchId",
        "sourceDeName",
        "journeyID",
        "journeyName",
        "journeyKey",
        "status",
        "requestedAt",
        "message",
        "Email",
        "sourceType",
        "campaignId",
        "memberStatus"
      ],
      vals: [
        batch.batchId,
        batch.sourceDeName,
        batch.journeyID,
        batch.journeyName,
        batch.journeyKey,
        batch.status,
        batch.requestedAt,
        batch.message,
        batch.Email,
        batch.sourceType || "dataextension",
        batch.campaignId || "",
        batch.memberStatus || ""
      ]
    },
    {
      cols: [
        "batchId",
        "sourceDeName",
        "journeyID",
        "journeyName",
        "journeyKey",
        "status",
        "requestedAt",
        "message",
        "Email"
      ],
      vals: [
        batch.batchId,
        batch.sourceDeName,
        batch.journeyID,
        batch.journeyName,
        batch.journeyKey,
        batch.status,
        batch.requestedAt,
        batch.message,
        batch.Email
      ]
    }
  ];
  var errors = [];
  var a;
  for (a = 0; a < attempts.length; a++) {
    try {
      Platform.Function.InsertData(BATCH_DE, attempts[a].cols, attempts[a].vals);
      return { ok: true, fields: attempts[a].cols.join(",") };
    } catch (insEx) {
      errors.push(attempts[a].cols.join("/") + ": " + (insEx.message || String(insEx)));
    }
  }
  return { ok: false, error: errors.join(" | ") };
}

function lookupTriggerByType(triggerType) {
  var typeKey = clean(triggerType);
  if (!typeKey) {
    return {
      ok: false,
      error: "Missing trigger type for " + TRIGGER_DE + " lookup."
    };
  }
  try {
    var externalKey = lookupValue(TRIGGER_DE, "externalKey", "type", typeKey);
    var automationName = lookupValue(TRIGGER_DE, "name", "type", typeKey);
    if (!externalKey) {
      return {
        ok: false,
        error:
          "No " +
          TRIGGER_DE +
          " row for type=\"" +
          typeKey +
          "\". Insert type, name, and externalKey."
      };
    }
    return {
      ok: true,
      type: typeKey,
      name: automationName || "",
      externalKey: externalKey
    };
  } catch (lookupEx) {
    return {
      ok: false,
      error: "Could not read " + TRIGGER_DE + ": " + (lookupEx.message || String(lookupEx))
    };
  }
}

function resolveAutomationObjectId(prox, externalKey) {
  var key = clean(externalKey);
  if (!key) {
    return "";
  }
  try {
    var byCustomerKey = prox.retrieve(
      "Program",
      ["ObjectID", "CustomerKey", "Name"],
      { Property: "CustomerKey", SimpleOperator: "equals", Value: key }
    );
    if (byCustomerKey && byCustomerKey.Results && byCustomerKey.Results.length) {
      return asStr(byCustomerKey.Results[0].ObjectID) || key;
    }
  } catch (ckEx) {}
  try {
    var byObjectId = prox.retrieve(
      "Program",
      ["ObjectID", "CustomerKey", "Name"],
      { Property: "ObjectID", SimpleOperator: "equals", Value: key }
    );
    if (byObjectId && byObjectId.Results && byObjectId.Results.length) {
      return asStr(byObjectId.Results[0].ObjectID) || key;
    }
  } catch (oidEx) {}
  return key;
}

function automationStatusLabel(statusId) {
  var map = {
    "0": "Unknown",
    "1": "Building",
    "2": "Ready",
    "3": "Running",
    "4": "Paused",
    "5": "Stopped",
    "6": "Scheduled",
    "7": "Waiting",
    "8": "Inactive"
  };
  var key = asStr(statusId);
  if (map[key]) {
    return map[key];
  }
  return key ? "Status " + key : "Unknown";
}

function automationIsRunning(statusId) {
  var s = asStr(statusId);
  return s === "1" || s === "3";
}

function getAutomationById(prox, objectId) {
  var id = asStr(objectId);
  if (!id) {
    return null;
  }
  var resp = prox.retrieve(
    "Automation",
    ["ObjectID", "ProgramID", "CustomerKey", "Name", "Status", "IsActive"],
    { Property: "ObjectID", SimpleOperator: "equals", Value: id }
  );
  if (resp && resp.Results && resp.Results.length > 0) {
    return resp.Results[0];
  }
  resp = prox.retrieve(
    "Automation",
    ["ObjectID", "ProgramID", "CustomerKey", "Name", "Status", "IsActive"],
    { Property: "ProgramID", SimpleOperator: "equals", Value: id }
  );
  if (resp && resp.Results && resp.Results.length > 0) {
    return resp.Results[0];
  }
  return null;
}

function triggerAutomationByType(triggerType) {
  var lookup = lookupTriggerByType(triggerType);
  if (!lookup.ok) {
    return lookup;
  }
  try {
    var prox = new Script.Util.WSProxy();
    var objectId = resolveAutomationObjectId(prox, lookup.externalKey);
    if (!objectId) {
      return {
        ok: false,
        error: "Could not resolve automation ObjectID for externalKey=" + lookup.externalKey
      };
    }
    var automation = getAutomationById(prox, objectId);
    var statusId = automation ? asStr(automation.Status) : "";
    if (automationIsRunning(statusId)) {
      var statusLabel = automationStatusLabel(statusId);
      return {
        ok: true,
        skipped: true,
        type: lookup.type,
        name: lookup.name,
        externalKey: lookup.externalKey,
        objectId: objectId,
        status: statusLabel,
        message:
          "Automation already " +
          statusLabel +
          "; batch queued without starting a new run." +
          (lookup.name ? " (" + lookup.name + ")" : "")
      };
    }
    var perform = prox.performItem("Program", { ObjectID: objectId }, "start", {});
    var topStatus = perform && perform.Status ? asStr(perform.Status) : "";
    var itemCode = "";
    var itemMsg = "";
    if (perform && perform.Results && perform.Results.length > 0) {
      itemCode = asStr(perform.Results[0].StatusCode);
      itemMsg = asStr(perform.Results[0].StatusMessage);
    }
    if (topStatus === "OK" || itemCode === "OK") {
      return {
        ok: true,
        type: lookup.type,
        name: lookup.name,
        externalKey: lookup.externalKey,
        objectId: objectId,
        message:
          "Automation started" +
          (lookup.name ? ": " + lookup.name : "") +
          " (type=" +
          lookup.type +
          ")."
      };
    }
    return {
      ok: false,
      type: lookup.type,
      name: lookup.name,
      externalKey: lookup.externalKey,
      objectId: objectId,
      error:
        "Automation start rejected. topStatus=" +
        topStatus +
        " itemCode=" +
        itemCode +
        " itemMsg=" +
        itemMsg
    };
  } catch (trigEx) {
    return {
      ok: false,
      type: lookup.type,
      name: lookup.name,
      externalKey: lookup.externalKey,
      error: trigEx.message || String(trigEx)
    };
  }
}

hubUrl = lookupValue("bd_sst_page_navigation", "ss_home", "type", "cloudpage") || "#";
journeyExitUrl = lookupValue("bd_sst_page_navigation", "ss_journey_exit", "type", "cloudpage") || "";
calendarUrl = lookupValue("bd_sst_page_navigation", "ss_email_calendar", "type", "cloudpage") || "";
environment = asLower(lookupValue("bd_sst_page_navigation", "environment", "type", "cloudpage"));
if (environment === "uat") {
  envDisplayName = "UAT";
  envDisplayEmail = "UAT+admin@magmutual.com";
  envAvatarLetter = "U";
} else if (environment === "prod") {
  envDisplayName = "PROD";
  envDisplayEmail = "admin@magmutual.com";
  envAvatarLetter = "P";
}
selectedJourneyId = clean(formValue("journeyId"));
selectedJourneyKey = clean(formValue("journeyKey"));
selectedJourneyName = clean(formValue("journeyName"));
sourceTypeValue = asLower(formValue("sourceType")) || "dataextension";
if (sourceTypeValue !== "campaign") {
  sourceTypeValue = "dataextension";
}
sourceDeNameValue = clean(formValue("sourceDeName"));
campaignIdValue = clean(formValue("campaignId"));
memberStatusValue = clean(formValue("memberStatus"));
alertEmailValue = clean(formValue("alertEmail"));
var formAction = clean(formValue("formAction"));

try {
  if (formAction == "queue") {
    if (!selectedJourneyId) {
      throw "Select a journey.";
    }
    if (!alertEmailValue) {
      throw "Enter an alert Email.";
    }
    if (alertEmailValue.indexOf("@") < 1) {
      throw "Enter a valid alert Email.";
    }

    var meta = resolveJourneyMeta(
      [],
      selectedJourneyId,
      selectedJourneyName,
      selectedJourneyKey
    );
    selectedJourneyId = meta.id;
    selectedJourneyKey = meta.key;
    selectedJourneyName = meta.name;
    journeyOptionsHtml = buildPostedJourneyOptions(
      selectedJourneyId,
      selectedJourneyKey,
      selectedJourneyName
    );

    var sourceLabel = "";
    if (sourceTypeValue === "campaign") {
      if (!campaignIdValue || campaignIdValue.length < 15) {
        throw "Enter a valid Salesforce Campaign ID (15 or 18 characters).";
      }
      if (!memberStatusValue) {
        throw "Enter the Campaign Member status to exit.";
      }
      sourceLabel = "Campaign:" + campaignIdValue;
      sourceDeNameValue = sourceLabel;
    } else {
      if (!sourceDeNameValue) {
        throw "Enter the source Data Extension name or Customer Key.";
      }
      var deCheck = sourceDeExists(sourceDeNameValue);
      if (!deCheck.ok) {
        throw deCheck.error || "Source Data Extension not found.";
      }
      if (deCheck.resolvedKey) {
        sourceDeNameValue = deCheck.resolvedKey;
      }
      sourceLabel = sourceDeNameValue;
      campaignIdValue = "";
      memberStatusValue = "";
    }

    createdBatchId = Platform.Function.GUID();
    var now = new Date();
    var insertResult = insertBatchRow({
      batchId: createdBatchId,
      sourceDeName: sourceLabel,
      sourceType: sourceTypeValue,
      campaignId: campaignIdValue,
      memberStatus: memberStatusValue,
      journeyID: selectedJourneyId,
      journeyName: selectedJourneyName,
      journeyKey: selectedJourneyKey,
      status: "Pending",
      requestedAt: now,
      message:
        sourceTypeValue === "campaign"
          ? "Queued from CloudPage (Campaign). Waiting for batch seeder."
          : "Queued from CloudPage. Waiting for batch seeder.",
      Email: alertEmailValue
    });

    if (!insertResult.ok) {
      throw "Failed to insert bd_sst_journey_exit_batch row: " + insertResult.error;
    }

    var triggerResult = triggerAutomationByType(TRIGGER_TYPE);
    if (triggerResult.ok) {
      resultStatus = "success";
      automationTriggerNote = triggerResult.message;
      if (triggerResult.skipped) {
        resultMessage =
          "Exit queued. Processing is already running; your request was added to the queue. " +
          "Notification email: " +
          alertEmailValue +
          ".";
      } else {
        resultMessage =
          "Exit started. We queued your contacts and started processing. " +
          "Notification email: " +
          alertEmailValue +
          ".";
      }
    } else {
      resultStatus = "warn";
      automationTriggerNote = triggerResult.error || "Automation did not start.";
      resultMessage =
        "Your exit request was saved, but processing could not be started automatically. " +
        automationTriggerNote;
    }
    resultDetail = asJson({
      batchId: createdBatchId,
      sourceType: sourceTypeValue,
      sourceDeName: sourceLabel,
      campaignId: campaignIdValue,
      memberStatus: memberStatusValue,
      journeyID: selectedJourneyId,
      journeyName: selectedJourneyName,
      journeyKey: selectedJourneyKey,
      Email: alertEmailValue,
      status: "Pending",
      automationTrigger: {
        type: TRIGGER_TYPE,
        name: triggerResult.name || "",
        ok: !!triggerResult.ok,
        skipped: !!triggerResult.skipped,
        status: triggerResult.status || "",
        externalKey: triggerResult.externalKey || "",
        objectId: triggerResult.objectId || "",
        message: triggerResult.message || "",
        error: triggerResult.error || ""
      }
    });
  } else {
    var auth = getAuthConfig();
    var token = getAccessToken(auth);
    var journeys = loadActiveJourneys(auth, token);
    journeyOptionsHtml = buildJourneyOptions(journeys, selectedJourneyId);
  }
} catch (ex) {
  if (formAction == "queue") {
    resultStatus = "error";
    resultMessage = asStr(ex && ex.message ? ex.message : ex);
    if (selectedJourneyId && !journeyOptionsHtml) {
      journeyOptionsHtml = buildPostedJourneyOptions(
        selectedJourneyId,
        selectedJourneyKey,
        selectedJourneyName
      );
    }
  } else {
    journeysLoadError = asStr(ex && ex.message ? ex.message : ex);
    if (!journeyOptionsHtml) {
      journeyOptionsHtml = '<option value="">Unable to load journeys</option>';
    }
  }
}

var viewBatchId = clean(queryValue("viewBatch")) || clean(formValue("viewBatch"));
var showContactsView = !!viewBatchId;
var exitContactsHtml = "";
var exitContactsError = "";
var exitViewBatchJourneyName = "";
var exitViewBatchAudience = "";
var exitViewBatchStatus = "";
var exitViewBatchRequestedAt = "";
var exitViewBatchRequestedAtDisplay = "";
var exitBackUrl = journeyExitUrl || "#";

if (viewBatchId) {
  var batchMeta = lookupBatchSummary(viewBatchId);
  if (batchMeta) {
    exitViewBatchJourneyName = batchMeta.journeyName || "";
    exitViewBatchAudience = batchMeta.sourceDeName || "";
    exitViewBatchStatus = batchMeta.status || "";
    exitViewBatchRequestedAt = batchMeta.requestedAt || "";
    exitViewBatchRequestedAtDisplay = formatDisplayDate(batchMeta.requestedAt);
  }
  try {
    var contactLoad = loadExitContactsByBatch(viewBatchId, MAX_CONTACTS_VIEW);
    if (contactLoad.ok) {
      exitContactsHtml = buildExitContactsHtml(contactLoad.rows, {
        truncated: contactLoad.truncated,
        total: contactLoad.total
      });
    } else {
      exitContactsError = contactLoad.error || "Could not load exit contacts.";
    }
  } catch (contactEx) {
    exitContactsError = asStr(contactEx && contactEx.message ? contactEx.message : contactEx);
  }
}

var recentBatchesHtml = "";
try {
  var recent = loadRecentBatches(5);
  if (recent.ok) {
    recentBatchesHtml = buildRecentBatchesHtml(recent.rows, viewBatchId);
  } else {
    recentBatchesHtml =
      '<p class="recent-empty">Could not load recent exits.</p>';
  }
} catch (recentEx) {
  recentBatchesHtml =
    '<p class="recent-empty">Could not load recent exits.</p>';
}

Platform.Variable.SetValue("@hubUrl", hubUrl || "#");
Platform.Variable.SetValue("@journeyExitUrl", journeyExitUrl || "");
