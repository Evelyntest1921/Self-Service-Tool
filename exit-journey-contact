<body>
<div class="dashboard-layout">
  %%=ContentBlockByKey("sst_shell_sidebar")=%%
  <main class="main-content">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="%%=v(@hubUrl)=%%" class="breadcrumb-link"><svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>Back</a>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      <span class="breadcrumb-current">Journey Exit</span>
    </nav>

    <div class="card">
      <h1>Journey Exit</h1>
      <p class="sub">Select a published journey and enter a source Data Extension. This writes a Pending row to <code>bd_sst_journey_exit_batch</code> for the seeder automation.</p>

      <script runat="server">
        function bodySafe(value) {
          return String(value || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }
        var loadErr = Platform.Variable.GetValue("@exitJourneysLoadError");
        if (loadErr) {
          Write('<div class="notice warn"><strong>Could not fully load journeys.</strong><br>' + bodySafe(loadErr) + '</div>');
        }
        var status = Platform.Variable.GetValue("@exitResultStatus");
        var message = Platform.Variable.GetValue("@exitResultMessage");
        if (status) {
          Write('<div class="notice ' + bodySafe(status) + '"><strong>' + bodySafe(message) + '</strong></div>');
        }
      </script>

      <form method="post" id="exitForm">
        <input type="hidden" name="formAction" id="formAction" value="queue">
        <input type="hidden" name="journeyName" id="journeyName" value="">
        <input type="hidden" name="journeyKey" id="journeyKey" value="">
        <div class="form-group">
          <label class="form-label" for="journeyId">Journey</label>
          <select class="form-select" id="journeyId" name="journeyId" required>
            <script runat="server">
              Write(Platform.Variable.GetValue("@exitJourneyOptionsHtml") || '<option value="">No journeys loaded</option>');
            </script>
          </select>
          <p class="hint">Published journeys only. Journey ID and Definition Key are saved on the batch row.</p>
        </div>
        <div class="form-group">
          <label class="form-label" for="sourceDeName">Source Data Extension</label>
          <script runat="server">
            function fieldSafe(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            Write('<input class="form-input" id="sourceDeName" name="sourceDeName" required placeholder="DE name or Customer Key (must include SubscriberKey)" value="' + fieldSafe(Platform.Variable.GetValue("@exitSourceDeName") || "") + '">');
          </script>
          <p class="hint">Source DE must contain a <code>SubscriberKey</code> column. Prefer Customer Key if names collide.</p>
        </div>
        <div class="form-group">
          <label class="form-label" for="alertEmail">Alert Email</label>
          <script runat="server">
            function fieldSafeEmail(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            Write('<input class="form-input" id="alertEmail" name="alertEmail" type="email" required placeholder="name@example.com" value="' + fieldSafeEmail(Platform.Variable.GetValue("@exitAlertEmail") || "") + '">');
          </script>
          <p class="hint">Saved to the batch <code>Email</code> column for status notifications.</p>
        </div>
        <div class="actions">
          <button class="btn btn-create" type="submit" id="submitBtn" onclick="return submitQueue();">Queue batch</button>
          <a class="btn btn-secondary" href="%%=v(@hubUrl)=%%">Cancel</a>
          <script runat="server">
            var detail = Platform.Variable.GetValue("@exitResultDetail");
            if (detail) {
              Write('<button type="button" class="btn btn-secondary" id="toggleDetailBtn">Show details</button>');
            }
          </script>
        </div>
      </form>

      <script runat="server">
        function detailSafe(value) {
          return String(value || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
        }
        var detailBody = Platform.Variable.GetValue("@exitResultDetail");
        if (detailBody) {
          Write('<pre class="detail" id="apiDetail">' + detailSafe(detailBody) + '</pre>');
        }
      </script>
    </div>
  </main>
</div>
<script>
(function () {
  var select = document.getElementById("journeyId");
  var journeyName = document.getElementById("journeyName");
  var journeyKey = document.getElementById("journeyKey");
  function syncJourneyMeta() {
    if (!select) return;
    var opt = select.options[select.selectedIndex];
    if (journeyName) {
      journeyName.value = opt && opt.getAttribute("data-name") ? opt.getAttribute("data-name") : "";
    }
    if (journeyKey) {
      journeyKey.value = opt && opt.getAttribute("data-key") ? opt.getAttribute("data-key") : "";
    }
  }
  if (select) {
    select.addEventListener("change", syncJourneyMeta);
    syncJourneyMeta();
  }
  window.submitQueue = function () {
    syncJourneyMeta();
    var deName = document.getElementById("sourceDeName").value || "";
    var label = journeyName.value || "the selected journey";
    return confirm("Queue exits for " + label + " from DE \"" + deName + "\"?");
  };
  var toggle = document.getElementById("toggleDetailBtn");
  var detail = document.getElementById("apiDetail");
  if (toggle && detail) {
    toggle.addEventListener("click", function () {
      var open = detail.className.indexOf("is-visible") > -1;
      detail.className = open ? "detail" : "detail is-visible";
      toggle.textContent = open ? "Show details" : "Hide details";
    });
  }
})();
</script>
</body>
</html>
