<script runat="server">
Platform.Load("core", "1");

var BATCH_DE = "bd_sst_journey_exit_batch";
var TRIGGER_DE = "sst_trigger_automation";
var TRIGGER_TYPE = "exit_automation";
var resultStatus = "";
var resultMessage = "";
var resultDetail = "";
var hubUrl = "";
var journeyExitUrl = "";
var journeyOptionsHtml = "";
var selectedJourneyId = "";
var selectedJourneyKey = "";
var selectedJourneyName = "";
var sourceDeNameValue = "";
var alertEmailValue = "";
var createdBatchId = "";
var journeysLoadError = "";
var envDisplayName = "";
var envDisplayEmail = "";
var envAvatarLetter = "";
var automationTriggerNote = "";
var environment = "";

function formValue(name) {
  var value = "";
  try {
    value = Platform.Request.GetFormField(name);
  } catch (e) {}
  return value || "";
}

function asStr(value) {
  if (value === null || typeof value === "undefined") {
    return "";
  }
  try {
    return (value + "").replace(/^\s+|\s+$/g, "");
  } catch (e) {
    return "";
  }
}

function clean(value) {
  return asStr(value);
}

function asLower(value) {
  var s = asStr(value);
  try {
    return s.toLowerCase();
  } catch (e) {
    return s;
  }
}

function htmlSafe(value) {
  return asStr(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function asJson(value) {
  return Platform.Function.Stringify(value);
}

function fromJson(value) {
  try {
    return Platform.Function.ParseJSON(asStr(value) || "{}");
  } catch (e) {
    return {};
  }
}

function lenArrayish(raw) {
  if (raw === null || typeof raw === "undefined") {
    return -1;
  }
  try {
    if (typeof raw.length === "number") {
      return raw.length;
    }
  } catch (e) {}
  return -1;
}

function coerceRows(raw) {
  if (raw === null || typeof raw === "undefined") {
    return [];
  }
  var n = lenArrayish(raw);
  if (n < 0) {
    return [];
  }
  var out = [];
  var i;
  for (i = 0; i < n; i++) {
    out.push(raw[i]);
  }
  return out;
}

function field(row, name) {
  if (!row) return "";
  var direct = row[name] || row[String(name)] || "";
  if (direct !== undefined && direct !== null && String(direct) !== "") {
    return direct;
  }
  try {
    var props = row.Properties;
    if (props && typeof props.length === "number") {
      var want = asLower(name);
      var i;
      for (i = 0; i < props.length; i++) {
        var pname = props[i].Name || props[i].name;
        if (asLower(pname) !== want) {
          continue;
        }
        var pval = props[i].Value;
        if (pval === undefined || pval === null) {
          pval = props[i].value;
        }
        if (pval !== undefined && pval !== null && String(pval) !== "") {
          return pval;
        }
      }
    }
  } catch (propEx) {}
  return "";
}

function fieldAny(row, names) {
  var i;
  for (i = 0; i < names.length; i++) {
    var val = field(row, names[i]);
    if (asStr(val)) {
      return val;
    }
  }
  return "";
}

function parseDateMs(value) {
  if (value === null || typeof value === "undefined" || value === "") {
    return 0;
  }
  try {
    if (value.getTime) {
      var msObj = value.getTime();
      if (!isNaN(msObj)) {
        return msObj;
      }
    }
  } catch (dateObjEx) {}
  var text = asStr(value);
  if (!text) {
    return 0;
  }
  try {
    var parsed = Date.parse(text);
    if (!isNaN(parsed)) {
      return parsed;
    }
  } catch (parseEx) {}
  try {
    var p = Platform.Function.ParseDate(text);
    if (p && p.getTime) {
      var ms = p.getTime();
      if (!isNaN(ms)) {
        return ms;
      }
    }
  } catch (ampEx) {}
  return 0;
}

function formatDisplayDate(value) {
  var ms = parseDateMs(value);
  if (!ms) {
    return asStr(value) || "—";
  }
  try {
    var d = new Date(ms);
    var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    var month = months[d.getMonth()] || "";
    var day = d.getDate();
    var year = d.getFullYear();
    var hour = d.getHours();
    var min = d.getMinutes();
    var ampm = hour >= 12 ? "PM" : "AM";
    var h12 = hour % 12;
    if (!h12) {
      h12 = 12;
    }
    var minText = min < 10 ? "0" + min : String(min);
    return month + " " + day + ", " + year + " " + h12 + ":" + minText + " " + ampm;
  } catch (fmtEx) {
    return asStr(value) || "—";
  }
}

function statusClass(status) {
  var s = asLower(status);
  if (s === "done" || s === "success") {
    return "is-done";
  }
  if (s === "failed" || s === "error") {
    return "is-failed";
  }
  if (s === "processing" || s === "queued") {
    return "is-active";
  }
  return "is-pending";
}

function contactsProcessedFromRow(row) {
  var direct = asStr(
    fieldAny(row, ["contactsProcessed", "ContactsProcessed", "contactProcessed"])
  );
  if (direct !== "") {
    return direct;
  }
  var message = asStr(fieldAny(row, ["message", "Message"]));
  if (!message) {
    return "";
  }
  try {
    var insertedMatch = message.match(/inserted=(\d+)/i);
    var dupMatch = message.match(/duplicates=(\d+)/i);
    if (insertedMatch) {
      var inserted = parseInt(insertedMatch[1], 10) || 0;
      var dups = dupMatch ? parseInt(dupMatch[1], 10) || 0 : 0;
      return String(inserted + dups);
    }
  } catch (parseEx) {}
  return "";
}

function loadRecentBatches(limit) {
  var max = limit || 5;
  var rows = [];
  var i;
  try {
    var de = DataExtension.Init(BATCH_DE);
    rows = coerceRows(de.Rows.Retrieve());
  } catch (initEx) {
    try {
      var prox = new Script.Util.WSProxy();
      var wsResp = prox.retrieve(
        "DataExtensionObject[" + BATCH_DE + "]",
        [
          "batchId",
          "journeyName",
          "sourceDeName",
          "requestedAt",
          "status",
          "contactsProcessed",
          "message"
        ],
        { Property: "batchId", SimpleOperator: "notEquals", Value: "" }
      );
      rows = coerceRows(wsResp && wsResp.Results ? wsResp.Results : []);
    } catch (wsEx) {
      return {
        ok: false,
        rows: [],
        error: wsEx.message || String(wsEx)
      };
    }
  }

  var normalized = [];
  for (i = 0; i < rows.length; i++) {
    var row = rows[i];
    var requestedAt = fieldAny(row, ["requestedAt", "RequestedAt"]);
    var contactsProcessed = contactsProcessedFromRow(row);
    normalized.push({
      journeyName: asStr(fieldAny(row, ["journeyName", "JourneyName"])) || "Untitled journey",
      sourceDeName: asStr(fieldAny(row, ["sourceDeName", "SourceDeName", "sourceDEName"])) || "—",
      contactsProcessed: contactsProcessed !== "" ? contactsProcessed : "—",
      requestedAt: requestedAt,
      requestedAtMs: parseDateMs(requestedAt),
      status: asStr(fieldAny(row, ["status", "Status"])) || "Pending"
    });
  }

  normalized.sort(function (a, b) {
    return (b.requestedAtMs || 0) - (a.requestedAtMs || 0);
  });

  if (normalized.length > max) {
    normalized = normalized.slice(0, max);
  }
  return { ok: true, rows: normalized, error: "" };
}

function buildRecentBatchesHtml(batches) {
  if (!batches || !batches.length) {
    return '<p class="recent-empty">No recent exit requests yet.</p>';
  }
  var parts = ['<ul class="recent-list">'];
  var i;
  for (i = 0; i < batches.length; i++) {
    var item = batches[i];
    parts.push(
      '<li class="recent-item">' +
        '<div class="recent-journey">' +
        htmlSafe(item.journeyName) +
        "</div>" +
        '<div class="recent-detail">' +
        '<span class="recent-label">Audience</span> ' +
        htmlSafe(item.sourceDeName) +
        "</div>" +
        '<div class="recent-detail">' +
        '<span class="recent-label">Contacts</span> ' +
        htmlSafe(item.contactsProcessed) +
        "</div>" +
        '<div class="recent-meta">' +
        '<span class="recent-date">' +
        htmlSafe(formatDisplayDate(item.requestedAt)) +
        "</span>" +
        '<span class="recent-status ' +
        statusClass(item.status) +
        '">' +
        htmlSafe(item.status) +
        "</span>" +
        "</div>" +
        "</li>"
    );
  }
  parts.push("</ul>");
  return parts.join("");
}

function lookupValue(deName, returnField, lookupField, lookupValue) {
  try {
    return clean(Platform.Function.Lookup(deName, returnField, lookupField, lookupValue));
  } catch (e) {}
  return "";
}

function getAuthConfig() {
  var rows = Platform.Function.LookupRows("SFMC_AUTH", "User", "Admin");
  if (!rows || rows.length < 1) {
    throw "Missing SFMC_AUTH row for User=Admin.";
  }
  var row = rows[0];
  var clientId = clean(field(row, "clientId"));
  var clientSecret = clean(field(row, "clientSecret"));
  var subdomain = clean(field(row, "subdomain"));
  var accountId = clean(field(row, "accountId"));
  if (!clientId || !clientSecret || !subdomain) {
    throw "SFMC_AUTH must include clientId, clientSecret, and subdomain.";
  }
  return {
    clientId: clientId,
    clientSecret: clientSecret,
    subdomain: subdomain,
    accountId: accountId
  };
}

function getAccessToken(auth) {
  var payload = {
    grant_type: "client_credentials",
    client_id: auth.clientId,
    client_secret: auth.clientSecret
  };
  if (auth.accountId) {
    payload.account_id = auth.accountId;
  }
  var req = new Script.Util.HttpRequest(
    "https://" + auth.subdomain + ".auth.marketingcloudapis.com/v2/token"
  );
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.contentType = "application/json";
  req.method = "POST";
  req.postData = asJson(payload);
  var resp = req.send();
  var body = asStr(resp.content);
  if (resp.statusCode != 200) {
    throw "Auth HTTP " + resp.statusCode + ": " + body;
  }
  var parsed = fromJson(body);
  if (!parsed.access_token) {
    throw "Auth response did not include access_token.";
  }
  return asStr(parsed.access_token);
}

function httpJson(auth, token, method, path, payload) {
  var req = new Script.Util.HttpRequest(
    "https://" + auth.subdomain + ".rest.marketingcloudapis.com" + path
  );
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.contentType = "application/json";
  req.setHeader("Authorization", "Bearer " + token);
  req.method = method;
  if (payload !== null && payload !== undefined) {
    req.postData = asJson(payload);
  }
  var resp = req.send();
  return {
    status: resp.statusCode,
    body: asStr(resp.content)
  };
}

function loadActiveJourneys(auth, token) {
  var all = [];
  var page = 1;
  var pageSize = 50;
  var maxPages = 20;
  while (page <= maxPages) {
    var path =
      "/interaction/v1/interactions?$page=" +
      page +
      "&$pagesize=" +
      pageSize +
      "&status=Published&mostRecentVersionOnly=true&$orderBy=Name ASC";
    var resp = httpJson(auth, token, "GET", path, null);
    if (resp.status != 200) {
      throw "Journey list HTTP " + resp.status + ": " + resp.body;
    }
    var parsed = fromJson(resp.body);
    var items = coerceRows(parsed && parsed.items ? parsed.items : []);
    var i;
    for (i = 0; i < items.length; i++) {
      var item = items[i] || {};
      var key = asStr(item.key);
      var id = asStr(item.id);
      var name = asStr(item.name) || "Untitled journey";
      var status = asStr(item.status) || "Published";
      var version = asStr(item.version);
      if (!version) {
        version = asStr(item.versionNumber);
      }
      if (!key && !id) {
        continue;
      }
      all.push({
        id: id || key,
        key: key || id,
        name: name,
        status: status,
        version: version
      });
    }
    var count = 0;
    try {
      count = parseInt(asStr(parsed.count) || "0", 10);
    } catch (countEx) {
      count = 0;
    }
    if (isNaN(count)) {
      count = 0;
    }
    if (!items.length || page * pageSize >= count) {
      break;
    }
    page++;
  }
  return all;
}

function buildJourneyOptions(journeys, selectedId) {
  var parts = ['<option value="">Select a published journey</option>'];
  var i;
  for (i = 0; i < journeys.length; i++) {
    var j = journeys[i];
    var selected = selectedId && selectedId === j.id ? " selected" : "";
    var label = j.name;
    if (j.version) {
      label += " (v" + j.version + ")";
    }
    label += " — " + j.status;
    parts.push(
      '<option value="' +
        htmlSafe(j.id) +
        '"' +
        selected +
        ' data-name="' +
        htmlSafe(j.name) +
        '" data-key="' +
        htmlSafe(j.key) +
        '">' +
        htmlSafe(label) +
        "</option>"
    );
  }
  return parts.join("");
}

function resolveJourneyMeta(journeys, journeyId, fallbackName, fallbackKey) {
  var i;
  for (i = 0; i < journeys.length; i++) {
    if (journeys[i].id === journeyId || journeys[i].key === journeyId) {
      return {
        id: journeys[i].id,
        key: journeys[i].key,
        name: journeys[i].name
      };
    }
  }
  return {
    id: journeyId,
    key: fallbackKey || journeyId,
    name: fallbackName || journeyId
  };
}

function sourceDeExists(deName) {
  var name = clean(deName);
  if (!name) {
    return { ok: false, error: "Enter a source Data Extension name or Customer Key." };
  }
  try {
    var de = DataExtension.Init(name);
    var rows = de.Rows.Retrieve();
    return { ok: true, rowHint: lenArrayish(rows) };
  } catch (deEx) {
    try {
      var prox = new Script.Util.WSProxy();
      var byKey = prox.retrieve(
        "DataExtension",
        ["Name", "CustomerKey", "ObjectID"],
        { Property: "CustomerKey", SimpleOperator: "equals", Value: name }
      );
      if (byKey && byKey.Results && byKey.Results.length) {
        return {
          ok: true,
          resolvedName: asStr(byKey.Results[0].Name),
          resolvedKey: asStr(byKey.Results[0].CustomerKey)
        };
      }
      var byName = prox.retrieve(
        "DataExtension",
        ["Name", "CustomerKey", "ObjectID"],
        { Property: "Name", SimpleOperator: "equals", Value: name }
      );
      if (byName && byName.Results && byName.Results.length) {
        return {
          ok: true,
          resolvedName: asStr(byName.Results[0].Name),
          resolvedKey: asStr(byName.Results[0].CustomerKey)
        };
      }
    } catch (wsEx) {
      return {
        ok: false,
        error:
          "Could not verify DE: " +
          (deEx.message || String(deEx)) +
          " | " +
          (wsEx.message || String(wsEx))
      };
    }
    return {
      ok: false,
      error: "Data Extension not found for name/key: " + name
    };
  }
}

function insertBatchRow(batch) {
  try {
    Platform.Function.InsertData(
      BATCH_DE,
      [
        "batchId",
        "sourceDeName",
        "journeyID",
        "journeyName",
        "journeyKey",
        "status",
        "requestedAt",
        "message",
        "Email"
      ],
      [
        batch.batchId,
        batch.sourceDeName,
        batch.journeyID,
        batch.journeyName,
        batch.journeyKey,
        batch.status,
        batch.requestedAt,
        batch.message,
        batch.Email
      ]
    );
    return { ok: true };
  } catch (insEx) {
    return { ok: false, error: insEx.message || String(insEx) };
  }
}

function lookupTriggerByType(triggerType) {
  var typeKey = clean(triggerType);
  if (!typeKey) {
    return {
      ok: false,
      error: "Missing trigger type for " + TRIGGER_DE + " lookup."
    };
  }
  try {
    var externalKey = lookupValue(TRIGGER_DE, "externalKey", "type", typeKey);
    var automationName = lookupValue(TRIGGER_DE, "name", "type", typeKey);
    if (!externalKey) {
      return {
        ok: false,
        error:
          "No " +
          TRIGGER_DE +
          " row for type=\"" +
          typeKey +
          "\". Insert type, name, and externalKey."
      };
    }
    return {
      ok: true,
      type: typeKey,
      name: automationName || "",
      externalKey: externalKey
    };
  } catch (lookupEx) {
    return {
      ok: false,
      error: "Could not read " + TRIGGER_DE + ": " + (lookupEx.message || String(lookupEx))
    };
  }
}

function resolveAutomationObjectId(prox, externalKey) {
  var key = clean(externalKey);
  if (!key) {
    return "";
  }
  try {
    var byCustomerKey = prox.retrieve(
      "Program",
      ["ObjectID", "CustomerKey", "Name"],
      { Property: "CustomerKey", SimpleOperator: "equals", Value: key }
    );
    if (byCustomerKey && byCustomerKey.Results && byCustomerKey.Results.length) {
      return asStr(byCustomerKey.Results[0].ObjectID) || key;
    }
  } catch (ckEx) {}
  try {
    var byObjectId = prox.retrieve(
      "Program",
      ["ObjectID", "CustomerKey", "Name"],
      { Property: "ObjectID", SimpleOperator: "equals", Value: key }
    );
    if (byObjectId && byObjectId.Results && byObjectId.Results.length) {
      return asStr(byObjectId.Results[0].ObjectID) || key;
    }
  } catch (oidEx) {}
  return key;
}

function triggerAutomationByType(triggerType) {
  var lookup = lookupTriggerByType(triggerType);
  if (!lookup.ok) {
    return lookup;
  }
  try {
    var prox = new Script.Util.WSProxy();
    var objectId = resolveAutomationObjectId(prox, lookup.externalKey);
    if (!objectId) {
      return {
        ok: false,
        error: "Could not resolve automation ObjectID for externalKey=" + lookup.externalKey
      };
    }
    var perform = prox.performItem("Program", { ObjectID: objectId }, "start", {});
    var topStatus = perform && perform.Status ? asStr(perform.Status) : "";
    var itemCode = "";
    var itemMsg = "";
    if (perform && perform.Results && perform.Results.length > 0) {
      itemCode = asStr(perform.Results[0].StatusCode);
      itemMsg = asStr(perform.Results[0].StatusMessage);
    }
    if (topStatus === "OK" || itemCode === "OK") {
      return {
        ok: true,
        type: lookup.type,
        name: lookup.name,
        externalKey: lookup.externalKey,
        objectId: objectId,
        message:
          "Automation started" +
          (lookup.name ? ": " + lookup.name : "") +
          " (type=" +
          lookup.type +
          ")."
      };
    }
    return {
      ok: false,
      type: lookup.type,
      name: lookup.name,
      externalKey: lookup.externalKey,
      objectId: objectId,
      error:
        "Automation start rejected. topStatus=" +
        topStatus +
        " itemCode=" +
        itemCode +
        " itemMsg=" +
        itemMsg
    };
  } catch (trigEx) {
    return {
      ok: false,
      type: lookup.type,
      name: lookup.name,
      externalKey: lookup.externalKey,
      error: trigEx.message || String(trigEx)
    };
  }
}

hubUrl = lookupValue("bd_sst_page_navigation", "ss_home", "type", "cloudpage") || "#";
journeyExitUrl = lookupValue("bd_sst_page_navigation", "ss_journey_exit", "type", "cloudpage") || "";
environment = asLower(lookupValue("bd_sst_page_navigation", "environment", "type", "cloudpage"));
if (environment === "uat") {
  envDisplayName = "UAT";
  envDisplayEmail = "UAT+admin@magmutual.com";
  envAvatarLetter = "U";
} else if (environment === "prod") {
  envDisplayName = "PROD";
  envDisplayEmail = "admin@magmutual.com";
  envAvatarLetter = "P";
}
selectedJourneyId = clean(formValue("journeyId"));
selectedJourneyKey = clean(formValue("journeyKey"));
selectedJourneyName = clean(formValue("journeyName"));
sourceDeNameValue = clean(formValue("sourceDeName"));
alertEmailValue = clean(formValue("alertEmail"));
var formAction = clean(formValue("formAction"));

try {
  var auth = getAuthConfig();
  var token = getAccessToken(auth);
  var journeys = loadActiveJourneys(auth, token);
  journeyOptionsHtml = buildJourneyOptions(journeys, selectedJourneyId);

  if (formAction == "queue") {
    if (!selectedJourneyId) {
      throw "Select a journey.";
    }
    if (!sourceDeNameValue) {
      throw "Enter the source Data Extension name or Customer Key.";
    }
    if (!alertEmailValue) {
      throw "Enter an alert Email.";
    }
    if (alertEmailValue.indexOf("@") < 1) {
      throw "Enter a valid alert Email.";
    }

    var meta = resolveJourneyMeta(
      journeys,
      selectedJourneyId,
      selectedJourneyName,
      selectedJourneyKey
    );
    selectedJourneyId = meta.id;
    selectedJourneyKey = meta.key;
    selectedJourneyName = meta.name;

    var deCheck = sourceDeExists(sourceDeNameValue);
    if (!deCheck.ok) {
      throw deCheck.error || "Source Data Extension not found.";
    }
    if (deCheck.resolvedKey) {
      sourceDeNameValue = deCheck.resolvedKey;
    }

    createdBatchId = Platform.Function.GUID();
    var now = new Date();
    var insertResult = insertBatchRow({
      batchId: createdBatchId,
      sourceDeName: sourceDeNameValue,
      journeyID: selectedJourneyId,
      journeyName: selectedJourneyName,
      journeyKey: selectedJourneyKey,
      status: "Pending",
      requestedAt: now,
      message: "Queued from CloudPage. Waiting for batch seeder.",
      Email: alertEmailValue
    });

    if (!insertResult.ok) {
      throw "Failed to insert bd_sst_journey_exit_batch row: " + insertResult.error;
    }

    var triggerResult = triggerAutomationByType(TRIGGER_TYPE);
    if (triggerResult.ok) {
      resultStatus = "success";
      automationTriggerNote = triggerResult.message;
      resultMessage =
        "Exit started. We queued your contacts and started processing. " +
        "Notification email: " +
        alertEmailValue +
        ".";
    } else {
      resultStatus = "warn";
      automationTriggerNote = triggerResult.error || "Automation did not start.";
      resultMessage =
        "Your exit request was saved, but processing could not be started automatically. " +
        automationTriggerNote;
    }
    resultDetail = asJson({
      batchId: createdBatchId,
      sourceDeName: sourceDeNameValue,
      journeyID: selectedJourneyId,
      journeyName: selectedJourneyName,
      journeyKey: selectedJourneyKey,
      Email: alertEmailValue,
      status: "Pending",
      automationTrigger: {
        type: TRIGGER_TYPE,
        name: triggerResult.name || "",
        ok: !!triggerResult.ok,
        externalKey: triggerResult.externalKey || "",
        objectId: triggerResult.objectId || "",
        message: triggerResult.message || "",
        error: triggerResult.error || ""
      }
    });
  }
} catch (ex) {
  if (formAction == "queue") {
    resultStatus = "error";
    resultMessage = asStr(ex && ex.message ? ex.message : ex);
  } else {
    journeysLoadError = asStr(ex && ex.message ? ex.message : ex);
    if (!journeyOptionsHtml) {
      journeyOptionsHtml = '<option value="">Unable to load journeys</option>';
    }
  }
}

var recentBatchesHtml = "";
try {
  var recent = loadRecentBatches(5);
  if (recent.ok) {
    recentBatchesHtml = buildRecentBatchesHtml(recent.rows);
  } else {
    recentBatchesHtml =
      '<p class="recent-empty">Could not load recent exits.</p>';
  }
} catch (recentEx) {
  recentBatchesHtml =
    '<p class="recent-empty">Could not load recent exits.</p>';
}

Platform.Variable.SetValue("@hubUrl", hubUrl || "#");
Platform.Variable.SetValue("@journeyExitUrl", journeyExitUrl || "");
Platform.Variable.SetValue("@activeNav", "journey_exit");
Platform.Variable.SetValue("@envDisplayName", envDisplayName);
Platform.Variable.SetValue("@envDisplayEmail", envDisplayEmail);
Platform.Variable.SetValue("@envAvatarLetter", envAvatarLetter);
Platform.Variable.SetValue("@exitHubUrl", hubUrl || "#");
Platform.Variable.SetValue("@exitResultStatus", resultStatus);
Platform.Variable.SetValue("@exitResultMessage", resultMessage);
Platform.Variable.SetValue("@exitResultDetail", resultDetail);
Platform.Variable.SetValue("@exitJourneyOptionsHtml", journeyOptionsHtml);
Platform.Variable.SetValue("@exitSelectedJourneyId", selectedJourneyId);
Platform.Variable.SetValue("@exitSelectedJourneyKey", selectedJourneyKey);
Platform.Variable.SetValue("@exitSelectedJourneyName", selectedJourneyName);
Platform.Variable.SetValue("@exitSourceDeName", sourceDeNameValue);
Platform.Variable.SetValue("@exitAlertEmail", alertEmailValue);
Platform.Variable.SetValue("@exitBatchId", createdBatchId);
Platform.Variable.SetValue("@exitJourneysLoadError", journeysLoadError);
Platform.Variable.SetValue("@exitRecentBatchesHtml", recentBatchesHtml);
</script>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Journey Exit | Self Service</title>
<link rel="icon" href="https://www.magmutual.com/_next/image?url=%2Fmagmutual-egg.svg&amp;w=640&amp;q=75" type="image/png">
<style>
:root {
  --primary-color: #6366f1;
  --primary-dark: #4f46e5;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --bg-secondary: #f9fafb;
  --border-color: #e5e7eb;
  --gray-400: #9ca3af;
  --gray-500: #6b7280;
  --gray-900: #111827;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --radius-md: 0.5rem;
}
.breadcrumb-nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  font-size: 14px;
  margin-bottom: 20px;
}
.breadcrumb-link {
  display: inline-flex;
  align-items: center;
  color: var(--primary-color);
  text-decoration: none;
  font-weight: 500;
  font-size: 16px;
}
.breadcrumb-link:hover { color: var(--primary-dark); text-decoration: underline; }
.breadcrumb-separator { margin: 0 8px; color: var(--gray-400); }
.breadcrumb-current { font-weight: 600; color: var(--gray-900); }
.exit-workspace {
  display: flex;
  gap: 24px;
  align-items: flex-start;
}
.exit-main {
  flex: 3;
  min-width: 0;
}
.exit-side {
  flex: 1;
  min-width: 220px;
  max-width: 320px;
}
.card {
  background: #fff;
  border: 1px solid var(--border-color);
  border-radius: 12px;
  box-shadow: var(--shadow-sm);
  padding: 28px 28px 32px;
}
.card-side {
  padding: 20px;
  border-radius: 0;
}
.side-title {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 4px;
}
.side-sub {
  color: var(--text-secondary);
  font-size: 13px;
  margin-bottom: 16px;
}
.recent-list {
  list-style: none;
  margin: 0;
  padding: 5px 10px;
  border-top: 1px solid #e5e7eb;
}
.recent-item {
  padding: 12px 0;
  border-bottom: 1px solid var(--border-color);
}
.recent-item:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}
.recent-journey {
  font-weight: 600;
  font-size: 14px;
  color: var(--gray-900);
  margin-bottom: 6px;
  word-break: break-word;
}
.recent-detail {
  font-size: 12px;
  color: var(--gray-500);
  margin-bottom: 4px;
  word-break: break-word;
}
.recent-label {
  font-weight: 600;
  color: var(--gray-900);
}
.recent-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
}
.recent-date {
  font-size: 12px;
  color: var(--gray-500);
}
.recent-status {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  padding: 2px 8px;
  border: 1px solid var(--border-color);
  background: #f9fafb;
  color: var(--gray-900);
}
.recent-status.is-done {
  border-color: #24a148;
  color: #0e6027;
  background: #f0fdf4;
}
.recent-status.is-failed {
  border-color: #da1e28;
  color: #a2191f;
  background: #fef2f2;
}
.recent-status.is-active {
  border-color: #f59e0b;
  color: #92400e;
  background: #fffbeb;
}
.recent-status.is-pending {
  border-color: #d1d5db;
  color: #4b5563;
}
.recent-empty {
  font-size: 13px;
  color: var(--gray-500);
  margin: 0;
}
@media (max-width: 980px) {
  .exit-workspace {
    flex-direction: column;
  }
  .exit-side {
    max-width: none;
    width: 100%;
  }
}
h1 {
  font-size: 1.75rem;
  font-weight: 700;
  margin-bottom: 8px;
  line-height: 1.25;
}
.sub {
  color: var(--text-secondary);
  margin-bottom: 24px;
}
.form-group { margin-bottom: 20px; }
.form-label {
  display: block;
  font-weight: 500;
  margin-bottom: 8px;
}
.form-input,
.form-select {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--border-color);
  border-radius: 0;
  font-size: 14px;
  background: #fff;
}
.form-input:focus,
.form-select:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}
.hint {
  margin-top: 6px;
  font-size: 13px;
  color: var(--gray-500);
}
.btn {
  border: 0;
  border-radius: 0;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 24px;
  min-height: 44px;
  line-height: 1.2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.btn-create {
  background: #000;
  color: #fff;
}
.btn-create:hover { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
.btn-secondary {
  background: #f3f4f6;
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  text-decoration: none;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  margin-top: 8px;
}
.notice {
  margin-bottom: 20px;
  padding: 14px 16px;
  border: 1px solid;
  background: #fff;
}
.success { border-color: #24a148; color: #0e6027; }
.error { border-color: #da1e28; color: #a2191f; }
.warn { border-color: #f59e0b; color: #92400e; }
.detail {
  margin-top: 12px;
  padding: 12px;
  background: #f9fafb;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  white-space: pre-wrap;
  word-break: break-word;
  color: #374151;
  display: none;
}
.detail.is-visible { display: block; }
</style>
</head>
<body>
<div class="dashboard-layout">
  %%=ContentBlockByKey("sst_shell_sidebar")=%%
  <main class="main-content">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="%%=v(@hubUrl)=%%" class="breadcrumb-link"><svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>Back</a>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      <span class="breadcrumb-current">Journey Exit</span>
    </nav>

    <div class="exit-workspace">
      <div class="exit-main">
        <div class="card">
          <h1>Journey Exit</h1>
          <p class="sub">Choose the journey and audience list to remove contacts from. You will get an email when processing finishes.</p>

          <script runat="server">
            function bodySafe(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            var loadErr = Platform.Variable.GetValue("@exitJourneysLoadError");
            if (loadErr) {
              Write('<div class="notice warn"><strong>Could not fully load journeys.</strong><br>' + bodySafe(loadErr) + '</div>');
            }
            var status = Platform.Variable.GetValue("@exitResultStatus");
            var message = Platform.Variable.GetValue("@exitResultMessage");
            if (status) {
              Write('<div class="notice ' + bodySafe(status) + '"><strong>' + bodySafe(message) + '</strong></div>');
            }
          </script>

          <form method="post" id="exitForm">
            <input type="hidden" name="formAction" id="formAction" value="queue">
            <input type="hidden" name="journeyName" id="journeyName" value="">
            <input type="hidden" name="journeyKey" id="journeyKey" value="">
            <div class="form-group">
              <label class="form-label" for="journeyId">Journey</label>
              <select class="form-select" id="journeyId" name="journeyId" required>
                <script runat="server">
                  Write(Platform.Variable.GetValue("@exitJourneyOptionsHtml") || '<option value="">No journeys loaded</option>');
                </script>
              </select>
              <p class="hint">Only published journeys are listed.</p>
            </div>
            <div class="form-group">
              <label class="form-label" for="sourceDeName">Audience list</label>
              <script runat="server">
                function fieldSafe(value) {
                  return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
                }
                Write('<input class="form-input" id="sourceDeName" name="sourceDeName" required placeholder="Enter the list name" value="' + fieldSafe(Platform.Variable.GetValue("@exitSourceDeName") || "") + '">');
              </script>
              <p class="hint">Use the Marketing Cloud list or data extension that holds the contacts to exit. It must include a Subscriber Key field.</p>
            </div>
            <div class="form-group">
              <label class="form-label" for="alertEmail">Notification email</label>
              <script runat="server">
                function fieldSafeEmail(value) {
                  return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
                }
                Write('<input class="form-input" id="alertEmail" name="alertEmail" type="email" required placeholder="name@example.com" value="' + fieldSafeEmail(Platform.Variable.GetValue("@exitAlertEmail") || "") + '">');
              </script>
              <p class="hint">We will send status updates to this address.</p>
            </div>
            <div class="actions">
              <button class="btn btn-create" type="submit" id="submitBtn" onclick="return submitQueue();">Start exit</button>
              <a class="btn btn-secondary" href="%%=v(@hubUrl)=%%">Cancel</a>
              <script runat="server">
                var detail = Platform.Variable.GetValue("@exitResultDetail");
                if (detail) {
                  Write('<button type="button" class="btn btn-secondary" id="toggleDetailBtn">Show details</button>');
                }
              </script>
            </div>
          </form>

          <script runat="server">
            function detailSafe(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
            }
            var detailBody = Platform.Variable.GetValue("@exitResultDetail");
            if (detailBody) {
              Write('<pre class="detail" id="apiDetail">' + detailSafe(detailBody) + '</pre>');
            }
          </script>
        </div>
      </div>

      <aside class="exit-side" aria-label="Recent exit requests">
        <div class="card card-side">
          <h2 class="side-title">Recent exits</h2>
          <p class="side-sub">Last 5 requests</p>
          <script runat="server">
            Write(Platform.Variable.GetValue("@exitRecentBatchesHtml") || '<p class="recent-empty">No recent exit requests yet.</p>');
          </script>
        </div>
      </aside>
    </div>
  </main>
</div>
<script>
(function () {
  var select = document.getElementById("journeyId");
  var journeyName = document.getElementById("journeyName");
  var journeyKey = document.getElementById("journeyKey");
  function syncJourneyMeta() {
    if (!select) return;
    var opt = select.options[select.selectedIndex];
    if (journeyName) {
      journeyName.value = opt && opt.getAttribute("data-name") ? opt.getAttribute("data-name") : "";
    }
    if (journeyKey) {
      journeyKey.value = opt && opt.getAttribute("data-key") ? opt.getAttribute("data-key") : "";
    }
  }
  if (select) {
    select.addEventListener("change", syncJourneyMeta);
    syncJourneyMeta();
  }
  window.submitQueue = function () {
    syncJourneyMeta();
    var deName = document.getElementById("sourceDeName").value || "";
    var label = journeyName.value || "the selected journey";
    return confirm("Start exiting contacts for " + label + " using audience list \"" + deName + "\"?");
  };
  var toggle = document.getElementById("toggleDetailBtn");
  var detail = document.getElementById("apiDetail");
  if (toggle && detail) {
    toggle.addEventListener("click", function () {
      var open = detail.className.indexOf("is-visible") > -1;
      detail.className = open ? "detail" : "detail is-visible";
      toggle.textContent = open ? "Show details" : "Hide details";
    });
  }
})();
</script>
</body>
</html>
