  margin-top: 12px;
  padding: 12px;
  background: #f9fafb;
  border: 1px solid var(--border-color);
  border-radius: 0;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  white-space: pre-wrap;
  word-break: break-word;
  color: #374151;
  display: none;
}
.detail.is-visible { display: block; }
.contacts-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
  margin-bottom: 16px;
  font-size: 14px;
  color: var(--gray-500);
}
.contacts-truncated {
  font-size: 13px;
  color: #92400e;
}
.contacts-table-wrap {
  overflow-x: auto;
  border: 1px solid var(--border-color);
}
.contacts-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}
.contacts-table th,
.contacts-table td {
  padding: 10px 12px;
  border-bottom: 1px solid var(--border-color);
  text-align: left;
  vertical-align: top;
}
.contacts-table th {
  background: var(--bg-secondary);
  font-weight: 600;
  color: var(--gray-900);
  white-space: nowrap;
}
.contacts-table tbody tr:last-child td {
  border-bottom: 0;
}
.contacts-table tbody tr:hover {
  background: #fafafa;
}
.contacts-mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  word-break: break-all;
}
.contacts-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 20px;
  font-size: 13px;
  color: var(--gray-500);
}
.contacts-meta-label {
  font-weight: 600;
  color: var(--gray-900);
}
.exit-form-card {
  position: relative;
}
.exit-form-loading {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 28px;
  background: rgba(255, 255, 255, 0.94);
}
.exit-form-loading.is-visible {
  display: flex;
}
.exit-form-loading-inner {
  max-width: 360px;
  text-align: center;
}
.exit-form-spinner {
  width: 40px;
  height: 40px;
  margin: 0 auto 16px;
  border: 3px solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: exitFormSpin 0.8s linear infinite;
}
@keyframes exitFormSpin {
  to {
    transform: rotate(360deg);
  }
}
.exit-form-loading-title {
  margin: 0 0 8px;
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--gray-900);
}
.exit-form-loading-sub {
  margin: 0;
  font-size: 14px;
  color: var(--text-secondary);
  line-height: 1.5;
}
</style>
</head>
<body>
<div class="dashboard-layout">
  %%=ContentBlockByKey("sst_shell_sidebar")=%%
  <main class="main-content">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="%%=v(@hubUrl)=%%" class="breadcrumb-link"><svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>Back</a>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      <span class="breadcrumb-current">Journey Exit</span>
    </nav>

    <div class="exit-workspace">
      <div class="exit-main">
        <script runat="server">
          function panelHidden(show) {
            return show ? "" : ' style="display:none;"';
          }
          var showContactsPanel =
            Platform.Variable.GetValue("@exitShowContactsView") === "true";
          Write(
            '<div id="exitFormPanel" class="exit-panel"' +
              panelHidden(!showContactsPanel) +
              ">"
          );
        </script>
        <div class="card exit-form-card">
          <div id="exitFormLoading" class="exit-form-loading" aria-hidden="true">
            <div class="exit-form-loading-inner">
              <div class="exit-form-spinner" aria-hidden="true"></div>
              <p class="exit-form-loading-title">Starting exit</p>
              <p class="exit-form-loading-sub">Queuing contacts and starting processing. This may take a moment.</p>
            </div>
          </div>
          <h1>Journey Exit</h1>
          <p class="sub">Choose the journey and data extension to remove contacts from. You will get an email when processing finishes.</p>

          <script runat="server">
            function bodySafe(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            var loadErr = Platform.Variable.GetValue("@exitJourneysLoadError");
            if (loadErr) {
              Write('<div class="notice warn"><strong>Could not fully load journeys.</strong><br>' + bodySafe(loadErr) + '</div>');
            }
            var status = Platform.Variable.GetValue("@exitResultStatus");
            var message = Platform.Variable.GetValue("@exitResultMessage");
            if (status) {
              Write('<div class="notice ' + bodySafe(status) + '" id="exitResultNotice"><strong>' + bodySafe(message) + '</strong></div>');
            }
          </script>

          <form method="post" id="exitForm">
            <input type="hidden" name="formAction" id="formAction" value="queue">
            <input type="hidden" name="journeyName" id="journeyName" value="">
            <input type="hidden" name="journeyKey" id="journeyKey" value="">
            <div class="form-group">
              <label class="form-label" for="journeyId">Journey</label>
              <select class="form-select" id="journeyId" name="journeyId" required>
                <script runat="server">
                  Write(Platform.Variable.GetValue("@exitJourneyOptionsHtml") || '<option value="">No journeys loaded</option>');
                </script>
              </select>
              <p class="hint">Only published journeys are listed.</p>
            </div>
            <div class="form-group">
              <label class="form-label" for="sourceType">Source</label>
              <script runat="server">
                function fieldSafeType(value) {
                  return String(value || "dataextension")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
                }
                var selectedSource = fieldSafeType(Platform.Variable.GetValue("@exitSourceType") || "dataextension");
                Write('<select class="form-select" id="sourceType" name="sourceType">');
                Write('<option value="dataextension"' + (selectedSource === "campaign" ? "" : " selected") + ">Data extension</option>");
                Write('<option value="campaign"' + (selectedSource === "campaign" ? " selected" : "") + ">Campaign</option>");
                Write("</select>");
              </script>
              <p class="hint">Choose a data extension or a Salesforce campaign.</p>
            </div>
            <div class="form-group" id="deSourceRow">
              <label class="form-label" for="sourceDeName">Data extension</label>
              <script runat="server">
                function fieldSafe(value) {
                  return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
                }
                Write('<input class="form-input" id="sourceDeName" name="sourceDeName" placeholder="Enter the data extension name" value="' + fieldSafe(Platform.Variable.GetValue("@exitSourceDeName") || "") + '">');
              </script>
              <p class="hint">Marketing Cloud list or data extension with a Subscriber Key field.</p>
            </div>
            <div class="form-group" id="campaignSourceRow" style="display:none;">
              <label class="form-label" for="campaignId">Campaign ID</label>
              <script runat="server">
                function fieldSafeCamp(value) {
                  return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
                }
                Write('<input class="form-input" id="campaignId" name="campaignId" placeholder="e.g. 701XXXXXXXXXXXXXXX" value="' + fieldSafeCamp(Platform.Variable.GetValue("@exitCampaignId") || "") + '">');
              </script>
              <p class="hint">Salesforce Campaign ID (15 or 18 characters).</p>
            </div>
            <div class="form-group" id="memberStatusRow" style="display:none;">
              <label class="form-label" for="memberStatus">Campaign Member status</label>
              <script runat="server">
                function fieldSafeStatus(value) {
                  return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
                }
                Write('<input class="form-input" id="memberStatus" name="memberStatus" placeholder="e.g. Sent" value="' + fieldSafeStatus(Platform.Variable.GetValue("@exitMemberStatus") || "") + '">');
              </script>
              <p class="hint">Exact CampaignMember Status value. Only members with this status are queued for exit.</p>
            </div>
            <div class="form-group">
              <label class="form-label" for="alertEmail">Notification email</label>
              <script runat="server">
                function fieldSafeEmail(value) {
                  return String(value || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;");
                }
                Write('<input class="form-input" id="alertEmail" name="alertEmail" type="email" required placeholder="name@example.com" value="' + fieldSafeEmail(Platform.Variable.GetValue("@exitAlertEmail") || "") + '">');
              </script>
              <p class="hint">We will send status updates to this address.</p>
            </div>
            <div class="actions">
              <button class="btn btn-create" type="submit" id="submitBtn">Start exit</button>
              <a class="btn btn-secondary" href="%%=v(@hubUrl)=%%">Cancel</a>
              <script runat="server">
                var detail = Platform.Variable.GetValue("@exitResultDetail");
                if (detail) {
                  Write('<button type="button" class="btn btn-secondary" id="toggleDetailBtn">Show details</button>');
                }
              </script>
            </div>
          </form>

          <script runat="server">
            function detailSafe(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
            }
            var detailBody = Platform.Variable.GetValue("@exitResultDetail");
            if (detailBody) {
              Write('<pre class="detail" id="apiDetail">' + detailSafe(detailBody) + '</pre>');
            }
          </script>
        </div>
        <script runat="server">Write("</div>");</script>

        <script runat="server">
          function contactsBodySafe(value) {
            return String(value || "")
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;")
              .replace(/"/g, "&quot;");
          }
          var showContactsPanelInner =
            Platform.Variable.GetValue("@exitShowContactsView") === "true";
          Write(
            '<div id="exitContactsPanel" class="exit-panel"' +
              (showContactsPanelInner ? "" : ' style="display:none;"') +
              ">"
          );
          Write('<div class="card">');
          Write(
            '<div class="actions" style="margin-top:0;margin-bottom:20px;">' +
              '<a class="btn btn-secondary" href="' +
              contactsBodySafe(Platform.Variable.GetValue("@exitBackUrl") || "#") +
              '">Back to new exit</a>' +
              "</div>"
          );
          Write("<h1>Exit contacts</h1>");
          var viewJourney = Platform.Variable.GetValue("@exitViewBatchJourneyName");
          var viewAudience = Platform.Variable.GetValue("@exitViewBatchAudience");
          var viewStatus = Platform.Variable.GetValue("@exitViewBatchStatus");
          var viewBatchIdDisplay = Platform.Variable.GetValue("@exitViewBatchId");
          var viewRequested = Platform.Variable.GetValue("@exitViewBatchRequestedAtDisplay");
          Write(
            '<p class="sub">Contacts queued and processed for this exit batch.</p>'
          );
          Write('<div class="contacts-meta">');
          if (viewJourney) {
            Write(
              '<div><span class="contacts-meta-label">Journey</span> ' +
                contactsBodySafe(viewJourney) +
                "</div>"
            );
          }
          if (viewAudience) {
            Write(
              '<div><span class="contacts-meta-label">Audience</span> ' +
                contactsBodySafe(viewAudience) +
                "</div>"
            );
          }
          if (viewBatchIdDisplay) {
            Write(
              '<div><span class="contacts-meta-label">Batch</span> <span class="contacts-mono">' +
                contactsBodySafe(viewBatchIdDisplay) +
                "</span></div>"
            );
          }
          if (viewRequested) {
            Write(
              '<div><span class="contacts-meta-label">Requested</span> ' +
                contactsBodySafe(viewRequested) +
                "</div>"
            );
          }
          if (viewStatus) {
            Write(
              '<div><span class="contacts-meta-label">Batch status</span> ' +
                contactsBodySafe(viewStatus) +
                "</div>"
            );
          }
          Write("</div>");
          var contactsErr = Platform.Variable.GetValue("@exitContactsError");
          if (contactsErr) {
            Write(
              '<div class="notice error"><strong>' +
                contactsBodySafe(contactsErr) +
                "</strong></div>"
            );
          }
          Write(
            Platform.Variable.GetValue("@exitContactsHtml") ||
              '<p class="recent-empty">No exit contacts found for this batch yet.</p>'
          );
          Write("</div></div>");
        </script>
      </div>

      <aside class="exit-side" aria-label="Recent exit requests">
        <div class="card card-side">
          <h2 class="side-title">Recent exits</h2>
          <p class="side-sub">Last 5 requests. Click one to view contacts.</p>
          <script runat="server">
            Write(Platform.Variable.GetValue("@exitRecentBatchesHtml") || '<p class="recent-empty">No recent exit requests yet.</p>');
          </script>
        </div>
      </aside>
    </div>
  </main>
</div>
<script>
(function () {
  var select = document.getElementById("journeyId");
  var journeyName = document.getElementById("journeyName");
  var journeyKey = document.getElementById("journeyKey");
  function syncJourneyMeta() {
    if (!select) return;
    var opt = select.options[select.selectedIndex];
    if (journeyName) {
      journeyName.value = opt && opt.getAttribute("data-name") ? opt.getAttribute("data-name") : "";
    }
    if (journeyKey) {
      journeyKey.value = opt && opt.getAttribute("data-key") ? opt.getAttribute("data-key") : "";
    }
  }
  if (select) {
    select.addEventListener("change", syncJourneyMeta);
    syncJourneyMeta();
  }
  function showExitLoading() {
    var panel = document.getElementById("exitFormPanel");
    var loading = document.getElementById("exitFormLoading");
    var submitBtn = document.getElementById("submitBtn");
    if (loading) {
      loading.className = "exit-form-loading is-visible";
      loading.setAttribute("aria-hidden", "false");
    }
    if (panel) {
      panel.setAttribute("aria-busy", "true");
    }
    if (submitBtn) {
      submitBtn.textContent = "Starting…";
    }
  }
  function getExitConfirmMessage() {
    syncJourneyMeta();
    var sourceTypeEl = document.getElementById("sourceType");
    var mode = sourceTypeEl ? sourceTypeEl.value : "dataextension";
    var label = journeyName.value || "the selected journey";
    if (mode === "campaign") {
      var campId = (document.getElementById("campaignId").value || "").replace(/^\s+|\s+$/g, "");
      var memberStatus = (document.getElementById("memberStatus").value || "").replace(/^\s+|\s+$/g, "");
      return (
        "Start exiting contacts for " +
        label +
        " from Campaign \"" +
        campId +
        "\" with status \"" +
        memberStatus +
        "\"?"
      );
    }
    var deName = document.getElementById("sourceDeName").value || "";
    return (
      "Start exiting contacts for " + label + " using data extension \"" + deName + "\"?"
    );
  }
  var exitForm = document.getElementById("exitForm");
  var exitSubmitting = false;
  if (exitForm) {
    exitForm.addEventListener("submit", function (e) {
      if (exitSubmitting) {
        return;
      }
      e.preventDefault();
      if (!confirm(getExitConfirmMessage())) {
        return;
      }
      exitSubmitting = true;
      showExitLoading();
      exitForm.submit();
    });
  }
  function syncSourceUi() {
    var sourceTypeEl = document.getElementById("sourceType");
    var mode = sourceTypeEl ? sourceTypeEl.value : "dataextension";
    var isCampaign = mode === "campaign";
    var deRow = document.getElementById("deSourceRow");
    var campRow = document.getElementById("campaignSourceRow");
    var statusRow = document.getElementById("memberStatusRow");
    var deInput = document.getElementById("sourceDeName");
    var campInput = document.getElementById("campaignId");
    var statusInput = document.getElementById("memberStatus");
    if (deRow) deRow.style.display = isCampaign ? "none" : "";
    if (campRow) campRow.style.display = isCampaign ? "" : "none";
    if (statusRow) statusRow.style.display = isCampaign ? "" : "none";
    if (deInput) {
      deInput.required = !isCampaign;
      deInput.disabled = isCampaign;
    }
    if (campInput) {
      campInput.required = isCampaign;
      campInput.disabled = !isCampaign;
    }
    if (statusInput) {
      statusInput.required = isCampaign;
      statusInput.disabled = !isCampaign;
    }
  }
  var sourceTypeSelect = document.getElementById("sourceType");
  if (sourceTypeSelect) {
    sourceTypeSelect.addEventListener("change", syncSourceUi);
  }
  syncSourceUi();
  var toggle = document.getElementById("toggleDetailBtn");
  var detail = document.getElementById("apiDetail");
  if (toggle && detail) {
    toggle.addEventListener("click", function () {
      var open = detail.className.indexOf("is-visible") > -1;
      detail.className = open ? "detail" : "detail is-visible";
      toggle.textContent = open ? "Show details" : "Hide details";
    });
  }

  var recentItems = document.querySelectorAll(".recent-item--clickable");
  var ri;
  for (ri = 0; ri < recentItems.length; ri++) {
    recentItems[ri].addEventListener("click", function () {
      var batchId = this.getAttribute("data-batch-id");
      if (!batchId) {
        return;
      }
      window.location.href =
        window.location.pathname +
        "?viewBatch=" +
        encodeURIComponent(batchId);
    });
    recentItems[ri].addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        this.click();
      }
    });
  }

  var successNotice = document.getElementById("exitResultNotice");
  if (successNotice && (" " + successNotice.className + " ").indexOf(" success ") > -1) {
    var submitBtn = document.getElementById("submitBtn");
    if (submitBtn) {
      submitBtn.disabled = true;
    }
    var exitForm = document.getElementById("exitForm");
    if (exitForm) {
      exitForm.addEventListener("submit", function (e) {
        e.preventDefault();
        return false;
      });
    }
    var secondsLeft = 5;
    var countdown = document.createElement("div");
    countdown.className = "reload-countdown";
    successNotice.appendChild(countdown);
    function tickReload() {
      countdown.textContent =
        "This page will reload in " + secondsLeft + " sec.";
      if (secondsLeft <= 0) {
        var nextUrl = window.location.pathname + window.location.search;
        window.location.replace(nextUrl);
        return;
      }
      secondsLeft -= 1;
      window.setTimeout(tickReload, 1000);
    }
    tickReload();
  }
})();
</script>
</body>
</html>
