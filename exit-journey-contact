}
.breadcrumb-nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4px;
  font-size: 14px;
  margin-bottom: 20px;
}
.breadcrumb-link {
  display: inline-flex;
  align-items: center;
  color: var(--primary-color);
