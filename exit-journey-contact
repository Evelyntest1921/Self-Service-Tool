  max-width: 560px;
}
.form-group { margin-bottom: 20px; }
.form-label {
  display: block;
  font-weight: 500;
  margin-bottom: 8px;
}
.form-input,
.form-select {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 14px;
  background: #fff;
}
.form-input:focus,
.form-select:focus {
