            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }
        var homeHref = navSafe(Platform.Variable.GetValue("@exitHubUrl") || "#");
        var exitHref = navSafe(Platform.Variable.GetValue("@exitJourneyExitUrl") || "#");
        Write('<a class="nav-link" href="' + homeHref + '"><svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg><span>Builder home</span></a>');
        Write('<a class="nav-link" href="' + homeHref + '"><svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg><span>Recent builds</span></a>');
        Write('<a class="nav-link" href="' + homeHref + '"><svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M9 11H7v6h2v-6zm4 0h-2v6h2v-6zm4 0h-2v6h2v-6zM5 20h14V4H5v16zm14 2H5c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h14c1.1 0 2 .9 2 2v16c0 1.1-.9 2-2 2z"/></svg><span>Performance</span></a>');
        Write('<a class="nav-link" href="' + homeHref + '"><svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10 2 10 2 10 2 9 3 8.18 4H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/></svg><span>Deployment</span></a>');
        Write('<div class="nav-section" style="margin-top: 24px;"><span class="nav-section-title">MANAGE</span></div>');
        Write('<a class="nav-link active" href="' + exitHref + '"><svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg><span>Journey Exit</span></a>');
      </script>
    </nav>
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <script runat="server">
          function bodySafe(value) {
            return String(value || "")
              .replace(/&/g, "&amp;")
              .replace(/</g, "&lt;")
              .replace(/>/g, "&gt;")
              .replace(/"/g, "&quot;");
          }
          Write('<div class="user-avatar">' + bodySafe(Platform.Variable.GetValue("@exitEnvAvatarLetter") || "") + '</div>');
          Write('<div class="user-info"><div class="user-name">' + bodySafe(Platform.Variable.GetValue("@exitEnvDisplayName") || "") + '</div>');
          Write('<div class="user-email">' + bodySafe(Platform.Variable.GetValue("@exitEnvDisplayEmail") || "") + '</div></div>');
        </script>
      </div>
    </div>
  </aside>

  <main class="main-content">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <script runat="server">
        function navSafe(value) {
          return String(value || "#")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }
        Write('<a href="' + navSafe(Platform.Variable.GetValue("@exitHubUrl") || "#") + '" class="breadcrumb-link"><svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>Back</a>');
      </script>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      <span class="breadcrumb-current">Journey Exit</span>
    </nav>

    <div class="card">
      <h1>Journey Exit</h1>
      <p class="sub">Select a published journey and enter a source Data Extension. This writes a Pending row to <code>bd_sst_journey_exit_batch</code> for the seeder automation.</p>

      <script runat="server">
        function bodySafe(value) {
          return String(value || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
        }
        var loadErr = Platform.Variable.GetValue("@exitJourneysLoadError");
        if (loadErr) {
          Write('<div class="notice warn"><strong>Could not fully load journeys.</strong><br>' + bodySafe(loadErr) + '</div>');
        }
        var status = Platform.Variable.GetValue("@exitResultStatus");
        var message = Platform.Variable.GetValue("@exitResultMessage");
        if (status) {
          Write('<div class="notice ' + bodySafe(status) + '"><strong>' + bodySafe(message) + '</strong></div>');
        }
      </script>

      <form method="post" id="exitForm">
        <input type="hidden" name="formAction" id="formAction" value="queue">
        <input type="hidden" name="journeyName" id="journeyName" value="">
        <input type="hidden" name="journeyKey" id="journeyKey" value="">
        <div class="form-group">
          <label class="form-label" for="journeyId">Journey</label>
          <select class="form-select" id="journeyId" name="journeyId" required>
            <script runat="server">
              Write(Platform.Variable.GetValue("@exitJourneyOptionsHtml") || '<option value="">No journeys loaded</option>');
            </script>
          </select>
          <p class="hint">Published journeys only. Journey ID and Definition Key are saved on the batch row.</p>
        </div>
        <div class="form-group">
          <label class="form-label" for="sourceDeName">Source Data Extension</label>
          <script runat="server">
            function fieldSafe(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            Write('<input class="form-input" id="sourceDeName" name="sourceDeName" required placeholder="DE name or Customer Key (must include SubscriberKey)" value="' + fieldSafe(Platform.Variable.GetValue("@exitSourceDeName") || "") + '">');
          </script>
          <p class="hint">Source DE must contain a <code>SubscriberKey</code> column. Prefer Customer Key if names collide.</p>
        </div>
        <div class="form-group">
          <label class="form-label" for="alertEmail">Alert Email</label>
          <script runat="server">
            function fieldSafeEmail(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            Write('<input class="form-input" id="alertEmail" name="alertEmail" type="email" required placeholder="name@example.com" value="' + fieldSafeEmail(Platform.Variable.GetValue("@exitAlertEmail") || "") + '">');
          </script>
          <p class="hint">Saved to the batch <code>Email</code> column for status notifications.</p>
        </div>
        <div class="actions">
          <button class="btn btn-create" type="submit" id="submitBtn" onclick="return submitQueue();">Queue batch</button>
          <script runat="server">
            function navSafe(value) {
              return String(value || "#")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            Write('<a class="btn btn-secondary" href="' + navSafe(Platform.Variable.GetValue("@exitHubUrl") || "#") + '">Cancel</a>');
          </script>
          <script runat="server">
            var detail = Platform.Variable.GetValue("@exitResultDetail");
            if (detail) {
              Write('<button type="button" class="btn btn-secondary" id="toggleDetailBtn">Show details</button>');
            }
          </script>
        </div>
      </form>

      <script runat="server">
        function detailSafe(value) {
          return String(value || "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;");
        }
        var detailBody = Platform.Variable.GetValue("@exitResultDetail");
        if (detailBody) {
          Write('<pre class="detail" id="apiDetail">' + detailSafe(detailBody) + '</pre>');
        }
      </script>
    </div>
  </main>
</div>
<script>
(function () {
  var select = document.getElementById("journeyId");
  var journeyName = document.getElementById("journeyName");
  var journeyKey = document.getElementById("journeyKey");
  function syncJourneyMeta() {
    if (!select) return;
    var opt = select.options[select.selectedIndex];
    if (journeyName) {
      journeyName.value = opt && opt.getAttribute("data-name") ? opt.getAttribute("data-name") : "";
    }
    if (journeyKey) {
      journeyKey.value = opt && opt.getAttribute("data-key") ? opt.getAttribute("data-key") : "";
    }
  }
  if (select) {
    select.addEventListener("change", syncJourneyMeta);
    syncJourneyMeta();
  }
  window.submitQueue = function () {
    syncJourneyMeta();
    var deName = document.getElementById("sourceDeName").value || "";
    var label = journeyName.value || "the selected journey";
    return confirm("Queue exits for " + label + " from DE \"" + deName + "\"?");
  };
  var toggle = document.getElementById("toggleDetailBtn");
  var detail = document.getElementById("apiDetail");
  if (toggle && detail) {
    toggle.addEventListener("click", function () {
      var open = detail.className.indexOf("is-visible") > -1;
      detail.className = open ? "detail" : "detail is-visible";
      toggle.textContent = open ? "Show details" : "Hide details";
    });
  }
})();
</script>
</body>
</html>
