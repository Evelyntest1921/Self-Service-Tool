Platform.Variable.SetValue("@exitViewBatchAudience", exitViewBatchAudience);
Platform.Variable.SetValue("@exitViewBatchStatus", exitViewBatchStatus);
Platform.Variable.SetValue("@exitViewBatchRequestedAt", exitViewBatchRequestedAt);
