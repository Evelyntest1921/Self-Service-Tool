.dashboard-layout{flex-direction:column;height:auto;overflow:visible}
.maker-sidebar{width:100%;flex-direction:row;overflow-x:auto;height:auto;padding:12px 0}
.maker-sidebar .sidebar-nav{display:flex;flex-direction:row;gap:4px;padding:8px 0;flex:1;flex-wrap:nowrap}
.maker-sidebar .nav-section-title{display:none}
.maker-sidebar .nav-link{white-space:nowrap;padding:8px 16px;border-right:none;border-radius:8px}
.maker-main{height:auto;overflow:visible}
.maker-main-inner{padding:16px}
}
</style>
</head>
<body>
<div class="dashboard-layout">
<aside class="maker-sidebar sidebar" aria-label="Primary">
  <div class="sidebar-logo">
    <a href="%%=v(@HOME_URL)=%%"><img src="https://www.magmutual.com/_next/image?url=%2Fmagmutual-egg.svg&amp;w=640&amp;q=75" alt="MagMutual" style="filter: invert(1);"></a>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section"><span class="nav-section-title">MENU</span></div>
    <a class="nav-link" href="%%=IIF(NOT Empty(@jid), Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid), @BUILD_PAGE_SELF)=%%">
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 17h2v-5H3v5zm8 5h2V6h-2v16zM13 9h8V7h-8v2zM3 5v4h14V5H3zm8 14h10v-2H11v2zM13 17h8v-2h-8v2z"/></svg>
      Manage build
    </a>
    %%[ IF @isSurveyBuild == "true" AND NOT Empty(@dispSurveyId) AND @dispSurveyId != "N/A" AND NOT Empty(@SURVEY_STAGE_URL) THEN ]%%
    <a class="nav-link" href="%%=Concat(@SURVEY_STAGE_URL,"?mode=edit&surveyid=",@dispSurveyId,IIF(NOT Empty(@jid),Concat("&journeyId=",@jid),""))=%%">
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1.003 1.003 0 0 0 0-1.42l-2.34-2.34a1.003 1.003 0 0 0-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z"/></svg>
      Edit Survey
    </a>
    %%[ ENDIF ]%%
    %%[ IF @isSurveyBuild == "true" AND NOT Empty(@dispSurveyId) AND @dispSurveyId != "N/A" AND NOT Empty(@SURVEY_ANALYTICS_URL) THEN ]%%
    <a class="nav-link" href="%%=Concat(@SURVEY_ANALYTICS_URL,"?surveyid=",@dispSurveyId,IIF(NOT Empty(@jid),Concat("&journeyId=",@jid),""))=%%">
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
      Results
    </a>
    %%[ ENDIF ]%%
    <span class="nav-link active" role="presentation">
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M4 6h16M4 12h10M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="18" cy="12" r="2" fill="currentColor"/>
      </svg>
      Journey
    </span>
    %%[ IF NOT Empty(@PERFORMANCE_URL) AND NOT Empty(@jid) THEN ]%%
    <a class="nav-link" href="%%=Concat(@PERFORMANCE_URL,"?journeyId=",@jid)=%%">
      <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 11H7v6h2v-6zm4 0h-2v6h2v-6zm4 0h-2v6h2v-6zM5 20h14V4H5v16zm14 2H5c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h14c1.1 0 2 .9 2 2v16c0 1.1-.9 2-2 2z"/></svg>
      Performance
    </a>
    %%[ ENDIF ]%%
  </nav>
</aside>
<main class="maker-main">
<div class="maker-main-inner">
%%[ IF @pageStatus == "nodata" THEN ]%%
<h1>Journey view</h1>
<p class="sub">Open this page from <strong>Manage build</strong> with a <strong>journeyId</strong> in the URL.</p>
%%[ ELSEIF @pageStatus == "emailonly" THEN ]%%
<h1>No Journey Builder canvas</h1>
<p class="sub">This build is email-only. There is no journey to visualize.</p>
<p class="sub"><a class="breadcrumb-link" href="%%=Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid)=%%">Back to manage build</a></p>
%%[ ELSEIF @pageStatus == "authfail" THEN ]%%
<h1>Could not authorize</h1>
<div class="banner bad">%%=v(@loadError)=%%</div>
%%[ ELSEIF @pageStatus == "apifail" THEN ]%%
<h1>Could not load journey</h1>
<div class="banner bad">%%=v(@loadError)=%%</div>
<p class="sub"><a class="breadcrumb-link" href="%%=Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid)=%%">Back to manage build</a></p>
%%[ ELSE ]%%
<h1>%%=IIF(NOT Empty(@apiJourneyName), @apiJourneyName, IIF(NOT Empty(@dispName), @dispName, "Journey"))=%%</h1>
<p class="sub">Primary path through the journey definition returned by Journey Builder (live API). Branches follow the first outcome only.</p>
<div class="panel">%%[ IF NOT Empty(@journeyMetaHtml) THEN ]%%%%=TreatAsContent(@journeyMetaHtml)=%%%%[ ENDIF ]%%</div>
<div class="panel">
  <h2 class="panel-title">Flow (primary path)</h2>
  <p class="flow-hint">%%=v(@apiActivityCount)=%% activities in definition. Use Journey Builder for the full canvas.</p>
  %%[ IF NOT Empty(@journeyFlowHtml) THEN ]%%
  %%=TreatAsContent(@journeyFlowHtml)=%%
  %%[ ELSE ]%%
  <p class="recent-empty">No flow diagram available.</p>
  %%[ ENDIF ]%%
</div>
<div class="panel">
  <h2 class="panel-title">All activities</h2>
  %%[ IF NOT Empty(@journeyActivitiesHtml) THEN ]%%
  %%=TreatAsContent(@journeyActivitiesHtml)=%%
  %%[ ELSE ]%%
  <p class="recent-empty">No activities available.</p>
  %%[ ENDIF ]%%
</div>
%%[ ENDIF ]%%
</div>
</main>
</div>
</body>
</html>
