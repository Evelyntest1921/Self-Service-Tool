          const clicksData = parseDailyNumericSeries(decodeAmpData('%%=v(@dailyClicksEnc)=%%'));
          const unsubscribedData = parseDailyNumericSeries(decodeAmpData('%%=v(@dailyUnsubscribedEnc)=%%'));
          const unregisteredOpensData = parseDailyNumericSeries(decodeAmpData('%%=v(@dailyUnregisteredOpensEnc)=%%'));
          const sumSeries = arr => arr.reduce((s, v) => s + (Number(v) || 0), 0);
          const opensTotal = sumSeries(opensData);
          const clicksTotal = sumSeries(clicksData);
          const unsubscribedTotal = sumSeries(unsubscribedData);
          const unregisteredOpensTotal = sumSeries(unregisteredOpensData);
         const allValues = opensData
             .concat(isUat ? clicksData : [])
             .concat(unsubscribedData, unregisteredOpensData)
             .filter(v => !isNaN(v));
           const maxValue = allValues.length > 0 ? Math.max(...allValues) : 1;
           const stepSize = Math.max(1, Math.ceil(maxValue / 10));
           new Chart(ctx, {
               type: 'line',
               data: {
                   labels: sortedDates,
                  datasets: [
                       {
