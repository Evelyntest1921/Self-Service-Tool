SET @responsesDataTruncated = "0"
SET @emailPreviewUrl = ""
SET @articlePreviewUrl = ""
SET @automationId = ""
SET @syncAutomationId = ""
SET @homeUrl = ""
SET @switchEnvironment = ""
Set @env = Lookup("SFMC_SS_DASHBOARD", "Environment", "Environment", "PROD")

IF @env == "UAT" THEN
 SET @BU = "UAT"
ELSE
 SET @BU = "PROD"
ENDIF

SET @row = LookupRows("SFMC_SS_DASHBOARD", "Environment", @BU)

IF RowCount(@row) > 0 THEN
  SET @firstRow = Row(@row, 1)
  SET @emailPreviewUrl = IIF(NOT EMPTY(Field(@firstRow, "Email_Preview_Code")), Field(@firstRow, "Email_Preview_Code"), "")
  SET @articlePreviewUrl = IIF(NOT EMPTY(Field(@firstRow, "Article_Preview_Code")), Field(@firstRow, "Article_Preview_Code"), "")
  SET @automationId = IIF(NOT EMPTY(Field(@firstRow, "Automation_GUID")), Field(@firstRow, "Automation_GUID"), "")
  SET @syncAutomationId = IIF(NOT EMPTY(Field(@firstRow, "SyncAutomationId")), Field(@firstRow, "SyncAutomationId"), "")
  SET @homeUrl = IIF(NOT EMPTY(Field(@firstRow, "Home_URL")), Field(@firstRow, "Home_URL"), "")
  SET @switchEnvironment = IIF(NOT EMPTY(Field(@firstRow, "EnvironmentSwitchUrl")), Field(@firstRow, "EnvironmentSwitchUrl"), "")
  
  IF EMPTY(@emailPreviewUrl) OR EMPTY(@articlePreviewUrl) OR EMPTY(@automationId) THEN
    SET @configError = "Configuration error: missing required values in SFMC_SS_DASHBOARD."
  ENDIF
ELSE
  SET @configError = Concat("Configuration error: no row found in SFMC_SS_DASHBOARD for Environment=", @BU)
ENDIF

IF RequestParameter("do") == "addContact" AND NOT EMPTY(RequestParameter("contactId")) AND EMPTY(@configError) THEN
  SET @contactIdToAdd = RequestParameter("contactId")
  Redirect(Concat(@articlePreviewUrl, "?subscriberKey=", @contactIdToAdd))
ENDIF

]%%
<script runat="server">
Platform.Load("core", "1");

