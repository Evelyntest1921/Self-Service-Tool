  Variable.SetValue("@chartStateRows", "0");
  Variable.SetValue("@chartSpecialtyRows", "0");
  Variable.SetValue("@chartHourRows", "0");
}

try {

function trimValue(value) {
  return String(value == null ? "" : value).replace(/^\s+|\s+$/g, "");
}

function isUnsubscribedEngagement(eng) {
  var e = trimValue(eng).toLowerCase();
  return e === "unsubscribed" || e === "unsubscribe" || e === "global unsubscribe" || e === "global unsubscribed";
}

function toPropList(item) {
  if (!item || !item.Properties) {
    return [];
  }
  if (item.Properties.length) {
    return item.Properties;
  }
  if (item.Properties.Property && item.Properties.Property.length) {
    return item.Properties.Property;
  }
  if (item.Properties.Property) {
    return [item.Properties.Property];
  }
  return [];
}

function appendWithLimit(currentValue, nextValue, suffix, maxChars) {
  var value = String(nextValue == null ? "" : nextValue);
  if (!value) {
    return currentValue;
  }
  if ((currentValue.length + value.length) < maxChars) {
    return currentValue + value + suffix;
  }
  return currentValue;
}

function responseValue(value) {
  var text = String(value == null ? "" : value);
  return text === "" ? "N/A" : text;
}

function ensureMetricBucket(metricMap, metricOrder, key) {
  if (!metricMap[key]) {
    metricMap[key] = { opened: 0, bounced: 0, didNotOpen: 0, clicked: 0, total: 0 };
    metricOrder.push(key);
  }
  return metricMap[key];
}

function buildMetricStrings(metricOrder, metricMap) {
  var labels = [];
  var opened = [];
  var bounced = [];
  var didNotOpen = [];
  var clicked = [];
  var total = [];

  for (var i = 0; i < metricOrder.length; i++) {
    var key = metricOrder[i];
    var bucket = metricMap[key];
    labels.push(key);
    opened.push(String(bucket.opened));
    bounced.push(String(bucket.bounced));
    didNotOpen.push(String(bucket.didNotOpen));
    clicked.push(String(bucket.clicked));
    total.push(String(bucket.total));
  }

  return {
    labels: labels.join(","),
    opened: opened.join(","),
    bounced: bounced.join(","),
    didNotOpen: didNotOpen.join(","),
    clicked: clicked.join(","),
    total: total.join(",")
  };
}

var sfmcMonthIndex = {
  Jan: 0, Feb: 1, Mar: 2, Apr: 3, May: 4, Jun: 5,
  Jul: 6, Aug: 7, Sep: 8, Oct: 9, Nov: 10, Dec: 11
};

function parseSfmcDateString(dateValue) {
  var text = trimValue(String(dateValue == null ? "" : dateValue));
  if (!text) {
    return null;
  }
  var nativeDate = new Date(text);
  if (!isNaN(nativeDate.getTime())) {
    return nativeDate;
  }
  var parts = text.split(/\s+/);
  if (parts.length < 3) {
    return null;
  }
  var month = parts[0];
  var day = parseInt(String(parts[1]).replace(/[^0-9]/g, ""), 10);
  var year = parseInt(String(parts[2]).replace(/[^0-9]/g, ""), 10);
  var hour24 = 0;
  var minutes = 0;
  if (parts.length >= 4) {
    var timeToken = parts[3];
    var ampm = "";
    if (/AM|PM/i.test(timeToken)) {
      ampm = timeToken.toUpperCase().indexOf("PM") >= 0 ? "PM" : "AM";
      timeToken = timeToken.replace(/AM|PM/gi, "").trim();
    } else if (parts.length >= 5 && /AM|PM/i.test(parts[4])) {
      ampm = parts[4].toUpperCase().indexOf("PM") >= 0 ? "PM" : "AM";
      timeToken = parts[3].replace(/AM|PM/gi, "").trim();
    }
    var timeParts = timeToken.split(":");
    if (timeParts.length >= 2) {
      hour24 = parseInt(timeParts[0], 10);
      minutes = parseInt(timeParts[1], 10) || 0;
      if (ampm === "PM" && hour24 !== 12) {
        hour24 = hour24 + 12;
      }
      if (ampm === "AM" && hour24 === 12) {
        hour24 = 0;
      }
    }
  }
  if (sfmcMonthIndex[month] === undefined || isNaN(day) || isNaN(year)) {
    return null;
  }
  var parsed = new Date(year, sfmcMonthIndex[month], day, hour24, minutes, 0);
  if (isNaN(parsed.getTime())) {
    return null;
  }
  return parsed;
}

function getSortTimestamp(dateValue) {
  var parsed = parseSfmcDateString(dateValue);
  if (!parsed) {
    return 0;
  }
  return parsed.getTime();
}

function getTimeInfo(dateValue) {
  var parsed = parseSfmcDateString(dateValue);
  if (!parsed) {
    return null;
  }
  return {
    hour: parsed.getHours(),
    minute: parsed.getMinutes()
  };
}

function formatAverageTimeLabel(totalMinutes, count) {
  if (!count) {
    return "N/A";
  }
  var rounded = Math.round(totalMinutes / count);
  var hour24 = Math.floor(rounded / 60) % 24;
  var minute = rounded % 60;
  var ampm = hour24 >= 12 ? "PM" : "AM";
  var hour12 = hour24 % 12;
  if (hour12 === 0) {
    hour12 = 12;
  }
  return hour12 + ":" + (minute < 10 ? "0" + minute : String(minute)) + " " + ampm;
}

function formatRateLabel(numerator, denominator) {
  if (!denominator) {
    return "0.0% Open Rate";
  }
  return ((numerator / denominator) * 100).toFixed(1) + "% Open Rate";
}

var skipTableLoad = String(Variable.GetValue("@skipTableLoad") || "") === "1";
var tableMaxRows = 200;
var tableFetchPool = 2500;
var tableFieldSep = "\u001f";
var tableLoadError = "";
var tableLoadMethod = "";
var tableResponsesData = "";
var tableResponsesDataTruncated = "0";
var tableRowCount = 0;
var maxPayloadChars = 450000;
var emailPreviewUrl = String(Variable.GetValue("@emailPreviewUrl") || "");
var articlePreviewUrl = String(Variable.GetValue("@articlePreviewUrl") || "");
var analyticsCustomerKey = "B7BAD774-2B05-4B0D-85B2-6109D4A899";
var analyticsCols = ["Engagement", "LastSent", "Email", "Contact_Id", "Primary_Specialty", "Related_Account_Primary_State", "JobID", "Related_Account_Name", "First_Name", "Last_Name", "Designation", "Role", "Mobile", "Auth0UserId", "OpenDate", "view_email_url", "Source", "validated"];

function rowFieldByName(row, fieldName) {
  if (!row || !fieldName) {
    return "";
  }
  var val = trimValue(rowVal(row, fieldName));
  if (val) {
    return val;
  }
  try {
    if (row[fieldName] != null && String(row[fieldName]) !== "") {
      return trimValue(String(row[fieldName]));
    }
  } catch (bracketErr) {}
  var want = String(fieldName).toLowerCase();
  try {
    for (var key in row) {
      if (String(key).toLowerCase() === want) {
        var matchVal = row[key];
        if (matchVal != null && String(matchVal) !== "") {
          return trimValue(String(matchVal));
        }
      }
    }
  } catch (keyErr) {}
  return "";
}

function rowToObject(row) {
  var out = {};
  if (!row) {
    return out;
  }
  for (var ci = 0; ci < analyticsCols.length; ci++) {
    var colName = analyticsCols[ci];
    out[colName] = rowFieldByName(row, colName);
  }
  return out;
}

function tableRowSortDate(rowData) {
  var date = trimValue(String(rowData.LastSent == null ? "" : rowData.LastSent));
  if (!date) {
    date = trimValue(String(rowData.OpenDate == null ? "" : rowData.OpenDate));
  }
  return date;
}

function buildTableEntry(rowData) {
  var date = tableRowSortDate(rowData);
  var contactId = String(rowData.Contact_Id == null ? "" : rowData.Contact_Id);
  var emailHistory = emailPreviewUrl && contactId ? emailPreviewUrl + "?subscriberKey=" + contactId : "";
  var courseHistory = articlePreviewUrl && contactId ? articlePreviewUrl + "?subscriberKey=" + contactId : "";
  return [
    responseValue(rowData.Contact_Id),
    responseValue(rowData.Email),
    responseValue(date),
    responseValue(rowData.Engagement),
    responseValue(rowData.Primary_Specialty),
    responseValue(rowData.Related_Account_Primary_State),
    responseValue(rowData.JobID),
    responseValue(rowData.Related_Account_Name),
    responseValue(rowData.First_Name),
    responseValue(rowData.Last_Name),
    responseValue(rowData.Designation),
    responseValue(rowData.Role),
    responseValue(rowData.Mobile),
    responseValue(rowData.Auth0UserId),
    responseValue(rowData.OpenDate),
    responseValue(rowData.view_email_url),
    responseValue(emailHistory),
    responseValue(courseHistory)
  ].join(tableFieldSep);
}

function finalizeTablePayload(entries) {
  entries.sort(function (a, b) {
    if (b.sortTs !== a.sortTs) {
      return b.sortTs - a.sortTs;
    }
    return b.idx - a.idx;
  });
  if (entries.length > tableMaxRows) {
    entries = entries.slice(0, tableMaxRows);
  }
  var payload = "";
  var truncated = "0";
  for (var ti = 0; ti < entries.length; ti++) {
    var part = entries[ti].payload;
    if ((payload.length + part.length) < maxPayloadChars) {
      payload += part;
    } else {
      truncated = "1";
      break;
    }
  }
  return { payload: payload, truncated: truncated, count: entries.length };
}

function loadTableViaLookupRows() {
  var deNames = ["PA_Server_Side_Engagement", analyticsCustomerKey];
  var fetchCap = Math.min(tableFetchPool, 2000);
  for (var di = 0; di < deNames.length; di++) {
    try {
      var rows = Platform.Function.LookupRows(
        deNames[di],
        ["Source", "validated"],
        ["Push Advice", "Yes"]
      );
      if (rows && rows.length > 0) {
        var rowLimit = rows.length > fetchCap ? fetchCap : rows.length;
        var entries = [];
        for (var ri = 0; ri < rowLimit; ri++) {
          var rowData = rowToObject(rows[ri]);
          entries.push({
            payload: buildTableEntry(rowData) + "|||",
            sortTs: getSortTimestamp(tableRowSortDate(rowData)),
            idx: ri
          });
        }
        return { ok: true, result: finalizeTablePayload(entries), method: "LookupRows" };
      }
    } catch (e) {}
  }
  return { ok: false };
}

function loadTableViaLookupOrdered() {
  var deNames = ["PA_Server_Side_Engagement", analyticsCustomerKey];
  for (var di = 0; di < deNames.length; di++) {
    try {
      var rows = Platform.Function.LookupOrderedRows(
        deNames[di],
        Math.min(tableFetchPool, 2000),
        "LastSent DESC",
        ["Source", "validated"],
        ["Push Advice", "Yes"]
      );
      if (rows && rows.length > 0) {
        var entries = [];
        for (var ri = 0; ri < rows.length; ri++) {
          var rowData = rowToObject(rows[ri]);
          entries.push({
            payload: buildTableEntry(rowData) + "|||",
            sortTs: getSortTimestamp(tableRowSortDate(rowData)),
            idx: ri
          });
        }
        return { ok: true, result: finalizeTablePayload(entries), method: "LookupOrderedRows" };
      }
    } catch (e) {}
  }
  return { ok: false };
}

function loadTableViaDeRetrieve() {
  var deNames = ["PA_Server_Side_Engagement", analyticsCustomerKey];
  for (var di = 0; di < deNames.length; di++) {
    var de = DataExtension.Init(deNames[di]);
    if (!de) {
      continue;
    }
    var rows = [];
    try {
      rows = de.Rows.Retrieve({
        LeftOperand: {
          Property: "Source",
          SimpleOperator: "equals",
          Value: "Push Advice"
        },
        LogicalOperator: "AND",
        RightOperand: {
          Property: "validated",
          SimpleOperator: "equals",
          Value: "Yes"
        }
      });
    } catch (re) {
      continue;
    }
    rows = rows || [];
    if (!rows.length) {
      continue;
    }
    var entries = [];
    for (var ri = 0; ri < rows.length; ri++) {
      var rowData = rowToObject(rows[ri]);
      entries.push({
        payload: buildTableEntry(rowData) + "|||",
        sortTs: getSortTimestamp(tableRowSortDate(rowData)),
        idx: ri
      });
    }
    return { ok: true, result: finalizeTablePayload(entries), method: "DataExtension.Retrieve" };
  }
  return { ok: false };
}

function loadTableViaWsProxy() {
  var entries = [];
  var wsError = "";
  try {
    var analyticsProx = new Script.Util.WSProxy();
    var analyticsHasMore = true;
    var analyticsRequestId = null;
    var fetched = 0;
    var fetchCap = 5000;
    do {
      var analyticsResp = analyticsRequestId
        ? analyticsProx.getNextBatch("DataExtensionObject[" + analyticsCustomerKey + "]", analyticsRequestId)
        : analyticsProx.retrieve("DataExtensionObject[" + analyticsCustomerKey + "]", analyticsCols);
      if (!analyticsResp || !analyticsResp.Results || analyticsResp.Results.length === 0) {
        break;
      }
      for (var ai = 0; ai < analyticsResp.Results.length; ai++) {
        fetched = fetched + 1;
        var propList = toPropList(analyticsResp.Results[ai]);
        var rowData = {};
        for (var ap = 0; ap < propList.length; ap++) {
          var prop = propList[ap];
          if (prop && prop.Name) {
            rowData[prop.Name] = prop.Value;
          }
        }
        if (trimValue(rowData.Source) !== "Push Advice" || trimValue(rowData.validated) !== "Yes") {
          continue;
        }
        entries.push({
          payload: buildTableEntry(rowData) + "|||",
          sortTs: getSortTimestamp(tableRowSortDate(rowData)),
          idx: entries.length
        });
        if (entries.length >= fetchCap) {
          analyticsHasMore = false;
          break;
        }
      }
      analyticsHasMore = analyticsResp.HasMoreRows === true;
      analyticsRequestId = analyticsResp.RequestID;
      if (!analyticsRequestId) {
        analyticsHasMore = false;
      }
    } while (!wsError && analyticsHasMore && fetched < fetchCap);
  } catch (e) {
    wsError = String(e);
    return { ok: false, error: wsError };
  }
  if (!entries.length) {
    return { ok: false, error: wsError || "WSProxy returned 0 matching rows." };
  }
  return { ok: true, result: finalizeTablePayload(entries), method: "WSProxy" };
}

function appendCsvValue(current, next) {
  var v = String(next == null ? "" : next);
  if (!v) {
    return current;
  }
  if (!current) {
    return v;
  }
  return current + "," + v;
}

var dailySeriesSep = "|";

function appendDailySeriesValue(current, next) {
  var v = String(next == null ? "" : next).replace(/\|/g, " ");
  if (!v) {
    return current;
  }
  if (!current) {
    return v;
  }
  return current + dailySeriesSep + v;
}

function formatChartDailyLabel(sortDateVal, dateLabelVal) {
  var parsed = parseSfmcDateString(sortDateVal);
  if (!parsed) {
    parsed = parseSfmcDateString(dateLabelVal);
  }
  if (!parsed) {
    var fallback = String(dateLabelVal || sortDateVal || "").replace(/,/g, "").trim();
    if (fallback) {
      parsed = new Date(fallback);
    }
  }
  if (!parsed || isNaN(parsed.getTime())) {
    return String(dateLabelVal || sortDateVal || "").replace(/,/g, "").trim();
  }
  var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return monthNames[parsed.getMonth()] + " " + parsed.getDate() + " " + parsed.getFullYear();
}

function formatOpenRateLabel(opened, total, bounced) {
  var openedN = Number(opened) || 0;
  var totalN = Number(total) || 0;
  var bouncedN = Number(bounced) || 0;
  var denom = totalN - bouncedN;
  if (denom <= 0) {
    return "0.0% Open Rate";
  }
  return ((openedN / denom) * 100).toFixed(1) + "% Open Rate";
}

function rowVal(row, name) {
  if (!row) {
    return "";
  }
  try {
    if (typeof row.get === "function") {
      var gv = row.get(name);
      if (gv != null && gv !== "") {
        return String(gv);
      }
    }
  } catch (e1) {}
  if (row[name] != null && row[name] !== "") {
    return String(row[name]);
  }
  if (row.Property && row.Property.length) {
    var wantName = String(name || "").toLowerCase();
    for (var p = 0; p < row.Property.length; p++) {
      if (row.Property[p].Name && String(row.Property[p].Name).toLowerCase() === wantName) {
        return String(row.Property[p].Value == null ? "" : row.Property[p].Value);
      }
    }
  }
  return "";
}

function trimDeVal(value) {
  return String(value == null ? "" : value).replace(/^\s+|\s+$/g, "");
}

function retrieveDeRows(deName, filterCol, filterVal, sortCol, sortDir) {
  var de = DataExtension.Init(deName);
  if (!de) {
    return { rows: [], error: "Data extension not found: " + deName };
  }
  var rows = [];
  try {
    if (filterCol) {
      rows = de.Rows.Retrieve({
        Property: filterCol,
        SimpleOperator: "equals",
        Value: filterVal
      });
    } else {
      rows = de.Rows.Retrieve();
    }
  } catch (re) {
    return { rows: [], error: String(re) };
  }
  rows = rows || [];
  if (rows.length === 0 && filterCol) {
    try {
      var allRows = de.Rows.Retrieve() || [];
      var want = trimDeVal(filterVal);
      for (var fi = 0; fi < allRows.length; fi++) {
        if (trimDeVal(rowVal(allRows[fi], filterCol)) === want) {
          rows.push(allRows[fi]);
        }
      }
    } catch (re2) {}
  }
  if (sortCol && rows.length > 1) {
    var desc = String(sortDir || "").toUpperCase() === "DESC";
    rows.sort(function (a, b) {
      var av = rowVal(a, sortCol);
      var bv = rowVal(b, sortCol);
      if (sortCol === "SortDate" || sortCol === "LastSent" || sortCol === "OpenDate") {
        var sortAd = getSortTimestamp(av);
        var sortBd = getSortTimestamp(bv);
        if (sortAd && sortBd) {
          return desc ? sortBd - sortAd : sortAd - sortBd;
        }
      }
      var an = parseFloat(av);
      var bn = parseFloat(bv);
      if (!isNaN(an) && !isNaN(bn)) {
        return desc ? bn - an : an - bn;
      }
      var ad = new Date(av).getTime();
      var bd = new Date(bv).getTime();
      if (!isNaN(ad) && !isNaN(bd)) {
        return desc ? bd - ad : ad - bd;
      }
      if (av < bv) {
        return desc ? 1 : -1;
      }
      if (av > bv) {
        return desc ? -1 : 1;
      }
      return 0;
    });
  }
  return { rows: rows, error: "" };
}

if (!skipTableLoad) {
  try {
    var tableLoad = loadTableViaLookupRows();
    if (!tableLoad.ok) {
      tableLoad = loadTableViaLookupOrdered();
    }
    if (!tableLoad.ok) {
      tableLoad = loadTableViaDeRetrieve();
    }
    if (!tableLoad.ok) {
      tableLoad = loadTableViaWsProxy();
    }
    if (tableLoad.ok && tableLoad.result) {
      tableLoadMethod = tableLoad.method;
      tableResponsesData = tableLoad.result.payload;
      tableResponsesDataTruncated = tableLoad.result.truncated;
      tableRowCount = tableLoad.result.count;
    } else {
      tableLoadError = tableLoad.error || "Could not load table rows from engagement DE.";
    }
  } catch (tableErr) {
    tableLoadError = String(tableErr);
  }
}

Variable.SetValue("@tableLoadMethod", tableLoadMethod);
Variable.SetValue("@tableLoadError", tableLoadError);
Variable.SetValue("@responsesData", tableResponsesData);
Variable.SetValue("@responsesDataTruncated", tableResponsesDataTruncated);
Variable.SetValue("@tableRowCount", String(tableRowCount));
