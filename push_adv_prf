       }
       function hidePageLoading() {
           const overlay = document.getElementById('pageLoadingOverlay');
           if (overlay) overlay.setAttribute('aria-busy', 'false');
           document.body.classList.remove('loading');
       }
      function decodeAmpData(encodedValue) {
          if (!encodedValue) return '';
          try {
              return decodeURIComponent(String(encodedValue).replace(/\+/g, '%20'));
          } catch (e) {
              return '';
          }
      }
       updateProgress(); 
       var redirectInput = document.getElementById('addContactRedirectUrl');
       if (redirectInput) redirectInput.value = window.location.href;
       if (window.location.search.indexOf('added=1') !== -1) {
           var section = document.getElementById('filterscrollto');
           if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
           if (window.history && window.history.replaceState) {
               window.history.replaceState({}, '', window.location.pathname);
           }
       }

       function parseDailyNumericSeries(encodedValue) {
           if (!encodedValue) return [];
           return encodedValue.split('|').map(function (v) { return Number(v.trim()) || 0; });
       }

       function parseDailyLabelSeries(encodedValue) {
           if (!encodedValue) return [];
           return encodedValue.split('|').map(function (v) { return v.trim(); }).filter(function (v) { return v !== ''; });
       }

       function formatOpenTimeAvgLabel(avgMinutesRaw) {
           var avgMinutes = parseFloat(avgMinutesRaw);
           if (isNaN(avgMinutes)) return 'N/A';
           var rounded = Math.round(avgMinutes);
           var hour24 = Math.floor(rounded / 60) % 24;
           var minute = rounded % 60;
           var ampm = hour24 >= 12 ? 'PM' : 'AM';
           var hour12 = hour24 % 12;
           if (hour12 === 0) hour12 = 12;
           return hour12 + ':' + (minute < 10 ? '0' + minute : String(minute)) + ' ' + ampm;
       }

       function createResponseChart() {
           const ctx = document.getElementById('responseChart');
           if (!ctx) return;
           const sortedDates = parseDailyLabelSeries(decodeAmpData('%%=v(@dailyDateLabelsEnc)=%%'));
           const counts = parseDailyNumericSeries(decodeAmpData('%%=v(@dailyTotalSentEnc)=%%'));
           const allValues = counts.filter(v => !isNaN(v));
           const maxValue = allValues.length > 0 ? Math.max(...allValues) : 1;
           const stepSize = Math.max(1, Math.ceil(maxValue / 10));
           new Chart(ctx, {
               type: 'line',
               data: {
                   labels: sortedDates,
                   datasets: [{
                       label: 'Emails Sent',
                       data: counts,
                       borderColor: '#000000',
                       backgroundColor: 'rgba(99, 102, 241, 0.1)',
                       borderWidth: 3,
                       fill: true,
                       tension: 0.4,
                       pointBackgroundColor: '#000000',
                       pointBorderColor: '#ffffff',
                       pointBorderWidth: 2,
                       pointRadius: 6,
                       pointHoverRadius: 8,
                       pointHoverBackgroundColor: '#4f46e5',
                       pointHoverBorderColor: '#ffffff',
                       pointHoverBorderWidth: 3
                   }]
               },
               options: {
                   responsive: true,
                   maintainAspectRatio: false,
                   animation: {
                       duration: 1500,
                       easing: 'easeInOutQuart',
                       delay: function (context) {
                           return context.dataIndex * 50;
                       }
                   },
                   plugins: {
                       legend: {
                           display: true,
                           position: 'top',
                           align: 'center',
                           labels: {
                               usePointStyle: true,
                               pointStyle: 'circle',
                               padding: 25,
                               font: {
                                   size: 13,
                                   weight: '500',
                                   family: "'Inter', sans-serif"
                               },
                               color: '#374151',
                               generateLabels: function (chart) {
                                   const original = Chart.defaults.plugins.legend.labels.generateLabels;
                                   const labels = original.call(this, chart);
                                   labels.forEach(label => {
                                       label.text = label.text.charAt(0).toUpperCase() + label.text.slice(1);
                                   });
                                   return labels;
                               }
                           }
                       },
                       tooltip: {
                           backgroundColor: 'rgba(17, 24, 39, 0.95)',
                           titleColor: '#ffffff',
                           bodyColor: '#ffffff',
                           borderColor: '#6366f1',
                           borderWidth: 2,
                           cornerRadius: 0,
                           padding: 16,
                           titleFont: {
                               size: 14,
                               weight: '600',
                               family: "'Inter', sans-serif"
                           },
                           bodyFont: {
                               size: 13,
                               weight: '500',
                               family: "'Inter', sans-serif"
                           },
                           mode: 'index',
                           intersect: false,
                           displayColors: true,
                           callbacks: {
                               title: function (context) {
                                   return '📅 ' + context[0].label;
                               },
                               label: function (context) {
                                   return 'Emails Sent: ' + context.parsed.y;
                               }
                           }
                       }
                   },
                   scales: {
                       x: {
                           grid: {
                               display: true,
                               color: 'rgba(229, 231, 235, 0.8)',
                               borderColor: 'rgba(229, 231, 235, 0.8)',
                               lineWidth: 1
                           },
                           border: {
                               display: true,
                               color: 'rgba(209, 213, 219, 0.8)',
                               width: 2
                           },
                           ticks: {
                               color: '#6b7280',
                               font: {
                                   size: 12,
                                   weight: '500',
                                   family: "'Inter', sans-serif"
                               },
                               maxRotation: 45,
                               minRotation: 0,
                               padding: 12,
                               callback: function (value, index, ticks) {
                                   const label = this.getLabelForValue(value);
                                   return label.length > 15 ? label.substring(0, 15) + '...' : label;
                               }
                           }
                       },
                       y: {
                           beginAtZero: true,
                           grid: {
                               display: true,
                               color: 'rgba(229, 231, 235, 0.6)',
                               borderColor: 'rgba(229, 231, 235, 0.8)',
                               lineWidth: 1,
                               drawBorder: true
                           },
                           border: {
                               display: true,
                               color: 'rgba(209, 213, 219, 0.8)',
                               width: 2
                           },
                           ticks: {
                               color: '#6b7280',
                               font: {
                                   size: 12,
                                   weight: '500',
                                   family: "'Inter', sans-serif"
                               },
                               stepSize: stepSize,
                               padding: 12,
                               callback: function (value) {
                                   return value.toLocaleString();
                               }
                           }
                       }
                   },
                   interaction: {
                       intersect: false,
                       mode: 'index'
                   }
               }
           });
       } 


       function buildDateCounts(dateDataStr) {
           const dateCounts = {};
           if (!dateDataStr || dateDataStr === '') return dateCounts;
           const dates = dateDataStr.split(',').filter(date => date.trim() !== '');
           dates.forEach(date => {
               const trimmedDate = date.trim();
               if (trimmedDate) {
                   const parsedDate = parseCustomDate(trimmedDate);
                   if (parsedDate && !isNaN(parsedDate.getTime())) {
                       const dateOnly = parsedDate.toLocaleDateString('en-US', {
                           year: 'numeric',
                           month: 'short',
                           day: 'numeric'
                       });
                       dateCounts[dateOnly] = (dateCounts[dateOnly] || 0) + 1;
                   } else {
                       const parts = trimmedDate.split(' ');
                       if (parts.length >= 3) {
                           const dateOnly = parts[0] + ' ' + parts[1] + ' ' + parts[2];
                           dateCounts[dateOnly] = (dateCounts[dateOnly] || 0) + 1;
                       }
                   }
               }
           });
           return dateCounts;
       } 


