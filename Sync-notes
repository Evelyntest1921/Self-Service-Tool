SST_SP_Survey_Responses_DE — TextPageNumber batch (text only, 20 rows = 1 UI page)

SELECT
    n.ResponsePK,
    CAST(
        (ISNULL(pc.ExistingCount, 0) + n.NewRowNum - 1) / 20 + 1
    AS INT) AS TextPageNumber,
    n.Contact,
    n.SurveyID,
    n.QuestionID,
    n.QuestionNumber,
    n.QuestionText,
    n.QuestionType,
    n.Response,
    n.Status,
    n.LastUpdated,
    n.CourseName
FROM (
    SELECT
        ResponsePK,
        ROW_NUMBER() OVER (
            PARTITION BY SurveyID, QuestionID
            ORDER BY LastUpdated ASC, ResponsePK
        ) AS NewRowNum,
        Contact,
        SurveyID,
        QuestionID,
        QuestionNumber,
        QuestionText,
        QuestionType,
        Response,
        Status,
        LastUpdated,
        CourseName
    FROM SST_SP_Survey_Responses_DE
    WHERE TextPageNumber IS NULL
      AND QuestionType = 'text'
      AND Response IS NOT NULL
      AND LTRIM(RTRIM(Response)) <> ''
) n
LEFT JOIN (
    SELECT
        SurveyID,
        QuestionID,
        COUNT(1) AS ExistingCount
    FROM SST_SP_Survey_Responses_DE
    WHERE TextPageNumber IS NOT NULL
      AND QuestionType = 'text'
    GROUP BY SurveyID, QuestionID
) pc
    ON pc.SurveyID = n.SurveyID
   AND pc.QuestionID = n.QuestionID

