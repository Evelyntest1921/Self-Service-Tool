SELECT
    t.ResponsePK,
    CAST(((t.RowNum - 1) / 20) + 1 AS INT) AS [PageNumber],
    CASE 
        WHEN t.IsText = 1 
            THEN CAST(((t.TextRowNum - 1) / 20) + 1 AS INT)
        ELSE NULL
    END AS [TextPageNumber],
    t.Contact,
    t.SurveyID,
    t.QuestionID,
    t.QuestionNumber,
    t.QuestionText,
    t.QuestionType,
    t.Response,
    t.Status,
    t.LastUpdated,
    t.CourseName
FROM (
    SELECT
        ResponsePK,
        ROW_NUMBER() OVER (ORDER BY LastUpdated ASC, Contact, SurveyID, QuestionNumber) AS RowNum,
        CASE WHEN LTRIM(RTRIM(QuestionType)) = 'text' THEN 1 ELSE 0 END AS IsText,
        ROW_NUMBER() OVER (
            PARTITION BY CASE WHEN LTRIM(RTRIM(QuestionType)) = 'text' THEN 1 ELSE 0 END
            ORDER BY LastUpdated ASC, Contact, SurveyID, QuestionNumber
        ) AS TextRowNum,
        Contact,
        SurveyID,
        QuestionID,
        QuestionNumber,
        QuestionText,
        QuestionType,
        Response,
        Status,
        LastUpdated,
        CourseName
    FROM SST_SP_Survey_Responses_DE
) t