SELECT TOP 250
    j.JourneyName,
    j.JourneyID,
    j.VersionNumber,
    j.JourneyStatus,
    ja.ActivityID,
    ja.ActivityName,
    ja.ActivityType,
    ja.ActivityExternalKey
FROM _JourneyActivity ja
INNER JOIN _Journey j
    ON j.VersionId = ja.VersionId
    AND j.JourneyStatus = 'Running'
WHERE
    ja.ActivityExternalKey LIKE 'WAITUNTILSPECIFICDATE%'
    
ORDER BY
    j.JourneyName ASC,
    j.VersionNumber DESC,
    ja.ActivityName ASC