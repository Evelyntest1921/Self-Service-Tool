%%[
  SET @EventConfigured = QueryParameter('EventConfigured')
  SET @ShortNotice = QueryParameter('ShortNotice')
  SET @CurrentDate = FormatDate(Now(), "S", " ", "en-US")
  
  VAR @CurrentYear, @CurrentMonth, @CurrentDay
  
  IF @ShortNotice == 1 THEN 
     SET @CurrentYear = DatePart(@CurrentDate, "Y")
     SET @CurrentMonth = DatePart(@CurrentDate, "M")
     SET @CurrentDay = DatePart(@CurrentDate, "D")
  ELSE 
     SET @DatePartFull = DateAdd(@CurrentDate, 8, "D")  
     SET @CurrentYear = DatePart(@DatePartFull, "Y")
     SET @CurrentMonth = DatePart(@DatePartFull, "M")
     SET @CurrentDay = DatePart(@DatePartFull, "D")  
  ENDIF
  
  SET @NotCreated = QueryParameter('NotCreated')
  
  
  IF EMPTY (@EventConfigured) THEN 
  SET @SaveURL = CloudPagesURL(3323, "RedirectToID", @RedirectToID, "EventConfigured", "1") 
]%%
