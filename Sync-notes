sst_analytics_per_course query — output column names MUST match DE attributes exactly:

surveyId, CourseName, TotalResponses, UniqueRespondents, CompletedRespondents, CompletionRatePct, FirstActivityDate, LastActivityDate

(Wrong aliases like TotalActivity or CompletedSurvey leave TotalResponses / CompletedRespondents NULL in the DE.)



SELECT

    r.SurveyID AS surveyId,

    LTRIM(RTRIM(r.CourseName)) AS CourseName,

    COUNT(DISTINCT CASE WHEN ISNULL(r.QuestionID, '') != 'SURVEY_OPEN' THEN r.Contact END) AS UniqueRespondents,

    COUNT(DISTINCT CASE WHEN LTRIM(RTRIM(ISNULL(r.Status, ''))) = 'Completed' THEN r.Contact END) AS CompletedRespondents,

    CAST(

        ISNULL(

            COUNT(DISTINCT CASE WHEN LTRIM(RTRIM(ISNULL(r.Status, ''))) = 'Completed' THEN r.Contact END) * 100.0

            / NULLIF(COUNT(DISTINCT CASE WHEN ISNULL(r.QuestionID, '') != 'SURVEY_OPEN' THEN r.Contact END), 0),

            0

        )

    AS DECIMAL(5, 2)) AS CompletionRatePct,

    MIN(r.LastUpdated) AS FirstActivityDate,

    MAX(r.LastUpdated) AS LastActivityDate,

    ISNULL(SUM(CASE WHEN ISNULL(r.QuestionID, '') != 'SURVEY_OPEN' THEN 1 ELSE 0 END), 0) AS TotalResponses

FROM SST_SP_Survey_Responses_DE r

WHERE r.SurveyID IS NOT NULL

  AND r.CourseName IS NOT NULL

  AND LTRIM(RTRIM(r.CourseName)) <> ''

GROUP BY

    r.SurveyID,

    LTRIM(RTRIM(r.CourseName))



