sst_analytics_per_survey — one row per survey (Survey Results header + Survey Landing cards/metrics).

DE columns: surveyId, UniqueRespondents, OpenedSurvey, CompletedSurvey, TotalActivity



SELECT

    r.SurveyID AS surveyId,

    COUNT(DISTINCT CASE WHEN ISNULL(r.QuestionID, '') != 'SURVEY_OPEN' THEN r.Contact END) AS UniqueRespondents,

    ISNULL(SUM(CASE WHEN r.QuestionID = 'SURVEY_OPEN' THEN 1 ELSE 0 END), 0) AS OpenedSurvey,

    COUNT(DISTINCT CASE WHEN LTRIM(RTRIM(ISNULL(r.Status, ''))) = 'Completed' THEN r.Contact END) AS CompletedSurvey,

    ISNULL(SUM(CASE WHEN ISNULL(r.QuestionID, '') != 'SURVEY_OPEN' THEN 1 ELSE 0 END), 0) AS TotalActivity

FROM SST_SP_Survey_Responses_DE r

WHERE r.SurveyID IS NOT NULL

GROUP BY r.SurveyID



