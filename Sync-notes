SELECT
    UniqueKey,
    CAST(((ROW_NUMBER() OVER (
        PARTITION BY JourneyID
        ORDER BY LastSent ASC, Contact_Id, JobID, UniqueKey
    ) - 1) / 20) + 1 AS INT) AS [PageNumber],
    CAST(((COUNT(1) OVER (
        PARTITION BY JourneyID
    ) - 1) / 20) + 1 AS INT) AS [TotalPages]
FROM bd_self_service_engagement