SELECT
    con.Id AS MemberId,
    '003WL00000w7kHdYAI' AS ContactId,
    'zcharles+uat@magmutual.com' AS Email,
    '' AS CampaignId,
    con.AccountId AS AccountId,
    u.Name AS Account_Owner_Name,
    u.Email AS Account_Owner_Email,
    '' AS Status,
    con.MailingState AS State,
    a.OwnerId AS AccountOwnerId,
    CAST(((ROW_NUMBER() OVER (ORDER BY con.Id) - 1) / 20) + 1 AS INT) AS [PageNumber],
    CAST(((COUNT(1) OVER () - 1) / 20) + 1 AS INT) AS [TotalPages],
    'SST' AS type
FROM ENT.Contact_Salesforce_1 con
LEFT JOIN ENT.Account_Salesforce_1 a 
    ON con.AccountId = a.Id
LEFT JOIN ENT.User_Salesforce_1 u 
    ON a.OwnerId = u.Id
WHERE con.Id IS NOT NULL