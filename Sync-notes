SELECT
    r.SurveyID AS surveyId,
    LTRIM(RTRIM(r.CourseName)) AS CourseName,
    COUNT(DISTINCT CASE WHEN r.QuestionID = 'SURVEY_OPEN' THEN r.Contact END) AS OpenedSurvey,
    COUNT(DISTINCT CASE WHEN r.QuestionID != 'SURVEY_OPEN' THEN r.Contact END) AS UniqueRespondents,
    COUNT(DISTINCT CASE WHEN r.Status = 'Completed' THEN r.Contact END) AS CompletedSurvey,
    CAST(
        COUNT(DISTINCT CASE WHEN r.Status = 'Completed' THEN r.Contact END) * 100.0
        / NULLIF(COUNT(DISTINCT CASE WHEN r.QuestionID != 'SURVEY_OPEN' THEN r.Contact END), 0)
    AS DECIMAL(5, 2)) AS CompletionRatePct,
    MIN(r.LastUpdated) AS FirstActivityDate,
    MAX(r.LastUpdated) AS LastActivityDate,
    SUM(CASE WHEN r.QuestionID != 'SURVEY_OPEN' THEN 1 ELSE 0 END) AS TotalActivity
FROM SST_SP_Survey_Responses_DE r
WHERE r.SurveyID IS NOT NULL
  AND r.CourseName IS NOT NULL
  AND LTRIM(RTRIM(r.CourseName)) <> ''
GROUP BY
    r.SurveyID,
    LTRIM(RTRIM(r.CourseName))