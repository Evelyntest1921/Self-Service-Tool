sst_open_time_chart — Performance opened send-time bar chart (per journey).
DE columns: JourneyId, Scope, HourIndex (0–23), OpenCount

SELECT
    e.JourneyID AS JourneyId,
    e.JourneyID AS Scope,
    CAST(DATEPART(HOUR, e.LastSent) AS INT) AS HourIndex,
    COUNT(*) AS OpenCount
FROM bd_self_service_engagement e
WHERE e.JourneyID IS NOT NULL
  AND e.LastSent IS NOT NULL
  AND LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Opened'
GROUP BY
    e.JourneyID,
    DATEPART(HOUR, e.LastSent)

