SELECT TOP 250
    j.JourneyName,
    j.JourneyID,
    j.VersionNumber,
    j.JourneyStatus,
    ja.ActivityID,
    ja.ActivityName,
    ja.ActivityType,
    ja.ActivityExternalKey
FROM _JourneyActivity ja
INNER JOIN _Journey j
    ON j.VersionId = ja.VersionId
    AND j.journeyID = '0dd0f71f-1741-4300-ba21-59eab6da7f01'
    AND j.JourneyStatus = 'Running'

    
ORDER BY
    j.JourneyName ASC,
    j.VersionNumber DESC,
    ja.ActivityName ASC


