sst_analytics_journey_metrics — one row per journey (summary cards + combined engagement bar).
DE columns: journeyId, TotalRecords, OpenedCount, BouncedCount, DidNotOpenCount, ClickedCount, UnregisteredOpenedCount

SELECT
    e.JourneyID AS journeyId,
    COUNT(*) AS TotalRecords,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Opened' THEN 1 ELSE 0 END) AS OpenedCount,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Bounced' THEN 1 ELSE 0 END) AS BouncedCount,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Did Not Open' THEN 1 ELSE 0 END) AS DidNotOpenCount,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Clicked' THEN 1 ELSE 0 END) AS ClickedCount,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Opened' AND (e.Auth0UserId IS NULL OR LTRIM(RTRIM(e.Auth0UserId)) = '') THEN 1 ELSE 0 END) AS UnregisteredOpenedCount
FROM bd_self_service_engagement e
WHERE e.JourneyID IS NOT NULL
GROUP BY e.JourneyID



sst_analytics_journey_sent_by_day — Emails Sent Over Time chart.
DE columns: journeyId, SortDate (Text yyyy-MM-dd), DayLabel (Text), SentCount (Number)

SELECT
    e.JourneyID AS journeyId,
    SUBSTRING(CONVERT(VARCHAR(20), e.LastSent, 120), 1, 10) AS SortDate,
    SUBSTRING(CONVERT(VARCHAR(20), e.LastSent, 120), 1, 10) AS DayLabel,
    COUNT(*) AS SentCount
FROM bd_self_service_engagement e
WHERE e.JourneyID IS NOT NULL
  AND e.LastSent IS NOT NULL
GROUP BY e.JourneyID, SUBSTRING(CONVERT(VARCHAR(20), e.LastSent, 120), 1, 10)



sst_analytics_journey_events_by_day — Opens & Clicks Over Time chart.
DE columns: journeyId, SortDate, DayLabel, OpenCount, ClickCount, UnsubscribedCount, UnregisteredOpenCount

SELECT
    e.JourneyID AS journeyId,
    SUBSTRING(CONVERT(VARCHAR(20), e.LastSent, 120), 1, 10) AS SortDate,
    SUBSTRING(CONVERT(VARCHAR(20), e.LastSent, 120), 1, 10) AS DayLabel,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Opened' THEN 1 ELSE 0 END) AS OpenCount,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Clicked' THEN 1 ELSE 0 END) AS ClickCount,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Unsubscribed' THEN 1 ELSE 0 END) AS UnsubscribedCount,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Opened' AND (e.Auth0UserId IS NULL OR LTRIM(RTRIM(e.Auth0UserId)) = '') THEN 1 ELSE 0 END) AS UnregisteredOpenCount
FROM bd_self_service_engagement e
WHERE e.JourneyID IS NOT NULL
  AND e.LastSent IS NOT NULL
GROUP BY e.JourneyID, SUBSTRING(CONVERT(VARCHAR(20), e.LastSent, 120), 1, 10)



sst_analytics_journey_by_state — state map/bar chart.
DE columns: journeyId, StateName, Opened, Bounced, DidNotOpen, Clicked, Total

SELECT
    e.JourneyID AS journeyId,
    LTRIM(RTRIM(e.Related_Account_Primary_State)) AS StateName,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Opened' THEN 1 ELSE 0 END) AS Opened,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Bounced' THEN 1 ELSE 0 END) AS Bounced,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Did Not Open' THEN 1 ELSE 0 END) AS DidNotOpen,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Clicked' THEN 1 ELSE 0 END) AS Clicked,
    COUNT(*) AS Total
FROM bd_self_service_engagement e
WHERE e.JourneyID IS NOT NULL
  AND e.Related_Account_Primary_State IS NOT NULL
  AND LTRIM(RTRIM(e.Related_Account_Primary_State)) <> ''
GROUP BY e.JourneyID, LTRIM(RTRIM(e.Related_Account_Primary_State))



sst_analytics_journey_by_specialty — specialty chart.
DE columns: journeyId, Specialty, Opened, Bounced, DidNotOpen, Clicked, Total

SELECT
    e.JourneyID AS journeyId,
    LTRIM(RTRIM(e.Primary_Specialty)) AS Specialty,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Opened' THEN 1 ELSE 0 END) AS Opened,
    SUM(CASE WHEN LTRIM(RTRIM(ISNULL(e.Engagement, ''))) = 'Bounced' THEN 1 ELSE 0 END) AS Bounced,
