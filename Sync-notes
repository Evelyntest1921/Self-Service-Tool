sst_analytics_completion_time — Survey Landing Avg Completion Time (one summary row). Fast sample: TOP 5 SurveyID+Contact by most recent first completion, not full-table avg.
DE columns: AvgCompletionMinutes (Decimal), CompletedSessionCount (Number, 1–5)

SELECT
    CAST(AVG(CAST(d.CompletionMinutes AS FLOAT)) AS DECIMAL(10, 2)) AS AvgCompletionMinutes,
    COUNT(*) AS CompletedSessionCount
FROM (
    SELECT
        DATEDIFF(MINUTE, opens.OpenedAt, recent.CompletedAt) AS CompletionMinutes
    FROM (
        SELECT TOP 5
            SurveyID,
            Contact,
            MIN(LastUpdated) AS CompletedAt
        FROM SST_SP_Survey_Responses_DE
        WHERE LTRIM(RTRIM(ISNULL(Status, ''))) = 'Completed'
          AND ISNULL(QuestionID, '') != 'SURVEY_OPEN'
        GROUP BY SurveyID, Contact
        ORDER BY MIN(LastUpdated) DESC
    ) recent
    INNER JOIN (
        SELECT
            r.SurveyID,
            r.Contact,
            r.CompletedAt,
            MAX(o.LastUpdated) AS OpenedAt
        FROM (
            SELECT TOP 5
                SurveyID,
                Contact,
                MIN(LastUpdated) AS CompletedAt
            FROM SST_SP_Survey_Responses_DE
            WHERE LTRIM(RTRIM(ISNULL(Status, ''))) = 'Completed'
              AND ISNULL(QuestionID, '') != 'SURVEY_OPEN'
            GROUP BY SurveyID, Contact
            ORDER BY MIN(LastUpdated) DESC
        ) r
        INNER JOIN SST_SP_Survey_Responses_DE o
            ON o.SurveyID = r.SurveyID
           AND o.Contact = r.Contact
           AND o.QuestionID = 'SURVEY_OPEN'
           AND o.LastUpdated <= r.CompletedAt
        GROUP BY r.SurveyID, r.Contact, r.CompletedAt
    ) opens
        ON recent.SurveyID = opens.SurveyID
       AND recent.Contact = opens.Contact
    WHERE DATEDIFF(MINUTE, opens.OpenedAt, recent.CompletedAt) BETWEEN 0 AND 2880
) d



