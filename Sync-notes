%%[
SET @batchId = AttributeValue("batchId")
IF Empty(@batchId) THEN
  SET @batchId = RequestParameter("batchId")
ENDIF

SET @batchRows = LookupRows("bd_sst_journey_exit_batch", "batchId", @batchId)
SET @batchRowCount = RowCount(@batchRows)

IF @batchRowCount > 0 THEN
  SET @batchRow = Row(@batchRows, 1)
  SET @batch_batchId = Field(@batchRow, "batchId")
  SET @batch_sourceDeName = Field(@batchRow, "sourceDeName")
  SET @batch_journeyID = Field(@batchRow, "journeyID")
  SET @batch_journeyName = Field(@batchRow, "journeyName")
  SET @batch_journeyKey = Field(@batchRow, "journeyKey")
  SET @batch_status = Field(@batchRow, "status")
  SET @batch_requestedAt = Field(@batchRow, "requestedAt")
  SET @batch_processedAt = Field(@batchRow, "processedAt")
  SET @batch_message = Field(@batchRow, "message")
ENDIF
]%%

Batch ID: %%=v(@batch_batchId)=%%
Source DE: %%=v(@batch_sourceDeName)=%%
Journey ID: %%=v(@batch_journeyID)=%%
Journey Name: %%=v(@batch_journeyName)=%%
Journey Key: %%=v(@batch_journeyKey)=%%
Status: %%=v(@batch_status)=%%
Requested At: %%=v(@batch_requestedAt)=%%
Processed At: %%=v(@batch_processedAt)=%%
Message: %%=v(@batch_message)=%%
