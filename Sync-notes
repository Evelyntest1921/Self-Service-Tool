FROM bd_self_service_engagement e
WHERE e.JourneyID IS NOT NULL
  AND e.Primary_Specialty IS NOT NULL
  AND LTRIM(RTRIM(e.Primary_Specialty)) <> ''
GROUP BY e.JourneyID, LTRIM(RTRIM(e.Primary_Specialty))

