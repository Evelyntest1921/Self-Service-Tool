SELECT
  cm.SubscriberKey AS SubscriberKey,
  COALESCE(NULLIF(RTRIM(ISNULL(cm.email, '')), ''), NULLIF(RTRIM(ISNULL(con.Email, '')), '')) AS Email,
  con.AccountId AS AccountId,
  u.Name AS Account_Owner_Name,
  u.Email AS Account_Owner_Email,
  con.MailingState AS State,
  a.ASC__c AS AccountOwnerId,
  'SST' AS type
FROM Data_Extension cm
LEFT JOIN ENT.Contact_Salesforce_1 con ON cm.ContactId = con.id
LEFT JOIN ENT.Account_Salesforce_1 a ON con.AccountId = a.id
LEFT JOIN ENT.User_Salesforce_1 u ON u.id = a.ASC__c
WHERE cm.SubscriberKey IS NOT NULL