SELECT
  j.JobID,
  j.EmailName,
  j.EmailSubject,
  MIN(s.EventDate) AS SendTime,
  COUNT(*) AS Recipients
FROM _Sent s
INNER JOIN _Job j
  ON j.JobID = s.JobID
WHERE s.EventDate >= CAST(GETDATE() AS DATE)
  AND s.EventDate < DATEADD(day, 1, CAST(GETDATE() AS DATE))
GROUP BY
  j.JobID,
  j.EmailName,
  j.EmailSubject
ORDER BY SendTime