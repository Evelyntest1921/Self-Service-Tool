SELECT
    n.ResponsePK,
    CAST(
        m.MaxPage + ((m.CurrentBatchCount + n.NewRowNum - 1) / 20)
    AS INT) AS [PageNumber],
    n.Contact,
    n.SurveyID,
    n.QuestionID,
    n.QuestionNumber,
    n.QuestionText,
    n.QuestionType,
    n.Response,
    n.Status,
    n.LastUpdated,
    n.CourseName
FROM (
    SELECT
        ResponsePK,
        ROW_NUMBER() OVER (ORDER BY LastUpdated ASC, Contact, SurveyID, QuestionNumber) AS NewRowNum,
        Contact,
        SurveyID,
        QuestionID,
        QuestionNumber,
        QuestionText,
        QuestionType,
        Response,
        Status,
        LastUpdated,
        CourseName
    FROM SST_SP_Survey_Responses_DE
    WHERE PageNumber IS NULL
) n
INNER JOIN (
    SELECT
        ISNULL(p.MaxPage, 1) AS MaxPage,
        ISNULL(COUNT(s.ResponsePK), 0) AS CurrentBatchCount
    FROM (
        SELECT MAX(PageNumber) AS MaxPage
        FROM SST_SP_Survey_Responses_DE
    ) p
    LEFT JOIN SST_SP_Survey_Responses_DE s
        ON s.PageNumber = p.MaxPage
    GROUP BY p.MaxPage
) m ON 1 = 1