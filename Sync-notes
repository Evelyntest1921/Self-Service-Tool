TextPageNumber batch — one sequence per SurveyID + QuestionID (20 non-empty text rows per page).
Re-run this query activity and update SST_SP_Survey_Responses_DE after changing logic.

SELECT
    t.ResponsePK,
    CAST(((t.RowNum - 1) / 20) + 1 AS INT) AS PageNumber,
    CASE
        WHEN tr.TextRowNum IS NOT NULL
            THEN CAST(((tr.TextRowNum - 1) / 20) + 1 AS INT)
        ELSE NULL
    END AS TextPageNumber,
    t.Contact,
    t.SurveyID,
    t.QuestionID,
    t.QuestionNumber,
    t.QuestionText,
    t.QuestionType,
    t.Response,
    t.Status,
    t.LastUpdated,
    t.CourseName
FROM (
    SELECT
        ResponsePK,
        ROW_NUMBER() OVER (ORDER BY LastUpdated ASC, ResponsePK) AS RowNum,
        Contact,
        SurveyID,
        QuestionID,
        QuestionNumber,
        QuestionText,
        QuestionType,
        Response,
        Status,
        LastUpdated,
        CourseName
    FROM SST_SP_Survey_Responses_DE
) t
LEFT JOIN (
    SELECT
        ResponsePK,
        ROW_NUMBER() OVER (
            PARTITION BY SurveyID, QuestionID
            ORDER BY LastUpdated ASC, ResponsePK
        ) AS TextRowNum
    FROM SST_SP_Survey_Responses_DE
    WHERE LTRIM(RTRIM(QuestionType)) = 'text'
      AND Response IS NOT NULL
      AND LTRIM(RTRIM(Response)) <> ''
) tr
    ON tr.ResponsePK = t.ResponsePK

