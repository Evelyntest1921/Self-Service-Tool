SST_SP_Analytics_Answers


SELECT
    q.SurveyID,
    q.QuestionID,
    q.SurveyName,
    q.QuestionNumber,
    q.QuestionText,
    q.QuestionType,
    q.Options,
    q.Required,
    q.OrderIndex,
    q.CreatedDate,

    COUNT(DISTINCT CASE 
        WHEN r.Response IS NOT NULL AND LTRIM(RTRIM(r.Response)) <> '' 
        THEN r.Contact 
    END) AS [UniqueRespondents],

    ISNULL(s.OpenedSurvey, 0) AS [OpenedSurvey],
    ISNULL(s.CompletedSurvey, 0) AS [CompletedSurvey],
    COUNT(r.ResponsePK) AS [TotalActivity],

    CAST(
        ISNULL(s.CompletedSurvey, 0) * 100.0 
        / NULLIF(s.OpenedSurvey, 0)
    AS DECIMAL(5, 2)) AS [CompletionRatePct],

    CAST(AVG(
        CASE 
            WHEN q.QuestionType = 'rating' AND r.Response = 'Poor' THEN 1.0
            WHEN q.QuestionType = 'rating' AND r.Response = 'Fair' THEN 2.0
            WHEN q.QuestionType = 'rating' AND r.Response = 'Good' THEN 3.0
            WHEN q.QuestionType = 'rating' AND r.Response = 'Very Good' THEN 4.0
            WHEN q.QuestionType = 'rating' AND r.Response = 'Excellent' THEN 5.0
            WHEN q.QuestionType = 'likert' AND r.Response = 'Strongly Disagree' THEN 1.0
            WHEN q.QuestionType = 'likert' AND r.Response = 'Disagree' THEN 2.0
            WHEN q.QuestionType = 'likert' AND r.Response = 'Neutral' THEN 3.0
            WHEN q.QuestionType = 'likert' AND r.Response = 'Agree' THEN 4.0
            WHEN q.QuestionType = 'likert' AND r.Response = 'Strongly Agree' THEN 5.0
            ELSE NULL 
        END
    ) AS DECIMAL(4, 2)) AS [AverageScore],

    SUM(CASE 
        WHEN r.Response IN ('Strongly Disagree', 'Poor', 'Yes') THEN 1 
        ELSE 0 
    END) AS [Opt1_Count],

    SUM(CASE 
        WHEN r.Response IN ('Disagree', 'Fair', 'No') THEN 1 
        ELSE 0 
    END) AS [Opt2_Count],

    SUM(CASE 
        WHEN r.Response IN ('Neutral', 'Good') THEN 1 
        ELSE 0 
    END) AS [Opt3_Count],

    SUM(CASE 
        WHEN r.Response IN ('Agree', 'Very Good') THEN 1 
        ELSE 0 
    END) AS [Opt4_Count],

    SUM(CASE 
        WHEN r.Response IN ('Strongly Agree', 'Excellent') THEN 1 
        ELSE 0 
    END) AS [Opt5_Count],

    SUM(CASE 
        WHEN q.QuestionType = 'text' AND r.Response IS NOT NULL AND LTRIM(RTRIM(r.Response)) <> '' 
        THEN 1 
        ELSE 0 
    END) AS [TextResponseCount],

    MIN(r.LastUpdated) AS [FirstActivityDate],
    MAX(r.LastUpdated) AS [LatestActivityDate]

FROM SST_SP_Survey_Questions_DE q

LEFT JOIN SST_SP_Survey_Responses_DE r
    ON  r.SurveyID = q.SurveyID
    AND r.QuestionID = q.QuestionID

LEFT JOIN (
    SELECT
        SurveyID,
        COUNT(DISTINCT Contact) AS OpenedSurvey,
        COUNT(DISTINCT CASE WHEN Status = 'Completed' THEN Contact END) AS CompletedSurvey
    FROM SST_SP_Survey_Responses_DE
    WHERE SurveyID IS NOT NULL
    GROUP BY SurveyID
) s
    ON s.SurveyID = q.SurveyID

WHERE q.SurveyID IS NOT NULL
  AND q.QuestionID IS NOT NULL

GROUP BY
    q.SurveyID,
    q.QuestionID,
    q.SurveyName,
    q.QuestionNumber,
    q.QuestionText,
    q.QuestionType,
    q.Options,
    q.Required,
    q.OrderIndex,
    q.CreatedDate,
    s.OpenedSurvey,
    s.CompletedSurvey