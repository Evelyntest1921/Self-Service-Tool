SELECT
  cm.id AS MemberId,
  cm.ContactId AS ContactId,
  COALESCE(NULLIF(RTRIM(ISNULL(cm.email, '')), ''), NULLIF(RTRIM(ISNULL(con.Email, '')), '')) AS Email,
  cm.CampaignId AS CampaignId,
  con.AccountId AS AccountId,
  u.Name AS Account_Owner_Name,
  u.Email AS Account_Owner_Email,
  cm.Status AS Status,
  con.MailingState AS State,
  a.OwnerId AS AccountOwnerId,
  'SST' AS type
FROM CampaignMember_Salesforce_1 cm
LEFT JOIN Contact_Salesforce con ON cm.ContactId = con.id
LEFT JOIN Account_Salesforce a ON con.AccountId = a.id
LEFT JOIN User_Salesforce u ON u.id = a.OwnerId
WHERE cm.CampaignId = '701cw00000ci3ifAAA'
  AND cm.ContactId IS NOT NULL