<script runat="server">
Platform.Load("core", "1");

var BATCH_DE = "bd_sst_journey_exit_batch";
var EXIT_QUEUE_DE = "bd_sst_journey_exit";
var LOG_DE = "sst_de_journey_exit_log";
var LOG_FIELD = "log";
var LOG_MAX_LEN = 4000;
var MAX_BATCHES_PER_RUN = 5;
var MAX_ROWS_PER_BATCH = 2500;

var resultLines = [];
var debugLines = [];

function strTrim(v) {
  if (v === null || typeof v === "undefined") {
    return "";
  }
  try {
    return (v + "").replace(/^\s+|\s+$/g, "");
  } catch (e) {
    return "";
  }
}

function asLower(v) {
  var s = strTrim(v);
  try {
    return s.toLowerCase();
  } catch (e) {
    return s;
  }
}

function writeExitLog(text) {
  var msg = text === null || typeof text === "undefined" ? "" : text + "";
  if (msg.length > LOG_MAX_LEN) {
    msg = msg.substring(0, LOG_MAX_LEN - 3) + "...";
  }
  try {
    Platform.Function.InsertData(LOG_DE, [LOG_FIELD], [msg]);
    return { ok: true };
  } catch (logEx) {
    return { ok: false, error: logEx.message || String(logEx) };
  }
}

function queueField(row, names) {
  if (!row) {
    return "";
  }
  for (var i = 0; i < names.length; i++) {
    var val = row[names[i]];
    if (val !== undefined && val !== null && String(val) !== "") {
      return String(val);
    }
  }
  return "";
}

function fieldFromPropertyList(props, names) {
  if (!props || typeof props.length !== "number") {
    return "";
  }
  for (var pi = 0; pi < props.length; pi++) {
    var pname = props[pi].Name != null ? props[pi].Name : props[pi].name;
    if (!pname) {
      continue;
    }
    for (var i = 0; i < names.length; i++) {
      if (asLower(pname) === asLower(names[i])) {
        var v = props[pi].Value != null ? props[pi].Value : props[pi].value;
        if (v !== null && typeof v !== "undefined" && String(v) !== "") {
          return String(v);
        }
      }
    }
  }
  return "";
}

function fieldFromRow(row, names) {
  if (!row) {
    return "";
  }
  var direct = queueField(row, names);
  if (direct) {
    return direct;
  }
  try {
    for (var i = 0; i < names.length; i++) {
      var v = Platform.Function.Field(row, names[i]);
      if (v !== null && typeof v !== "undefined" && String(v) !== "") {
        return String(v);
      }
    }
  } catch (fe) {}
  var fromProps = fieldFromPropertyList(row.Properties, names);
  if (fromProps) {
    return fromProps;
  }
  return fieldFromPropertyList(row.Property, names);
}

function rowKeysSample(row) {
  if (!row) {
    return "(null row)";
  }
  var keys = [];
  try {
    for (var k in row) {
      if (keys.length >= 12) {
        break;
      }
      if (k === "Properties" || k === "Property") {
        continue;
      }
      keys.push(k);
    }
  } catch (e) {}
  if (row.Properties && typeof row.Properties.length === "number") {
    for (var p = 0; p < row.Properties.length && keys.length < 20; p++) {
      var pn = row.Properties[p].Name || row.Properties[p].name;
      if (pn) {
        keys.push("Properties." + pn);
      }
    }
  }
  return keys.length ? keys.join(",") : "(no enumerable keys)";
}

function coerceRows(raw) {
  if (raw === null || typeof raw === "undefined") {
    return [];
  }
  var rows = raw;
  if (rows.Results) {
    rows = rows.Results;
  }
  if (typeof rows.length === "number") {
    var out = [];
    for (var i = 0; i < rows.length; i++) {
      out.push(rows[i]);
    }
    return out;
  }
  if (typeof rows === "object") {
    return [rows];
  }
  return [];
}

function normalizeBatchRows(rawRows) {
  var rows = coerceRows(rawRows);
  var out = [];
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    out.push({
      batchId: strTrim(
        fieldFromRow(row, ["batchId", "BatchId", "BATCHID"])
      ),
      sourceDeName: strTrim(
        fieldFromRow(row, ["sourceDeName", "SourceDeName", "sourceDEName"])
      ),
      sourceType: strTrim(
        fieldFromRow(row, ["sourceType", "SourceType"])
      ),
      campaignId: strTrim(
        fieldFromRow(row, ["campaignId", "CampaignId", "CAMPAIGNID"])
      ),
      memberStatus: strTrim(
        fieldFromRow(row, ["memberStatus", "MemberStatus"])
      ),
      journeyID: strTrim(
        fieldFromRow(row, ["journeyID", "journeyId", "JourneyID"])
      ),
      journeyName: strTrim(
        fieldFromRow(row, ["journeyName", "JourneyName"])
      ),
      journeyKey: strTrim(
        fieldFromRow(row, ["journeyKey", "JourneyKey", "definitionKey"])
      ),
      status: strTrim(fieldFromRow(row, ["status", "Status"]))
    });
  }
  return out;
}

function isWorkableBatchStatus(status) {
  var s = asLower(status);
  if (!s) {
    return true;
  }
  return (
    s === "pending" ||
    s === "failed" ||
    s === "queued" ||
    s === "processing" ||
    s === "done"
  );
}

function fetchPendingBatches(prox) {
  var errors = [];
  var notes = [];
  var keyVariants = [BATCH_DE, String(BATCH_DE).toLowerCase()];
  var props = [
    "batchId",
    "sourceDeName",
    "sourceType",
    "campaignId",
    "memberStatus",
    "journeyID",
    "journeyName",
    "journeyKey",
    "status",
    "requestedAt",
    "message"
  ];
  var collected = [];
  var seen = {};
  var statusCounts = {};

  function addRows(rows, sourceLabel) {
    var list = normalizeBatchRows(rows);
    notes.push(sourceLabel + " raw=" + list.length);
    for (var i = 0; i < list.length; i++) {
      var row = list[i];
      var st = row.status || "(blank)";
      statusCounts[st] = (statusCounts[st] || 0) + 1;
      if (!row.batchId) {
        notes.push(sourceLabel + " skipped row missing batchId");
        continue;
      }
      if (!isWorkableBatchStatus(row.status)) {
        notes.push(
          sourceLabel +
            " skipped batchId=" +
            row.batchId +
            " status=" +
            st
        );
        continue;
      }
      var id = asLower(row.batchId);
      if (seen[id]) {
        continue;
      }
      seen[id] = true;
      if (!row.status) {
        row.status = "Pending";
      }
      collected.push(row);
    }
  }

  for (var v = 0; v < keyVariants.length; v++) {
    var deKey = keyVariants[v];
    try {
      var de = DataExtension.Init(deKey);
      var initRows = de.Rows.Retrieve();
      addRows(initRows, "Init(" + deKey + ")");
      if (collected.length) {
        return {
          rows: collected,
          error: "",
          notes: notes.join(" | "),
          statusCounts: statusCounts
        };
      }
    } catch (deEx) {
      errors.push(
        "DataExtension.Init(" + deKey + "): " + (deEx.message || String(deEx))
      );
    }
  }

  var filters = [
    { Property: "batchId", SimpleOperator: "isNotNull" },
    { Property: "status", SimpleOperator: "isNotNull" },
    { Property: "sourceDeName", SimpleOperator: "isNotNull" }
  ];
  for (var f = 0; f < filters.length; f++) {
    for (var k = 0; k < keyVariants.length; k++) {
      try {
        var wsResp = prox.retrieve(
          "DataExtensionObject[" + keyVariants[k] + "]",
          props,
          filters[f]
        );
        addRows(
          wsResp && wsResp.Results ? wsResp.Results : [],
          "WSProxy[" + keyVariants[k] + "]/" + filters[f].Property
        );
        if (collected.length) {
          return {
            rows: collected,
            error: "",
            notes: notes.join(" | "),
            statusCounts: statusCounts
          };
        }
      } catch (wsEx) {
        errors.push(
          "WSProxy " +
            keyVariants[k] +
            " " +
            filters[f].Property +
            ": " +
            (wsEx.message || String(wsEx))
        );
      }
    }
  }

  var statusValues = ["Pending", "Failed", "Queued", "Processing", "Done"];
  for (var s = 0; s < statusValues.length; s++) {
    for (var k2 = 0; k2 < keyVariants.length; k2++) {
      try {
        var wsResp2 = prox.retrieve(
          "DataExtensionObject[" + keyVariants[k2] + "]",
          props,
          {
            Property: "status",
            SimpleOperator: "equals",
            Value: statusValues[s]
          }
        );
        addRows(
          wsResp2 && wsResp2.Results ? wsResp2.Results : [],
          "WSProxy[" + keyVariants[k2] + "]/status=" + statusValues[s]
        );
      } catch (wsEx2) {
        errors.push(
          "WSProxy status=" +
            statusValues[s] +
            ": " +
            (wsEx2.message || String(wsEx2))
        );
      }
    }
  }

  if (collected.length) {
    return {
      rows: collected,
      error: "",
      notes: notes.join(" | "),
      statusCounts: statusCounts
    };
  }

  var countBits = [];
  for (var ck in statusCounts) {
    if (statusCounts.hasOwnProperty(ck)) {
      countBits.push(ck + "=" + statusCounts[ck]);
    }
  }

  return {
    rows: [],
    error: errors.join(" | "),
    notes: notes.join(" | "),
    statusCounts: statusCounts,
    statusSummary: countBits.join(", ")
  };
}

function updateBatchRow(batchId, status, message, contactsProcessed) {
  var id = strTrim(batchId);
  if (!id) {
    return { ok: false, error: "Missing batchId for update." };
  }
  var msg = strTrim(message).substring(0, 3900);
  var countVal =
    contactsProcessed === null || typeof contactsProcessed === "undefined"
      ? ""
      : String(contactsProcessed);
  try {
    if (countVal !== "") {
      Platform.Function.UpdateData(
        BATCH_DE,
        ["batchId"],
        [id],
        ["status", "processedAt", "message", "contactsProcessed"],
        [status, new Date(), msg, countVal]
      );
    } else {
      Platform.Function.UpdateData(
        BATCH_DE,
        ["batchId"],
        [id],
        ["status", "processedAt", "message"],
        [status, new Date(), msg]
      );
    }
    return { ok: true };
  } catch (upEx) {
    try {
      if (countVal !== "") {
        Platform.Function.UpdateData(
          BATCH_DE,
          ["batchId"],
          [id],
          ["status", "message", "contactsProcessed"],
          [status, msg, countVal]
        );
      } else {
        Platform.Function.UpdateData(
          BATCH_DE,
          ["batchId"],
          [id],
          ["status", "message"],
          [status, msg]
        );
      }
      return { ok: true };
    } catch (upEx2) {
      return {
        ok: false,
        error:
          (upEx.message || String(upEx)) +
          " | " +
          (upEx2.message || String(upEx2))
      };
    }
  }
}

function resolveDeIdentity(prox, sourceDeName) {
  var name = strTrim(sourceDeName);
  if (!name) {
    return { ok: false, error: "Empty sourceDeName." };
  }
  var resolvedKey = name;
  var resolvedName = name;
  try {
    var byKey = prox.retrieve(
      "DataExtension",
      ["Name", "CustomerKey"],
      { Property: "CustomerKey", SimpleOperator: "equals", Value: name }
    );
    if (byKey && byKey.Results && byKey.Results.length) {
      resolvedKey = strTrim(byKey.Results[0].CustomerKey) || name;
      resolvedName = strTrim(byKey.Results[0].Name) || name;
      return { ok: true, customerKey: resolvedKey, name: resolvedName };
    }
    var byName = prox.retrieve(
      "DataExtension",
      ["Name", "CustomerKey"],
      { Property: "Name", SimpleOperator: "equals", Value: name }
    );
    if (byName && byName.Results && byName.Results.length) {
      resolvedKey = strTrim(byName.Results[0].CustomerKey) || name;
      resolvedName = strTrim(byName.Results[0].Name) || name;
      return { ok: true, customerKey: resolvedKey, name: resolvedName };
    }
  } catch (wsEx) {
    return {
      ok: false,
      error: "Source DE lookup failed: " + (wsEx.message || String(wsEx))
    };
  }
  return { ok: true, customerKey: name, name: name };
}

function retrieveSourceRows(prox, deIdentity) {
  var tryKeys = [];
  var seen = {};
  function addKey(k) {
    var key = strTrim(k);
    if (!key || seen[asLower(key)]) {
      return;
    }
    seen[asLower(key)] = true;
    tryKeys.push(key);
  }
  addKey(deIdentity.customerKey);
  addKey(deIdentity.name);
  addKey(asLower(deIdentity.customerKey));
  addKey(asLower(deIdentity.name));

  var notes = [];
  var i;

  for (i = 0; i < tryKeys.length; i++) {
    try {
      var de = DataExtension.Init(tryKeys[i]);
      var rows = coerceRows(de.Rows.Retrieve());
      notes.push("Init(" + tryKeys[i] + ") rows=" + rows.length);
      if (rows.length) {
        return { ok: true, deKey: tryKeys[i], rows: rows, notes: notes.join(" | ") };
      }
    } catch (deEx) {
      notes.push(
        "Init(" + tryKeys[i] + ") ERROR " + (deEx.message || String(deEx))
      );
    }
  }

  var fieldSets = [
    ["SubscriberKey"],
    ["subscriberKey"],
    ["ContactKey"],
    ["SubscriberKey", "Email"]
  ];
  for (i = 0; i < tryKeys.length; i++) {
    for (var f = 0; f < fieldSets.length; f++) {
      try {
        var filterProp = fieldSets[f][0];
        var wsResp = prox.retrieve(
          "DataExtensionObject[" + tryKeys[i] + "]",
          fieldSets[f],
          { Property: filterProp, SimpleOperator: "isNotNull" }
        );
        var wsRows = coerceRows(wsResp && wsResp.Results ? wsResp.Results : []);
        notes.push(
          "WSProxy[" +
            tryKeys[i] +
            "] fields=" +
            fieldSets[f].join(",") +
            " rows=" +
            wsRows.length
        );
        if (wsRows.length) {
          return {
            ok: true,
            deKey: tryKeys[i],
            rows: wsRows,
            notes: notes.join(" | ")
          };
        }
      } catch (wsEx) {
        notes.push(
          "WSProxy[" +
            tryKeys[i] +
            "] " +
            fieldSets[f].join(",") +
            " ERROR " +
            (wsEx.message || String(wsEx))
        );
      }
    }
  }

  return {
    ok: false,
    error: "No source rows retrieved. " + notes.join(" | "),
    notes: notes.join(" | ")
  };
}

function subscriberKeyFromRow(row) {
  return strTrim(
    fieldFromRow(row, [
      "SubscriberKey",
      "subscriberKey",
      "SUBSCRIBERKEY",
      "ContactKey",
      "contactKey"
    ])
  );
}

function insertExitQueueRow(subscriberKey, journeyName, journeyId, batchId) {
  var sk = strTrim(subscriberKey);
  var jid = strTrim(journeyId);
  var bid = strTrim(batchId);
  if (!sk) {
    return { ok: false, error: "Need subscriberKey for insert." };
  }
  if (!bid) {
    return { ok: false, error: "Need batchId for insert." };
  }
  var rowKey = bid + "|" + sk;
  var attempts = [
    ["key", "subscriberKey", "journeyName", "journeyId", "batchID"],
    ["key", "subscriberKey", "journeyName", "journeyId", "batchId"],
    ["key", "subscriberKey", "journeyName", "journeyID", "batchID"],
    ["key", "subscriberKey", "journeyName", "journeyID", "batchId"],
    ["Key", "subscriberKey", "journeyName", "journeyId", "batchID"],
    ["Key", "subscriberKey", "journeyName", "journeyId", "batchId"]
  ];
  var errors = [];
  var a;
  for (a = 0; a < attempts.length; a++) {
    try {
      var cols = attempts[a];
      var vals = [];
      var c;
      for (c = 0; c < cols.length; c++) {
        var colLower = asLower(cols[c]);
        if (colLower === "key") {
          vals.push(rowKey);
        } else if (colLower === "subscriberkey") {
          vals.push(sk);
        } else if (colLower === "journeyname") {
          vals.push(journeyName || "");
        } else if (colLower === "journeyid") {
          vals.push(jid || "");
        } else if (colLower === "batchid") {
          vals.push(bid);
        } else {
          vals.push("");
        }
      }
      Platform.Function.InsertData(EXIT_QUEUE_DE, cols, vals);
      return {
        ok: true,
        duplicate: false,
        fields: cols.join(","),
        key: rowKey,
        batchId: bid
      };
    } catch (insEx) {
      var msg = asLower(insEx.message || String(insEx));
      if (
        msg.indexOf("primary key") >= 0 ||
        msg.indexOf("duplicate") >= 0 ||
        msg.indexOf("already") >= 0 ||
        msg.indexOf("violation") >= 0 ||
        msg.indexOf("cannot insert duplicate") >= 0
      ) {
        try {
          Platform.Function.UpdateData(
            EXIT_QUEUE_DE,
            ["key"],
            [rowKey],
            ["batchID", "journeyName", "journeyId", "subscriberKey"],
            [bid, journeyName || "", jid || "", sk]
          );
        } catch (upEx1) {
          try {
            Platform.Function.UpdateData(
              EXIT_QUEUE_DE,
              ["key"],
              [rowKey],
              ["batchId", "journeyName", "journeyId", "subscriberKey"],
              [bid, journeyName || "", jid || "", sk]
            );
          } catch (upEx2) {}
        }
        return {
          ok: true,
          duplicate: true,
          fields: attempts[a].join(","),
          key: rowKey,
          batchId: bid
        };
      }
      errors.push(attempts[a].join("/") + ": " + (insEx.message || String(insEx)));
    }
  }
  return { ok: false, error: errors.join(" | "), key: rowKey, batchId: bid };
}

function lookupEnvironment() {
  try {
    return asLower(
      Platform.Function.Lookup(
        "bd_sst_page_navigation",
        "environment",
        "type",
        "cloudpage"
      ) || ""
    );
  } catch (e) {
    return "";
  }
}

function campaignIdVariants(campaignId) {
  var c = strTrim(campaignId);
  var out = [];
  var seen = {};
  function add(v) {
    var s = strTrim(v);
    if (!s || seen[asLower(s)]) {
      return;
    }
    seen[asLower(s)] = true;
    out.push(s);
  }
  add(c);
  if (c.length >= 18) {
    add(c.substring(0, 18));
  }
  if (c.length >= 15) {
    add(c.substring(0, 15));
  }
  return out;
}

function campaignIdsMatch(left, right) {
  var a = asLower(strTrim(left));
  var b = asLower(strTrim(right));
  if (!a || !b) {
    return false;
  }
  if (a === b) {
    return true;
  }
  if (a.length >= 15 && b.length >= 15 && a.substring(0, 15) === b.substring(0, 15)) {
    return true;
  }
  return false;
}

function statusesMatch(left, right) {
  return asLower(strTrim(left)) === asLower(strTrim(right));
}

function campaignMemberDeKeys(environment) {
  var preferred =
    asLower(environment) === "uat"
      ? [
          "ENT.CampaignMember_Salesforce_2",
          "CampaignMember_Salesforce_2",
          "CampaignMember_Salesforce_1",
          "CampaignMember_Salesforce",
          "ENT.CampaignMember_Salesforce_1"
        ]
      : [
          "CampaignMember_Salesforce_1",
          "CampaignMember_Salesforce",
          "ENT.CampaignMember_Salesforce_1",
          "ENT.CampaignMember_Salesforce_2",
          "CampaignMember_Salesforce_2"
        ];
  return preferred;
}

function filterCampaignMemberRows(rows, campaignId, memberStatus) {
  var out = [];
  var statusSamples = {};
  var campSampleList = [];
  var campSampleSeen = {};
  var i;
  for (i = 0; i < rows.length; i++) {
    var rowCamp = strTrim(
      fieldFromRow(rows[i], [
        "CampaignId",
        "campaignId",
        "CAMPAIGNID",
        "CampaignID"
      ])
    );
    var rowStatus = strTrim(
      fieldFromRow(rows[i], ["Status", "status", "STATUS", "MemberStatus"])
    );
    if (rowCamp && !campSampleSeen[asLower(rowCamp)] && campSampleList.length < 5) {
      campSampleSeen[asLower(rowCamp)] = true;
      campSampleList.push(rowCamp);
    }
    if (campaignIdsMatch(rowCamp, campaignId)) {
      if (rowStatus) {
        statusSamples[rowStatus] = (statusSamples[rowStatus] || 0) + 1;
      }
      if (statusesMatch(rowStatus, memberStatus)) {
        var contactId = strTrim(
          fieldFromRow(rows[i], [
            "ContactId",
            "contactId",
            "CONTACTID",
            "SubscriberKey",
            "subscriberKey"
          ])
        );
        if (contactId) {
          out.push(rows[i]);
        }
      }
    }
  }
  var statusBits = [];
  for (var st in statusSamples) {
    if (statusSamples.hasOwnProperty(st)) {
      statusBits.push(st + "=" + statusSamples[st]);
    }
  }
  return {
    rows: out,
    statusSummary: statusBits.join(", "),
    campaignSamples: campSampleList.join(", ")
  };
}

function retrieveCampaignMemberRows(prox, campaignId, memberStatus, environment) {
  var camp = strTrim(campaignId);
  var statusVal = strTrim(memberStatus);
  if (!camp) {
    return { ok: false, error: "Missing campaignId.", rows: [], notes: "" };
  }
  if (!statusVal) {
    return { ok: false, error: "Missing memberStatus.", rows: [], notes: "" };
  }
  var keys = campaignMemberDeKeys(environment);
  var campVariants = campaignIdVariants(camp);
  var notes = [];
  notes.push("env=" + (environment || "(blank)"));
  notes.push("campaignVariants=" + campVariants.join(","));
  notes.push("status=" + statusVal);
  var campaignFields = ["CampaignId", "campaignId", "CAMPAIGNID"];
  var propSets = [
    ["ContactId", "CampaignId", "Status", "Id"],
    ["ContactId", "CampaignId", "Status"],
    ["contactId", "CampaignId", "Status", "Id"],
    ["ContactId", "campaignId", "Status", "Id"]
  ];
  var lastFilter = { rows: [], statusSummary: "", campaignSamples: "" };
  var k;
  var v;
  var f;
  var p;

  for (k = 0; k < keys.length; k++) {
    for (v = 0; v < campVariants.length; v++) {
      for (f = 0; f < campaignFields.length; f++) {
        for (p = 0; p < propSets.length; p++) {
          try {
            var wsResp = prox.retrieve(
              "DataExtensionObject[" + keys[k] + "]",
              propSets[p],
              {
                Property: campaignFields[f],
                SimpleOperator: "equals",
                Value: campVariants[v]
              }
            );
            var topStatus = wsResp && wsResp.Status ? String(wsResp.Status) : "";
            if (topStatus && topStatus !== "OK") {
              var errMsg = topStatus;
              try {
                if (
                  wsResp.Results &&
                  wsResp.Results.length &&
                  wsResp.Results[0].StatusMessage
                ) {
                  errMsg = String(wsResp.Results[0].StatusMessage);
                }
              } catch (msgEx) {}
              notes.push(
                "WSProxy[" +
                  keys[k] +
                  "]/" +
                  campaignFields[f] +
                  "=" +
                  campVariants[v] +
                  " STATUS " +
                  errMsg
              );
              continue;
            }
            var rows = coerceRows(wsResp && wsResp.Results ? wsResp.Results : []);
            var filtered = filterCampaignMemberRows(rows, camp, statusVal);
            lastFilter = filtered;
            notes.push(
              "WSProxy[" +
                keys[k] +
                "]/" +
                campaignFields[f] +
                "=" +
                campVariants[v] +
                " raw=" +
                rows.length +
                " matched=" +
                filtered.rows.length
            );
            if (filtered.rows.length) {
              return {
                ok: true,
                deKey: keys[k],
                rows: filtered.rows,
                notes: notes.join(" | ")
              };
            }
          } catch (wsEx) {
            notes.push(
              "WSProxy[" +
                keys[k] +
                "]/" +
                campaignFields[f] +
                " ERROR " +
                (wsEx.message || String(wsEx))
            );
          }
        }
      }
    }
  }

  var hint = "";
  if (lastFilter.statusSummary) {
    hint += " Statuses seen for campaign: " + lastFilter.statusSummary + ".";
  } else if (lastFilter.campaignSamples) {
    hint += " CampaignId samples seen: " + lastFilter.campaignSamples + ".";
  } else {
    hint +=
      " No CampaignMember rows returned for this CampaignId from synced DEs. Check sync DE name/env and that Status matches exactly (case-insensitive).";
  }

  return {
    ok: false,
    error:
      "No CampaignMember rows for campaign/status." +
      hint +
      " Notes: " +
      notes.join(" | "),
    rows: [],
    notes: notes.join(" | ")
  };
}

function subscriberKeyFromCampaignRow(row) {
  return strTrim(
    fieldFromRow(row, [
      "ContactId",
      "contactId",
      "CONTACTID",
      "SubscriberKey",
      "subscriberKey",
      "Id"
    ])
  );
}

function processBatch(prox, batch) {
  var batchId = strTrim(batch.batchId);
  var sourceType = asLower(batch.sourceType) || "dataextension";
  if (sourceType !== "campaign") {
    sourceType = "dataextension";
  }
  var label =
    batchId +
    " / " +
    (batch.journeyName || "(no journey name)") +
    " / " +
    (sourceType === "campaign"
      ? "Campaign=" + (batch.campaignId || "(none)") + " Status=" + (batch.memberStatus || "(none)")
      : "DE=" + (batch.sourceDeName || "(no DE)"));

  if (!batchId) {
    return label + " — SKIP missing batchId.";
  }
  if (sourceType === "campaign") {
    if (!strTrim(batch.campaignId)) {
      updateBatchRow(batchId, "Failed", "Missing campaignId.");
      return label + " — FAILED missing campaignId.";
    }
    if (!strTrim(batch.memberStatus)) {
      updateBatchRow(batchId, "Failed", "Missing memberStatus.");
      return label + " — FAILED missing memberStatus.";
    }
  } else if (!strTrim(batch.sourceDeName)) {
    updateBatchRow(batchId, "Failed", "Missing sourceDeName.");
    return label + " — FAILED missing sourceDeName.";
  }
  if (!strTrim(batch.journeyID) && !strTrim(batch.journeyId)) {
    updateBatchRow(batchId, "Failed", "Missing journeyId.");
    return label + " — FAILED missing journeyId.";
  }

  var markProcessing = updateBatchRow(
    batchId,
    "Processing",
    "Seeder started."
  );
  if (!markProcessing.ok) {
    return (
      label +
      " — could not mark Processing: " +
      (markProcessing.error || "unknown")
    );
  }

  var sourceRows = [];
  var sourceNotes = "";
  var sourceDeKey = "";
  if (sourceType === "campaign") {
    var environment = lookupEnvironment();
    var campaignSource = retrieveCampaignMemberRows(
      prox,
      batch.campaignId,
      batch.memberStatus,
      environment
    );
    if (!campaignSource.ok) {
      updateBatchRow(
        batchId,
        "Failed",
        campaignSource.error || "Campaign member retrieve failed."
      );
      return (
        label +
        " — FAILED " +
        (campaignSource.error || "campaign member retrieve failed")
      );
    }
    sourceRows = campaignSource.rows || [];
    sourceNotes = campaignSource.notes || "";
    sourceDeKey = campaignSource.deKey || "";
    debugLines.push(
      batchId +
        " campaign source deKey=" +
        sourceDeKey +
        " rows=" +
        sourceRows.length +
        " notes=" +
        sourceNotes
    );
  } else {
    var identity = resolveDeIdentity(prox, batch.sourceDeName);
    if (!identity.ok) {
      updateBatchRow(batchId, "Failed", identity.error || "Source DE resolve failed.");
      return label + " — FAILED " + (identity.error || "source resolve failed");
    }

    var source = retrieveSourceRows(prox, identity);
    if (!source.ok) {
      updateBatchRow(batchId, "Failed", source.error || "Source retrieve failed.");
      return label + " — FAILED " + (source.error || "source retrieve failed");
    }
    sourceRows = source.rows || [];
    sourceNotes = source.notes || "";
    sourceDeKey = source.deKey || "";
    debugLines.push(
      batchId +
        " source deKey=" +
        sourceDeKey +
        " rows=" +
        sourceRows.length +
        " notes=" +
        sourceNotes
    );
  }

  if (sourceRows.length) {
    debugLines.push(
      batchId + " firstRowKeys=" + rowKeysSample(sourceRows[0])
    );
    debugLines.push(
      batchId +
        " firstSubscriberKey=" +
        ((sourceType === "campaign"
          ? subscriberKeyFromCampaignRow(sourceRows[0])
          : subscriberKeyFromRow(sourceRows[0])) || "(empty)")
    );
  }

  if (!sourceRows.length) {
    updateBatchRow(
      batchId,
      "Failed",
      (sourceType === "campaign"
        ? "Campaign member query returned 0 rows. "
        : "Source DE returned 0 rows. ") + sourceNotes
    );
    return label + " — FAILED source returned 0 rows.";
  }

  var inserted = 0;
  var duplicates = 0;
  var skipped = 0;
  var errors = 0;
  var limitHit = false;
  var max = MAX_ROWS_PER_BATCH;
  var journeyName = strTrim(batch.journeyName);
  var journeyId = strTrim(batch.journeyID || batch.journeyId);
  var firstInsertError = "";

  for (var i = 0; i < sourceRows.length; i++) {
    if (inserted + duplicates >= max) {
      limitHit = true;
      break;
    }
    var sk =
      sourceType === "campaign"
        ? subscriberKeyFromCampaignRow(sourceRows[i])
        : subscriberKeyFromRow(sourceRows[i]);
    if (!sk) {
      skipped++;
      if (skipped <= 3) {
        debugLines.push(
          batchId +
            " skipped row " +
            i +
            " keys=" +
            rowKeysSample(sourceRows[i])
        );
      }
      continue;
    }
    var ins = insertExitQueueRow(sk, journeyName, journeyId, batchId);
    if (!ins.ok) {
      errors++;
      if (!firstInsertError) {
        firstInsertError = ins.error || "unknown";
      }
      if (errors <= 5) {
        debugLines.push(
          batchId + " insert failed for " + sk + ": " + (ins.error || "unknown")
        );
      }
      continue;
    }
    if (ins.duplicate) {
      duplicates++;
    } else {
      inserted++;
    }
  }

  var summary =
    "Queued into " +
    EXIT_QUEUE_DE +
    ": inserted=" +
    inserted +
    ", duplicates=" +
    duplicates +
    ", skippedEmptyKey=" +
    skipped +
    ", errors=" +
    errors +
    ", sourceRows=" +
    sourceRows.length +
    ", sourceType=" +
    sourceType +
    (firstInsertError ? ", firstInsertError=" + firstInsertError : "") +
    (limitHit ? ", cappedAt=" + max : "");

  if (!inserted && !duplicates) {
    updateBatchRow(batchId, "Failed", summary, 0);
    return label + " — FAILED " + summary;
  }

  updateBatchRow(
    batchId,
    limitHit ? "Queued" : "Done",
    summary +
      (limitHit
        ? " Batch marked Queued because row cap was hit; re-run or raise MAX_ROWS_PER_BATCH."
        : ""),
    inserted + duplicates
  );
  return label + " — " + (limitHit ? "QUEUED (capped) " : "DONE ") + summary;
}

try {
  var prox = new Script.Util.WSProxy();
  var fetch = fetchPendingBatches(prox);
  var batches = fetch.rows || [];
  resultLines.push(
    "bd_sst_journey_exit_batch seeder — " +
      batches.length +
      " workable batch(es)."
  );
  if (fetch.notes) {
    debugLines.push("Fetch notes: " + fetch.notes);
  }
  if (fetch.statusSummary) {
    debugLines.push("Status counts: " + fetch.statusSummary);
  }
  if (fetch.error) {
    debugLines.push("Retrieve errors: " + fetch.error);
  }

  if (!batches.length) {
    resultLines.push(
      "No workable batches found. Check Fetch notes/Status counts in the log. Expected DE external key: " +
        BATCH_DE +
        ". Workable statuses: Pending, Failed, Queued, Processing, Done, or blank."
    );
  } else {
    var runCount =
      batches.length > MAX_BATCHES_PER_RUN
        ? MAX_BATCHES_PER_RUN
        : batches.length;
    if (batches.length > MAX_BATCHES_PER_RUN) {
      resultLines.push(
        "Processing first " +
          runCount +
          " of " +
          batches.length +
          " batches this run."
      );
    }
    for (var b = 0; b < runCount; b++) {
      debugLines.push(
        "Selected batchId=" +
          (batches[b].batchId || "") +
          " status=" +
          (batches[b].status || "") +
          " sourceDeName=" +
          (batches[b].sourceDeName || "") +
          " journeyId=" +
          (batches[b].journeyID || "")
      );
      debugLines.push(processBatch(prox, batches[b]));
    }
  }
} catch (runEx) {
  resultLines.push("ERROR: " + (runEx.message || String(runEx)));
}

var output = resultLines.join("\n");
if (debugLines.length) {
  output += "\n\n" + debugLines.join("\n");
}

var logResult = writeExitLog(output);
if (!logResult.ok) {
  output += "\n\n[sst_de_journey_exit_log insert FAILED] " + logResult.error;
}
Write(output);
</script>
