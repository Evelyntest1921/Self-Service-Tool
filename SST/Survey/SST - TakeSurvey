/* Import Inter font */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
/* CSS Variables */
:root {
  --primary-color: #6366f1;
  --primary-dark: #4f46e5;
  --secondary-color: #10b981;
  --accent-color: #f59e0b;
  --text-primary: #111827;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;
  --bg-primary: #ffffff;
  --bg-secondary: #f9fafb;
  --bg-tertiary: #f3f4f6;
  --border-color: #e5e7eb;
  --border-light: #f3f4f6;
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --radius-sm: 0.375rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
}








* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}








body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background: var(--bg-secondary);
  color: var(--text-primary);
  line-height: 1.6;
  padding: 20px;
}








.survey-container {
  max-width: 800px;
margin: 0 auto;
overflow: hidden;
}








.survey-header {
     background: #eff0f1;
color: #060606;
padding: 20px 40px;
text-align: center;
border: 1px solid #cacad3;
}








.logo {
  margin-bottom: 20px;
}








.logo img {
  height: 40px;
}








.survey-title {
  font-size: 1.875rem;
  font-weight: 700;
  margin-bottom: 8px;
}








.survey-subtitle {
  font-size: 1.125rem;
  opacity: 0.9;
}








.progress-bar {
  background: rgb(217 217 217 / 88%);
  height: 4px;
  border-radius: 2px;
  margin-top: 20px;
  overflow: hidden;
}








.progress-fill {
  background: linear-gradient(264deg, black, black);
  height: 100%;
  border-radius: 2px;
  transition: width 0.3s ease;
}








.survey-content {
 /* padding: 40px 0px; */
      background: #ffffff;
border: #eff0f1 solid 1px;
      margin-bottom: 50px;
}








.question-card {
     /* background: var(--bg-primary); */
/* border: 1px solid var(--border-color); */
/* border-radius: var(--radius-md); */
padding: 24px;
/* margin-bottom: 24px; */
transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
opacity: 1;
transform: translateY(0);
margin-bottom: 16px;
position: relative;
}








.question-card:hover {
  box-shadow: var(--shadow-md);
}








.question-card.answered {
  opacity: 0;
  transform: translateY(-30px) scale(0.95);
  max-height: 0;
  padding: 0;
  margin: 0;
  overflow: hidden;
  pointer-events: none;
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}




.question-card.fade-in {
  animation: fadeIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}




@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(30px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}








.question-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20px;
  align-items: center;
}








.question-number {
background: #000000;
color: white;
width: 42px;
height: 42px;
border-radius: 50%;
display: flex;
align-items: center;
justify-content: center;
font-size: 24px;
font-weight: 600;
margin-right: 16px;
flex-shrink: 0;
}








.question-content {
  flex: 1;
}








.question-text {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8px;
}








.question-type {
  font-size: 0.875rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}








.question-required {
  color: #ef4444;
  font-size: 0.875rem;
  margin-top: 4px;
}
















/* Form Controls */
.form-group {
  margin-bottom: 16px;
}








.radio-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}








.radio-option {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  border: 1px solid var(--border-color);
  /* border-radius: var(--radius-md); */
  cursor: pointer;
  transition: all 0.2s ease;
}








.radio-option:hover {
 border-color: #000000;
 background: #eff0f1;
}








.radio-option.selected {
  border-color: #000000;
  background: #f0f0f0;
  box-shadow: var(--shadow-sm);
}








.radio-option input[type="radio"] {
  margin-right: 12px;
  transform: scale(1.2);
  cursor: pointer;
}








.radio-option label {
  cursor: pointer;
  font-weight: 500;
  margin: 0;
  flex: 1;
  user-select: none;
}








.select-control {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 1rem;
  background: var(--bg-primary);
  transition: all 0.2s ease;
}








.select-control:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}








.textarea-control {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  font-size: 1rem;
  background: var(--bg-primary);
  resize: vertical;
  min-height: 100px;
  font-family: inherit;
  transition: all 0.2s ease;
}








.textarea-control:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}








/* Submit Button */
.submit-section {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid var(--border-color);
}








.submit-button {
  background: #0e0e1d;
  color: white;
  border: none;
  padding: 16px 32px;
 /* border-radius: var(--radius-md); */
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  width: 100%;
  position: relative;
}








/* Make text question Next button share submit styles */
.next-button {
 width: auto;
 display: inline-block;
}
/* Make back button look exactly the same as next button */
.back-button {
width: auto;
  display: inline-block;
}
.back-button:hover {
 background: var(--primary-hover);
 transform: translateY(-1px);
}
.back-button:active {
 transform: translateY(0);
}
/* Question buttons container */
.question-buttons {
 display: flex;
 align-items: center;
 gap: 10px;
}
















.submit-button:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}








.submit-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}








.spinner {
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top: 2px solid white;
  border-radius: 50%;
  width: 20px;
  height: 20px;
  animation: spin 1s linear infinite;
  display: inline-block;
  margin-left: 8px;
}








@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}








/* Success Message */
.success-message {
  text-align: center;
  padding: 0px 60px 20px 40px;
}








.success-icon {
  font-size: 4rem;
  margin-bottom: 24px;
}








.success-title {
font-size: 2rem;
font-weight: 700;
margin-bottom: 16px;
color: #000000;
}








.success-text {
  font-size: 1.125rem;
  color: var(--text-secondary);
  line-height: 1.6;
}








/* Responsive */
@media (max-width: 768px) {
  body {
    padding: 10px;
  }
  .survey-header {
    padding: 30px 20px;
  }
  .survey-content {
    padding: 30px 20px;
  }
  .survey-title {
    font-size: 1.5rem;
  }
}
</style>
