    <script>
        function getTextFocusFetchUrl(questionId, page, responseCount) {
            var cfg = document.getElementById('textFocusConfig');
            var surveyId = cfg ? (cfg.getAttribute('data-survey-id') || '') : '';
            var journeyId = cfg ? (cfg.getAttribute('data-journey-id') || '') : '';
            var url;
            try {
                url = new URL(window.location.pathname, window.location.origin);
            } catch (e) {
                url = new URL(window.location.href);
            }
            url.search = '';
            if (!surveyId) {
                try {
                    surveyId = new URL(window.location.href).searchParams.get('surveyid') || '';
                } catch (e2) {}
            }
            if (surveyId) {
                url.searchParams.set('surveyid', surveyId);
            }
            if (journeyId) {
                url.searchParams.set('journeyId', journeyId);
            }
            url.searchParams.set('textFocus', '1');
            url.searchParams.set('textQ', questionId);
            url.searchParams.set('textPage', String(page));
            url.searchParams.set('textTotal', String(responseCount || 0));
            url.hash = '';
            return url.toString();
        }

        function openTextQuestionFocus(questionId, responseCount) {
            var count = parseInt(responseCount || '0', 10);
            if (count < 0 || isNaN(count)) {
                count = 0;
            }
            window.location.assign(getTextFocusFetchUrl(questionId, 1, count));
        }

