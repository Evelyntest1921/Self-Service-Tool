            cursor: default;
        }
        .dashboard-layout--build-shell .nav-icon {
            width: 20px;
            height: 20px;
            opacity: 0.75;
            flex-shrink: 0;
        }
        .dashboard-layout--build-shell .main-content {
            flex: 1;
            min-width: 0;
            height: 100vh;
        }
        @media (max-width: 768px) {
            .dashboard-layout--build-shell {
                flex-direction: column;
                height: auto;
                overflow: visible;
            }
            .dashboard-layout--build-shell .maker-sidebar {
                width: 100%;
                flex-direction: row;
                overflow-x: auto;
                align-items: center;
                min-height: 0;
                padding: 12px 0;
                height: auto;
            }
            .dashboard-layout--build-shell .maker-sidebar .sidebar-logo {
                margin-bottom: 0;
                flex-shrink: 0;
                padding-right: 16px;
            }
            .dashboard-layout--build-shell .maker-sidebar .sidebar-nav {
                display: flex;
                flex-direction: row;
                gap: 4px;
                padding: 8px 0;
                flex: 1;
                flex-wrap: nowrap;
            }
            .dashboard-layout--build-shell .maker-sidebar .nav-section-title {
                display: none;
            }
            .dashboard-layout--build-shell .maker-sidebar .sidebar-nav .nav-link {
                white-space: nowrap;
                padding: 8px 16px;
                border-right: none;
                border-radius: 8px;
            }
            .dashboard-layout--build-shell .main-content {
                height: auto;
            }
        }
    </style>
    %%[ ENDIF ]%%
</head>
<body>
<div class="dashboard-layout%%[ IF @buildNavContext == "true" THEN ]%% dashboard-layout--build-shell%%[ ENDIF ]%%">
  %%[ IF @buildNavContext == "true" AND NOT Empty(@editSidebarHtml) THEN ]%%
  %%=TreatAsContent(@editSidebarHtml)=%%
  %%[ ELSE ]%%
  %%[ SET @activeNav = "survey_home" ]%%
  %%=ContentBlockByName("sst_shell_sidebar")=%%
  %%[ ENDIF ]%%
        <main class="main-content survey-analytics-page%%[ IF @textFocusMode == "true" THEN ]%% text-focus-active%%[ ENDIF ]%% is-analytics-loading">
            <div class="survey-analytics-loading-panel" id="surveyAnalyticsLoadingPanel" aria-live="polite">
                <div class="survey-analytics-loading-spinner" aria-hidden="true"></div>
                <p class="survey-analytics-loading-title">Loading survey</p>
                <p class="survey-analytics-loading-sub">Fetching survey results and charts. This may take a moment.</p>
            </div>
            <div id="textFocusConfig" style="display:none" data-fetch-base="%%=v(@textNavBase)=%%" data-survey-id="%%=v(@surveyId)=%%" data-journey-id="%%=v(@jid)=%%"></div>
            <div id="textQuestionFocusView" class="text-question-focus-view" style="%%[ IF @textFocusMode == "true" THEN ]%%display:flex%%[ ELSE ]%%display:none%%[ ENDIF ]%%">
                <div class="survey-header text-focus-survey-header">
                    <div class="breadcrumb-section">
                        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                            <a href="%%=v(@textNavBase)=%%" class="breadcrumb-link">
                                <svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
                                Back
                            </a>
                            <span class="breadcrumb-separator" aria-hidden="true">/</span>
                            <span class="breadcrumb-current">%%=v(@surveyName)=%%</span>
                        </nav>
                    </div>
                </div>
                <div id="textFocusBody" class="text-focus-body">
                %%[ IF @textFocusMode == "true" THEN ]%%
                <div class="question-card text-focus-question-card">
                <div class="question-header">
                    <span class="question-number">%%=Format(@focusQuestionNumber, "00")=%%</span>
                    <div class="question-content">
                        <h3>%%=v(@focusQuestionText)=%%</h3>
                    </div>
                </div>
                <div class="question-stats">
                    <div class="stat-summary">
                        <div class="stat-item">
                            <span class="stat-label">Total Responses</span>
                            <span class="stat-value">%%=v(@focusResponseCount)=%%</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Response Rate</span>
                            <span class="stat-value">%%=IIF(@textFocusUniqueContacts > 0, FormatNumber(Multiply(Divide(@focusResponseCount, @textFocusUniqueContacts), 100), 0), 0)=%%%</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Question Type</span>
                            <span class="stat-value">
                                <span class="question-type-badge type-%%=v(@focusQuestionType)=%%">%%=v(@focusQuestionType)=%%</span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="text-responses-section">
                <h4>Text Responses (%%=v(@focusResponseCount)=%%)</h4>
                <div class="text-focus-list">
                %%[
                SET @textBatchRowCount = 0
                IF NOT EMPTY(@surveyId) AND NOT EMPTY(@focusQuestionId) THEN
                SET @textDePageKey = Concat("", @textLocalUiPage)
                SET @textBatchRows = LookupRows("SST_SP_Survey_Responses_DE", "SurveyID", @surveyId, "QuestionID", @focusQuestionId, "TextPageNumber", @textDePageKey)
                SET @textBatchRowCount = RowCount(@textBatchRows)
                IF @textBatchRowCount == 0 THEN
                SET @textBatchRows = LookupRows("SST_SP_Survey_Responses_DE", "SurveyID", @surveyId, "QuestionID", @focusQuestionId, "TextPageNumber", @textLocalUiPage)
                SET @textBatchRowCount = RowCount(@textBatchRows)
                ENDIF
                ENDIF
                IF @textBatchRowCount > 0 THEN
                FOR @textRowIdx = 1 TO @textBatchRowCount DO
                SET @textResponse = Field(Row(@textBatchRows, @textRowIdx), "Response")
                IF NOT EMPTY(@textResponse) THEN
                ]%%
                <div class="text-response-item"><div class="text-response-content"><span class="text-response-text">"%%=v(@textResponse)=%%"</span></div></div>
                %%[
                ENDIF
                NEXT @textRowIdx
                ELSEIF @focusResponseCount > 0 THEN
                ]%%
                <p class="text-focus-empty">No text responses on this page. Confirm TextPageNumber is populated on SST_SP_Survey_Responses_DE.</p>
                %%[
                ELSE
                ]%%
                <p class="text-focus-empty">No text responses recorded for this question.</p>
                %%[
                ENDIF
                ]%%
                </div>
                <div class="text-responses-expanded-footer">
                <div class="text-responses-pagination">
                <span class="text-responses-page-info">Page %%=v(@textLocalUiPage)=%% of %%=v(@textTotalUiPages)=%%</span>
                <div class="text-responses-page-buttons">
                %%[ IF @textLocalUiPage > 1 THEN ]%%
                <a class="btn-secondary text-responses-page-btn" href="%%=Concat(@textFragNav, @textPrevPage)=%%">Previous</a>
                %%[ ENDIF ]%%
                %%[ IF @textLocalUiPage < @textTotalUiPages THEN ]%%
                <a class="btn-secondary text-responses-page-btn" href="%%=Concat(@textFragNav, @textNextPage)=%%">Next</a>
                %%[ ENDIF ]%%
                </div>
                </div>
                </div>
                </div>
                %%[ ENDIF ]%%
                </div>
            </div>
            <div id="surveyAnalyticsMainWrap">
            <!-- Survey Header with Breadcrumb -->
            <div class="survey-header">
                <div class="breadcrumb-section">
                    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
                        <a href="%%=IIF(NOT Empty(@surveyHomeUrl), @surveyHomeUrl, @hubUrl)=%%" class="breadcrumb-link">
                            <svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
                            Back
                        </a>
                        <span class="breadcrumb-separator" aria-hidden="true">/</span>
                        <span class="breadcrumb-current">Analytics</span>
                    </nav>
                </div>


                %%[ IF @deleteSuccess == "true" THEN ]%%
                <div class="alert alert-success">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                    </svg>
                    Survey has been successfully deleted. Redirecting to dashboard...
                </div>
                <script>
                    setTimeout(function () {
                        window.location.href = '%%=v(@surveyHomeUrl)=%%';
                    }, 2000);
                </script>
                %%[ ELSEIF NOT EMPTY(@deleteError) THEN ]%%
                <div class="alert alert-error">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path
                            d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                    </svg>
                    %%=v(@deleteError)=%%
                </div>
                %%[ ENDIF ]%%


                %%[
                VAR @surveyName, @surveyStatus, @analyticsCount, @analyticsRows
                VAR @courseAnalyticsRows, @courseAnalyticsCount
                VAR @surveyMetricsRows, @surveyMetricsCount, @surveyMetricRow
                VAR @uniqueContacts, @openedCount, @completedCount, @surveyTotalActivity


                SET @analyticsCount = 0
                SET @courseAnalyticsCount = 0
                SET @surveyMetricsCount = 0
                SET @uniqueContacts = 0
                SET @openedCount = 0
                SET @completedCount = 0
                SET @surveyTotalActivity = 0
                IF NOT EMPTY(@surveyId) THEN
                SET @analyticsRows = LookupRows("sst_analytics_answers", "SurveyID", @surveyId)
                SET @analyticsCount = RowCount(@analyticsRows)
                SET @courseAnalyticsRows = LookupRows("sst_analytics_per_course", "surveyId", Trim(@surveyId))
                SET @courseAnalyticsCount = RowCount(@courseAnalyticsRows)
                IF @courseAnalyticsCount == 0 THEN
                SET @courseAnalyticsRows = LookupRows("sst_analytics_per_course", "SurveyID", Trim(@surveyId))
                SET @courseAnalyticsCount = RowCount(@courseAnalyticsRows)
                ENDIF
                SET @surveyMetricsRows = LookupRows("sst_analytics_per_survey", "surveyId", @surveyId)
                SET @surveyMetricsCount = RowCount(@surveyMetricsRows)
                ENDIF
                IF @surveyMetricsCount > 0 THEN
                SET @surveyMetricRow = Row(@surveyMetricsRows, 1)
                SET @uniqueContacts = Field(@surveyMetricRow, "UniqueRespondents")
                SET @openedCount = Field(@surveyMetricRow, "OpenedSurvey")
                SET @completedCount = Field(@surveyMetricRow, "CompletedSurvey")
                SET @surveyTotalActivity = Field(@surveyMetricRow, "TotalActivity")
                IF EMPTY(@uniqueContacts) THEN SET @uniqueContacts = 0 ENDIF
                IF EMPTY(@openedCount) THEN SET @openedCount = 0 ENDIF
                IF EMPTY(@completedCount) THEN SET @completedCount = 0 ENDIF
                IF EMPTY(@surveyTotalActivity) THEN SET @surveyTotalActivity = 0 ENDIF
                ENDIF








                /* Get survey name and status from SST_SP_Surveys_Master_DE */
                SET @surveyName = Lookup("SST_SP_Surveys_Master_DE", "SurveyName", "SurveyID", @surveyId)
                SET @surveyStatus = Lookup("SST_SP_Surveys_Master_DE", "SurveyStatus", "SurveyID", @surveyId)



                /* Fallback if survey not found in master DE */
                IF EMPTY(@surveyName) THEN
                SET @surveyName = Concat("Survey ", @surveyId)
                ENDIF


                IF EMPTY(@surveyStatus) THEN
                SET @surveyStatus = "Unknown"
                ENDIF
                ]%%


                <div class="survey-title-section">
                    <div class="survey-title-row">
                        <h1>%%=v(@surveyName)=%%</h1>
                        <div class="survey-actions-header">


                            <a href="%%=v(@surveyPreviewUrl)=%%"
                                class="btn-preview" target="_blank" rel="noopener noreferrer">
                                📑
                                Preview
                            </a>
                            %%[ IF NOT Empty(@surveyEmailLink) THEN ]%%
                            <button type="button" class="btn-copy-link" id="copySurveyLinkBtn" onclick="copySurveyEmailLink(this); return false;" title="Copy survey URL for email (includes survey title and subscriber key token for send time)." data-take-url="%%=v(@surveyTakeUrl)=%%" data-survey-id="%%=v(@surveyId)=%%" data-survey-name="%%=v(@surveyNameEncoded)=%%">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
                                </svg>
                                Copy link
                            </button>
                            %%[ ENDIF ]%%
                            <a href="%%=IIF(NOT Empty(@editSurveyUrl), @editSurveyUrl, Concat(@surveyStageUrl, "?mode=edit&surveyid=", @surveyId))=%%"
                                class="btn-edit">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                    <path
                                        d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                                </svg>
                                Edit Survey
                            </a>
                            <div class="dropdown">
                                <button class="btn-dropdown" onclick="toggleDropdown()">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                        <path
                                            d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" />
                                    </svg>
                                </button>
                                <div class="dropdown-menu" id="dropdownMenu">
                                    <form method="POST" action="%%=v(@textNavBase)=%%"
                                        onsubmit="return confirmDelete()">
                                        <input type="hidden" name="deleteAction" value="delete">
                                        <input type="hidden" name="surveyid" value="%%=v(@surveyId)=%%">
                                        <button type="submit" class="dropdown-item delete-item">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                                <path
                                                    d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                            </svg>
                                            Delete Survey
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="survey-meta-info">
                        <span class="survey-badge">Survey ID: %%=v(@surveyId)=%%</span>
                        <span class="survey-status-badge status-%%=v(@surveyStatus)=%%">%%=v(@surveyStatus)=%%</span>
                        <span class="response-count">%%=v(@surveyTotalActivity)=%% Total Responses</span>
                        <span class="last-updated">Last updated: %%=Format(Now(), "MMM dd, yyyy")=%%</span>
                    </div>
                </div>
            </div>




            <!-- Survey Overview Metrics -->




            <!-- Survey Analytics Section (Default View) -->
            <div id="surveyAnalyticsSection">
                %%[ IF @surveyMetricsCount > 0 OR @analyticsCount > 0 OR @courseAnalyticsCount > 0 THEN ]%%
                <div class="analytics-view-bar">
                    <div class="view-toggle">
                        <button type="button" class="toggle-btn active" data-view="chart">Chart View</button>
                        <button type="button" class="toggle-btn" data-view="responses">Responses View</button>
                    </div>
                </div>
                %%[ ENDIF ]%%
                <div id="analyticsChartView">
                <div class="metrics-grid">
                    <div class="metric-card">
                        <div class="metric-icon sent">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
                            </svg>
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">%%=v(@uniqueContacts)=%%</div>
                            <div class="metric-label">Unique Respondents</div>
                            <div class="metric-trend">Based on response data</div>
                        </div>
                    </div>


                    <div class="metric-card">
                        <div class="metric-icon opened">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <path
                                    d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                            </svg>
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">%%=v(@openedCount)=%%</div>
                            <div class="metric-label">Opened the survey</div>
                            <div class="metric-trend">Tracked automatically</div>
                        </div>
                    </div>


                    <div class="metric-card">
                        <div class="metric-icon completed">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <path
                                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                            </svg>
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">%%=v(@completedCount)=%%</div>
                            <div class="metric-label">Completed the Survey</div>
                            <div class="metric-trend">Based on status field</div>
                        </div>
                    </div>


                    <div class="metric-card">
                        <div class="metric-icon responses">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <path
                                    d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10 2 10 2 10 2 9 3 8.18 4H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z" />
                            </svg>
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">%%=v(@surveyTotalActivity)=%%</div>
                            <div class="metric-label">Total Activity</div>
                            <div class="metric-trend">All activity detected</div>
                        </div>
                    </div>
                </div>










                <!-- Question Analysis Section -->
                %%[ IF @analyticsCount > 0 THEN ]%%
                <div class="questions-section">
                    <div class="section-header">
                        <h2>Question Analysis</h2>
                    </div>


                    %%[
                    /* Get questions from SST_SP_Survey_Questions_DE */
                    VAR @questions, @questionCount
                    SET @questions = LookupRows("SST_SP_Survey_Questions_DE", "SurveyID", @surveyId)
                    SET @questionCount = RowCount(@questions)


                    /* Debug: Check if questions exist */
                    IF @questionCount == 0 THEN
                    SET @debugMessage = "No questions found in SST_SP_Survey_Questions_DE for SurveyID: " + @surveyId
                    ELSE
                    SET @debugMessage = "Found " + @questionCount + " questions"
                    ENDIF
                    ]%%


                    %%[ IF @questionCount > 0 THEN ]%%


                    <!-- Debug Info 
      <div style="background: #f0f0f0; padding: 10px; margin: 10px 0; border-radius: 5px; font-family: monospace; font-size: 12px;">
        <strong>Debug Info:</strong><br>
        Survey ID: %%=v(@surveyId)=%%<br>
        Questions Found: %%=v(@questionCount)=%%<br>
        Responses Found: %%=v(@surveyTotalActivity)=%%<br>
        Debug Message: %%=v(@debugMessage)=%%<br>
        <br>
        <strong>Questions in SST_SP_Survey_Questions_DE:</strong><br>
        %%[ FOR @i = 1 TO @questionCount DO
          SET @debugRow = Row(@questions, @i)
          SET @debugText = Field(@debugRow, "QuestionText")
          SET @debugId = Field(@debugRow, "QuestionID")
        ]%%
        %%=v(@i)=%%. %%=v(@debugText)=%% (ID: %%=v(@debugId)=%%)<br>
        %%[ NEXT @i ]%%
      </div> 
-->


                    %%[ FOR @q = 1 TO @questionCount DO
                    SET @questionRow = Row(@questions, @q)
                    SET @questionText = Field(@questionRow, "QuestionText")
                    SET @questionId = Field(@questionRow, "QuestionID")
                    SET @questionType = Field(@questionRow, "QuestionType")


                    /* Count responses for this question */
                    VAR @responseCount, @yesCount, @noCount, @otherResponses
                    SET @responseCount = 0
                    SET @yesCount = 0
                    SET @noCount = 0
                    SET @otherResponses = ""


                    IF @analyticsCount > 0 THEN
                    SET @responseCount = Lookup("sst_analytics_answers", "TotalActivity", "SurveyID", @surveyId, "QuestionID", @questionId)
                    IF @questionType == "text" THEN
                    SET @responseCount = Lookup("sst_analytics_answers", "TextResponseCount", "SurveyID", @surveyId, "QuestionID", @questionId)
                    ENDIF
                    SET @yesCount = Lookup("sst_analytics_answers", "Opt1_Count", "SurveyID", @surveyId, "QuestionID", @questionId)
                    SET @noCount = Lookup("sst_analytics_answers", "Opt2_Count", "SurveyID", @surveyId, "QuestionID", @questionId)
                    IF EMPTY(@responseCount) THEN SET @responseCount = 0 ENDIF
                    IF EMPTY(@yesCount) THEN SET @yesCount = 0 ENDIF
                    IF EMPTY(@noCount) THEN SET @noCount = 0 ENDIF
                    ENDIF
                    ]%%


                    <div class="question-card" id="question-%%=v(@questionId)=%%">
                        <div class="question-header">
                            <span class="question-number">%%=Format(@q, "00")=%%</span>
                            <div class="question-content">
                                <!-- <h3>%%=v(@questionText)=%%</h3> -->
                                <h3>
                                    %%=v(@questionText)=%%
                                </h3>
                                <!-- Debug: Question Text = "%%=v(@questionText)=%%" -->
                            </div>
                        </div>


                        <div class="question-stats">
                            <div class="stat-summary">
                                <div class="stat-item">
                                    <span class="stat-label">Total Responses</span>
                                    <span class="stat-value">%%=v(@responseCount)=%%</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Response Rate</span>
                                    <span class="stat-value">%%=IIF(@uniqueContacts > 0,
                                        FormatNumber(Multiply(Divide(@responseCount, @uniqueContacts), 100), 0),
                                        0)=%%%</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Question Type</span>
                                    <span class="stat-value">
                                        <span
                                            class="question-type-badge type-%%=v(@questionType)=%%">%%=v(@questionType)=%%</span>
                                    </span>
                                </div>
                            </div>
                        </div>


                        %%[ IF @responseCount > 0 THEN ]%%
                        <div class="answer-bars">
                            %%[ IF @questionType == "yesno" AND (@yesCount > 0 OR @noCount > 0) THEN ]%%
                            <!-- Yes/No Questions -->
                            %%[ IF @yesCount > 0 THEN ]%%
                            <div class="answer-option">
                                <div class="option-info">
                                    <span class="option-label">Yes</span>
                                    <span class="option-stats">%%=v(@yesCount)=%% responses
                                        (%%=FormatNumber(Multiply(Divide(@yesCount, @responseCount), 100), 0)=%%)</span>
                                </div>
                                <div class="progress-bar-modern">
                                    <div class="progress-fill-modern yes"
                                        style="width: %%=FormatNumber(Multiply(Divide(@yesCount, @responseCount), 100), 0)=%%%;">
                                    </div>
                                </div>
                            </div>
                            %%[ ENDIF ]%%


                            %%[ IF @noCount > 0 THEN ]%%
                            <div class="answer-option">
                                <div class="option-info">
                                    <span class="option-label">No</span>
                                    <span class="option-stats">%%=v(@noCount)=%% responses
                                        (%%=FormatNumber(Multiply(Divide(@noCount, @responseCount), 100), 0)=%%)</span>
                                </div>
                                <div class="progress-bar-modern">
                                    <div class="progress-fill-modern no"
                                        style="width: %%=FormatNumber(Multiply(Divide(@noCount, @responseCount), 100), 0)=%%%;">
                                    </div>
                                </div>
                            </div>
                            %%[ ENDIF ]%%


