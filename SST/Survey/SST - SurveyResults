                console.error('Invalid course chart data:', { labels, data });
                var courseFallback = document.getElementById('courseChartFallback');
                if (courseFallback) {
                    courseFallback.style.display = 'block';
                    courseFallback.querySelector('h3').textContent = 'No course chart data';
                    courseFallback.querySelector('p').textContent = 'Add rows to sst_analytics_per_course for this survey or run the per-course query activity.';
