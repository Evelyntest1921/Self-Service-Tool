        function downloadResponsesCSV() {
            var url = buildSurveyResponsesExportUrl();
            var filename = getSurveyResponsesExportFilename();
            fetch(url.toString(), { credentials: 'same-origin' })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error('Export request failed');
                    }
                    return response.blob();
                })
                .then(function (blob) {
                    var objectUrl = URL.createObjectURL(blob);
                    var link = document.createElement('a');
                    link.href = objectUrl;
                    link.download = filename;
                    link.style.display = 'none';
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    URL.revokeObjectURL(objectUrl);
                })
                .catch(function () {
                    window.location.assign(url.toString());
                });
        }

        // Initialize course chart
        function initializeCourseChart() {
            console.log('Initializing course chart...');
            
            const canvas = document.getElementById('courseChart');
            if (!canvas) {
                console.error('Course chart canvas element not found');
                return;
            }

            // Check if Chart.js is loaded and available
            if (typeof Chart === 'undefined' || !Chart.prototype || !Chart.prototype.constructor) {
                console.error('Chart.js not properly loaded');
                document.getElementById('courseChartFallback').style.display = 'block';
                canvas.style.display = 'none';
                return;
            }

            // Get chart data from AMPscript variables
            const labelsElement = document.getElementById('courseChartLabels');
            const valuesElement = document.getElementById('courseChartValues');
            
            if (!labelsElement || !valuesElement) {
                console.error('Course chart data elements not found');
                return;
            }

            const labels = labelsElement.textContent.split('|').filter(label => label.trim());
            const values = valuesElement.textContent.split('|').map(val => parseInt(val.trim()) || 0);

            console.log('Course chart data:', { labels, values });

            // Sort data by values (descending) to show most filled out courses first
            const sortedData = labels.map((label, index) => ({
                label: label,
                value: values[index]
            })).sort((a, b) => b.value - a.value);

            const sortedLabels = sortedData.map(item => item.label);
            const sortedValues = sortedData.map(item => item.value);

            // Create Chart.js chart
            createCourseChart(canvas, sortedLabels, sortedValues);
        }

        // Create course chart
