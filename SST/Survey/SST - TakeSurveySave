%%[
VAR @contact, @surveyId, @qid, @qnum, @answer, @saved, @responsePK
SET @contact = RequestParameter("contact")
SET @surveyId = RequestParameter("id")
SET @qid = RequestParameter("qid")
SET @qnum = RequestParameter("qnum")
SET @answer = RequestParameter("answer")
SET @saved = "false"
IF NOT EMPTY(@contact) AND NOT EMPTY(@surveyId) AND NOT EMPTY(@qid) AND NOT EMPTY(@answer) THEN
SET @responsePK = Concat(@contact, "_", @surveyId, "_", @qid)
UpsertData("SST_SP_Survey_Responses_DE", 1, "ResponsePK", @responsePK, "Contact", @contact, "SurveyID", @surveyId, "QuestionID", @qid, "QuestionNumber", @qnum, "Response", @answer, "Status", "Opened", "LastUpdated", NOW())
SET @saved = "true"
ENDIF
]%%
{"ok":%%=v(@saved)=%%}