}
.survey-journey-hub-form {
  min-width: 0;
}
.preview-panel {
  border: 1px solid var(--border-color);
  background: #ffffff;
  min-width: 0;
  position: sticky;
  top: 16px;
  align-self: start;
  max-height: calc(100vh - 48px);
