.sender-settings-panel {
  margin-top: 8px;
  border: 1px solid var(--border-color);
  border-radius: 12px;
  overflow: hidden;
  background: var(--bg-primary);
}
.sender-settings-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px 16px;
  border: 0;
  background: var(--bg-secondary);
  font: inherit;
  font-weight: 600;
  font-size: 0.9375rem;
  color: var(--text-primary);
  cursor: pointer;
  text-align: left;
}
.sender-settings-toggle:hover { background: #f3f4f6; }
.sender-settings-chevron {
  flex-shrink: 0;
  transition: transform 0.2s ease;
}
.sender-settings-panel.is-open .sender-settings-chevron { transform: rotate(180deg); }
.sender-settings-body {
  display: none;
  padding: 16px;
  border-top: 1px solid var(--border-color);
}
.sender-settings-panel.is-open .sender-settings-body { display: block; }
.sender-settings-body .form-group:last-child { margin-bottom: 0; }
.form-alert {
  padding: 12px 16px;
  border-radius: var(--radius-md);
  border: 1px solid #fecaca;
  background: #fef2f2;
  color: #b91c1c;
