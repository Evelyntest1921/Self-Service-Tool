    max-height: none;
  }
}
.preview-header-outlook {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding: 16px 20px;
  background: #faf9f8;
  border-bottom: 1px solid #edebe9;
  font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, sans-serif;
}
.preview-outlook-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #0078d4;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  flex-shrink: 0;
}
.preview-outlook-subject {
  font-weight: 600;
  font-size: 15px;
  margin: 0;
  color: #323130;
}
.preview-outlook-snippet {
  font-size: 13px;
  color: #605e5c;
  margin: 4px 0 0;
}
.step2-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 8px;
}
@media (max-width: 768px) {
  body { padding: 0; }
  .survey-title { font-size: 1.5rem; }
  .maker-sidebar {
    width: 100%;
    flex-direction: row;
    overflow-x: auto;
    align-items: center;
    min-height: 0;
  }
  .maker-sidebar .sidebar-logo { margin-bottom: 0; flex-shrink: 0; padding-right: 16px; }
  .maker-sidebar .sidebar-nav { display: flex; flex-direction: row; gap: 4px; padding: 8px 0; flex: 1; flex-wrap: nowrap; }
  .maker-sidebar .nav-section-title { display: none; }
  .maker-sidebar .nav-link { white-space: nowrap; padding: 8px 16px; border-right: none; border-radius: 8px; }
  .dashboard-layout { flex-direction: column; height: auto; overflow: visible; }
  .maker-sidebar { height: auto; overflow: visible; }
  .maker-main { height: auto; overflow: visible; }
  .maker-main-inner { overflow: visible; padding: 16px !important; }
  .maker-main-footer { padding: 14px 16px; }
}
</style>
</head>
<body>
<div class="dashboard-layout">
  <aside class="maker-sidebar sidebar" aria-label="Primary">
    <div class="sidebar-logo">
      <a href="%%=v(@hubUrl)=%%"><img src="https://www.magmutual.com/_next/image?url=%2Fmagmutual-egg.svg&w=640&q=75" alt="MagMutual" style="filter: invert(1);"></a>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section"><span class="nav-section-title">MENU</span></div>
      <span class="nav-link active" role="presentation">
        <svg class="nav-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 17h2v-5H3v5zm8 5h2V6h-2v16zM13 9h8V7h-8v2zM3 5v4h14V5H3zm8 14h10v-2H11v2zM13 17h8v-2h-8v2z"/></svg>
        %%=v(@builderPageLabel)=%%
      </span>
    </nav>
  </aside>
  <main class="maker-main">
    <div class="maker-main-inner">
    <div class="breadcrumb-section">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="%%=v(@hubUrl)=%%" class="breadcrumb-link">
          <svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
          Back
        </a>
        <span class="breadcrumb-separator" aria-hidden="true">/</span>
%%[ IF @showForm == "true" THEN ]%%
        <span class="breadcrumb-current">%%=v(@builderPageLabel)=%%</span>
%%[ ELSE ]%%
        <span class="breadcrumb-current">%%=Concat(@builderPageLabel," • Result")=%%</span>
%%[ ENDIF ]%%
      </nav>
    </div>
%%[ IF @showForm == "true" THEN ]%%
    <div class="maker-page-heading">
      <div class="maker-page-heading-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 17h2v-5H3v5zm8 5h2V6h-2v16zM13 9h8V7h-8v2zM3 5v4h14V5H3zm8 14h10v-2H11v2zM13 17h8v-2h-8v2z"/></svg>
      </div>
      <div class="maker-page-heading-text">
        <h1 class="maker-page-title">Create Survey Journey</h1>
      </div>
    </div>
    <p class="maker-page-subtitle" id="surveyJourneySubtitle">Name the journey, choose survey and audience (Campaign or Data Extension entry), then preview the invitation email.</p>
    <div class="maker-form-shell">
   <div id="surveyJourneyStep1">
   <form method="post" action="" id="surveyJourneyStep1Form">
     <div class="question-card">
       <div class="question-header">
         <div class="question-number">1</div>
         <div class="question-text">Name</div>
       </div>
       <div class="form-group">
         <label class="form-label" for="journeyName">Journey name</label>
         <input type="text" class="textarea-control" name="journeyName" id="journeyName" value="%%=v(@journeyNameInput)=%%" placeholder="e.g. Q3 survey invitation" required maxlength="80">
       </div>
       <div class="question-header" style="margin-top: 24px;">
         <div class="question-number">2</div>
         <div class="question-text">Survey</div>
       </div>
       <div class="form-group">
         <label class="form-label" for="selectedSurveyId">Survey to send</label>
         <select class="select-control" id="selectedSurveyId" name="selectedSurveyId" required>
           <option value="">Select an active survey</option>
           %%=TreatAsContent(@surveyOptionsHtml)=%%
         </select>
%%[ IF @activeSurveyCount == 0 THEN ]%%
         <p class="form-alert" style="margin-top:10px;" role="alert">No active surveys in SST_SP_Surveys_Master_DE. Create a survey from Survey Home first.</p>
%%[ ENDIF ]%%
       </div>
       <div class="question-header" style="margin-top: 24px;">
         <div class="question-number">3</div>
         <div class="question-text">Target audience</div>
       </div>
       <div class="form-group">
         <label class="form-label" for="audienceSource">Audience source</label>
         <select id="audienceSource" class="select-control" name="audienceSource">
           <option value="campaign"%%[ IF @audienceSource != "dataextension" THEN ]%% selected%%[ ENDIF ]%%>Salesforce Campaign</option>
           <option value="dataextension"%%[ IF @audienceSource == "dataextension" THEN ]%% selected%%[ ENDIF ]%%>Data Extension</option>
         </select>
       </div>
       <div class="form-group campaign-id-group">
         <div class="question-text" id="audienceSourceLabel" style="font-size:0.9375rem;margin-bottom:8px;">%%[ IF @audienceSource == "dataextension" THEN ]%%Source Data Extension name%%[ ELSE ]%%Salesforce Campaign ID%%[ ENDIF ]%%</div>
         <div class="campaign-id-row" id="campaignSourceRow"%%[ IF @audienceSource == "dataextension" THEN ]%% style="display:none;"%%[ ENDIF ]%%>
           <input type="text" class="textarea-control" id="campaignId" name="campaignId" value="%%=v(@campaignId)=%%" placeholder="e.g. 701WL00000pFzUEYA0"%%[ IF @audienceSource == "dataextension" THEN ]%% disabled%%[ ELSE ]%% required%%[ ENDIF ]%%>
           <button type="submit" name="verifyCampaign" value="1" class="submit-button campaign-verify-btn" formnovalidate>Verify</button>
         </div>
         <div class="campaign-id-row" id="deSourceRow"%%[ IF @audienceSource != "dataextension" THEN ]%% style="display:none;"%%[ ENDIF ]%%>
           <input type="text" class="textarea-control" id="sourceDataExtension" name="sourceDataExtension" value="%%=v(@sourceDataExtension)=%%" placeholder="e.g. Audience_DE"%%[ IF @audienceSource == "dataextension" THEN ]%% required%%[ ELSE ]%% disabled%%[ ENDIF ]%%>
         </div>
%%[ IF @campaignVerifyShow == "1" AND @audienceSource != "dataextension" THEN ]%%
         <div class="campaign-verify-panel campaign-verify-panel--%%=v(@campaignVerifyStatus)=%%" role="status">
           <p class="campaign-verify-message">%%=v(@campaignVerifyMessage)=%%</p>
%%[ IF @campaignVerifyStatus == "used" THEN ]%%
           <ul class="campaign-verify-list">%%=TreatAsContent(@campaignVerifyListHtml)=%%</ul>
%%[ ENDIF ]%%
         </div>
%%[ ENDIF ]%%
      <div id="entryScheduleSection" class="schedule-section">
        <div class="question-header" style="margin-top: 16px;">
          <div class="question-number" aria-hidden="true" style="width:auto;height:auto;border:none;font-size:0.875rem;margin-right:8px;">—</div>
          <div class="question-text" style="font-size:1rem;">Entry schedule</div>
        </div>
        <p class="schedule-radio-hint" style="margin: 0 0 12px 58px;">Applies when a data extension is the entry source. Choose the schedule mode; finish timing in Journey Builder.</p>
        <div class="schedule-radio-group" style="margin-left: 58px;">
          <label class="schedule-radio-option">
            <input type="radio" name="entryScheduleType" value="runOnce" %%[ IF @entryScheduleType != "recurring" THEN ]%%checked%%[ ENDIF ]%%>
            <span class="schedule-radio-copy">
              <span class="schedule-radio-title">Run once</span>
              <span class="schedule-radio-hint">One-time entry schedule. Set On activation or a specific start in Journey Builder.</span>
            </span>
          </label>
          <label class="schedule-radio-option">
            <input type="radio" name="entryScheduleType" value="recurring" %%[ IF @entryScheduleType == "recurring" THEN ]%%checked%%[ ENDIF ]%%>
            <span class="schedule-radio-copy">
              <span class="schedule-radio-title">Recurring</span>
              <span class="schedule-radio-hint">Repeating entry schedule aligned with Journey Builder (Eastern Time).</span>
            </span>
          </label>
        </div>
        <div id="recurringScheduleFields" class="recurring-fields">
          <div class="form-group">
            <label for="entryScheduleRepeat">Repeat</label>
            <select class="textarea-control" name="entryScheduleRepeat" id="entryScheduleRepeat">
              <option value="hourly" %%[ IF @entryScheduleRepeat == "hourly" THEN ]%%selected%%[ ENDIF ]%%>Hourly</option>
              <option value="daily" %%[ IF @entryScheduleRepeat == "daily" THEN ]%%selected%%[ ENDIF ]%%>Daily</option>
              <option value="weekdays" %%[ IF @entryScheduleRepeat == "weekdays" THEN ]%%selected%%[ ENDIF ]%%>Weekdays</option>
              <option value="weekly" %%[ IF @entryScheduleRepeat == "weekly" THEN ]%%selected%%[ ENDIF ]%%>Weekly</option>
              <option value="monthly" %%[ IF @entryScheduleRepeat == "monthly" THEN ]%%selected%%[ ENDIF ]%%>Monthly</option>
              <option value="yearly" %%[ IF @entryScheduleRepeat == "yearly" THEN ]%%selected%%[ ENDIF ]%%>Yearly</option>
            </select>
          </div>
          <div class="form-group">
            <label for="entryScheduleInterval">Every</label>
            <input type="number" min="1" max="999" class="textarea-control" name="entryScheduleInterval" id="entryScheduleInterval" value="%%=v(@entryScheduleInterval)=%%">
          </div>
          <div id="weeklyDayPanel" class="schedule-weekday-panel">
            <label>On the selected days</label>
            <p class="schedule-eastern-note">Click the days contacts can enter the journey (weekly repeat).</p>
            <div class="schedule-weekday-row">
              <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="sun"> Sun</label>
              <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="mon"> Mon</label>
              <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="tue"> Tue</label>
              <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="wed"> Wed</label>
              <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="thu"> Thu</label>
              <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="fri"> Fri</label>
              <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="sat"> Sat</label>
            </div>
            <input type="hidden" name="entryScheduleWeekdays" id="entryScheduleWeekdays" value="%%=v(@entryScheduleWeekdays)=%%">
          </div>
          <div class="form-group">
            <label for="entryScheduleStart">Start date</label>
            <input type="date" class="textarea-control" name="entryScheduleStart" id="entryScheduleStart" value="%%=IIF(Length(@entryScheduleStart)>=10,Substring(@entryScheduleStart,1,10),@entryScheduleStart)=%%">
            <p class="schedule-eastern-note">Start time is always 12:00 AM in Eastern Time (US &amp; Canada).</p>
          </div>
          <div class="form-group">
            <span class="schedule-radio-title">End</span>
            <div class="schedule-end-group">
              <label class="schedule-end-option">
                <input type="radio" name="entryScheduleEnd" value="occurrences" %%[ IF @entryScheduleEnd != "endDate" AND @entryScheduleEnd != "never" THEN ]%%checked%%[ ENDIF ]%%>
                <span>After</span>
                <input type="number" min="1" max="9999" class="textarea-control schedule-end-inline" name="entryScheduleOccurrences" id="entryScheduleOccurrences" value="%%=v(@entryScheduleOccurrences)=%%">
                <span>occurrence(s)</span>
              </label>
              <label class="schedule-end-option">
                <input type="radio" name="entryScheduleEnd" value="endDate" %%[ IF @entryScheduleEnd == "endDate" THEN ]%%checked%%[ ENDIF ]%%>
                <span>On date</span>
                <input type="date" class="textarea-control schedule-end-inline schedule-end-date" name="entryScheduleEndDate" id="entryScheduleEndDate" value="%%=IIF(Length(@entryScheduleEndDate)>=10,Substring(@entryScheduleEndDate,1,10),@entryScheduleEndDate)=%%">
              </label>
              <label class="schedule-end-option">
                <input type="radio" name="entryScheduleEnd" value="never" %%[ IF @entryScheduleEnd == "never" THEN ]%%checked%%[ ENDIF ]%%>
                <span>Never</span>
              </label>
            </div>
            <p class="schedule-eastern-note">On date uses 11:59 PM Eastern Time on the selected day. Never uses a far-future end date (Journey Builder equivalent).</p>
          </div>
          <div class="form-group">
            <span class="schedule-radio-title">Contact evaluation</span>
            <div class="schedule-radio-group" style="margin-top: 8px;">
              <label class="schedule-radio-option">
                <input type="radio" name="entryContactEvaluation" value="newOnly" %%[ IF @entryContactEvaluation != "all" THEN ]%%checked%%[ ENDIF ]%%>
                <span class="schedule-radio-copy">
                  <span class="schedule-radio-title">Evaluate new records only</span>
                  <span class="schedule-radio-hint">Typical when new rows are appended without overwriting existing rows.</span>
                </span>
              </label>
              <label class="schedule-radio-option">
                <input type="radio" name="entryContactEvaluation" value="all" %%[ IF @entryContactEvaluation == "all" THEN ]%%checked%%[ ENDIF ]%%>
                <span class="schedule-radio-copy">
                  <span class="schedule-radio-title">Evaluate all records</span>
                  <span class="schedule-radio-hint">Re-evaluates the full data extension on each run (slower).</span>
                </span>
              </label>
            </div>
          </div>
        </div>
       </div>
       <div class="question-header" style="margin-top: 24px;">
         <div class="question-number">4</div>
         <div class="question-text">Sender Configurations</div>
       </div>
       <div class="sender-settings-panel" id="senderSettingsPanel">
         <button type="button" class="sender-settings-toggle" id="senderSettingsToggle" aria-expanded="false" aria-controls="senderSettingsBody">
           <span>Sender profile and send classification</span>
           <svg class="sender-settings-chevron" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>
         </button>
         <div class="sender-settings-body" id="senderSettingsBody">
           <div class="form-group">
%%[ IF @senderProfileConfigOk == "true" THEN ]%%
             <select id="senderProfileId" class="select-control" name="senderProfileId">
               %%=TreatAsContent(@senderProfileOptionsHtml)=%%
             </select>
%%[ ELSE ]%%
             <div class="maker-alert" role="alert">Could not load sender profiles from Marketing Cloud.</div>
%%[ ENDIF ]%%
           </div>
           <div class="form-group">
%%[ IF @sendClassificationConfigOk == "true" THEN ]%%
             <select id="sendClassificationId" class="select-control" name="sendClassificationId">
               %%=TreatAsContent(@sendClassificationOptionsHtml)=%%
             </select>
%%[ ELSE ]%%
             <div class="maker-alert" role="alert">Could not load send classifications from Marketing Cloud.</div>
%%[ ENDIF ]%%
           </div>
