   '<a href="' + escapeHtml(surveyUrl) + '" target="_blank" style="color:#FFFFFF;text-decoration:none;"><font color="#FFFFFF">Take Survey</font></a></td></tr></table>';
  var feedbackHtml =
   'Your feedback is important - it helps us measure the effectiveness of our courses and identify ways to improve future offerings.<br><br>' +
   'If you have any questions about this course, the evaluation, or our programs, feel free to contact us:<br><br>' +
   'Call: 800-282-4882<br>' +
   'Email: questions@magmutual.com<br><br>';
  var year = new Date().getFullYear();
  return [
   '<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">' +
   '<style>body{margin:0;padding:0;background:#EFEFEF;}table{border-collapse:collapse;}a{color:#808080;text-decoration:none;}</style></head>',
