.schedule-weekday-chip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.8125rem; cursor: pointer; }
.schedule-weekday-chip input { margin: 0; }
.schedule-weekday-panel { display: none; margin-top: 12px; }
.schedule-weekday-panel.is-visible { display: block; }
.schedule-eastern-note { font-size: 0.8125rem; color: var(--text-secondary); margin: 6px 0 0; }
.schedule-end-group { display: flex; flex-direction: column; gap: 10px; margin-top: 8px; }
.schedule-end-option { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; }
.schedule-end-option input[type="radio"] { margin: 0; }
.schedule-end-inline { width: auto; max-width: 120px; padding: 8px 10px; }
.schedule-end-date { max-width: 180px; }
.select-control, .textarea-control { width: 100%; padding: 12px 16px; border: 1px solid var(--border-color); border-radius: 0px); font-size: 1rem; background: var(--bg-primary); transition: all 0.2s ease; font-family: inherit; }
textarea.textarea-control { min-height: 88px; resize: vertical; }
.select-control:focus, .textarea-control:focus { outline: none; border-color: var(--primary-color); box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1); }
.question-card .sender-settings-panel { margin-bottom: 8px; }
.sender-settings-body .sender-template-group { margin-top: 20px; }
.sender-settings-body .sender-template-group .question-text { margin-bottom: 12px; }
.sender-settings-body .email-cards { margin-bottom: 0; }
.submit-section { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border-color); }
.submit-button { background: #0e0e1d; color: white; border: none; padding: 16px 32px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
.submit-button:hover { background: var(--primary-dark); transform: translateY(-1px); box-shadow: var(--shadow-md); }
.submit-button:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
.spinner { border: 2px solid rgba(255,255,255,0.3); border-top: 2px solid white; border-radius: 50%; width: 20px; height: 20px; animation: spin 1s linear infinite; display: inline-block; margin-left: 8px; vertical-align: middle; }
.email-cards { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
.email-card {
  flex: 1;
  min-width: 180px;
  max-width: 280px;
  position: relative;
  border: 1px solid var(--border-color);
  cursor: pointer;
  transition: all 0.2s ease;
  background: var(--bg-secondary);
  text-align: left;
  overflow: hidden;
  display: block;
  box-sizing: border-box;
  padding: 0;
}
.email-card:hover { border-color: var(--primary-color); box-shadow: var(--shadow-md); }
.email-card.selected { border: 2px solid #53575a; }
.email-card input { display: none; }
.email-card-img {
  width: 100%;
  height: auto;
  display: block;
}
.email-card-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 22px;
  padding: 0 10px;
  font-size: 0.8125rem;
  font-weight: 700;
  color: #484848;
  line-height: 1.2;
  z-index: 2;
}
.email-card-id {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6px;
  padding: 0 10px;
  font-size: 0.6875rem;
  color: #363232eb;
  z-index: 2;
}
.email-card::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 156px;
  background: linear-gradient(to top, rgb(255 255 255), #fcfeff);
  pointer-events: none;
  z-index: 1;
}
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    /* Form Container */
    .form-container {
          background: var(--bg-primary);
    border-radius: 12px;
    padding: 32px;
    /* box-shadow: var(--shadow-md); */
    margin-bottom: 32px;
    border: 1px solid #e5e7eb;
      margin-top: 20px;
