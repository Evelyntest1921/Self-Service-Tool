  var invitePreviewEl = document.getElementById('step2InvitationPreview');
  var previewSubject = document.getElementById('previewSubject');
  var previewPreheader = document.getElementById('previewPreheader');
  var previewFrame = document.getElementById('previewFrame');
  var hiddenBody = document.getElementById('step2EmailBodyText');
  var surveyId = surveyIdField ? surveyIdField.value.trim() : '';
  var masterSurveyName = surveyNameEl ? surveyNameEl.value.trim() : '';
  var emailHeadline = headlineEl && headlineEl.value.trim() ? headlineEl.value.trim() : masterSurveyName;
  var linkSurveyName = subsetEl && subsetEl.value.trim() ? subsetEl.value.trim() : masterSurveyName;
  var takeBase = takeUrlEl ? takeUrlEl.value.trim() : '';
  var signatureChoice = signatureEl ? signatureEl.value : 'none';
  var state = {
   subject: subjectEl ? subjectEl.value.trim() : '',
   preheader: preheaderEl ? preheaderEl.value.trim() : '',
   body: bodyEl ? bodyEl.value : '',
   surveyId: surveyId,
   surveyName: masterSurveyName,
   emailHeadline: emailHeadline,
   linkSurveyName: linkSurveyName,
   takeBase: takeBase,
   signatureChoice: signatureChoice,
   greeting: buildSurveyPreviewGreeting()
