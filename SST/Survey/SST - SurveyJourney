<script>
(function(){
 function escapeHtml(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
 }
 function textToHtml(text) {
  return escapeHtml(text).replace(/\r\n|\r|\n/g, '<br>');
 }
 function formatSurveyHeaderText(surveyName) {
  var name = String(surveyName || '').trim();
  if (!name) return 'Survey';
  var words = name.split(/\s+/).filter(function(w) { return w.length; });
  var limited = words.slice(0, 10).join(' ');
  if (words.length < 2) return 'Survey: ' + limited;
  return limited;
 }
 function buildInvitationPreviewUrl(takeBase, surveyId, surveyName) {
  var base = String(takeBase || 'https://cloud.go.magmutual.com/MH1Fdf3gkpiWmvpt').replace(/\/$/, '');
  var pct = String.fromCharCode(37);
  var contactMerge = pct + pct + '=_subscriberkey=' + pct + pct;
  return base + '?id=' + encodeURIComponent(surveyId || '') + '&contact=' + contactMerge + '&surveyName=' + encodeURIComponent(surveyName || '');
 }
 var previewFontStack = "'IBM Plex Sans', Arial, Helvetica, sans-serif";
 var surveyPreviewSample = {
  contactsalutation: 'Dr.',
  contactfirstname: 'Amara',
  sendfromName: 'Alex Morgan',
  senderTitle: 'Regional Underwriter',
  sendFromEmail: 'alex.morgan@magmutual.com',
  signaturePhone: '(404) 555-0192',
  senderLicense: 'LU-284719'
 };
 function previewSpacerRow(height) {
  return '<tr><td align="center" height="' + height + '" style="line-height:0;font-size:' + height + 'px;height:' + height + 'px;"><img src="https://image.go.magmutual.com/lib/fe2f11747364047d731d72/m/1/spacer.gif" width="1" height="' + height + '" alt="" border="0" style="display:block;" /></td></tr>';
 }
 function buildSurveyPreviewGreeting() {
  var p = surveyPreviewSample;
  if (p.contactsalutation && p.contactfirstname) {
   return 'Hello, ' + p.contactsalutation + ' ' + p.contactfirstname + ',';
  }
  return 'Hello,';
 }
 function buildSurveyPreviewSignatureHtml(choice) {
  if (!choice || choice === 'none') {
   return '';
  }
  var sender = surveyPreviewSample;
  var chunks = [
   '<p style="font-family: ' + previewFontStack + '; font-size:14px; color:#161616; line-height:20px; padding:0;">',
   'Best regards,<br /><br />',
   '<span style="font-style:italic; font-family: serif; font-size:20px;">' + escapeHtml(sender.sendfromName) + '</span><br />',
   escapeHtml(sender.senderTitle) + '<br />',
   'MagMutual Insurance<br />',
   escapeHtml(sender.sendFromEmail) + '<br />',
   escapeHtml(sender.signaturePhone) + '<br />',
   escapeHtml(sender.senderLicense),
   '</p>'
  ];
  if (choice === 'dm') {
   chunks.splice(1, 0, '<span style="font-size:12px;color:#6b7280;">Distributed Marketing signature (preview sample)</span><br /><br />');
  }
  return chunks.join('');
 }
 function renderSurveyPreview(state) {
  var headlineFormatted = escapeHtml(formatSurveyHeaderText(state.emailHeadline || state.surveyName || ''));
  var greeting = escapeHtml(state.greeting || buildSurveyPreviewGreeting());
