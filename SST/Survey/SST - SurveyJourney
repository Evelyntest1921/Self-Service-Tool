 function padLocal(n) { return n < 10 ? '0' + n : String(n); }
 function futureDateString(daysAhead) {
  var d = new Date();
  d.setDate(d.getDate() + daysAhead);
  return d.getFullYear() + '-' + padLocal(d.getMonth() + 1) + '-' + padLocal(d.getDate());
 }
 function syncWeekdayHidden() {
  if (!weekdayHidden) return;
  var parts = [];
  for (var i = 0; i < weekdayChecks.length; i++) {
   if (weekdayChecks[i].checked) parts.push(weekdayChecks[i].value);
  }
  weekdayHidden.value = parts.join(',');
 }
 function loadWeekdayChecksFromHidden() {
  if (!weekdayHidden || !weekdayHidden.value) return;
  var set = {};
  var tokens = String(weekdayHidden.value).toLowerCase().split(/[,;\s]+/);
  for (var t = 0; t < tokens.length; t++) { if (tokens[t]) set[tokens[t]] = true; }
  for (var i = 0; i < weekdayChecks.length; i++) {
   weekdayChecks[i].checked = !!set[weekdayChecks[i].value];
  }
 }
 function selectedEndMode() {
  for (var e = 0; e < endRadios.length; e++) {
   if (endRadios[e].checked) return endRadios[e].value;
  }
  return 'occurrences';
 }
 function addYearsToDateKey(dateKey, years) {
  if (!dateKey || dateKey.length < 10) return futureDateString(365);
  var parts = dateKey.split('-');
  return (parseInt(parts[0], 10) + years) + '-' + parts[1] + '-' + parts[2];
 }
 function syncEndInputsUi() {
  var mode = selectedEndMode();
  if (occurInput) occurInput.disabled = mode !== 'occurrences';
  if (endDateInput) {
   endDateInput.disabled = mode !== 'endDate';
   if (mode === 'endDate' && !endDateInput.value) {
    var startInput = document.getElementById('entryScheduleStart');
    var base = startInput && startInput.value ? startInput.value : futureDateString(2);
    endDateInput.value = addYearsToDateKey(base, 1);
    endDateInput.min = base;
   }
  }
 }
 function syncEntryScheduleUi() {
  var audienceMode = (document.getElementById('audienceSource') || {}).value;
  var hasDe = audienceMode === 'dataextension' && entryDeInput && String(entryDeInput.value || '').replace(/^\s+|\s+$/g, '').length > 0;
  if (scheduleSection) scheduleSection.classList.toggle('is-visible', !!hasDe);
  var recurringSelected = false;
  for (var i = 0; i < scheduleRadios.length; i++) {
   if (scheduleRadios[i].checked && scheduleRadios[i].value === 'recurring') recurringSelected = true;
  }
  if (recurringFields) recurringFields.classList.toggle('is-visible', !!hasDe && recurringSelected);
  var weeklySelected = repeatSelect && repeatSelect.value === 'weekly';
  if (weeklyDayPanel) weeklyDayPanel.classList.toggle('is-visible', !!hasDe && recurringSelected && weeklySelected);
  var startInput = document.getElementById('entryScheduleStart');
  if (startInput) {
   var minDate = futureDateString(2);
