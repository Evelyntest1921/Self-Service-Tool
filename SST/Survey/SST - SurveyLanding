    <div class="surveys-grid" id="surveysGrid">
      %%[ IF @dataExists == "false" THEN ]%%
      %%[
        VAR @rows, @rowCount, @i, @row, @name, @id, @status, @created, @responseCount, @surveyAnalyticsLink
        VAR @progLabelClass, @progFillClass, @progLabel, @progWidthPct
        SET @rowCount = 3
        FOR @i = 1 TO @rowCount DO
          IF @i == 1 THEN
            SET @name = "Risk Management Training Q4 2024"
            SET @id = "DEMO001"
            SET @status = "Active"
            SET @created = "2024-01-15"
            SET @responseCount = 47
          ELSEIF @i == 2 THEN
            SET @name = "Annual Safety Assessment"
            SET @id = "DEMO002"
            SET @status = "Completed"
            SET @created = "2024-01-10"
            SET @responseCount = 89
          ELSE
            SET @name = "Quarterly Compliance Review"
            SET @id = "DEMO003"
            SET @status = "Draft"
            SET @created = "2024-01-05"
            SET @responseCount = 11
          ENDIF
          SET @surveyAnalyticsLink = ""
          IF NOT Empty(@surveyAnalyticsUrl) AND NOT Empty(@id) THEN
            SET @surveyAnalyticsLink = Concat(@surveyAnalyticsUrl, "?surveyid=", @id)
          ENDIF
          IF @status == "Draft" THEN
            SET @progLabelClass = "progress-percentage--draft"
            SET @progFillClass = "progress-fill--draft"
            SET @progLabel = "Draft"
          ELSEIF @status == "Completed" THEN
            SET @progLabelClass = "progress-percentage--ready"
            SET @progFillClass = "progress-fill--ready"
            SET @progLabel = "Completed"
          ELSE
            SET @progLabelClass = "progress-percentage--running"
            SET @progFillClass = "progress-fill--running"
            SET @progLabel = "Active"
          ENDIF
          IF @responseCount > 100 THEN
            SET @progWidthPct = "100%"
          ELSEIF @responseCount > 0 THEN
            SET @progWidthPct = Concat(@responseCount, "%")
          ELSE
            SET @progWidthPct = "0%"
          ENDIF
      ]%%
      <div class="survey-card">
        <div class="survey-header">
          <div class="survey-icon">
           📋
          </div>
          <div class="survey-status status-%%=v(@status)=%%">%%=v(@status)=%%</div>
        </div>
        <h3 class="survey-title">%%=v(@name)=%%</h3>
        <div class="survey-meta">
          <span class="survey-id">ID: %%=v(@id)=%%</span>
          <span class="survey-date">%%=v(@created)=%%</span>
        </div>
        <div class="survey-progress">
          <div class="progress-info">
            <span class="progress-percentage %%=v(@progLabelClass)=%%">%%=v(@progLabel)=%%</span>
            <span class="progress-sent-count">%%=v(@responseCount)=%% opens</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill %%=v(@progFillClass)=%%" style="width: %%=v(@progWidthPct)=%%;"></div>
          </div>
        </div>
        <div class="survey-actions">
          %%[ IF NOT Empty(@surveyAnalyticsLink) THEN ]%%
          <a href="%%=v(@surveyAnalyticsLink)=%%" class="btn-secondary">Manage Survey</a>
          %%[ ELSE ]%%
          <span class="btn-secondary" style="opacity: 0.5; cursor: not-allowed;">Manage Survey</span>
          %%[ ENDIF ]%%
        </div>
      </div>
