%%[ 
VAR @errorFlag, @dataExists, @testCount
VAR @surveysGridOk, @jaSurveysMarkup, @jaSurveysEmpty, @jaSurveysLoadError, @surveysPage, @jaSurveysPagination
VAR @hubUrl, @journeyExitUrl, @calendarUrl, @surveyHomeUrl, @surveyAnalyticsUrl, @environment, @environmentSwitchUrl
VAR @envDisplayName, @envDisplayEmail, @envAvatarLetter, @envSwitchLabel
VAR @navRows, @navRow, @surveyUrlRows, @surveyUrlRow
SET @errorFlag = "false"
SET @dataExists = "true"
SET @surveysGridOk = "false"
SET @jaSurveysMarkup = ""
SET @jaSurveysEmpty = "1"
SET @jaSurveysLoadError = ""
SET @surveysPage = "1"
SET @jaSurveysPagination = ""
SET @redirect = requestparameter("redirect")
SET @surveysPage = Trim(RequestParameter("surveysPage"))
IF Empty(@surveysPage) THEN
  SET @surveysPage = "1"
ENDIF
SET @hubUrl = "#"
SET @journeyExitUrl = ""
SET @calendarUrl = ""
SET @surveyHomeUrl = ""
SET @surveyAnalyticsUrl = ""
SET @environment = ""
SET @environmentSwitchUrl = ""
SET @envDisplayName = ""
SET @envDisplayEmail = ""
SET @envAvatarLetter = ""
SET @envSwitchLabel = ""
SET @navRows = LookupRows("bd_sst_page_navigation","type","cloudpage")
IF RowCount(@navRows) > 0 THEN
  SET @navRow = Row(@navRows,1)
  SET @hubUrl = Field(@navRow,"ss_home")
  SET @journeyExitUrl = Trim(Field(@navRow,"ss_journey_exit"))
  SET @calendarUrl = Trim(Field(@navRow,"ss_email_calendar"))
  SET @surveyHomeUrl = Trim(Field(@navRow,"ss_survey_home"))
  SET @environment = Trim(Lowercase(Field(@navRow,"environment")))
  SET @environmentSwitchUrl = Trim(Field(@navRow,"environment_switch"))
ENDIF
SET @surveyUrlRows = LookupRows("SST_SP_Survey_Url_DE","user","admin")
IF RowCount(@surveyUrlRows) > 0 THEN
  SET @surveyUrlRow = Row(@surveyUrlRows,1)
  SET @surveyAnalyticsUrl = Trim(Field(@surveyUrlRow,"Analytics"))
  IF Empty(@surveyAnalyticsUrl) THEN
    SET @surveyAnalyticsUrl = Trim(Field(@surveyUrlRow,"analytics"))
  ENDIF
  IF Empty(@surveyHomeUrl) THEN
    SET @surveyHomeUrl = Trim(Field(@surveyUrlRow,"dashboard"))
  ENDIF
ENDIF
IF @environment == "uat" THEN
  SET @envDisplayName = "UAT"
  SET @envDisplayEmail = "@magmutual.com"
  SET @envAvatarLetter = "U"
  SET @envSwitchLabel = "Switch to production environment"
ELSEIF @environment == "prod" THEN
  SET @envDisplayName = "PROD"
  SET @envDisplayEmail = "@magmutual.com"
  SET @envAvatarLetter = "P"
  SET @envSwitchLabel = "Switch to UAT environment"
ENDIF

IF @redirect == "true" THEN
  IF NOT Empty(@surveyHomeUrl) THEN
    Redirect(@surveyHomeUrl)
  ELSE
    Redirect("https://cloud.go.magmutual.com/survey-home")
  ENDIF
ENDIF
SET @testCount = LookupRows("SST_SP_Surveys_Master_DE", "SurveyStatus", "Active")
SET @testCount = RowCount(@testCount)
IF @testCount > 0 THEN
  SET @dataExists = "true"
ELSE
  SET @dataExists = "false"
ENDIF

]%%
<script runat="server" language="javascript">
  Platform.Load("Core", "1.1");
  var SURVEYS_DE = "SST_SP_Surveys_Master_DE";
  var RESPONSES_DE = "SST_SP_Survey_Responses_DE";
  var SURVEY_PAGE_SIZE = 20;
  function parseSurveyPage(val) {
    var page = parseInt(String(val || "1"), 10);
    if (isNaN(page) || page < 1) {
      return 1;
    }
    return page;
  }
  function surveyHomeUrlWithPage(homeUrl, page) {
    var base = String(homeUrl || "");
    if (!base) {
      return "?surveysPage=" + page;
    }
    if (base.indexOf("?") >= 0) {
      return base + "&surveysPage=" + page;
    }
    return base + "?surveysPage=" + page;
  }
  function renderSurveysPagination(homeUrl, page, totalPages, totalCount) {
    if (totalPages <= 1) {
      return "";
    }
    var parts = [
      '<div class="browse-pagination">' +
      '<div class="browse-pagination-inner">'
    ];
    if (page > 1) {
      parts.push(
        '<a href="' +
        esc(surveyHomeUrlWithPage(homeUrl, page - 1)) +
        '" class="filter-btn">Previous</a>'
      );
    } else {
      parts.push('<span class="filter-btn browse-page-disabled">Previous</span>');
    }
    parts.push(
      '<span class="browse-page-label">Page ' +
      page +
      " of " +
      totalPages +
      " (" +
      totalCount +
      " surveys)</span>"
    );
    if (page < totalPages) {
      parts.push(
        '<a href="' +
        esc(surveyHomeUrlWithPage(homeUrl, page + 1)) +
        '" class="filter-btn">Next</a>'
      );
    } else {
      parts.push('<span class="filter-btn browse-page-disabled">Next</span>');
    }
    parts.push("</div></div>");
    return parts.join("");
  }
  function setV(key, val) {
    var s = val == null ? "" : String(val);
    try {
      Platform.Variable.SetValue(key, s);
    } catch (e0) {}
    try {
      Platform.Variable.SetValue("@" + key, s);
    } catch (e1) {}
  }
  function getAmpVar(name) {
    var v = "";
    try {
      v = Platform.Variable.GetValue("@" + name);
    } catch (e0) {}
    if (v === null || v === undefined || String(v) === "") {
      try {
        v = Variable.GetValue(name);
      } catch (e1) {}
    }
    if (v === null || v === undefined) {
      return "";
    }
    return String(v);
  }
  function esc(s) {
    if (s == null || s === undefined) {
      return "";
    }
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/"/g, "&quot;");
  }
  function lenArrayish(x) {
    if (x == null) {
      return -1;
    }
    if (typeof x.length === "number") {
      return x.length;
    }
    return -1;
  }
  function coerceRows(raw) {
    if (raw == null) {
      return [];
    }
    var r = raw;
    if (r.Results && typeof r.Results.length === "number") {
      r = r.Results;
    }
    var n = lenArrayish(r);
    if (n < 0) {
      return [];
    }
    var out = [];
    var i;
    for (i = 0; i < n; i++) {
      out.push(r[i]);
    }
    return out;
  }
  function fieldFromPropertyList(props, names) {
    var pi, i, pname, v;
    if (!props || typeof props.length !== "number") {
      return "";
    }
    for (pi = 0; pi < props.length; pi++) {
      pname = props[pi].Name != null ? props[pi].Name : props[pi].name;
      if (!pname) {
        continue;
      }
      for (i = 0; i < names.length; i++) {
        if (String(pname).toLowerCase() === String(names[i]).toLowerCase()) {
          v = props[pi].Value != null ? props[pi].Value : props[pi].value;
          if (v !== null && v !== undefined && v !== "") {
            return v;
          }
        }
      }
    }
    return "";
  }
  function fieldFromRow(r, names) {
    var i, n, v;
    if (r == null) {
      return "";
    }
    for (i = 0; i < names.length; i++) {
      n = names[i];
      v = null;
      try {
        v = Platform.Function.Field(r, n);
      } catch (fe0) {}
      if (v === null || v === undefined || v === "") {
        try {
          v = r[n];
        } catch (fe1) {}
      }
      if (v !== null && v !== undefined && v !== "") {
        return v;
      }
    }
    v = fieldFromPropertyList(r.Properties, names);
    if (v !== "") {
      return v;
    }
    v = fieldFromPropertyList(r.Property, names);
    if (v !== "") {
      return v;
    }
    return "";
  }
  function coerceDeRows(raw) {
    if (raw == null) {
      return [];
    }
    var r = raw;
    if (r.Results && typeof r.Results.length === "number") {
      r = r.Results;
    }
    if (r.rows && typeof r.rows.length === "number") {
      r = r.rows;
    }
    if (r.Rows && typeof r.Rows.length === "number") {
      r = r.Rows;
    }
    var out = coerceRows(r);
    if (out.length) {
      return out;
    }
    if (r && typeof r === "object" && fieldFromRow(r, ["SurveyID", "SurveyId", "SurveyName"])) {
      return [r];
    }
    return [];
  }
  function loadSurveyMasterRows() {
    var rows = [];
    try {
      rows = coerceDeRows(DataExtension.Init(SURVEYS_DE).Rows.Retrieve());
    } catch (deEx) {}
    if (rows.length) {
      return rows;
    }
    var statuses = ["Active", "Completed", "Draft"];
    var seen = {};
    var out = [];
    var si, st, chunk, ci, row, sidKey;
    for (si = 0; si < statuses.length; si++) {
      st = statuses[si];
      chunk = [];
      try {
        chunk = coerceRows(Platform.Function.LookupRows(SURVEYS_DE, "SurveyStatus", st));
      } catch (lookupEx) {}
      for (ci = 0; ci < chunk.length; ci++) {
        row = chunk[ci];
        sidKey = String(fieldFromRow(row, ["SurveyID", "SurveyId"])).toLowerCase();
        if (sidKey && !seen[sidKey]) {
          seen[sidKey] = true;
          out.push(row);
        }
      }
    }
    if (out.length) {
      return out;
    }
    try {
      return coerceRows(
        Platform.Function.LookupOrderedRows(
          SURVEYS_DE,
          500,
          "SurveyCreatedDate DESC",
          "SurveyStatus",
          "Active"
        )
      );
    } catch (orderedEx) {}
    return [];
  }
  function msFromSurveyRow(r) {
    var raw = fieldFromRow(r, ["SurveyCreatedDate", "surveyCreatedDate"]);
    if (raw === "") {
      return 0;
    }
    try {
      var t = new Date(String(raw)).getTime();
      if (!isNaN(t) && t > 0) {
        return t;
      }
    } catch (dateEx) {}
    return 0;
  }
  function sortRowsBySurveyCreatedDate(rows) {
    var i, j, tmp, mi, mj, idi, idj;
    for (i = 0; i < rows.length; i++) {
      for (j = i + 1; j < rows.length; j++) {
        mi = msFromSurveyRow(rows[i]);
        mj = msFromSurveyRow(rows[j]);
        if (mj > mi) {
          tmp = rows[i];
          rows[i] = rows[j];
          rows[j] = tmp;
        } else if (mj === mi) {
          idi = String(fieldFromRow(rows[i], ["SurveyID", "SurveyId"]));
          idj = String(fieldFromRow(rows[j], ["SurveyID", "SurveyId"]));
          if (idj > idi) {
            tmp = rows[i];
            rows[i] = rows[j];
            rows[j] = tmp;
          }
        }
      }
    }
    return rows;
  }
  function loadOpenCountsBySurveyId() {
    var map = {};
    var respRows, ri, rid, qid;
    try {
      respRows = coerceDeRows(DataExtension.Init(RESPONSES_DE).Rows.Retrieve());
      for (ri = 0; ri < respRows.length; ri++) {
        qid = String(fieldFromRow(respRows[ri], ["QuestionID", "QuestionId"]));
        if (qid !== "SURVEY_OPEN") {
          continue;
        }
        rid = String(fieldFromRow(respRows[ri], ["SurveyID", "SurveyId"]));
        if (!rid) {
          continue;
        }
        map[rid] = (map[rid] || 0) + 1;
      }
    } catch (openEx) {}
    return map;
  }
  function surveyProgress(statusRaw, openCount) {
    var status, labelClass, fillClass, label, width;
    status = String(statusRaw == null ? "" : statusRaw).replace(/^\s+|\s+$/g, "");
    if (status === "Draft") {
      labelClass = "progress-percentage--draft";
      fillClass = "progress-fill--draft";
      label = "Draft";
    } else if (status === "Completed") {
      labelClass = "progress-percentage--ready";
      fillClass = "progress-fill--ready";
      label = "Completed";
    } else {
      labelClass = "progress-percentage--running";
      fillClass = "progress-fill--running";
      label = "Active";
    }
    if (openCount > 100) {
      width = "100%";
    } else if (openCount > 0) {
      width = String(openCount) + "%";
    } else {
      width = "0%";
    }
    return {
      labelClass: labelClass,
      fillClass: fillClass,
      label: label,
      width: width
    };
  }
  function formatSurveyCreated(r) {
    var raw = fieldFromRow(r, ["SurveyCreatedDate", "surveyCreatedDate"]);
    if (raw === "") {
      return "";
    }
    try {
      var formatted = Platform.Function.FormatDate(raw, "M/d/yyyy h:mm:ss a");
      if (formatted !== null && formatted !== undefined && String(formatted) !== "") {
        return String(formatted);
      }
    } catch (fmtEx) {}
    return String(raw);
  }
  if (getAmpVar("dataExists") !== "false") {
    try {
      var analyticsBase = getAmpVar("surveyAnalyticsUrl");
      var surveyHomeUrl = getAmpVar("surveyHomeUrl");
      var surveysPage = parseSurveyPage(getAmpVar("surveysPage"));
      if (!surveysPage || surveysPage === 1) {
        try {
          surveysPage = parseSurveyPage(Request.GetQueryStringParameter("surveysPage"));
        } catch (surveysPageEx) {}
      }
      var surveyRows = loadSurveyMasterRows();
      sortRowsBySurveyCreatedDate(surveyRows);
      var openCounts = loadOpenCountsBySurveyId();
      var rowCount = surveyRows.length;
      var totalPages = rowCount > 0 ? Math.ceil(rowCount / SURVEY_PAGE_SIZE) : 1;
      if (surveysPage > totalPages) {
        surveysPage = totalPages;
      }
      if (surveysPage < 1) {
        surveysPage = 1;
      }
      setV("surveysPage", String(surveysPage));
      if (!rowCount) {
        setV("surveysGridOk", "true");
        setV("jaSurveysEmpty", "1");
        setV("jaSurveysMarkup", "");
        setV("jaSurveysLoadError", "");
        setV("jaSurveysPagination", "");
      } else {
        var startIdx = (surveysPage - 1) * SURVEY_PAGE_SIZE;
        var endIdx = surveysPage * SURVEY_PAGE_SIZE;
        if (endIdx > rowCount) {
          endIdx = rowCount;
        }
        var parts = [];
        var si, sr, nm, sid, st, created, opens, prog, linkHref, actionHtml;
        for (si = startIdx; si < endIdx; si++) {
          sr = surveyRows[si];
          nm = String(fieldFromRow(sr, ["SurveyName", "surveyName"]));
          if (!nm) {
            nm = "Untitled survey";
          }
          sid = String(fieldFromRow(sr, ["SurveyID", "SurveyId"]));
          st = String(fieldFromRow(sr, ["SurveyStatus", "surveyStatus"]));
          if (!st) {
            st = "Active";
          }
          created = formatSurveyCreated(sr);
          opens = sid && openCounts[sid] ? openCounts[sid] : 0;
          prog = surveyProgress(st, opens);
          linkHref = "";
          if (analyticsBase && sid) {
            linkHref = analyticsBase + "?surveyid=" + encodeURIComponent(sid);
          }
          if (linkHref) {
            actionHtml =
              '<a href="' + esc(linkHref) + '" class="btn-secondary">Manage Survey</a>';
          } else {
            actionHtml =
              '<span class="btn-secondary" style="opacity: 0.5; cursor: not-allowed;">Manage Survey</span>';
          }
          parts.push(
            '<div class="survey-card">' +
            '<div class="survey-header">' +
            '<div class="survey-icon">📋</div>' +
            '<div class="survey-status status-' + esc(st) + '">' + esc(st) + "</div>" +
            "</div>" +
            '<h3 class="survey-title">' + esc(nm) + "</h3>" +
            '<div class="survey-meta">' +
            '<span class="survey-id">ID: ' + esc(sid) + "</span>" +
            '<span class="survey-date">' + esc(created) + "</span>" +
            "</div>" +
            '<div class="survey-progress">' +
            '<div class="progress-info">' +
            '<span class="progress-percentage ' + prog.labelClass + '">' + esc(prog.label) + "</span>" +
            '<span class="progress-sent-count">' + esc(String(opens)) + " opens</span>" +
            "</div>" +
            '<div class="progress-bar">' +
            '<div class="progress-fill ' + prog.fillClass + '" style="width:' + esc(prog.width) + ';"></div>' +
            "</div>" +
            "</div>" +
            '<div class="survey-actions">' + actionHtml + "</div>" +
            "</div>"
          );
        }
        setV("jaSurveysMarkup", parts.join(""));
        setV("jaSurveysEmpty", "0");
        setV("surveysGridOk", "true");
        setV("jaSurveysLoadError", "");
        setV(
          "jaSurveysPagination",
          renderSurveysPagination(surveyHomeUrl, surveysPage, totalPages, rowCount)
        );
      }
    } catch (gridLoadEx) {
      var errMsg = "Could not load surveys.";
      try {
        errMsg =
          gridLoadEx.message != null && gridLoadEx.message !== ""
            ? String(gridLoadEx.message)
            : String(gridLoadEx);
        if (errMsg.length > 400) {
          errMsg = errMsg.substring(0, 400);
        }
      } catch (err2) {}
      setV("jaSurveysLoadError", errMsg);
      setV("surveysGridOk", "false");
      setV("jaSurveysEmpty", "1");
      setV("jaSurveysMarkup", "");
      setV("jaSurveysPagination", "");
    }
  }
</script>

<title>Survey home | Self Service</title>
<link rel="icon" href="https://www.magmutual.com/_next/image?url=%2Fmagmutual-egg.svg&w=640&q=75" type="image/png">
%%[ SET @activeNav = "survey_home" ]%%
<div class="dashboard-layout">
  %%=ContentBlockByKey("sst_shell_sidebar")=%%
  <main class="main-content is-page-loading">
    <div class="sst-page-loading-panel" id="sstPageLoadingPanel" aria-live="polite">
      <div class="sst-page-loading-spinner" aria-hidden="true"></div>
      <p class="sst-page-loading-title">Loading survey</p>
      <p class="sst-page-loading-sub">Fetching surveys and analytics. This may take a moment.</p>
    </div>
    %%[ IF @dataExists == "false" THEN ]%%
    <div class="demo-notice">
      <div class="demo-icon">🔧</div>
      <div class="demo-content">
        <strong>Test Mode:</strong> Data extensions are not accessible. Showing sample data for Testing.
        <br><span style="font-size: 12px; opacity: 0.8;">
          Check that SST_SP_Surveys_Master_DE, SST_SP_Survey_Responses_DE, and SST_SP_Survey_Questions_DE exist and have proper CloudPage permissions.
        </span>
      </div>
    </div>
    %%[ ENDIF ]%%
    <!-- Breadcrumb Section (Hidden by default) -->
    <div class="breadcrumb-section" id="breadcrumbSection" style="display: none;">
      <div class="breadcrumb">
        <a href="#" onclick="showDashboard(); return false;" class="breadcrumb-link">Dashboard</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">All Surveys</span>
      </div>
    </div>

    <!-- Hero Section -->
    <div class="hero-section" id="heroSection">
      <div class="hero-content">
        <div class="hero-badge">SURVEY ANALYTICS</div>
        <h1>Enhance Your Insights with<br>MagMutual Survey Analytics</h1>
        <p>Comprehensive survey management and real-time analytics to drive better decision making</p>
        <button class="hero-cta" onclick="location.href='https://cloud.go.magmutual.com/survey-staging'">
          Create New Survey
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
          </svg>
        </button>
      </div>
      <div class="hero-illustration">
        <div class="floating-card card-1">
          <div class="mini-chart"></div>
        </div>
        <div class="floating-card card-2">
          <div class="mini-stat">85%</div>
        </div>
        <div class="floating-card card-3">
          <div class="mini-progress"></div>
        </div>
      </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-grid">
      %%[
        VAR @surveyCount, @activeCount, @completedCount, @totalResponses, @allSurveys
        
        IF @dataExists == "true" THEN
          /* Use the new SP Data Extensions */
          /* Get all surveys from SST_SP_Surveys_Master_DE */
          SET @allSurveys = LookupRows("SST_SP_Surveys_Master_DE", "SurveyStatus", "Active")
          SET @surveyCount = RowCount(@allSurveys)
          
          SET @activeCount = LookupRows("SST_SP_Surveys_Master_DE", "SurveyStatus", "Active")
          SET @activeCount = RowCount(@activeCount)
          
          SET @completedCount = LookupRows("SST_SP_Survey_Responses_DE", "QuestionID", "QSURV_20250807_113246_1")
          SET @completedCount = RowCount(@completedCount)
          
          SET @totalResponses = LookupRows("SST_SP_Survey_Responses_DE", "Status", "Completed")
          SET @totalResponses = RowCount(@totalResponses)
        ELSE
          /* Demo data when data extensions don't exist */
          SET @surveyCount = 0
          SET @activeCount = 0
          SET @completedCount = 0
          SET @totalResponses = 0
        ENDIF
      ]%%
      
      <div class="stat-card primary">
        <div class="stat-icon">
          <svg class="stat-icon-svg" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="currentColor" d="M19 21H5V5h2v2h10V5h2v2.172l1-1V4h-3V3h-3a2 2 0 0 0-4 0H7v1H4v18h16V11.828l-1 1zM8 4h3V2.615A.615.615 0 0 1 11.614 2h.771a.615.615 0 0 1 .615.615V4h3v2H8zm14.646 1.646l.707.707-8.853 8.854-3.854-3.854.707-.707 3.147 3.147z"/></svg>
        </div>
        <div class="stat-content">
          <div class="stat-value">%%=v(@surveyCount)=%%</div>
          <div class="stat-label">Total Surveys</div>
          <div class="stat-change">+100% from last month</div>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon success">
          <svg class="stat-icon-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8.00009 13L12.2278 16.3821C12.6557 16.7245 13.2794 16.6586 13.6264 16.2345L22.0001 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path fill-rule="evenodd" clip-rule="evenodd" d="M10.8051 11.9167L15.387 6.31663C15.5618 6.10291 15.5303 5.7879 15.3166 5.61304C15.1029 5.43817 14.7879 5.46967 14.613 5.6834L10.0369 11.2765L10.8051 11.9167ZM7.63879 15.7866L6.87054 15.1464L6.22007 15.9415C6.0504 16.1488 5.74743 16.1856 5.53309 16.0248L2.3 13.6C2.07909 13.4343 1.76568 13.4791 1.6 13.7C1.43431 13.9209 1.47909 14.2343 1.7 14.4L4.93309 16.8248C5.57613 17.3071 6.48503 17.1968 6.99402 16.5747L7.63879 15.7866Z" fill="currentColor"/></svg>
        </div>
        <div class="stat-content">
          <div class="stat-value">%%=v(@completedCount)=%%</div>
          <div class="stat-label">Completed</div>
          <div class="stat-change success">+8% completion rate</div>
        </div>
      </div>
      
