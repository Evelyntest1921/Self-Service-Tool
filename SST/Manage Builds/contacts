:root{--primary-color:#6366f1;--primary-dark:#4f46e5;--text-primary:#111827;--text-secondary:#6b7280;--bg-primary:#fff;--bg-secondary:#f9fafb;--border-color:#e5e7eb;--gray-400:#9ca3af;--gray-600:#4b5563;--gray-700:#374151;--gray-900:#111827;--radius-md:0.5rem;--shadow-sm:0 1px 2px 0 rgba(0,0,0,0.05)}
