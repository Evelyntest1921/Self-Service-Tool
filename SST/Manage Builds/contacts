.pagination-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border:1px solid #d1d5db;background:#fff;color:var(--gray-700);border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;text-decoration:none}
