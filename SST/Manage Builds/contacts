%%[
VAR @HOME_URL, @BUILD_PAGE_SELF, @CONTACTS_PAGE_SELF, @EDIT_DE_OPEN_URL, @jid, @contactUiPage
VAR @navRows, @navRow, @detailRows, @detailRow, @detailCount
VAR @dispName, @dispType, @dispDeName, @dispDeId, @dispQueryKey, @sourceDeKey
VAR @pageStatus, @loadError, @contactsTableHtml, @totalRecords
VAR @contactTotalPages, @contactPageSize, @contactStartRow, @contactEndRow, @contactNavBase
VAR @editSidebarHtml, @buildNavContext, @buildNavActive, @journeyDisplayName
VAR @STACK_JOURNEY_TYPE, @isStackBuild, @automationGuid, @automationCustomerKey, @automationName
VAR @confirmRunQuery, @runQueryBanner, @runQueryOk
VAR @confirmClearDe, @clearDeBanner, @clearDeOk

SET @STACK_JOURNEY_TYPE = "Journey + Automation"
SET @HOME_URL = ""
SET @BUILD_PAGE_SELF = ""
SET @CONTACTS_PAGE_SELF = ""
SET @EDIT_DE_OPEN_URL = ""
SET @jid = Trim(RequestParameter("journeyId"))
IF Empty(@jid) THEN
 SET @jid = Trim(QueryParameter("journeyId"))
ENDIF
SET @contactUiPage = Trim(RequestParameter("contactPage"))
IF Empty(@contactUiPage) THEN
 SET @contactUiPage = Trim(QueryParameter("contactPage"))
ENDIF
IF Empty(@contactUiPage) THEN
 SET @contactUiPage = 1
ENDIF
SET @contactUiPage = Add(0, @contactUiPage)
IF @contactUiPage < 1 THEN
 SET @contactUiPage = 1
ENDIF
SET @pageStatus = "ready"
SET @loadError = ""
SET @contactsTableHtml = ""
SET @totalRecords = 0
SET @contactTotalPages = 1
SET @contactPageSize = 20
SET @contactStartRow = 0
SET @contactEndRow = 0
SET @contactNavBase = ""
SET @buildNavContext = "true"
SET @buildNavActive = "contacts"
SET @dispName = ""
SET @dispType = ""
SET @dispDeName = ""
SET @dispDeId = ""
SET @dispQueryKey = ""
SET @sourceDeKey = ""
SET @journeyDisplayName = "Contacts"
SET @detailCount = 0
SET @isStackBuild = "false"
SET @automationGuid = ""
SET @automationCustomerKey = ""
SET @automationName = ""
SET @confirmRunQuery = "0"
SET @runQueryBanner = ""
SET @runQueryOk = ""
SET @confirmClearDe = "0"
SET @clearDeBanner = ""
SET @clearDeOk = ""
IF RequestParameter("confirmRunQuery") == "1" THEN
 SET @confirmRunQuery = "1"
ENDIF
IF RequestParameter("confirmClearRecords") == "1" THEN
 SET @confirmClearDe = "1"
ENDIF

SET @navRows = LookupRows("bd_sst_page_navigation","type","cloudpage")
IF RowCount(@navRows) > 0 THEN
 SET @navRow = Row(@navRows,1)
 SET @HOME_URL = Field(@navRow,"ss_home")
 SET @BUILD_PAGE_SELF = Field(@navRow,"ss_edit")
 SET @CONTACTS_PAGE_SELF = Trim(Field(@navRow,"ss_contacts"))
 SET @EDIT_DE_OPEN_URL = Trim(Field(@navRow,"ss_edit_de_open"))
ENDIF

IF Empty(@jid) THEN
 SET @pageStatus = "nodata"
ELSE
 SET @detailRows = LookupRows("Bd_journey_analytics","journeyId",@jid)
 IF RowCount(@detailRows) == 0 THEN
  SET @detailRows = LookupRows("Bd_journey_analytics","JourneyID",@jid)
 ENDIF
 SET @detailCount = RowCount(@detailRows)
 IF @detailCount == 0 THEN
  SET @pageStatus = "nodata"
 ELSE
  SET @detailRow = Row(@detailRows,1)
  SET @dispName = Field(@detailRow,"journeyName")
  SET @dispType = Field(@detailRow,"journeyType")
  SET @dispDeName = Trim(Field(@detailRow,"deName"))
  SET @dispDeId = Trim(Field(@detailRow,"deId"))
  SET @dispQueryKey = Trim(Field(@detailRow,"queryKey"))
  SET @automationGuid = Trim(Field(@detailRow,"automationGuid"))
  SET @automationCustomerKey = Trim(Field(@detailRow,"automationCustomerKey"))
  SET @automationName = Trim(Field(@detailRow,"automationName"))
  IF Lowercase(@automationGuid) == "null" OR Lowercase(@automationGuid) == "n/a" THEN
   SET @automationGuid = ""
  ENDIF
  IF Lowercase(@automationCustomerKey) == "null" OR Lowercase(@automationCustomerKey) == "n/a" THEN
   SET @automationCustomerKey = ""
  ENDIF
  IF Lowercase(@dispQueryKey) == "null" OR Lowercase(@dispQueryKey) == "n/a" THEN
   SET @dispQueryKey = ""
  ENDIF
  IF @automationGuid == "00000000-0000-0000-0000-000000000000" THEN
   SET @automationGuid = ""
  ENDIF
  IF Trim(@dispType) == @STACK_JOURNEY_TYPE THEN
   SET @isStackBuild = "true"
  ENDIF
  SET @journeyDisplayName = @dispName
  IF Empty(@journeyDisplayName) THEN
   SET @journeyDisplayName = "Contacts"
  ENDIF
  SET @sourceDeKey = @dispDeId
  IF Empty(@sourceDeKey) OR @sourceDeKey == "N/A" THEN
   SET @sourceDeKey = @dispDeName
  ENDIF
  IF Empty(@sourceDeKey) OR @sourceDeKey == "N/A" THEN
   SET @pageStatus = "node"
   SET @loadError = "No entry data extension on analytics for this build."
  ENDIF
  IF @confirmClearDe == "1" AND @pageStatus == "ready" THEN
   SET @postedClearJid = Trim(RequestParameter("journeyId"))
   IF Empty(@postedClearJid) THEN
    SET @postedClearJid = @jid
   ENDIF
   IF @postedClearJid != @jid THEN
    SET @pageStatus = "tamper"
    SET @loadError = "Clear request did not match this build."
   ENDIF
  ENDIF
 ENDIF
ENDIF

IF NOT Empty(@CONTACTS_PAGE_SELF) AND NOT Empty(@jid) THEN
 SET @contactNavBase = Concat(@CONTACTS_PAGE_SELF,"?journeyId=",@jid,"&contactPage=")
ENDIF

IF @confirmClearDe == "1" AND @pageStatus == "ready" AND NOT Empty(@sourceDeKey) THEN
 SET @clearDeOk = "false"
 SET @clearDeRowCount = ClearData(@sourceDeKey)
 SET @clearDeOk = "true"
 SET @clearDeBanner = Concat('<div class="banner good">All records were removed from the entry data extension.</div>')
ENDIF
]%%
<script runat="server">
Platform.Load("core","1");

function ctStr(v) {
 if (v == null || typeof v == "undefined") {
  return "";
 }
 try {
  return String(v);
 } catch (ctEx) {
  return "";
 }
}

function ctTrim(v) {
 var s = ctStr(v);
 if (!s) {
  return "";
 }
 var len = s.length;
 if (typeof len != "number" || isNaN(len) || len < 0) {
  return "";
 }
 var start = 0;
 var end = len;
 var sp = " \t\r\n";
 while (start < end && sp.indexOf(s.charAt(start)) >= 0) {
  start += 1;
 }
 while (end > start && sp.indexOf(s.charAt(end - 1)) >= 0) {
  end -= 1;
 }
 if (start >= end) {
  return "";
 }
 var out = "";
 var i;
 for (i = start; i < end; i++) {
  out += s.charAt(i);
 }
 return out;
}

function ctHtml(v) {
 var s = ctStr(v);
 var out = "";
 var i;
 var lt = String.fromCharCode(60);
 var gt = String.fromCharCode(62);
 for (i = 0; i < s.length; i++) {
  var ch = s.charAt(i);
  if (ch == "&") {
   out += "&" + "amp;";
  } else if (ch == lt) {
   out += "&" + "lt;";
  } else if (ch == gt) {
   out += "&" + "gt;";
  } else if (ch == '"') {
   out += "&" + "quot;";
  } else {
   out += ch;
  }
 }
 return out;
}

function ctSet(name, val) {
 var key = ctTrim(name);
 if (!key) {
  return;
 }
 if (key.indexOf("@") != 0) {
  key = "@" + key;
 }
 try {
  Platform.Variable.SetValue(key, ctStr(val));
 } catch (setEx) {
  key = key;
 }
}

function ctCoerceRows(r) {
 if (!r) {
  return [];
 }
 if (r.Results) {
  return ctCoerceRows(r.Results);
 }
 if (typeof r.length == "number") {
  var out = [];
  var i;
  for (i = 0; i < r.length; i++) {
   out.push(r[i]);
  }
  return out;
 }
 if (typeof r == "object") {
  return [r];
 }
 return [];
}

function ctField(row, names) {
 if (!row) {
  return "";
 }
 var i;
 for (i = 0; i < names.length; i++) {
  var n = names[i];
  if (row[n] !== undefined && row[n] !== null && ctTrim(row[n])) {
   return ctTrim(row[n]);
  }
 }
 return "";
}

function ctRetrieveDeRows(deKey) {
 var key = ctTrim(deKey);
 if (!key || key.toUpperCase() == "N/A") {
  return [];
 }
 var variants = [key, key.toLowerCase(), key.toUpperCase()];
 var seen = {};
 var keys = [];
 var vi;
 for (vi = 0; vi < variants.length; vi++) {
  var v = variants[vi];
  if (!v || seen[v]) {
   continue;
  }
  seen[v] = true;
  keys.push(v);
 }
 var ki;
 for (ki = 0; ki < keys.length; ki++) {
  try {
   var rows = ctCoerceRows(DataExtension.Init(keys[ki]).Rows.Retrieve());
   if (rows.length) {
    return rows;
   }
  } catch (initEx) {}
 }
 var props = ["ContactId", "Email", "Account_Owner_Name", "Account_Owner_Email", "MemberId"];
 for (ki = 0; ki < keys.length; ki++) {
  try {
   var prox = new Script.Util.WSProxy();
   var got = prox.retrieve(
    "DataExtensionObject[" + keys[ki] + "]",
    props,
    {
     Property: "ContactId",
     SimpleOperator: "isNotNull"
    }
   );
   rows = ctCoerceRows(got);
   if (rows.length) {
    return rows;
   }
  } catch (wsEx) {}
 }
 return [];
}

function ctParseJson(text) {
 try {
  return Platform.Function.ParseJSON(ctStr(text));
 } catch (parseEx) {
  return null;
 }
}

function ctHttpGet(token, url) {
 var req = new Script.Util.HttpRequest(url);
 req.emptyContentHandling = 0;
 req.retries = 1;
 req.continueOnError = true;
 req.method = "GET";
 req.setHeader("Authorization", "Bearer " + token);
 var resp = req.send();
 var body = "";
 if (resp.content) {
  body = ctStr(resp.content);
 }
 return {
  status: resp.statusCode,
  body: body
 };
}

function ctHttpPost(token, url, postData) {
 var req = new Script.Util.HttpRequest(url);
 req.emptyContentHandling = 0;
 req.retries = 1;
 req.continueOnError = true;
 req.method = "POST";
 req.contentType = "application/json";
 req.setHeader("Authorization", "Bearer " + token);
 req.postData = postData == null ? "{}" : ctStr(postData);
 var resp = req.send();
 var body = "";
 if (resp.content) {
  body = ctStr(resp.content);
 }
 return {
  status: resp.statusCode,
  body: body
 };
}

function ctGuidLike(id) {
 var v = ctTrim(id);
 if (!v || v.length !== 36) {
  return false;
 }
 if (
  v.charAt(8) !== "-" ||
  v.charAt(13) !== "-" ||
  v.charAt(18) !== "-" ||
  v.charAt(23) !== "-"
 ) {
  return false;
 }
 return true;
}

function ctQueryRestIdFromObj(obj) {
 if (!obj) {
  return "";
 }
 if (obj.id) {
  return ctTrim(obj.id);
 }
 if (obj.queryDefinitionId) {
  return ctTrim(obj.queryDefinitionId);
 }
 if (obj.objectId) {
  return ctTrim(obj.objectId);
 }
 if (obj.queryId) {
  return ctTrim(obj.queryId);
 }
 return "";
}

function ctFindQueryRestId(sub, token, queryRef) {
 var ref = ctTrim(queryRef);
 if (!ref) {
  return "";
 }
 var base = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/queries";
 var byKey = ctHttpGet(token, base + "/key:" + encodeURIComponent(ref));
 if (byKey.status == 200 && byKey.body) {
  var keyed = ctParseJson(byKey.body);
  var keyedId = ctQueryRestIdFromObj(keyed);
  if (keyedId) {
   return keyedId;
  }
 }
 var page = 1;
 var refLc = ref.toLowerCase();
 while (page <= 5) {
  var listUrl = base + "?" + "$page=" + page + "&" + "$pagesize=100";
  var listResp = ctHttpGet(token, listUrl);
  if (listResp.status != 200) {
   break;
  }
  var listObj = ctParseJson(listResp.body);
  var items = listObj && listObj.items ? listObj.items : [];
  var i;
  for (i = 0; i < items.length; i++) {
   var itemKey = ctTrim(items[i].key);
   if (itemKey && itemKey.toLowerCase() == refLc) {
    return ctQueryRestIdFromObj(items[i]);
   }
  }
  for (i = 0; i < items.length; i++) {
   var itemName = ctTrim(items[i].name);
   if (itemName && itemName.toLowerCase() == refLc) {
    return ctQueryRestIdFromObj(items[i]);
   }
  }
  if (items.length < 100) {
   break;
  }
  page += 1;
 }
 return "";
}

function ctResolveQueryObjectIdWproxy(queryRef) {
 var ref = ctTrim(queryRef);
 if (!ref) {
  return "";
 }
 try {
  var prox = new Script.Util.WSProxy();
  var filters = [
   { Property: "CustomerKey", Value: ref },
   { Property: "Name", Value: ref }
  ];
  if (ctGuidLike(ref)) {
   filters.push({ Property: "ObjectID", Value: ref });
  }
  var fi;
  for (fi = 0; fi < filters.length; fi++) {
   var got = prox.retrieve("QueryDefinition", ["ObjectID"], {
    Property: filters[fi].Property,
    SimpleOperator: "equals",
    Value: filters[fi].Value
   });
   if (got && got.Results && got.Results.length > 0) {
    var oid = ctTrim(got.Results[0].ObjectID);
    if (oid) {
     return oid;
    }
   }
  }
 } catch (resolveEx) {}
 return "";
}

function ctInvokePerformQuery(objectId) {
 var oid = ctTrim(objectId);
 if (!oid) {
  return { ok: false, msg: "Missing query ObjectID." };
 }
 try {
  var statusAndRequestId = ["", 0, ""];
  var qd = Platform.Function.CreateObject("QueryDefinition");
  Platform.Function.SetObjectProperty(qd, "ObjectID", oid);
  Platform.Function.InvokePerform(qd, "Start", statusAndRequestId, null);
  var statusMessage = ctStr(statusAndRequestId[0]);
  var errorCode = statusAndRequestId[1];
  if (errorCode === 0 || errorCode === "0") {
   return {
    ok: true,
    msg: "Query run started. Refresh this page in a minute to see updated entry DE rows."
   };
  }
  if (statusMessage && statusMessage.toLowerCase().indexOf("success") >= 0) {
   return {
    ok: true,
    msg: "Query run started. Refresh this page in a minute to see updated entry DE rows."
   };
  }
  return {
   ok: false,
   msg: "Could not start query: " + (statusMessage || "InvokePerform error " + ctStr(errorCode))
  };
 } catch (invokeEx) {
  return {
   ok: false,
   msg: ctTrim(invokeEx.message || ctStr(invokeEx)) || "Query perform failed."
  };
 }
}

function ctStartQueryRest(sub, token, queryRef) {
 var ref = ctTrim(queryRef);
 if (!ref) {
  return { ok: false, msg: "Missing query reference." };
 }
 var base = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/queries/";
 var startUrls = [
  base + "key:" + encodeURIComponent(ref) + "/actions/start",
  base + encodeURIComponent(ref) + "/actions/start"
 ];
 var ui;
 var lastStatus = 0;
 var lastBody = "";
 for (ui = 0; ui < startUrls.length; ui++) {
  var resp = ctHttpPost(token, startUrls[ui], "{}");
  lastStatus = resp.status;
  lastBody = resp.body;
  if (resp.status == 200 || resp.status == 202) {
   return {
    ok: true,
    msg: "Query run started. Refresh this page in a minute to see updated entry DE rows."
   };
  }
 }
 var restId = ctFindQueryRestId(sub, token, ref);
 if (restId && restId.toLowerCase() !== ref.toLowerCase()) {
  var byIdUrl = base + encodeURIComponent(restId) + "/actions/start";
  var idResp = ctHttpPost(token, byIdUrl, "{}");
  lastStatus = idResp.status;
  lastBody = idResp.body;
  if (idResp.status == 200 || idResp.status == 202) {
   return {
    ok: true,
    msg: "Query run started. Refresh this page in a minute to see updated entry DE rows."
   };
  }
 }
 var clip = ctTrim(lastBody).substring(0, 160);
 return {
  ok: false,
  msg:
   "Could not start query via REST (HTTP " +
   lastStatus +
   ")" +
   (clip ? " — " + clip : "") +
   ". Check queryKey matches the query external key in Automation Studio."
 };
}

function ctRunQueryByRef(queryRef) {
 var ref = ctTrim(queryRef);
 if (!ref) {
  return { ok: false, msg: "Missing query reference." };
 }
 var auth = ctAuthAdmin();
 if (!auth.ok) {
  return { ok: false, msg: auth.msg };
 }
 var restResult = ctStartQueryRest(auth.subdomain, auth.token, ref);
 if (restResult.ok) {
  return restResult;
 }
 var oid = ctResolveQueryObjectIdWproxy(ref);
 if (!oid && ctGuidLike(ref)) {
  oid = ref;
 }
 if (oid) {
  var soapResult = ctInvokePerformQuery(oid);
  if (soapResult.ok) {
   return soapResult;
  }
  return {
   ok: false,
   msg: soapResult.msg || restResult.msg
  };
 }
 return restResult;
}

function ctAuthAdmin() {
 var clientId = ctLookupAuthScalar("Admin", "clientId");
 if (!clientId) {
  clientId = ctLookupAuthScalar("Admin", "ClientId");
 }
 var clientSecret = ctLookupAuthScalar("Admin", "clientSecret");
 if (!clientSecret) {
  clientSecret = ctLookupAuthScalar("Admin", "ClientSecret");
 }
 var subdomain = ctLookupAuthScalar("Admin", "subdomain");
 if (!subdomain) {
  subdomain = ctLookupAuthScalar("Admin", "Subdomain");
 }
 var accountId = ctLookupAuthScalar("Admin", "accountId");
 if (!accountId) {
  accountId = ctLookupAuthScalar("Admin", "AccountId");
 }
 if (!clientId || !clientSecret || !subdomain) {
  return { ok: false, token: "", subdomain: "", msg: "SFMC_AUTH Admin credentials missing." };
 }
 try {
  var authUrl = "https://" + subdomain + ".auth.marketingcloudapis.com/v2/token";
  var payload =
   '{"grant_type":"client_credentials","client_id":"' +
   ctEscJson(clientId) +
   '","client_secret":"' +
   ctEscJson(clientSecret) +
   '"';
  if (accountId) {
   payload += ',"account_id":"' + ctEscJson(accountId) + '"';
  }
  payload += "}";
  var req = new Script.Util.HttpRequest(authUrl);
  req.emptyContentHandling = 0;
  req.retries = 1;
  req.continueOnError = true;
  req.method = "POST";
  req.contentType = "application/json";
  req.postData = payload;
  var resp = req.send();
  var body = resp.content ? ctStr(resp.content) : "";
  if (resp.statusCode != 200 && resp.statusCode != 201) {
   return { ok: false, token: "", subdomain: subdomain, msg: "Auth HTTP " + resp.statusCode + "." };
  }
  var token = "";
  try {
   var parsed = Platform.Function.ParseJSON(body);
   if (parsed && parsed.access_token) {
    token = ctStr(parsed.access_token);
   }
  } catch (authParseEx) {
   token = "";
  }
  if (!token) {
   return { ok: false, token: "", subdomain: subdomain, msg: "Auth response missing access_token." };
  }
  return { ok: true, token: token, subdomain: subdomain, msg: "" };
 } catch (authEx) {
  return { ok: false, token: "", subdomain: "", msg: ctStr(authEx.message || authEx) };
 }
}

function ctEscJson(s) {
 var text = ctStr(s);
 var out = "";
 var i;
 for (i = 0; i < text.length; i++) {
  var ch = text.charAt(i);
  if (ch == "\\") {
   out += "\\\\";
  } else if (ch == '"') {
   out += '\\"';
  } else if (ch == "\r") {
   out += "\\r";
  } else if (ch == "\n") {
   out += "\\n";
  } else {
   out += ch;
  }
 }
 return out;
}

function ctLookupAuthScalar(userKey, returnField) {
 var val = "";
 try {
  val = Platform.Function.Lookup("SFMC_AUTH", returnField, "User", userKey);
 } catch (lookupEx) {
  return "";
 }
 return ctTrim(val);
}

function ctGetAutomationByKey(base, token, keyVal) {
 var url = base + "key:" + encodeURIComponent(String(keyVal));
 var got = ctHttpGet(token, url);
 if (got.status == 200 && got.body) {
  var obj = ctParseJson(got.body);
  if (obj && obj.id) {
   return { ok: true, obj: obj };
  }
 }
 return { ok: false, obj: null };
}

function ctGetAutomationById(base, token, restId) {
 var url = base + encodeURIComponent(String(restId));
 var got = ctHttpGet(token, url);
 if (got.status == 200 && got.body) {
  var obj = ctParseJson(got.body);
  if (obj && obj.id) {
   return { ok: true, obj: obj };
  }
 }
 return { ok: false, obj: null };
}

function ctGetAutomation(sub, token, automationGuid, automationCustomerKey, automationName) {
 var base = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/automations/";
 var guid = ctTrim(automationGuid);
 var key = ctTrim(automationCustomerKey);
 var name = ctTrim(automationName);
 if (key) {
  var byKey = ctGetAutomationByKey(base, token, key);
  if (byKey.ok) {
   return byKey;
  }
 }
 if (guid) {
  var byId = ctGetAutomationById(base, token, guid);
  if (byId.ok) {
   return byId;
  }
 }
 if (name) {
  var page = 1;
  while (page <= 5) {
   var listUrl = base + "?" + "$page=" + page + "&" + "$pagesize=100";
   var listResp = ctHttpGet(token, listUrl);
   if (listResp.status != 200) {
    break;
   }
   var listObj = ctParseJson(listResp.body);
   var items = listObj && listObj.items ? listObj.items : [];
   var i;
   for (i = 0; i < items.length; i++) {
    if (items[i].name && String(items[i].name) == String(name)) {
     return { ok: true, obj: items[i] };
    }
   }
   if (items.length < 100) {
    break;
   }
   page += 1;
  }
 }
 return { ok: false, obj: null };
}

function ctFirstQueryActivityId(obj) {
 var steps = obj && obj.steps ? obj.steps : [];
 var si;
 for (si = 0; si < steps.length; si++) {
  var activities = steps[si] && steps[si].activities ? steps[si].activities : [];
  var ai;
  for (ai = 0; ai < activities.length; ai++) {
   var act = activities[ai] || {};
   if (parseInt(String(act.objectTypeId), 10) == 300 && ctTrim(act.activityObjectId)) {
    return ctTrim(act.activityObjectId);
   }
  }
 }
 return "";
}

function ctNormalizeQueryKey(raw) {
 var k = ctTrim(raw);
 if (!k) {
  return "";
 }
 var lower = k.toLowerCase();
 if (lower == "null" || lower == "n/a") {
  return "";
 }
 return k;
}

function ctRunFirstQueryAutomation() {
 var queryKey = ctNormalizeQueryKey(Platform.Variable.GetValue("@dispQueryKey") || "");
 if (queryKey) {
  return ctRunQueryByRef(queryKey);
 }
 var guid = ctTrim(Platform.Variable.GetValue("@automationGuid") || "");
 var autoKey = ctTrim(Platform.Variable.GetValue("@automationCustomerKey") || "");
 var name = ctTrim(Platform.Variable.GetValue("@automationName") || "");
 var auth = ctAuthAdmin();
 if (!auth.ok) {
  return { ok: false, msg: auth.msg };
 }
 var fetched = ctGetAutomation(auth.subdomain, auth.token, guid, autoKey, name);
 if (!fetched.ok || !fetched.obj) {
  return {
   ok: false,
   msg: "No queryKey on analytics and could not load automation for this build."
  };
 }
 var autoObj = fetched.obj;
 var queryOid = ctFirstQueryActivityId(autoObj);
 if (queryOid) {
  return ctRunQueryByRef(queryOid);
 }
 return {
  ok: false,
  msg: "Could not resolve a query for this build. Add queryKey to Bd_journey_analytics."
 };
}

function ctBuildTableHtml(rows, page, pageSize) {
 var total = rows.length;
 var totalPages = total > 0 ? Math.ceil(total / pageSize) : 1;
 if (page > totalPages) {
  page = totalPages;
 }
 if (page < 1) {
  page = 1;
 }
 var start = (page - 1) * pageSize;
 var end = start + pageSize;
 if (end > total) {
  end = total;
 }
 var html = "";
 var i;
 if (total == 0) {
  html =
   '<tr><td colspan="4" style="text-align:center;padding:24px;color:#6b7280;">No rows in the entry data extension.</td></tr>';
 } else {
  for (i = start; i < end; i++) {
   var row = rows[i];
   var contactId = ctField(row, ["ContactId", "contactId", "contactid", "SubscriberKey"]);
   var email = ctField(row, ["Email", "email"]);
   var ownerName = ctField(row, ["Account_Owner_Name", "Account_owner_name", "account_owner_name"]);
   var ownerEmail = ctField(row, ["Account_Owner_Email", "Account_owner_email", "account_owner_email"]);
   html += "<tr>";
   html += "<td>" + ctHtml(contactId || "-") + "</td>";
   html += "<td>" + ctHtml(email || "-") + "</td>";
   html += "<td>" + ctHtml(ownerName || "-") + "</td>";
   html += "<td>" + ctHtml(ownerEmail || "-") + "</td>";
   html += "</tr>";
  }
 }
 return {
  html: html,
  total: total,
  totalPages: totalPages,
  page: page,
  startRow: total > 0 ? start + 1 : 0,
  endRow: end > 0 ? end : 0
 };
}

var pageStatus = ctTrim(Platform.Variable.GetValue("@pageStatus") || "ready");
var loadError = ctTrim(Platform.Variable.GetValue("@loadError") || "");
var sourceDeKey = ctTrim(Platform.Variable.GetValue("@sourceDeKey") || "");
var pageNum = parseInt(String(Platform.Variable.GetValue("@contactUiPage") || "1"), 10);
var pageSize = parseInt(String(Platform.Variable.GetValue("@contactPageSize") || "20"), 10);
if (isNaN(pageNum) || pageNum < 1) {
 pageNum = 1;
}
if (isNaN(pageSize) || pageSize < 1) {
 pageSize = 20;
}

var confirmRunQuery = Platform.Variable.GetValue("@confirmRunQuery") == "1";
var isStackBuild = Platform.Variable.GetValue("@isStackBuild") == "true";
if (confirmRunQuery && isStackBuild) {
 var runResult = ctRunFirstQueryAutomation();
 ctSet("runQueryOk", runResult.ok ? "true" : "false");
 if (runResult.ok) {
  ctSet("runQueryBanner", '<div class="banner good">' + ctHtml(runResult.msg) + "</div>");
 } else {
  ctSet("runQueryBanner", '<div class="banner bad">' + ctHtml(runResult.msg) + "</div>");
 }
}

if (pageStatus == "ready" && sourceDeKey) {
 try {
  var allRows = ctRetrieveDeRows(sourceDeKey);
  var built = ctBuildTableHtml(allRows, pageNum, pageSize);
  ctSet("contactsTableHtml", built.html);
  ctSet("totalRecords", String(built.total));
  ctSet("contactTotalPages", String(built.totalPages));
  ctSet("contactUiPage", String(built.page));
  ctSet("contactStartRow", String(built.startRow));
  ctSet("contactEndRow", String(built.endRow));
 } catch (loadEx) {
  pageStatus = "error";
  loadError = loadEx.message || ctStr(loadEx);
  ctSet("pageStatus", pageStatus);
  ctSet("loadError", loadError);
  ctSet("contactsTableHtml", '<tr><td colspan="4" style="text-align:center;padding:24px;color:#b91c1c;">Could not load entry DE rows.</td></tr>');
 }
}
</script>
