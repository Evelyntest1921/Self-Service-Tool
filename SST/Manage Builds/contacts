<script>
(function () {
 function closeActionPanel(panel, toggleBtn) {
  if (!panel) {
   return;
  }
  panel.hidden = true;
  panel.classList.remove("is-open");
  if (toggleBtn) {
   toggleBtn.setAttribute("aria-expanded", "false");
  }
 }
 function openActionPanel(panel, toggleBtn, otherPanels) {
  if (!panel) {
   return;
  }
  var pi;
  if (otherPanels && otherPanels.length) {
   for (pi = 0; pi < otherPanels.length; pi++) {
    var entry = otherPanels[pi];
    closeActionPanel(entry.panel, entry.toggleBtn);
   }
  }
  panel.hidden = false;
  panel.classList.add("is-open");
  if (toggleBtn) {
   toggleBtn.setAttribute("aria-expanded", "true");
  }
 }
 var editQueryCache = null;
 var actionPanelPeers = [
  { panelId: "runQueryConfirmPanel", toggleBtnId: "runQueryBtn" },
  { panelId: "clearRecordsConfirmPanel", toggleBtnId: "clearRecordsBtn" },
  { panelId: "editQueryConfirmPanel", toggleBtnId: "editQueryBtn" }
 ];
 function otherPanelsExcept(panelId) {
  var out = [];
  var i;
  for (i = 0; i < actionPanelPeers.length; i++) {
   if (actionPanelPeers[i].panelId === panelId) {
    continue;
   }
   out.push({
    panel: document.getElementById(actionPanelPeers[i].panelId),
    toggleBtn: document.getElementById(actionPanelPeers[i].toggleBtnId)
   });
  }
  return out;
 }
 function wireActionConfirm(opts) {
  var toggleBtn = document.getElementById(opts.toggleBtnId);
  var panel = document.getElementById(opts.panelId);
  var cancelBtn = document.getElementById(opts.cancelBtnId);
  var confirmForm = document.getElementById(opts.confirmFormId);
  var confirmBtn = document.getElementById(opts.confirmBtnId);
  var otherPanels = opts.otherPanels || [];
  if (toggleBtn && panel) {
   toggleBtn.addEventListener("click", function () {
    if (panel.classList.contains("is-open")) {
     closeActionPanel(panel, toggleBtn);
     if (opts.onClose) {
      opts.onClose();
     }
    } else {
     openActionPanel(panel, toggleBtn, otherPanels);
     if (opts.onOpen) {
      opts.onOpen();
     }
    }
   });
  }
  if (cancelBtn) {
   cancelBtn.addEventListener("click", function () {
    closeActionPanel(panel, toggleBtn);
    if (opts.onClose) {
     opts.onClose();
    }
   });
  }
  if (confirmForm) {
   confirmForm.addEventListener("submit", function () {
    if (confirmBtn) {
     confirmBtn.disabled = true;
     confirmBtn.textContent = opts.confirmPendingLabel || "Working…";
    }
    if (opts.onSubmit) {
     opts.onSubmit();
    }
    if (opts.clearQueryCacheOnSubmit) {
     editQueryCache = null;
    }
   });
  }
  if (panel && panel.getAttribute("data-auto-open") === "true") {
   openActionPanel(panel, toggleBtn, otherPanels);
   if (opts.onOpen) {
    opts.onOpen();
   }
  }
 }
 function parseContactsJsonResponse(text) {
  var raw = String(text || "").replace(/^\uFEFF/, "");
  var jsonStart = raw.indexOf("{");
  if (jsonStart > 0) {
   raw = raw.substring(jsonStart);
  }
  return JSON.parse(raw);
 }
 function applyEditQueryPayload(payload) {
  var meta = document.getElementById("editQueryLoadMeta");
  var textarea = document.getElementById("editQueryTextarea");
  var targetSelect = document.getElementById("editQueryTargetUpdateType");
  var confirmBtn = document.getElementById("editQueryConfirmBtn");
  if (!payload || !payload.ok) {
   if (meta) {
    meta.textContent =
     (payload && payload.error) || "Could not load query.";
   }
   if (textarea) {
    textarea.value = "";
    textarea.disabled = true;
   }
   if (targetSelect) {
    targetSelect.disabled = true;
   }
   if (confirmBtn) {
    confirmBtn.disabled = true;
   }
   return;
  }
  if (meta) {
   var metaParts = [];
   if (payload.name) {
    metaParts.push("Name: " + payload.name);
   }
   if (payload.customerKey) {
    metaParts.push("Key: " + payload.customerKey);
   }
   meta.textContent = metaParts.length ? metaParts.join(" · ") : "Query loaded.";
  }
  if (textarea) {
   textarea.value = payload.queryText || "";
   textarea.disabled = false;
  }
  if (targetSelect) {
   var action = payload.targetUpdateType || "Update";
   if (
    action !== "Append" &&
    action !== "Update" &&
    action !== "Overwrite"
   ) {
    action = "Update";
   }
   targetSelect.value = action;
   targetSelect.disabled = false;
  }
  if (confirmBtn) {
   confirmBtn.disabled = false;
  }
 }
 function loadEditQuerySql() {
  var meta = document.getElementById("editQueryLoadMeta");
  var textarea = document.getElementById("editQueryTextarea");
  var targetSelect = document.getElementById("editQueryTargetUpdateType");
  var confirmBtn = document.getElementById("editQueryConfirmBtn");
  if (!textarea) {
   return;
  }
  if (editQueryCache && editQueryCache.ok) {
   applyEditQueryPayload(editQueryCache);
   return;
  }
  if (meta) {
   meta.textContent = "Loading query…";
  }
  textarea.value = "";
  textarea.disabled = true;
  if (targetSelect) {
   targetSelect.disabled = true;
  }
  if (confirmBtn) {
   confirmBtn.disabled = true;
  }
  var url = new URL(window.location.href);
  url.searchParams.set("contactsQueryData", "1");
  fetch(url.toString(), { credentials: "same-origin" })
   .then(function (resp) {
    return resp.text();
   })
   .then(function (text) {
    var payload = null;
    try {
     payload = parseContactsJsonResponse(text);
    } catch (parseEx) {
     payload = { ok: false, error: "Invalid response from server." };
    }
    editQueryCache = payload;
    applyEditQueryPayload(payload);
   })
   .catch(function () {
    if (meta) {
     meta.textContent = "Network error loading query.";
    }
   });
 }
 function resetEditQueryDraft() {
  var textarea = document.getElementById("editQueryTextarea");
  var meta = document.getElementById("editQueryLoadMeta");
  var targetSelect = document.getElementById("editQueryTargetUpdateType");
  var confirmBtn = document.getElementById("editQueryConfirmBtn");
  if (textarea) {
   textarea.value = "";
   textarea.disabled = true;
   textarea.placeholder = "Open this panel to load query SQL…";
  }
  if (targetSelect) {
   targetSelect.value = "Update";
   targetSelect.disabled = true;
  }
  if (meta) {
   meta.textContent = "";
  }
  if (confirmBtn) {
   confirmBtn.disabled = true;
  }
 }
 wireActionConfirm({
  toggleBtnId: "editQueryBtn",
  panelId: "editQueryConfirmPanel",
  cancelBtnId: "editQueryCancelBtn",
  confirmFormId: "editQueryConfirmForm",
  confirmBtnId: "editQueryConfirmBtn",
  confirmPendingLabel: "Saving…",
  clearQueryCacheOnSubmit: true,
  otherPanels: otherPanelsExcept("editQueryConfirmPanel"),
  onOpen: loadEditQuerySql,
  onClose: resetEditQueryDraft
 });
 wireActionConfirm({
  toggleBtnId: "clearRecordsBtn",
  panelId: "clearRecordsConfirmPanel",
  cancelBtnId: "clearRecordsCancelBtn",
  confirmFormId: "clearRecordsConfirmForm",
  confirmBtnId: "clearRecordsConfirmBtn",
  confirmPendingLabel: "Clearing…",
  otherPanels: otherPanelsExcept("clearRecordsConfirmPanel")
 });
 wireActionConfirm({
  toggleBtnId: "runQueryBtn",
  panelId: "runQueryConfirmPanel",
  cancelBtnId: "runQueryCancelBtn",
  confirmFormId: "runQueryConfirmForm",
  confirmBtnId: "runQueryConfirmBtn",
  confirmPendingLabel: "Starting…",
  otherPanels: otherPanelsExcept("runQueryConfirmPanel"),
  onSubmit: function () {
   var runQueryBtn = document.getElementById("runQueryBtn");
   if (!runQueryBtn) {
    return;
   }
   runQueryBtn.disabled = true;
   runQueryBtn.setAttribute("aria-disabled", "true");
   runQueryBtn.tabIndex = -1;
   runQueryBtn.classList.add("run-query-button-running");
   runQueryBtn.textContent = "Running";
  }
 });
})();
(function () {
 var openDeBtn = document.getElementById("openEntryDeBtn");
 if (!openDeBtn) {
  return;
 }
 openDeBtn.addEventListener("click", function () {
  var deOpenBase = openDeBtn.getAttribute("data-de-open-url") || "";
  var journeyId = openDeBtn.getAttribute("data-journey-id") || "";
  if (!deOpenBase) {
   alert(
    "Entry DE link is not configured. Add text field ss_edit_de_open on bd_sst_page_navigation with the published edit-build-de-open Cloud Page URL."
   );
   return;
  }
  if (!journeyId) {
   alert("Missing journeyId for this build.");
   return;
  }
  var url = new URL(deOpenBase, window.location.href);
  url.searchParams.set("journeyId", journeyId);
  openDeBtn.disabled = true;
  var prevLabel = openDeBtn.textContent;
  openDeBtn.textContent = "Opening…";
  fetch(url.toString(), { credentials: "same-origin" })
   .then(function (resp) {
    return resp.text();
   })
   .then(function (text) {
    var payload = null;
    var raw = String(text || "").replace(/^\uFEFF/, "");
    var jsonStart = raw.indexOf("{");
    if (jsonStart > 0) {
     raw = raw.substring(jsonStart);
    }
    try {
     payload = JSON.parse(raw);
    } catch (parseEx) {
     payload = { ok: false, error: "Invalid response from server." };
    }
    if (payload && payload.ok && payload.url) {
     window.open(payload.url, "_blank", "noopener");
    } else {
     alert(
      (payload && payload.error) ||
       "Could not open this data extension. Try Contact Builder and search by name or customer key."
     );
    }
   })
   .catch(function () {
    alert("Network error resolving data extension link.");
   })
   .finally(function () {
    openDeBtn.disabled = false;
    openDeBtn.textContent = prevLabel;
   });
 });
})();
</script>
</body>
