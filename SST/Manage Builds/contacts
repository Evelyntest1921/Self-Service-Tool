%%[
VAR @HOME_URL, @BUILD_PAGE_SELF, @CONTACTS_PAGE_SELF, @jid, @contactUiPage
VAR @navRows, @navRow, @detailRows, @detailRow, @detailCount
VAR @dispName, @dispType, @dispDeName, @dispDeId, @sourceDeKey
VAR @pageStatus, @loadError, @contactsTableHtml, @totalRecords
VAR @contactTotalPages, @contactPageSize, @contactStartRow, @contactEndRow, @contactNavBase
VAR @editSidebarHtml, @buildNavContext, @buildNavActive, @journeyDisplayName

SET @HOME_URL = ""
SET @BUILD_PAGE_SELF = ""
SET @CONTACTS_PAGE_SELF = ""
SET @jid = Trim(RequestParameter("journeyId"))
IF Empty(@jid) THEN
 SET @jid = Trim(QueryParameter("journeyId"))
ENDIF
SET @contactUiPage = Trim(RequestParameter("contactPage"))
IF Empty(@contactUiPage) THEN
 SET @contactUiPage = Trim(QueryParameter("contactPage"))
ENDIF
IF Empty(@contactUiPage) THEN
 SET @contactUiPage = 1
ENDIF
SET @contactUiPage = Add(0, @contactUiPage)
IF @contactUiPage < 1 THEN
 SET @contactUiPage = 1
ENDIF
SET @pageStatus = "ready"
SET @loadError = ""
SET @contactsTableHtml = ""
SET @totalRecords = 0
SET @contactTotalPages = 1
SET @contactPageSize = 20
SET @contactStartRow = 0
SET @contactEndRow = 0
SET @contactNavBase = ""
SET @buildNavContext = "true"
SET @buildNavActive = "contacts"
SET @dispName = ""
SET @dispType = ""
SET @dispDeName = ""
SET @dispDeId = ""
SET @sourceDeKey = ""
SET @journeyDisplayName = "Contacts"
SET @detailCount = 0

SET @navRows = LookupRows("bd_sst_page_navigation","type","cloudpage")
IF RowCount(@navRows) > 0 THEN
 SET @navRow = Row(@navRows,1)
 SET @HOME_URL = Field(@navRow,"ss_home")
 SET @BUILD_PAGE_SELF = Field(@navRow,"ss_edit")
 SET @CONTACTS_PAGE_SELF = Trim(Field(@navRow,"ss_contacts"))
ENDIF

IF Empty(@jid) THEN
 SET @pageStatus = "nodata"
ELSE
 SET @detailRows = LookupRows("Bd_journey_analytics","journeyId",@jid)
 IF RowCount(@detailRows) == 0 THEN
  SET @detailRows = LookupRows("Bd_journey_analytics","JourneyID",@jid)
 ENDIF
 SET @detailCount = RowCount(@detailRows)
 IF @detailCount == 0 THEN
  SET @pageStatus = "nodata"
 ELSE
  SET @detailRow = Row(@detailRows,1)
  SET @dispName = Field(@detailRow,"journeyName")
  SET @dispType = Field(@detailRow,"journeyType")
  SET @dispDeName = Trim(Field(@detailRow,"deName"))
  SET @dispDeId = Trim(Field(@detailRow,"deId"))
  SET @journeyDisplayName = @dispName
  IF Empty(@journeyDisplayName) THEN
   SET @journeyDisplayName = "Contacts"
  ENDIF
  SET @sourceDeKey = @dispDeId
  IF Empty(@sourceDeKey) OR @sourceDeKey == "N/A" THEN
   SET @sourceDeKey = @dispDeName
  ENDIF
  IF Empty(@sourceDeKey) OR @sourceDeKey == "N/A" THEN
   SET @pageStatus = "node"
   SET @loadError = "No entry data extension on analytics for this build."
  ENDIF
 ENDIF
ENDIF

IF NOT Empty(@CONTACTS_PAGE_SELF) AND NOT Empty(@jid) THEN
 SET @contactNavBase = Concat(@CONTACTS_PAGE_SELF,"?journeyId=",@jid,"&contactPage=")
ENDIF
]%%
<script runat="server">
Platform.Load("core","1");

function ctStr(v) {
 if (v == null || typeof v == "undefined") {
  return "";
 }
 try {
  return String(v);
 } catch (ctEx) {
  return "";
 }
}

function ctTrim(v) {
 var s = ctStr(v);
 if (!s) {
  return "";
 }
 var len = s.length;
 if (typeof len != "number" || isNaN(len) || len < 0) {
  return "";
 }
 var start = 0;
 var end = len;
 var sp = " \t\r\n";
 while (start < end && sp.indexOf(s.charAt(start)) >= 0) {
  start += 1;
 }
 while (end > start && sp.indexOf(s.charAt(end - 1)) >= 0) {
  end -= 1;
 }
 if (start >= end) {
  return "";
 }
 var out = "";
 var i;
 for (i = start; i < end; i++) {
  out += s.charAt(i);
 }
 return out;
}

function ctHtml(v) {
 var s = ctStr(v);
 var out = "";
 var i;
 var lt = String.fromCharCode(60);
 var gt = String.fromCharCode(62);
 for (i = 0; i < s.length; i++) {
  var ch = s.charAt(i);
  if (ch == "&") {
   out += "&" + "amp;";
  } else if (ch == lt) {
   out += "&" + "lt;";
  } else if (ch == gt) {
   out += "&" + "gt;";
  } else if (ch == '"') {
   out += "&" + "quot;";
  } else {
   out += ch;
  }
 }
 return out;
}

function ctSet(name, val) {
 var key = ctTrim(name);
 if (!key) {
  return;
 }
 if (key.indexOf("@") != 0) {
  key = "@" + key;
 }
 try {
  Platform.Variable.SetValue(key, ctStr(val));
 } catch (setEx) {
  key = key;
 }
}

function ctCoerceRows(r) {
 if (!r) {
  return [];
 }
 if (r.Results) {
  return ctCoerceRows(r.Results);
 }
 if (typeof r.length == "number") {
  var out = [];
  var i;
  for (i = 0; i < r.length; i++) {
   out.push(r[i]);
  }
  return out;
 }
 if (typeof r == "object") {
  return [r];
 }
 return [];
}

function ctField(row, names) {
 if (!row) {
  return "";
 }
 var i;
 for (i = 0; i < names.length; i++) {
  var n = names[i];
  if (row[n] !== undefined && row[n] !== null && ctTrim(row[n])) {
   return ctTrim(row[n]);
  }
 }
 return "";
}

function ctRetrieveDeRows(deKey) {
 var key = ctTrim(deKey);
 if (!key || key.toUpperCase() == "N/A") {
  return [];
 }
 var variants = [key, key.toLowerCase(), key.toUpperCase()];
 var seen = {};
 var keys = [];
 var vi;
 for (vi = 0; vi < variants.length; vi++) {
  var v = variants[vi];
  if (!v || seen[v]) {
   continue;
  }
  seen[v] = true;
  keys.push(v);
 }
 var ki;
 for (ki = 0; ki < keys.length; ki++) {
  try {
   var rows = ctCoerceRows(DataExtension.Init(keys[ki]).Rows.Retrieve());
   if (rows.length) {
    return rows;
   }
  } catch (initEx) {}
 }
 var props = ["ContactId", "Email", "Account_Owner_Name", "Account_Owner_Email", "MemberId"];
 for (ki = 0; ki < keys.length; ki++) {
  try {
   var prox = new Script.Util.WSProxy();
   var got = prox.retrieve(
    "DataExtensionObject[" + keys[ki] + "]",
    props,
    {
     Property: "ContactId",
     SimpleOperator: "isNotNull"
    }
   );
   rows = ctCoerceRows(got);
   if (rows.length) {
    return rows;
   }
  } catch (wsEx) {}
 }
 return [];
}

function ctBuildTableHtml(rows, page, pageSize) {
 var total = rows.length;
 var totalPages = total > 0 ? Math.ceil(total / pageSize) : 1;
 if (page > totalPages) {
  page = totalPages;
 }
 if (page < 1) {
  page = 1;
 }
 var start = (page - 1) * pageSize;
 var end = start + pageSize;
 if (end > total) {
  end = total;
 }
 var html = "";
 var i;
 if (total == 0) {
  html =
   '<tr><td colspan="4" style="text-align:center;padding:24px;color:#6b7280;">No rows in the entry data extension.</td></tr>';
 } else {
  for (i = start; i < end; i++) {
   var row = rows[i];
   var contactId = ctField(row, ["ContactId", "contactId", "contactid", "SubscriberKey"]);
   var email = ctField(row, ["Email", "email"]);
   var ownerName = ctField(row, ["Account_Owner_Name", "Account_owner_name", "account_owner_name"]);
   var ownerEmail = ctField(row, ["Account_Owner_Email", "Account_owner_email", "account_owner_email"]);
   html += "<tr>";
   html += "<td>" + ctHtml(contactId || "-") + "</td>";
   html += "<td>" + ctHtml(email || "-") + "</td>";
   html += "<td>" + ctHtml(ownerName || "-") + "</td>";
   html += "<td>" + ctHtml(ownerEmail || "-") + "</td>";
   html += "</tr>";
  }
 }
 return {
  html: html,
  total: total,
  totalPages: totalPages,
  page: page,
  startRow: total > 0 ? start + 1 : 0,
  endRow: end > 0 ? end : 0
 };
}

var pageStatus = ctTrim(Platform.Variable.GetValue("@pageStatus") || "ready");
var loadError = ctTrim(Platform.Variable.GetValue("@loadError") || "");
var sourceDeKey = ctTrim(Platform.Variable.GetValue("@sourceDeKey") || "");
var pageNum = parseInt(String(Platform.Variable.GetValue("@contactUiPage") || "1"), 10);
var pageSize = parseInt(String(Platform.Variable.GetValue("@contactPageSize") || "20"), 10);
if (isNaN(pageNum) || pageNum < 1) {
 pageNum = 1;
}
if (isNaN(pageSize) || pageSize < 1) {
 pageSize = 20;
}

if (pageStatus == "ready" && sourceDeKey) {
 try {
  var allRows = ctRetrieveDeRows(sourceDeKey);
  var built = ctBuildTableHtml(allRows, pageNum, pageSize);
  ctSet("contactsTableHtml", built.html);
  ctSet("totalRecords", String(built.total));
  ctSet("contactTotalPages", String(built.totalPages));
  ctSet("contactUiPage", String(built.page));
  ctSet("contactStartRow", String(built.startRow));
  ctSet("contactEndRow", String(built.endRow));
 } catch (loadEx) {
  pageStatus = "error";
  loadError = loadEx.message || ctStr(loadEx);
  ctSet("pageStatus", pageStatus);
  ctSet("loadError", loadError);
  ctSet("contactsTableHtml", '<tr><td colspan="4" style="text-align:center;padding:24px;color:#b91c1c;">Could not load entry DE rows.</td></tr>');
 }
}
</script>
