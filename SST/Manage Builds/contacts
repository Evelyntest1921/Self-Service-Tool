.page-number{display:inline-flex;align-items:center;justify-content:center;min-width:36px;height:36px;padding:0 8px;border:1px solid #d1d5db;background:#fff;color:var(--gray-700);border-radius:6px;font-size:14px;font-weight:500;text-decoration:none}
.page-number.active{background:var(--primary-color);color:#fff;border-color:var(--primary-color)}
