 IF RowCount(@detailRows) > 0 THEN
  SET @detailRow = Row(@detailRows,1)
  SET @automationId = Trim(Field(@detailRow,"automationGuid"))
  SET @automationCustomerKey = Trim(Field(@detailRow,"automationCustomerKey"))
  IF Lowercase(@automationId) == "null" OR Lowercase(@automationId) == "n/a" THEN SET @automationId = "" ENDIF
  IF Lowercase(@automationCustomerKey) == "null" OR Lowercase(@automationCustomerKey) == "n/a" THEN SET @automationCustomerKey = "" ENDIF
  IF @automationId == "00000000-0000-0000-0000-000000000000" THEN SET @automationId = "" ENDIF
  SET @connectedAutomationName = Trim(Field(@detailRow,"automationName"))
  SET @sourceDeName = Trim(Field(@detailRow,"deName"))
  SET @journeyAutomationId = @automationId
  IF Empty(@journeyAutomationId) THEN
   SET @journeyAutomationId = @automationCustomerKey
  ENDIF
 ENDIF
