<script runat="server">
Platform.Load("core", "1");

var MC_CLOUD = "https://mc.s13.exacttarget.com/cloud/";

function isWsChar(c) {
  return c === " " || c === "\t" || c === "\n" || c === "\r";
}
function toJsString(v) {
  if (v === null || typeof v === "undefined") return "";
  if (typeof v === "string") return v;
  if (typeof v === "number" || typeof v === "boolean") return v + "";
  try {
    var s = v + "";
    if (s && s.indexOf("[object") !== 0) return s;
  } catch (coerceEx) {}
  return "";
}
function strTrim(v) {
  var s = toJsString(v);
  var start = 0;
  var end = s.length;
  while (start < end && isWsChar(s.charAt(start))) start += 1;
  while (end > start && isWsChar(s.charAt(end - 1))) end -= 1;
  var out = "";
  var i;
  for (i = start; i < end; i++) {
    out += s.charAt(i);
  }
  return out;
}
function strReplaceAll(s, find, repl) {
  var text = toJsString(s);
  if (!find || text.indexOf(find) < 0) return text;
  return text.split(find).join(repl);
}
function htmlSafe(v) {
  var s = strTrim(v);
  s = strReplaceAll(s, "&", "&amp;");
  s = strReplaceAll(s, "<", "&lt;");
  s = strReplaceAll(s, ">", "&gt;");
  s = strReplaceAll(s, '"', "&quot;");
  return s;
}
function parseJsonSafe(text) {
  var raw = toJsString(text);
  if (!raw) return null;
  try { return Platform.Function.ParseJSON(raw); } catch (e1) {}
  try {
    if (typeof Script.Util.JSON !== "undefined" && Script.Util.JSON.parse) {
      return Script.Util.JSON.parse(raw);
    }
  } catch (e2) {}
  return null;
}
function httpJson(token, method, url) {
  try {
    var req = new Script.Util.HttpRequest(url);
    req.emptyContentHandling = 0;
    req.retries = 2;
    req.continueOnError = true;
    req.setHeader("Authorization", "Bearer " + token);
    req.method = method;
    var resp = req.send();
    return { status: resp.statusCode, body: resp.content ? String(resp.content) : "" };
  } catch (httpEx) {
    return { status: 0, body: httpEx.message || String(httpEx) };
  }
}
function activityTypeLabel(typeId) {
  var id = parseInt(typeId, 10);
  var map = {
    42: "Import",
    43: "Report",
    45: "File transfer",
    53: "Data extract",
    73: "Filter",
    84: "Data extract",
    300: "Query",
    303: "Filter",
    423: "Script",
    425: "Script",
    426: "Verification",
    467: "Wait",
    725: "Refresh group",
    771: "Verification",
    952: "Journey"
  };
  if (map[id]) return map[id];
  if (!isNaN(id) && id > 0) return "Activity " + id;
  return "Activity";
}
function statusLabelForCode(code) {
  var raw = strTrim(code);
  var labels = {
    "-1": "Failed",
    "0": "Build failed",
    "1": "Building",
    "2": "Ready",
    "3": "Running",
    "4": "Paused",
    "5": "Stopped",
    "6": "Scheduled",
    "7": "Waiting",
    "8": "Inactive"
  };
  if (labels[raw]) return labels[raw];
  return raw || "Unknown";
}
function automationStatusCode(obj) {
  if (!obj) return "";
  if (obj.statusId !== undefined && obj.statusId !== null && String(obj.statusId) !== "") {
    return String(obj.statusId);
  }
  var statusVal = obj.status;
  if (statusVal === undefined || statusVal === null) return "";
  var raw = strTrim(String(statusVal));
  if (/^-?\d+$/.test(raw)) return raw;
  var byName = {
    failed: "-1",
    "build failed": "0",
    building: "1",
    ready: "2",
    running: "3",
    paused: "4",
    stopped: "5",
    scheduled: "6",
    waiting: "7",
    error: "7",
    inactive: "8"
  };
  var mapped = byName[raw.toLowerCase()];
  if (mapped) return mapped;
  return raw;
}
function automationStatusLabel(obj) {
  var statusVal = obj && obj.status !== undefined && obj.status !== null ? strTrim(String(obj.status)) : "";
  if (statusVal && !/^-?\d+$/.test(statusVal)) return statusVal;
  return statusLabelForCode(automationStatusCode(obj));
}
function statusClassForCode(code, label) {
  var base = "journey-meta-value";
  var raw = strTrim(code);
  if (raw === "3") return base + " status-running";
  if (raw === "4" || raw === "5" || raw === "6") return base + " status-paused-schedule";
  if (raw === "2") return base + " status-ready";
  if (raw === "1" || raw === "8") return base + " status-building";
  if (raw === "-1" || raw === "0" || raw === "7") return base + " status-error";
  var lower = strTrim(label).toLowerCase();
  if (lower === "running") return base + " status-running";
  if (lower === "paused" || lower === "stopped" || lower === "scheduled") return base + " status-paused-schedule";
  if (lower === "ready") return base + " status-ready";
  if (lower === "building" || lower === "inactive") return base + " status-building";
  if (lower === "failed" || lower === "build failed" || lower === "waiting" || lower === "error") return base + " status-error";
  return base + " status-unknown";
}
function metaRow(label, value) {
  var shown = strTrim(value);
  if (!shown) shown = "Not set";
  return "<dt>" + htmlSafe(label) + "</dt><dd>" + htmlSafe(shown) + "</dd>";
}
function metaStatusRow(obj) {
  var code = automationStatusCode(obj);
  var label = automationStatusLabel(obj);
  var cls = statusClassForCode(code, label);
  return "<dt>Status</dt><dd><span class=\"" + cls + "\">" + htmlSafe(label) + "</span><p class=\"journey-meta-note\">" + htmlSafe(automationStatusNote(code, label)) + "</p></dd>";
}
function automationStatusNote(code, label) {
  var raw = strTrim(code);
  var lower = strTrim(label).toLowerCase();
  if (raw === "3" || lower === "running") {
    return "Your job is running right now (for example refreshing data or moving files). You can stop it if you need to make a change, or wait until it finishes and refresh this page.";
  }
  if (raw === "4" || lower === "paused") {
    return "The automatic schedule is turned off. Nothing will run on its own until you turn the schedule back on with Activate schedule.";
  }
  if (raw === "5" || lower === "stopped") {
    return "This job is stopped. It will not run until you turn the schedule on again or use Run Automation Once for a single run.";
  }
  if (raw === "6" || lower === "scheduled") {
    return "The schedule is on. This job will run automatically at the times you configured (Eastern Time).";
  }
  if (raw === "2" || lower === "ready") {
    return "The job is set up and idle. It will run on the next scheduled time, or immediately if you choose Run Automation Once.";
  }
  if (raw === "1" || lower === "building") {
    return "Salesforce is still preparing this job. Wait a few minutes and refresh the page before you change the schedule or run it.";
  }
  if (raw === "8" || lower === "inactive") {
    return "The trigger that starts this job is turned off in Automation Studio. It will not run until your admin fixes or re-enables that trigger.";
  }
  if (raw === "7" || lower === "waiting") {
    return "This job is waiting for something else first, such as a file to land or a manual start in Automation Studio.";
  }
  if (raw === "-1" || lower === "failed") {
    return "The last run did not finish successfully. Open Automation Studio (button above) to see the error and what to fix.";
  }
  if (raw === "0" || lower === "build failed") {
    return "This job could not be built correctly. Your technical team needs to review it in Automation Studio.";
  }
  return "This is the latest status from Automation Studio. If it looks wrong, wait a moment and refresh the page.";
}
function parseIcalValue(ical, key) {
  var re = new RegExp(key + "=([^;]+)", "i");
  var match = strTrim(ical || "").match(re);
  return match ? match[1] : "";
}
function scheduleFrequencyFromObj(obj) {
  var ical = strTrim((obj && obj.schedule ? obj.schedule : {}).icalRecur || "");
  if (!ical) return "";
  if (ical.indexOf("COUNT=1") >= 0) return "once";
  if (ical.indexOf("MINUTELY") >= 0) return "minute";
  if (ical.indexOf("YEARLY") >= 0) return "yearly";
  if (ical.indexOf("MONTHLY") >= 0) return "monthly";
  if (ical.indexOf("WEEKLY") >= 0) return "weekly";
  if (ical.indexOf("DAILY") >= 0) {
    var byDay = parseIcalValue(ical, "BYDAY").toUpperCase();
    if (byDay.indexOf("MO") >= 0 && byDay.indexOf("FR") >= 0 && byDay.indexOf("SA") < 0 && byDay.indexOf("SU") < 0) {
      return "weekdays";
    }
    return "daily";
  }
  if (ical.indexOf("HOURLY") >= 0) return "hourly";
  return "";
}
function scheduleIntervalFromIcal(ical, freq) {
  var rule = strTrim(ical || "");
  var match = rule.match(/INTERVAL=(\d+)/);
  var v = match ? parseInt(match[1], 10) : 1;
  if (isNaN(v) || v < 1) v = 1;
  if (strTrim(freq).toLowerCase() === "minute") {
    if (v === 15 || v === 30 || v === 45) return String(v);
    return "15";
  }
  return String(v);
}
function scheduleWeekdaysFromIcal(ical) {
  var byDay = parseIcalValue(ical, "BYDAY").toUpperCase();
  if (!byDay) return "mon";
  var map = { MO: "mon", TU: "tue", WE: "wed", TH: "thu", FR: "fri", SA: "sat", SU: "sun" };
  var tokens = byDay.split(",");
  var out = [];
  var i;
  for (i = 0; i < tokens.length; i++) {
    var t = strTrim(tokens[i]).toUpperCase();
    if (map[t]) out.push(map[t]);
  }
  return out.length ? out.join(",") : "mon";
}
function applyScheduleFormDefaultsFromAutomation(obj) {
  var postedFreq = strTrim(Platform.Variable.GetValue("@schedFreq") || "");
  var freq = postedFreq || scheduleFrequencyFromObj(obj) || "hourly";
  Platform.Variable.SetValue("@schedFreq", freq);
  var ical = strTrim((obj.schedule || {}).icalRecur || "");
  var postedInterval = strTrim(Platform.Variable.GetValue("@schedInterval") || "");
  var intervalVal = postedInterval || scheduleIntervalFromIcal(ical, freq);
  Platform.Variable.SetValue("@schedInterval", intervalVal);
  var postedMinute = strTrim(Platform.Variable.GetValue("@schedMinute") || "");
  if (freq === "minute") {
    Platform.Variable.SetValue("@schedMinute", postedMinute || intervalVal || "15");
  } else if (postedMinute) {
    Platform.Variable.SetValue("@schedMinute", postedMinute);
  } else {
    Platform.Variable.SetValue("@schedMinute", "15");
  }
  var postedWeekdays = strTrim(Platform.Variable.GetValue("@schedWeekdays") || "");
  Platform.Variable.SetValue("@schedWeekdays", postedWeekdays || scheduleWeekdaysFromIcal(ical));
  var postedEnd = strTrim(Platform.Variable.GetValue("@schedEnd") || "");
  var endDefaults = scheduleEndDefaultsFromAutomation(obj);
  var endMode = postedEnd || endDefaults.mode || "never";
  Platform.Variable.SetValue("@schedEnd", endMode);
  var postedEndDate = strTrim(Platform.Variable.GetValue("@schedEndDate") || "");
  Platform.Variable.SetValue("@schedEndDate", postedEndDate || endDefaults.endDate || "");
  var postedOcc = strTrim(Platform.Variable.GetValue("@schedOccurrences") || "");
  Platform.Variable.SetValue("@schedOccurrences", postedOcc || endDefaults.occurrences || "2");
}
function dateKeyFromIsoValue(value) {
  var match = strTrim(value).match(/^(\d{4}-\d{2}-\d{2})/);
  return match ? match[1] : "";
}
function scheduleEndDefaultsFromAutomation(obj) {
  var schedule = obj && obj.schedule ? obj.schedule : {};
  var ical = strTrim(schedule.icalRecur || "");
  var endRaw = strTrim(schedule.endDate || schedule.endDateTime || "");
  if (ical.indexOf("COUNT=1") >= 0) {
    return { mode: "occurrences", occurrences: "1", endDate: "" };
  }
  var countMatch = ical.match(/COUNT=(\d+)/);
  if (countMatch && countMatch[1] !== "1") {
    return { mode: "occurrences", occurrences: countMatch[1], endDate: "" };
  }
  if (ical.indexOf("UNTIL=20991231") >= 0 || endRaw.indexOf("2099-12-31") >= 0) {
    return { mode: "never", occurrences: "2", endDate: "" };
  }
  var endKey = dateKeyFromIsoValue(soapStartToEasternFormValue(endRaw) + ":00");
  if (!endKey) endKey = dateKeyFromIsoValue(endRaw);
  if (endKey) {
    return { mode: "enddate", occurrences: "2", endDate: endKey };
  }
  return { mode: "occurrences", occurrences: "2", endDate: "" };
}
function humanScheduleText(schedule) {
  var ical = strTrim(schedule.icalRecur || "");
  var startRaw = strTrim(schedule.startDate || "");
  var startParts = easternPartsFromScheduleApi(startRaw);
  var start = startParts
    ? monthNameEnglish(startParts.mo) + " " + startParts.d + ", " + startParts.y + " at " + formatHour12AmPm(startParts.h, startParts.mi)
    : startRaw;
  var timing = "";
  if (ical.indexOf("MINUTELY") >= 0) timing = "Runs every few minutes";
  else if (ical.indexOf("YEARLY") >= 0) timing = "Runs on a yearly schedule";
  else if (ical.indexOf("MONTHLY") >= 0) timing = "Runs on a monthly schedule";
  else if (ical.indexOf("WEEKLY") >= 0) timing = "Runs on a weekly schedule";
  else if (ical.indexOf("DAILY") >= 0 && ical.indexOf("BYDAY=MO,TU,WE,TH,FR") >= 0) timing = "Runs on weekdays";
  else if (ical.indexOf("DAILY") >= 0) timing = "Runs once per day";
  else if (ical.indexOf("HOURLY") >= 0) timing = "Runs every hour";
  else if (strTrim(schedule.scheduleStatus)) timing = "Schedule is " + strTrim(schedule.scheduleStatus);
  if (timing && start) return timing + ", starting " + start + ".";
  if (timing) return timing + ".";
  if (start) return "Scheduled to start " + start + ".";
  return "";
}
function buildScheduleSummary(obj) {
  var schedule = obj.schedule || {};
  var raw = automationStatusCode(obj);
  if (raw === "3") return "A run is in progress right now.";
  if (raw === "4") return "The automatic schedule is paused. Use Edit schedule when you are ready to turn it on again.";
  if (raw === "5") return "This job is stopped. Use Edit schedule or Run Automation Once when you want it to run.";
  if (isScheduledStatus(obj)) {
    var startLine = businessScheduleStartText(obj);
    if (startLine) return startLine + ".";
  }
  var human = humanScheduleText(schedule);
  if (human) return human + " All times are Eastern Time (US and Canada).";
  if (raw === "6") return "A schedule is active. This job will run automatically on that timetable (Eastern Time).";
  return "No automatic schedule is set up yet. Click Edit schedule to choose when this job should run.";
}
function countAutomationActivities(obj) {
  var steps = obj.steps || [];
  var total = 0;
  var s;
  for (s = 0; s < steps.length; s++) {
    var activities = (steps[s] || {}).activities || [];
    total += activities.length;
  }
  return total;
}
function normalizeAutomationRef(val) {
  var s = strTrim(val);
  if (!s) {
    return "";
  }
  var lower = s.toLowerCase();
  if (lower === "null" || lower === "n/a" || lower === "undefined") {
    return "";
  }
  if (/^0{8}-0{4}-0{4}-0{4}-0{12}$/i.test(s)) {
    return "";
  }
  return s;
}
function looksLikeAutomationGuid(val) {
  var s = normalizeAutomationRef(val);
  if (!s) {
    return false;
  }
  return /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(s);
}
function uniqueAutomationKeyCandidates(customerKey, guid) {
  var out = [];
  var seen = {};
  function add(val) {
    var s = normalizeAutomationRef(val);
    if (!s) {
      return;
    }
    var marker = s.toLowerCase();
    if (seen[marker]) {
      return;
    }
    seen[marker] = true;
    out.push(s);
  }
  add(customerKey);
  add(guid);
  return out;
}
function automationPayloadOk(obj) {
  return !!(obj && (obj.id || obj.name || obj.key));
}
function getAutomationByRestId(base, token, restId) {
  var id = normalizeAutomationRef(restId);
  if (!id) {
    return { ok: false, obj: null, status: 0, body: "" };
  }
  var resp = httpJson(token, "GET", base + encodeURIComponent(id));
  if (resp.status == 200) {
    var obj = parseJsonSafe(resp.body);
    if (automationPayloadOk(obj)) {
      return { ok: true, obj: obj, status: resp.status, body: resp.body };
    }
  }
  return { ok: false, obj: null, status: resp.status, body: resp.body };
}
function getAutomationByCustomerKey(base, token, keyVal) {
  var key = normalizeAutomationRef(keyVal);
  var urls, ui, resp, obj;
  if (!key) {
    return { ok: false, obj: null, status: 0, body: "" };
  }
  urls = [base + "key:" + key, base + "key:" + encodeURIComponent(key)];
  for (ui = 0; ui < urls.length; ui++) {
    resp = httpJson(token, "GET", urls[ui]);
    if (resp.status == 200) {
      obj = parseJsonSafe(resp.body);
      if (automationPayloadOk(obj)) {
        return { ok: true, obj: obj, status: resp.status, body: resp.body };
      }
    }
  }
  return {
    ok: false,
    obj: null,
    status: resp ? resp.status : 0,
    body: resp && resp.body ? resp.body : ""
  };
