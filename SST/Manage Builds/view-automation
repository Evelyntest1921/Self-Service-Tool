<script>
(function(){
  var schedulePanel = document.getElementById("schedulePanel");
  var scheduleOpenBtn = document.getElementById("scheduleEditOpenBtn");
  var runOnceOpenBtn = document.getElementById("runOnceOpenBtn");
  var runOnceCancelBtn = document.getElementById("runOnceCancelBtn");
  var runOnceConfirm = document.getElementById("runOnceConfirm");
  if (schedulePanel && scheduleOpenBtn) {
    scheduleOpenBtn.addEventListener("click", function() {
      schedulePanel.classList.remove("is-run-once-open");
      if (runOnceConfirm) runOnceConfirm.setAttribute("hidden", "hidden");
      schedulePanel.classList.add("is-editing");
    });
  }
  if (schedulePanel && runOnceOpenBtn && runOnceConfirm) {
    runOnceOpenBtn.addEventListener("click", function() {
      schedulePanel.classList.remove("is-editing");
      schedulePanel.classList.add("is-run-once-open");
      runOnceConfirm.removeAttribute("hidden");
    });
  }
  if (schedulePanel && runOnceCancelBtn && runOnceConfirm) {
    runOnceCancelBtn.addEventListener("click", function() {
      schedulePanel.classList.remove("is-run-once-open");
      runOnceConfirm.setAttribute("hidden", "hidden");
    });
  }
  var startInput = document.getElementById("automationStartDate");
  if (startInput && !startInput.value) {
    try {
      var easternNow = new Date(Date.now() + 10 * 60 * 1000);
      var parts = new Intl.DateTimeFormat("en-CA", {
        timeZone: "America/New_York",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false
      }).formatToParts(easternNow);
      var map = {};
      var i;
      for (i = 0; i < parts.length; i++) {
        if (parts[i].type !== "literal") map[parts[i].type] = parts[i].value;
      }
      if (map.year && map.month && map.day && map.hour && map.minute) {
        startInput.value = map.year + "-" + map.month + "-" + map.day + "T" + map.hour + ":" + map.minute;
      }
    } catch (prefillEx) {}
  }
  var scheduleFreq = document.getElementById("automationFrequency");
  var everyWrap = document.getElementById("automationEveryWrap");
  var intervalInput = document.getElementById("automationScheduleInterval");
  var unitLabel = document.getElementById("automationEveryUnitLabel");
  var weeklyPanel = document.getElementById("automationWeeklyDayPanel");
  var weekdayHidden = document.getElementById("automationScheduleWeekdays");
  var minuteHidden = document.getElementById("automationMinuteInterval");
  var weekdayChecks = document.querySelectorAll(".schedule-weekday-cb");
  function syncWeekdayHidden() {
    if (!weekdayHidden) return;
    var parts = [];
    var wi;
    for (wi = 0; wi < weekdayChecks.length; wi++) {
      if (weekdayChecks[wi].checked) parts.push(weekdayChecks[wi].value);
    }
    weekdayHidden.value = parts.length ? parts.join(",") : "mon";
  }
  function syncScheduleFrequencyFields() {
    if (!scheduleFreq) return;
    var repeat = scheduleFreq.value;
    if (everyWrap) everyWrap.hidden = repeat === "once";
    if (weeklyPanel) weeklyPanel.classList.toggle("is-visible", repeat === "weekly");
    if (unitLabel) {
      var units = { minute: "minutes", hourly: "hours", daily: "days", weekdays: "days", weekly: "weeks", monthly: "months", yearly: "years" };
      unitLabel.textContent = units[repeat] || "hours";
    }
    if (intervalInput) {
      intervalInput.disabled = repeat === "weekdays";
      if (repeat === "weekdays") intervalInput.value = "1";
      if (repeat === "minute") {
        intervalInput.min = "15";
        intervalInput.max = "45";
        intervalInput.step = "15";
        if (intervalInput.value !== "15" && intervalInput.value !== "30" && intervalInput.value !== "45") intervalInput.value = "15";
      } else {
        intervalInput.min = "1";
        intervalInput.max = "9999";
        intervalInput.step = "1";
        if (!intervalInput.value || parseInt(intervalInput.value, 10) < 1) intervalInput.value = "1";
      }
    }
    if (minuteHidden && intervalInput && repeat === "minute") minuteHidden.value = intervalInput.value;
    syncWeekdayHidden();
    syncAutomationEndWrapVisibility();
  }
  var endRadios = document.querySelectorAll('input[name="automationScheduleEnd"]');
  var endDateInput = document.getElementById("automationScheduleEndDate");
  var occurInput = document.getElementById("automationScheduleOccurrences");
  var endWrap = document.getElementById("automationScheduleEndWrap");
  function padLocal(n) {
    return n < 10 ? "0" + n : String(n);
  }
  function futureDateString(daysAhead) {
    var d = new Date();
    d.setDate(d.getDate() + daysAhead);
    return d.getFullYear() + "-" + padLocal(d.getMonth() + 1) + "-" + padLocal(d.getDate());
  }
  function selectedAutomationEndMode() {
    var e;
    for (e = 0; e < endRadios.length; e++) {
      if (endRadios[e].checked) return endRadios[e].value;
    }
    return "occurrences";
  }
  function addYearsToDateKey(dateKey, years) {
    if (!dateKey || dateKey.length < 10) return futureDateString(365);
    var parts = dateKey.split("-");
    var y = parseInt(parts[0], 10) + years;
    return y + "-" + parts[1] + "-" + parts[2];
  }
  function syncAutomationEndFields() {
    var mode = selectedAutomationEndMode();
    if (occurInput) occurInput.disabled = mode !== "occurrences";
    if (endDateInput) {
      endDateInput.disabled = mode !== "endDate";
      if (mode === "endDate" && !endDateInput.value) {
        var base = startInput && startInput.value ? startInput.value.split("T")[0] : futureDateString(0);
        endDateInput.value = addYearsToDateKey(base, 1);
        endDateInput.min = base;
      }
    }
  }
  function syncAutomationEndWrapVisibility() {
    if (!endWrap || !scheduleFreq) return;
    endWrap.hidden = scheduleFreq.value === "once";
  }
  var er;
  for (er = 0; er < endRadios.length; er++) {
    endRadios[er].addEventListener("change", syncAutomationEndFields);
  }
  if (startInput) startInput.addEventListener("change", syncAutomationEndFields);
  var wi2;
  for (wi2 = 0; wi2 < weekdayChecks.length; wi2++) {
    weekdayChecks[wi2].addEventListener("change", syncWeekdayHidden);
  }
  if (intervalInput) {
    intervalInput.addEventListener("change", function() {
      if (scheduleFreq && scheduleFreq.value === "minute" && minuteHidden) minuteHidden.value = intervalInput.value;
    });
  }
  var activateForm = document.querySelector("#schedulePanelEditor form.schedule-form input[name='automationAction'][value='activate']");
  if (activateForm && activateForm.form) {
    activateForm.form.addEventListener("submit", function() {
      syncWeekdayHidden();
      syncScheduleFrequencyFields();
    });
  }
  if (scheduleFreq) {
    scheduleFreq.addEventListener("change", syncScheduleFrequencyFields);
    syncScheduleFrequencyFields();
  } else {
    syncAutomationEndWrapVisibility();
    syncAutomationEndFields();
  }
})();
function openAutomationStudio(el) {
  var name = el.getAttribute("data-automation-name") || "";
  var url = el.getAttribute("data-studio-url") || "";
  var actionCell = el.parentNode;
  var hint = actionCell ? actionCell.querySelector(".copy-hint") : null;
  window.open(url, "_blank", "noopener");
  function markCopied(ok) {
    if (hint) hint.textContent = ok ? "Automation name copied." : "Could not copy the name.";
  }
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(name).then(function () { markCopied(true); }, function () { markCopied(fallbackCopy(name)); });
  } else {
    markCopied(fallbackCopy(name));
  }
}
function fallbackCopy(name) {
  var box = document.createElement("textarea");
  box.value = name;
  document.body.appendChild(box);
  box.select();
  var ok = false;
  try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
  document.body.removeChild(box);
  return ok;
}
</script>
