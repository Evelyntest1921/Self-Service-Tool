function analyzeRunOnceWarning(obj, sourceDeName) {
  var steps = obj.steps || [];
  var has952 = false;
  var has300 = false;
  var activityCount = 0;
  var otherActivity = false;
  var s;
  var a;
  for (s = 0; s < steps.length; s++) {
    var activities = (steps[s] || {}).activities || [];
    for (a = 0; a < activities.length; a++) {
      activityCount++;
      var tid = parseInt((activities[a] || {}).objectTypeId, 10);
      if (tid === 952) has952 = true;
      else if (tid === 300) has300 = true;
      else otherActivity = true;
    }
  }
  var de = strTrim(sourceDeName);
  if (has952) {
    var journeyMsg = "Warning: This automation includes a Journey step. Running it once may send emails to contacts";
    if (de) journeyMsg += ' in the source data extension "' + de + '"';
    else journeyMsg += " from the audience tied to this build";
    journeyMsg += ".";
    return { warnClass: "run-once-warning-danger", confirmClass: "btn-run-confirm-danger", message: journeyMsg };
  }
  if (has300 && !has952 && !otherActivity && activityCount > 0) {
    return {
      warnClass: "run-once-warning-safe",
      confirmClass: "btn-run-confirm-safe",
      message: "This automation only runs a Query step. It refreshes data and does not send emails through a Journey. Confirm only if you intend to refresh that data now."
    };
  }
  if (has300 && !has952) {
    return {
      warnClass: "run-once-warning-danger",
      confirmClass: "btn-run-confirm-danger",
      message: "This automation has more than a query step and no Journey step was detected. Review the flow before you run it once."
    };
  }
  return {
    warnClass: "run-once-warning-danger",
    confirmClass: "btn-run-confirm-danger",
    message: "Running this automation once may update data or start customer-facing steps. Review the activities below before you confirm."
  };
}
