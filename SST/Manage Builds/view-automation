<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Automation • SST</title>
<link rel="icon" href="https://www.magmutual.com/_next/image?url=%2Fmagmutual-egg.svg&amp;w=640&amp;q=75" type="image/png">
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
:root{--primary-color:#6366f1;--primary-dark:#4f46e5;--text-primary:#111827;--text-secondary:#6b7280;--bg-secondary:#f9fafb;--border-color:#e5e7eb;--shadow-sm:0 1px 2px 0 rgba(0,0,0,.05);--radius-lg:12px;--gray-400:#9ca3af;--gray-600:#4b5563;--gray-900:#111827;--danger:#b91c1c;--dangerbg:#fef2f2}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg-secondary);color:var(--text-primary);line-height:1.55}
.dashboard-layout{display:flex;height:100vh;min-height:100vh;overflow:hidden}
.maker-main{flex:1;min-width:0;height:100vh;overflow:hidden;display:flex;flex-direction:column;background:var(--bg-secondary)}
.maker-main-inner{flex:1;overflow-y:auto;padding:32px 40px 48px}
h1{font-size:1.65rem;margin-bottom:8px;font-weight:700}
.journey-page-heading{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.journey-page-heading h1{margin:0}
.sub{color:var(--text-secondary);margin-bottom:22px}
.panel{background:#fff;border:1px solid var(--border-color);padding:26px 30px;margin-bottom:20px}
.panel-title{font-size:1rem;font-weight:700;margin:0 0 16px 0}
.banner{padding:14px 16px;border-radius:10px;margin-bottom:16px;font-size:14px;border:1px solid var(--border-color)}
.banner.bad{border-color:#fecaca;background:var(--dangerbg);color:var(--danger)}
.banner.good{border-color:#bbf7d0;background:#f0fdf4;color:#166534}
.recent-empty{color:var(--text-secondary);font-size:14px}
.journey-meta-dl{margin:0}
.journey-meta-dl dt{font-size:11px;color:var(--gray-600);text-transform:uppercase;font-weight:600;letter-spacing:0.05em;margin:16px 0 4px 0}
.journey-meta-dl dt:first-child{margin-top:0}
.journey-meta-dl dd{font-weight:600;font-size:1rem;margin:0;padding:0;color:var(--gray-900);word-break:break-word}
.journey-meta-name{display:flex;align-items:center;justify-content:space-between;gap:16px}
.journey-meta-title{margin:0;font-size:1.65rem;font-weight:700;line-height:1.2;flex:1;min-width:0;word-break:break-word}
.journey-meta-name-icon-wrap{width:40px;height:40px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:var(--gray-900)}
.journey-meta-name-icon{width:40px;height:40px;display:block}
.journey-meta-dl dd .journey-meta-value{display:inline-block;padding:4px 10px;font-size:14px;font-weight:700;color:#000;background:#e5e7eb}
.journey-meta-dl dd .journey-meta-value.status-running{background:#86efac;color:#000}
.journey-meta-dl dd .journey-meta-value.status-paused-schedule{background:#fdba74;color:#000}
.journey-meta-dl dd .journey-meta-value.status-ready{background:#bfdbfe;color:#000}
.journey-meta-dl dd .journey-meta-value.status-building{background:#e5e7eb;color:#000}
.journey-meta-dl dd .journey-meta-value.status-error{background:#fca5a5;color:#000}
.journey-meta-dl dd .journey-meta-value.status-unknown{background:#f3f4f6;color:#000}
.journey-meta-note{font-weight:400;font-size:13px;line-height:1.45;color:var(--text-secondary);margin:6px 0 0;padding:0}
.journey-meta-action{margin:0}
.flow-hint{font-size:13px;color:var(--text-secondary);margin:0 0 14px 0}
.copy-hint{margin-left:8px;color:var(--text-secondary);font-size:13px;font-weight:400}
.journey-flow-scroll{width:100%;overflow-x:auto;overflow-y:hidden;padding:8px 4px 16px;-webkit-overflow-scrolling:touch}
.journey-flow{display:flex;flex-direction:row;align-items:center;flex-wrap:nowrap;width:max-content;min-width:100%;padding:4px 8px}
.journey-flow-node{border:1px solid #cbd5e1;border-radius:10px;background:#fff;padding:12px 14px;min-width:150px;max-width:200px;width:180px;text-align:center;box-shadow:var(--shadow-sm);flex-shrink:0;overflow:hidden;box-sizing:border-box}
.journey-flow-type{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);margin-bottom:4px;overflow-wrap:anywhere;word-break:break-word;line-height:1.3}
.journey-flow-name{font-size:14px;font-weight:700;color:var(--gray-900);margin-bottom:4px;line-height:1.25;overflow-wrap:anywhere;word-break:break-word;max-width:100%}
.journey-flow-arrow-h{color:var(--path-color, #94a3b8);font-size:22px;line-height:1;padding:0 6px;flex-shrink:0;font-weight:600}
.schedule-form{margin:0 0 16px}
.schedule-field{margin-bottom:16px}
.schedule-field label{display:block;font-size:0.8125rem;font-weight:600;color:var(--text-secondary);margin-bottom:6px}
.schedule-control{width:100%;padding:10px 12px;border:1px solid var(--border-color);border-radius:8px;font:inherit;background:#fff}
.schedule-eastern-note{font-size:0.8125rem;color:var(--text-secondary);margin:6px 0 12px}
.schedule-radio-title{display:block;font-size:0.8125rem;font-weight:600;color:var(--text-secondary);margin-bottom:6px}
.schedule-end-group{display:flex;flex-direction:column;gap:10px;margin-top:8px}
.schedule-end-option{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:10px 12px;border:1px solid var(--border-color);border-radius:8px;cursor:pointer}
.schedule-end-option input[type="radio"]{margin:0}
.schedule-end-inline{width:auto;max-width:120px;padding:8px 10px}
.schedule-end-date{max-width:180px}
.schedule-every-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.schedule-every-input{width:auto;max-width:120px;padding:8px 10px}
.schedule-every-unit{font-size:0.875rem;font-weight:600;color:var(--text-secondary)}
.schedule-weekday-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.schedule-weekday-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border:1px solid var(--border-color);border-radius:8px;font-size:0.8125rem;cursor:pointer}
.schedule-weekday-panel{display:none;margin-bottom:16px}
.schedule-weekday-panel.is-visible{display:block}
.schedule-panel-lead{margin-bottom:12px}
.schedule-panel-summary{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:4px}
.schedule-panel-editor{display:none;margin-top:16px;padding-top:16px;border-top:1px solid var(--border-color)}
.schedule-panel.is-editing .schedule-panel-editor{display:block}
.schedule-panel.is-editing .schedule-panel-summary{display:none}
.schedule-inline-form{margin:0;display:inline}
.run-once-confirm{margin-top:16px;padding-top:16px;border-top:1px solid var(--border-color)}
.run-once-warning{margin:0 0 14px 0;padding:14px 16px;font-size:14px;line-height:1.5;color:#000}
.run-once-warning-danger{background:#fef2f2;border:1px solid #fecaca}
.run-once-warning-safe{background:#f0fdf4;border:1px solid #bbf7d0}
.run-once-actions{display:flex;flex-wrap:wrap;align-items:center;justify-content:flex-start;gap:10px}
.run-once-form{margin:0}
.btn-run-cancel{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;font-size:14px;font-weight:600;border-radius:0;border:1px solid #d1d5db;background:#e5e7eb;color:#111;cursor:pointer;font-family:inherit;line-height:1.2}
.btn-run-confirm-danger{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;font-size:14px;font-weight:600;border-radius:0;border:1px solid #dc2626;background:#dc2626;color:#fff;cursor:pointer;font-family:inherit;line-height:1.2}
.btn-run-confirm-safe{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;font-size:14px;font-weight:600;border-radius:0;border:1px solid #16a34a;background:#16a34a;color:#fff;cursor:pointer;font-family:inherit;line-height:1.2}
.btn-activate-schedule{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;font-size:14px;font-weight:600;border-radius:0;border:1px solid #16a34a;background:#16a34a;color:#fff;cursor:pointer;font-family:inherit;line-height:1.2}
.btn-activate-schedule:hover{background:#15803d;border-color:#15803d;color:#fff}
.schedule-panel.is-run-once-open .schedule-panel-summary{display:none}
.schedule-panel.is-run-once-open .run-once-confirm{display:block}
.contacts-table-wrap{overflow-x:auto}
.contacts-table{width:100%;border-collapse:collapse;font-size:14px}
.contacts-table th,.contacts-table td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--border-color);vertical-align:top}
.contacts-table th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--gray-600);background:#fafafa}
.contacts-table tbody tr:last-child td{border-bottom:none}
.contacts-mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;word-break:break-all}
.breadcrumb-nav{display:flex;align-items:center;flex-wrap:wrap;font-size:16px;gap:4px;margin-bottom:20px}
.breadcrumb-link{display:inline-flex;align-items:center;color:var(--primary-color);text-decoration:none;font-weight:500;font-size:16px}
.breadcrumb-link:hover{color:var(--primary-dark);text-decoration:underline}
.breadcrumb-separator{margin:0 8px;color:var(--gray-400)}
.breadcrumb-current{display:inline-flex;align-items:center;gap:8px;font-weight:600;color:var(--gray-900);font-size:16px}
.breadcrumb-page-icon{width:20px;height:20px;flex-shrink:0;color:var(--gray-900)}
.btn-sst-black{display:inline-flex;align-items:center;justify-content:center;padding:11px 18px;font-size:14px;font-weight:600;border-radius:0;border:1px solid #000;background:#000;color:#fff;cursor:pointer;font-family:inherit;text-decoration:none;line-height:1.2}
.btn-sst-black:hover{background:#000;border-color:#000;color:#fff}
@media (max-width:768px){
.dashboard-layout{flex-direction:column;height:auto;overflow:visible}
.maker-main{height:auto;overflow:visible}
.maker-main-inner{padding:16px}
}
</style>
