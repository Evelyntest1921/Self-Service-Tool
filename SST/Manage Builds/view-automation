<script>
(function(){
  var schedulePanel = document.getElementById("schedulePanel");
  var scheduleOpenBtn = document.getElementById("scheduleEditOpenBtn");
  if (schedulePanel && scheduleOpenBtn) {
    scheduleOpenBtn.addEventListener("click", function() {
      schedulePanel.classList.add("is-editing");
    });
  }
})();
function openAutomationStudio(el) {
  var name = el.getAttribute("data-automation-name") || "";
  var url = el.getAttribute("data-studio-url") || "";
  var actionCell = el.parentNode;
  var hint = actionCell ? actionCell.querySelector(".copy-hint") : null;
  window.open(url, "_blank", "noopener");
  function markCopied(ok) {
    if (hint) hint.textContent = ok ? "Automation name copied." : "Could not copy the name.";
  }
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(name).then(function () { markCopied(true); }, function () { markCopied(fallbackCopy(name)); });
  } else {
    markCopied(fallbackCopy(name));
  }
}
function fallbackCopy(name) {
  var box = document.createElement("textarea");
  box.value = name;
  document.body.appendChild(box);
  box.select();
  var ok = false;
  try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
  document.body.removeChild(box);
  return ok;
}
</script>
