var pageStatus = Platform.Variable.GetValue("@pageStatus") || "";
var authOk = Platform.Variable.GetValue("@authOk") || "";
var accessToken = Platform.Variable.GetValue("@accessToken") || "";
if (String(Platform.Variable.GetValue("@authPending") || "") === "true") {
  var authObj = parseJsonSafe(Platform.Variable.GetValue("@authResponse") || "");
  accessToken = authObj && authObj.access_token ? String(authObj.access_token) : "";
  if (accessToken) {
    authOk = "true";
    Platform.Variable.SetValue("@accessToken", accessToken);
    Platform.Variable.SetValue("@authOk", "true");
  } else {
    pageStatus = "authfail";
    Platform.Variable.SetValue("@pageStatus", "authfail");
    Platform.Variable.SetValue("@loadError", "Auth response missing access token.");
  }
}
var subdomain = Platform.Variable.GetValue("@subdomain") || "";
var automationGuid = normalizeAutomationRef(Platform.Variable.GetValue("@automationId") || "");
var automationCustomerKey = normalizeAutomationRef(Platform.Variable.GetValue("@automationCustomerKey") || "");
var connectedAutomationName = strTrim(Platform.Variable.GetValue("@connectedAutomationName") || "");
var metaHtml = "";
var stepsHtml = "";
var studioUrl = "";
var apiName = "";

try {
  if (
    pageStatus === "view" &&
    authOk === "true" &&
    accessToken &&
    subdomain &&
    (automationGuid || automationCustomerKey)
  ) {
    var actionOn = String(Platform.Variable.GetValue("@autoActionOn") || "") === "true";
    var actionName = strTrim(Platform.Variable.GetValue("@autoAction") || "").toLowerCase();
    var customerKey = automationCustomerKey;
    var beforeAction = actionOn
      ? getAutomation(subdomain, accessToken, automationGuid, automationCustomerKey, connectedAutomationName)
      : { ok: false, obj: null };
    if (actionOn && actionName === "stop") {
      if (beforeAction.ok && isRunningStatus(beforeAction.obj)) {
        var stopResp = postJsonAction(subdomain, accessToken, beforeAction.obj.id, "stop");
        Platform.Variable.SetValue("@actionOk", stopResp.status == 200 || stopResp.status == 202 ? "true" : "false");
        Platform.Variable.SetValue("@actionMsg", stopResp.status == 200 || stopResp.status == 202 ? "Stop requested." : "Stop failed HTTP " + stopResp.status + " " + clip(stopResp.body, 180));
      } else {
        Platform.Variable.SetValue("@actionOk", "false");
        Platform.Variable.SetValue("@actionMsg", "Automation is not running. Stop was not sent.");
      }
    }
    if (actionOn && actionName === "pause") {
      var pauseResp = soapSchedule(
        subdomain,
        accessToken,
        (beforeAction.obj && beforeAction.obj.id) || automationGuid,
        customerKey || (beforeAction.obj && beforeAction.obj.key) || "",
        "pause",
        null
      );
      Platform.Variable.SetValue("@actionOk", pauseResp.ok ? "true" : "false");
      Platform.Variable.SetValue("@actionMsg", pauseResp.ok ? "Pause requested." : "Pause failed HTTP " + pauseResp.status + " " + pauseResp.body);
    }
    if (actionOn && actionName === "runonce") {
      var runTargetId = beforeAction.obj && beforeAction.obj.id;
      if (beforeAction.ok && isRunningStatus(beforeAction.obj)) {
        Platform.Variable.SetValue("@actionOk", "false");
        Platform.Variable.SetValue("@actionMsg", "Automation is already running. Stop it first or wait for the run to finish.");
      } else {
        var runResp = postJsonAction(subdomain, accessToken, runTargetId, "runallonce");
        Platform.Variable.SetValue("@actionOk", runResp.status == 200 || runResp.status == 202 ? "true" : "false");
        Platform.Variable.SetValue("@actionMsg", runResp.status == 200 || runResp.status == 202 ? "Run once requested." : "Run once failed HTTP " + runResp.status + " " + clip(runResp.body, 180));
      }
    }
    if (actionOn && actionName === "activate") {
      var notes = "";
      var targetId = beforeAction.obj && beforeAction.obj.id;
      if (beforeAction.ok && isRunningStatus(beforeAction.obj)) {
        var preStop = postJsonAction(subdomain, accessToken, targetId, "stop");
        notes = preStop.status == 200 || preStop.status == 202 ? "Running instance stop requested. " : "Stop before activate failed HTTP " + preStop.status + ". ";
      }
      var schedulePayload = buildSchedulePayload(
        Platform.Variable.GetValue("@schedFreq") || "",
        Platform.Variable.GetValue("@schedStart") || "",
        Platform.Variable.GetValue("@schedInterval") || "",
        Platform.Variable.GetValue("@schedMinute") || "",
        Platform.Variable.GetValue("@schedWeekdays") || "",
        Platform.Variable.GetValue("@schedEnd") || "",
        Platform.Variable.GetValue("@schedEndDate") || "",
        Platform.Variable.GetValue("@schedOccurrences") || ""
      );
      var activateResp = soapSchedule(subdomain, accessToken, targetId, customerKey, "start", schedulePayload);
      Platform.Variable.SetValue("@actionOk", activateResp.ok ? "true" : "false");
      Platform.Variable.SetValue("@actionMsg", notes + (activateResp.ok ? "Activate schedule requested." : "Activate failed HTTP " + activateResp.status + " " + activateResp.body));
    }
    var fetched = getAutomation(
      subdomain,
      accessToken,
      automationGuid,
      automationCustomerKey,
      connectedAutomationName
    );
    if (fetched.ok && fetched.obj) {
      var obj = fetched.obj;
      queueAutomationAnalyticsBackfill(obj, automationGuid, automationCustomerKey);
      apiName = obj.name ? String(obj.name) : "";
      studioUrl = MC_CLOUD + "#app/Automation%20Studio/AutomationStudioFuel3/";
      applyScheduleFormDefaultsFromAutomation(obj);
      var runningNow = isRunningStatus(obj);
      var pausedNow = isPausedStatus(obj);
      metaHtml = buildMetaHtml(obj, studioUrl, apiName);
      stepsHtml = buildStepsHtml(obj);
      Platform.Variable.SetValue("@automationRunning", runningNow ? "true" : "false");
      Platform.Variable.SetValue("@automationActivityCount", String(countAutomationActivities(obj)));
      Platform.Variable.SetValue("@automationFlowHtml", buildFlowHtml(obj));
      var runOnceWarning = analyzeRunOnceWarning(obj, Platform.Variable.GetValue("@sourceDeName") || "");
      var schedStartVal = strTrim(Platform.Variable.GetValue("@schedStart") || "");
      if (!schedStartVal) {
        schedStartVal = scheduleStartFromAutomation(obj);
        if (!schedStartVal) schedStartVal = defaultEasternStartDateTime();
      }
      schedStartVal = datetimeLocalValueFromScheduleStart(schedStartVal);
      Platform.Variable.SetValue("@schedStart", schedStartVal);
      Platform.Variable.SetValue("@automationSchedulePanelHtml", buildSchedulePanelHtml(
        Platform.Variable.GetValue("@jid") || "",
        Platform.Variable.GetValue("@schedFreq") || "hourly",
        schedStartVal,
        Platform.Variable.GetValue("@schedInterval") || "1",
        Platform.Variable.GetValue("@schedEnd") || "never",
        Platform.Variable.GetValue("@schedEndDate") || "",
        Platform.Variable.GetValue("@schedOccurrences") || "2",
        Platform.Variable.GetValue("@schedWeekdays") || "mon",
        runningNow,
        pausedNow,
        buildScheduleSummary(obj),
        String(Platform.Variable.GetValue("@scheduleEditorOpen") || "") === "true",
        String(Platform.Variable.GetValue("@runOnceConfirmOpen") || "") === "true",
        runOnceWarning
      ));
    } else {
      Platform.Variable.SetValue("@pageStatus", "apifail");
      Platform.Variable.SetValue("@loadError", fetched.msg || "Could not load automation.");
    }
  }
} catch (loadEx) {
  Platform.Variable.SetValue("@pageStatus", "apifail");
  Platform.Variable.SetValue("@loadError", "Could not load automation: " + (loadEx.message || String(loadEx)));
}

Platform.Variable.SetValue("@automationMetaHtml", metaHtml);
Platform.Variable.SetValue("@automationStepsHtml", stepsHtml);
Platform.Variable.SetValue("@automationStudioUrl", studioUrl);
Platform.Variable.SetValue("@apiAutomationName", apiName);
</script>
