<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
:root{--text-primary:#111827;--text-secondary:#6b7280;--border-color:#e5e7eb;--bg-secondary:#f9fafb;--danger:#b91c1c;--dangerbg:#fef2f2;--radius-md:0.5rem}
