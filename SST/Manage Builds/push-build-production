body{font-family:Inter,-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg-secondary);color:var(--text-primary);line-height:1.55}
.dashboard-layout{display:flex;height:100vh;min-height:100vh;overflow:hidden}
.maker-main{flex:1;min-width:0;height:100vh;overflow:hidden;display:flex;flex-direction:column}
.maker-main-inner{flex:1;overflow-y:auto;padding:32px 40px 48px}
h1{font-size:1.65rem;margin-bottom:8px;font-weight:700}
.sub{color:var(--text-secondary);margin-bottom:22px;max-width:720px}
.panel{background:#fff;border:1px solid var(--border-color);padding:26px 30px;margin-bottom:20px;border-radius:12px}
.panel-title{font-size:1rem;font-weight:700;margin:0 0 16px 0}
.push-plan-intro{margin-bottom:16px;font-size:14px;color:var(--text-secondary)}
.push-steps{list-style:none;padding:0;margin:0;counter-reset:pushstep}
.push-step{border:1px solid var(--border-color);border-radius:10px;padding:18px 20px;margin-bottom:14px;background:#fafafa}
.push-step-head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.push-step-num{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:999px;background:#111827;color:#fff;font-size:13px;font-weight:600}
.push-step-badge{font-size:11px;font-weight:600;text-transform:uppercase;padding:3px 8px;border-radius:999px;background:#e5e7eb;color:#374151}
.push-step.state-done .push-step-badge{background:#d1fae5;color:#065f46}
.push-step.state-blocked .push-step-badge{background:#fee2e2;color:#991b1b}
.push-step-note,.push-step-status{font-size:13px;color:var(--text-secondary);margin:4px 0}
.push-step-warn{font-size:13px;color:var(--danger);margin:8px 0 0}
.push-step-form{margin-top:12px}
.btn-step{padding:9px 14px;font-size:13px}
.push-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:20px}
.btn{padding:11px 18px;border-radius:var(--radius-md);font-weight:600;font-size:14px;cursor:pointer;border:1px solid transparent;font:inherit;text-decoration:none;display:inline-flex;align-items:center}
.btn-neutral{color:#111827;border-color:var(--border-color);background:#fff}
.btn-neutral:hover{background:#fafafa}
.btn-push{background:#059669;color:#fff;border-color:#059669}
.btn-push:hover{background:#047857}
.banner{padding:14px 16px;border-radius:10px;margin-bottom:16px;font-size:14px;border:1px solid var(--border-color)}
.banner.bad{border-color:#fecaca;background:var(--dangerbg);color:var(--danger)}
.banner.good{border-color:#a7f3d0;background:#ecfdf5;color:#065f46}
.push-log{margin:12px 0 0 20px;font-size:14px}
.push-log li{margin:6px 0}
.push-campaign-row{margin:0 0 18px;padding:14px 16px;border:1px solid var(--border-color);border-radius:10px;background:#fff}
.push-campaign-label{display:block;font-size:13px;font-weight:600;margin-bottom:6px}
.push-campaign-input{width:100%;max-width:320px;padding:9px 11px;border:1px solid var(--border-color);border-radius:8px;font:inherit}
.push-campaign-hint{font-size:12px;color:var(--text-secondary);margin-top:8px}
</style>
<script>
function pbConfirmPushStep(form){
 var main=document.getElementById("pushCampaignIdField");
 var hid=form.querySelector('input[name="campaignId"]');
 if(main&&hid){hid.value=main.value.trim();}
 return confirm("Push only this step to Production?");
}
</script>
</head>
<body>
<div class="dashboard-layout">
%%=TreatAsContent(@editSidebarHtml)=%%
<main class="maker-main">
<div class="maker-main-inner">
<h1>Push to Production</h1>
%%[ IF @pageStatus == "nodata" THEN ]%%
<p class="sub">Open this page with <strong>journeyId</strong> from Manage Build.</p>
%%[ ELSE ]%%
<p class="sub">Recreate stack artifacts in Production using the <strong>build name</strong> as CustomerKey/Name (same as a new stack build). Nothing is copied from UAT. Steps depend on <strong>journeyType</strong>.</p>
%%=TreatAsContent(@pushResultBanner)=%%
<div class="panel">
 <p class="panel-title">Build: %%=v(@dispName)=%%</p>
 <p class="sub" style="margin-bottom:12px">Journey ID: <code>%%=v(@jid)=%%</code></p>
 %%=TreatAsContent(@manifestHtml)=%%
</div>
%%[ IF NOT Empty(@pushBlockedMsg) AND (@pageStatus == "review" OR @pageStatus == "step_done" OR @pageStatus == "step_failed") THEN ]%%
<div class="banner bad">%%=v(@pushBlockedMsg)=%%</div>
%%[ ENDIF ]%%
%%[ IF @pageStatus == "step_done" OR @pageStatus == "step_failed" THEN ]%%
<div class="panel">
 <p class="panel-title">Step log</p>
 %%=TreatAsContent(@pushLogHtml)=%%
</div>
<a class="btn btn-neutral" href="%%=Concat(@PUSH_PAGE_SELF,"?journeyId=",@jid,IIF(Empty(@pushCampaignId),"",Concat("&campaignId=",@pushCampaignId)))=%%">Back to push steps</a>
<a class="btn btn-neutral" href="%%=Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid)=%%">Manage Build</a>
%%[ ELSEIF @pageStatus == "review" THEN ]%%
<a class="btn btn-neutral" href="%%=Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid)=%%">Back to Manage Build</a>
%%[ ENDIF ]%%
%%[ ENDIF ]%%
</div>
</main>
</div>
</body>
</html>
