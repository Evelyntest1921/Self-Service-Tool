%%[
VAR @HOME_URL, @BUILD_PAGE_SELF, @PUSH_PAGE_SELF, @jid, @confirmStep
VAR @navRows, @navRow, @detailRows, @detailRow, @detailCount
VAR @dispName, @dispType, @pageStatus, @pushBlockedMsg, @pushLogHtml, @pushResultBanner
VAR @manifestHtml, @editSidebarHtml, @buildNavContext, @buildNavActive
VAR @STACK_JOURNEY_TYPE, @AUTH_PROD_USER, @pushBackHref, @manageHref, @isStackBuild

SET @STACK_JOURNEY_TYPE = "Journey + Automation"
SET @AUTH_PROD_USER = "Admin_Production"
SET @HOME_URL = ""
SET @BUILD_PAGE_SELF = ""
SET @PUSH_PAGE_SELF = ""
SET @jid = Trim(RequestParameter("journeyId"))
IF Empty(@jid) THEN
 SET @jid = Trim(QueryParameter("journeyId"))
ENDIF
SET @confirmStep = "0"
IF RequestParameter("confirmStep") == "1" THEN
 SET @confirmStep = "1"
ENDIF
SET @pageStatus = "review"
SET @pushBlockedMsg = ""
SET @pushLogHtml = ""
SET @pushResultBanner = ""
SET @manifestHtml = ""
SET @buildNavContext = "true"
SET @buildNavActive = "manage"
SET @isStackBuild = "false"
SET @dispName = ""
SET @dispType = ""
SET @detailCount = 0

SET @navRows = LookupRows("bd_sst_page_navigation","type","cloudpage")
IF RowCount(@navRows) > 0 THEN
 SET @navRow = Row(@navRows,1)
 SET @HOME_URL = Field(@navRow,"ss_home",0)
 SET @BUILD_PAGE_SELF = Field(@navRow,"ss_edit",0)
 SET @PUSH_PAGE_SELF = Trim(Field(@navRow,"ss_push_production",0))
ENDIF

IF Empty(@jid) THEN
 SET @pageStatus = "nodata"
ELSE
 SET @detailRows = LookupRows("Bd_journey_analytics","journeyId",@jid)
 IF RowCount(@detailRows) == 0 THEN
  SET @detailRows = LookupRows("Bd_journey_analytics","JourneyID",@jid)
 ENDIF
 SET @detailCount = RowCount(@detailRows)
 IF @detailCount == 0 THEN
  SET @pageStatus = "nodata"
 ELSE
  SET @detailRow = Row(@detailRows,1)
  SET @dispName = Field(@detailRow,"journeyName",0)
  SET @dispType = Field(@detailRow,"journeyType",0)
  IF Trim(@dispType) == @STACK_JOURNEY_TYPE THEN
   SET @isStackBuild = "true"
  ENDIF
 ENDIF
ENDIF

SET @pushBackHref = Concat(@PUSH_PAGE_SELF,"?journeyId=",@jid)
SET @manageHref = Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid)
]%%
<script runat="server">
Platform.Load("core", "1");

function pbToStr(v) {
 if (v === null || typeof v === "undefined") {
  return "";
 }
 try {
  return String(v);
 } catch (pbEx) {
  return "";
 }
}

function pbTrim(v) {
 var s = pbToStr(v);
 if (!s) {
  return "";
 }
 var len = s.length;
 if (typeof len !== "number" || isNaN(len) || len < 0) {
  return "";
 }
 var start = 0;
 var end = len;
 while (start < end && (s.charAt(start) === " " || s.charAt(start) === "\t" || s.charAt(start) === "\n" || s.charAt(start) === "\r")) {
  start += 1;
 }
 while (end > start && (s.charAt(end - 1) === " " || s.charAt(end - 1) === "\t" || s.charAt(end - 1) === "\n" || s.charAt(end - 1) === "\r")) {
  end -= 1;
 }
 if (start >= end) {
  return "";
 }
 var out = "";
 var i;
 for (i = start; i < end; i++) {
  out += s.charAt(i);
 }
 return out;
}

function pbHtmlSafe(v) {
 return pbToStr(v)
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;")
  .replace(/"/g, "&quot;");
}

function pbEscJson(s) {
 var text = pbToStr(s);
 var out = "";
 var i;
 for (i = 0; i < text.length; i++) {
  var ch = text.charAt(i);
  if (ch === "\\") {
   out += "\\\\";
  } else if (ch === '"') {
   out += '\\"';
  } else if (ch === "\r") {
   out += "\\r";
  } else if (ch === "\n") {
   out += "\\n";
  } else {
   out += ch;
  }
 }
 return out;
}

function pbHttpOk(statusCode) {
 var code = parseInt(String(statusCode), 10);
 return code === 200 || code === 201 || code === 202;
}

function pbExtractAccessToken(body) {
 var text = pbToStr(body);
 if (!text) {
  return "";
 }
 try {
  var parsed = Platform.Function.ParseJSON(text);
  if (parsed && parsed.access_token) {
   return pbToStr(parsed.access_token);
  }
 } catch (parseEx) {}
 var m = text.match(/"access_token"\s*:\s*"([^"]+)"/);
 if (m && m[1]) {
  return m[1];
 }
 return "";
}

function pbClip(val, maxLen) {
 var s = pbToStr(val);
 var take = maxLen;
 if (!take) {
  take = 3900;
 }
 if (!s) {
  return "";
 }
 var len = s.length;
 if (typeof len !== "number" || len < 1) {
  return "";
 }
 if (len <= take) {
  return s;
 }
 var out = "";
 var i;
 for (i = 0; i < take; i++) {
  out += s.charAt(i);
 }
 return out;
}

function pbSetAmpVar(name, val) {
 var key = pbTrim(name);
 if (!key) {
  return;
 }
 if (key.indexOf("@") !== 0) {
  key = "@" + key;
 }
 try {
  Platform.Variable.SetValue(key, pbClip(val, 3900));
 } catch (setEx) {}
}

function pbLookupAuthScalar(userKey, returnField) {
 var val = "";
 try {
  val = Platform.Function.Lookup("SFMC_AUTH", returnField, "User", userKey);
 } catch (lookupEx) {
  return "";
 }
 return pbTrim(val);
}

function pbAuthForProd() {
 var out = {
  ok: false,
  token: "",
  subdomain: "",
  msg: "",
  userKey: ""
 };
 var keys = ["Admin_Production", "Admin_production", "Production_Admin", "Admin Production"];
 var ki;
 var clientId = "";
 var clientSecret = "";
 var subdomain = "";
 var accountId = "";
 var lookupUser = "";
 for (ki = 0; ki < keys.length; ki++) {
  var candidate = keys[ki];
  clientId = pbLookupAuthScalar(candidate, "clientId");
  if (!clientId) {
   clientId = pbLookupAuthScalar(candidate, "ClientId");
  }
  clientSecret = pbLookupAuthScalar(candidate, "clientSecret");
  if (!clientSecret) {
   clientSecret = pbLookupAuthScalar(candidate, "ClientSecret");
  }
  subdomain = pbLookupAuthScalar(candidate, "subdomain");
  if (!subdomain) {
   subdomain = pbLookupAuthScalar(candidate, "Subdomain");
  }
  if (clientId && clientSecret && subdomain) {
   lookupUser = candidate;
   accountId = pbLookupAuthScalar(candidate, "accountId");
   if (!accountId) {
    accountId = pbLookupAuthScalar(candidate, "AccountId");
   }
   break;
  }
 }
 out.userKey = lookupUser;
 if (!clientId || !clientSecret || !subdomain) {
  out.msg = "No SFMC_AUTH credentials for User=Admin_Production.";
  return out;
 }
 try {
  var authUrl = "https://" + subdomain + ".auth.marketingcloudapis.com/v2/token";
  var payload =
   '{"grant_type":"client_credentials","client_id":"' +
   pbEscJson(clientId) +
   '","client_secret":"' +
   pbEscJson(clientSecret) +
   '"';
  if (accountId) {
   payload += ',"account_id":"' + pbEscJson(accountId) + '"';
  }
  payload += "}";
  var req = new Script.Util.HttpRequest(authUrl);
  req.emptyContentHandling = 0;
  req.retries = 1;
  req.continueOnError = true;
  req.method = "POST";
  req.contentType = "application/json";
  req.postData = payload;
  var resp = req.send();
  var body = "";
  if (resp.content) {
   body = pbToStr(resp.content);
  }
  if (!pbHttpOk(resp.statusCode)) {
   out.msg = "Auth HTTP " + resp.statusCode + " for User=" + lookupUser + " — " + pbClip(pbTrim(body), 160);
   return out;
  }
  var token = pbExtractAccessToken(body);
  if (!token) {
   out.msg = "Auth HTTP " + resp.statusCode + " for User=" + lookupUser + " but no access_token.";
   return out;
  }
  out.ok = true;
  out.token = token;
  out.subdomain = subdomain;
  return out;
 } catch (authEx) {
  out.msg = authEx.message || pbToStr(authEx);
  return out;
 }
}

function pbHttpJson(token, subdomain, method, url, bodyObj) {
 var req = new Script.Util.HttpRequest(url);
 req.emptyContentHandling = 0;
 req.retries = 1;
 req.continueOnError = true;
 req.method = method;
 req.contentType = "application/json";
 req.setHeader("Authorization", "Bearer " + token);
 if (bodyObj !== null && typeof bodyObj !== "undefined") {
  if (typeof bodyObj === "string") {
   req.postData = bodyObj;
  } else {
   req.postData = Platform.Function.Stringify(bodyObj);
  }
 }
 var resp = req.send();
 var body = "";
 if (resp.content) {
  body = pbToStr(resp.content);
 }
 return {
  status: resp.statusCode,
  body: body
 };
}

function pbParseJson(text) {
 try {
  return Platform.Function.ParseJSON(pbToStr(text));
 } catch (parseEx) {
  return null;
 }
}

function pbXmlSafe(s) {
 return pbToStr(s)
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/"/g, "&quot;");
}

function pbSoapXmlDecl() {
 return String.fromCharCode(60, 63) + 'xml version="1.0" encoding="UTF-8"' + String.fromCharCode(63, 62);
}

function pbSoapCall(sub, token, action, bodyXml) {
 var envelope =
  pbSoapXmlDecl() +
  '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing">' +
  "<s:Header>" +
  '<a:Action s:mustUnderstand="1">' +
  action +
  "</a:Action>" +
  '<a:To s:mustUnderstand="1">https://' +
  pbXmlSafe(sub) +
  ".soap.marketingcloudapis.com/Service.asmx</a:To>" +
  '<fueloauth xmlns="http://exacttarget.com">' +
  pbXmlSafe(token) +
  "</fueloauth></s:Header>" +
  '<s:Body xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">' +
  bodyXml +
  "</s:Body></s:Envelope>";
 var req = new Script.Util.HttpRequest("https://" + sub + ".soap.marketingcloudapis.com/Service.asmx");
 req.emptyContentHandling = 0;
 req.retries = 1;
 req.continueOnError = true;
 req.method = "POST";
 req.contentType = "text/xml";
 req.setHeader("SOAPAction", action);
 req.postData = envelope;
 var resp = req.send();
 var body = "";
 if (resp.content) {
  body = pbToStr(resp.content);
 }
 return {
  status: resp.statusCode,
  body: body
 };
}

function pbParseSoapObjectId(body) {
 var text = pbToStr(body);
 var mNew = text.match(/NewObjectID[^>]*>([^<]+)/i);
 if (mNew && pbTrim(mNew[1])) {
  return pbTrim(mNew[1]);
 }
 var mObj = text.match(/ObjectID[^>]*>([^<]+)/i);
 if (mObj && pbTrim(mObj[1])) {
  return pbTrim(mObj[1]);
 }
 return "";
}

function pbRetrieveQueryObjectId(sub, token, queryKey) {
 var key = pbTrim(queryKey);
 if (!key) {
  return "";
 }
 var retrieveKey =
  '<RetrieveRequestMsg xmlns="http://exacttarget.com/wsdl/partnerAPI"><RetrieveRequest>' +
  "<ObjectType>QueryDefinition</ObjectType><Properties>ObjectID</Properties><Properties>CustomerKey</Properties><Properties>Name</Properties>" +
  '<Filter xsi:type="SimpleFilterPart"><Property>CustomerKey</Property><SimpleOperator>equals</SimpleOperator><Value>' +
  pbXmlSafe(key) +
  "</Value></Filter></RetrieveRequest></RetrieveRequestMsg>";
 var found = pbSoapCall(sub, token, "Retrieve", retrieveKey);
 var oid = pbParseSoapObjectId(found.body);
 if (oid) {
  return oid;
 }
 var retrieveName =
  '<RetrieveRequestMsg xmlns="http://exacttarget.com/wsdl/partnerAPI"><RetrieveRequest>' +
  "<ObjectType>QueryDefinition</ObjectType><Properties>ObjectID</Properties><Properties>CustomerKey</Properties><Properties>Name</Properties>" +
  '<Filter xsi:type="SimpleFilterPart"><Property>Name</Property><SimpleOperator>equals</SimpleOperator><Value>' +
  pbXmlSafe(key) +
  "</Value></Filter></RetrieveRequest></RetrieveRequestMsg>";
 var byName = pbSoapCall(sub, token, "Retrieve", retrieveName);
 return pbParseSoapObjectId(byName.body);
}

function pbPad2(n) {
 var x = parseInt(String(n), 10);
 if (isNaN(x) || x < 0) {
  x = 0;
 }
 if (x < 10) {
  return "0" + String(x);
 }
 return String(x);
}

function pbNextHourLocal() {
 var nowVal = new Date();
 nowVal.setMinutes(0, 0, 0);
 nowVal.setHours(nowVal.getHours() + 1);
 return (
  String(nowVal.getFullYear()) +
  "-" +
  pbPad2(nowVal.getMonth() + 1) +
  "-" +
  pbPad2(nowVal.getDate()) +
  "T" +
  pbPad2(nowVal.getHours()) +
  ":" +
  pbPad2(nowVal.getMinutes()) +
  ":00"
 );
}

function pbUntilCompact() {
 var nowVal = new Date();
 nowVal.setDate(nowVal.getDate() + 365);
 return String(nowVal.getFullYear()) + pbPad2(nowVal.getMonth() + 1) + pbPad2(nowVal.getDate());
}

function pbQuerySteps(queryObjectId) {
 return [
  {
   annotation: "",
   stepNumber: 0,
   activities: [
    {
     name: "Query Activity",
     description: "",
     objectTypeId: 300,
     displayOrder: 0,
     activityObjectId: pbToStr(queryObjectId),
     serializedObject: ""
    }
   ]
  }
 ];
}

function pbScheduleWrite(recur, startLocal, timezoneId) {
 return {
  scheduleTypeId: 2,
  startDate: startLocal,
  endDate: startLocal,
  rangeTypeId: 0,
  occurrences: 9999,
  icalRecur: recur,
  timezoneId: timezoneId,
  statusId: 0
 };
}

function pbFindAutomationByKey(token, sub, automationKey) {
 var endpoint = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/automations";
 var url = endpoint + "/key:" + encodeURIComponent(String(automationKey));
 var got = pbHttpJson(token, sub, "GET", url, null);
 if (got.status == 200 && got.body) {
  return pbParseJson(got.body);
 }
 return null;
}

function pbFindAutomationInList(token, sub, name, key) {
 var endpoint = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/automations";
 var page = 1;
 while (page <= 5) {
  var url = endpoint + "?$page=" + page + "&$pagesize=100";
  var r = pbHttpJson(token, sub, "GET", url, null);
  if (r.status != 200) {
   return null;
  }
  var obj = pbParseJson(r.body);
  var items = [];
  if (obj && obj.items) {
   items = obj.items;
  }
  var i;
  for (i = 0; i < items.length; i++) {
   if (key && items[i].key && String(items[i].key).toLowerCase() == String(key).toLowerCase()) {
    return items[i];
   }
  }
  for (i = 0; i < items.length; i++) {
   if (name && items[i].name && String(items[i].name) == String(name)) {
    return items[i];
   }
  }
  if (items.length < 100) {
   break;
  }
  page++;
 }
 return null;
}

function pbCreateOrUpdateAutomation(token, sub, automationName, automationKey, queryObjectId) {
 var startDateLocal = pbNextHourLocal();
 var untilCompact = pbUntilCompact();
 var recurRule = "FREQ=HOURLY;INTERVAL=1;UNTIL=" + untilCompact;
 var timezoneId = 1;
 var endpoint = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/automations";
 var existing = pbFindAutomationByKey(token, sub, automationKey);
 var automationId = "";
 var createdNow = false;
 if (existing && existing.id) {
  automationId = String(existing.id);
 } else {
  var listMatch = pbFindAutomationInList(token, sub, automationName, automationKey);
  if (listMatch && listMatch.id) {
   automationId = String(listMatch.id);
  }
 }
 if (!automationId) {
  var recurAttempts = [recurRule, "FREQ=HOURLY;COUNT=1;INTERVAL=1", "FREQ=MINUTELY;INTERVAL=60;UNTIL=" + untilCompact];
  var createStatus = 0;
  var createBody = "";
  var usedRecur = recurRule;
  var ri;
  for (ri = 0; ri < recurAttempts.length; ri++) {
   usedRecur = recurAttempts[ri];
   var payloadObj = {
    name: String(automationName),
    description: "Created via SST Production push",
    key: String(automationKey),
    steps: pbQuerySteps(queryObjectId),
    startSource: {
     typeId: 1,
     schedule: pbScheduleWrite(usedRecur, startDateLocal, timezoneId)
    }
   };
   var cr = pbHttpJson(token, sub, "POST", endpoint, payloadObj);
   createStatus = cr.status;
   createBody = cr.body;
   if (pbHttpOk(createStatus)) {
    recurRule = usedRecur;
    break;
   }
   if (createBody.indexOf("already exists") >= 0) {
    var recovered = pbFindAutomationInList(token, sub, automationName, automationKey);
    if (recovered && recovered.id) {
     automationId = String(recovered.id);
     break;
    }
   }
  }
  if (!automationId) {
   if (!pbHttpOk(createStatus)) {
    return {
     ok: false,
     automationId: "",
     msg: "Automation create HTTP " + createStatus + " — " + pbClip(pbTrim(createBody), 220)
    };
   }
   var createObj = pbParseJson(createBody);
   if (createObj && createObj.id) {
    automationId = String(createObj.id);
    createdNow = true;
   }
  }
 }
 if (!automationId) {
  return { ok: false, automationId: "", msg: "Automation ID not available after create." };
 }
 var patchEndpoint = endpoint + "/" + encodeURIComponent(automationId);
 pbHttpJson(token, sub, "PATCH", patchEndpoint, {
  id: automationId,
  name: automationName,
  description: "Created via SST Production push",
  key: automationKey,
  steps: pbQuerySteps(queryObjectId),
  startSource: {
   typeId: 1,
   schedule: pbScheduleWrite(recurRule, startDateLocal, timezoneId)
  }
 });
 var verb = "updated";
 if (createdNow) {
  verb = "created";
 }
 return {
  ok: true,
  automationId: automationId,
  msg: "Automation " + verb + " in Production. key=" + automationKey + " id=" + automationId + "."
 };
}

function pbBuildButtonHtml(jid, buildName) {
 var html = '<p class="push-plan-intro">Plan: Production automation only. Query must already exist as <code>' + pbHtmlSafe(buildName) + "</code>.</p>";
 html += '<ol class="push-steps">';
 html += '<li class="push-step state-pending">';
 html += '<div class="push-step-head"><span class="push-step-num">1</span>';
 html += "<strong>Automation</strong>";
 html += '<span class="push-step-badge">pending</span></div>';
 html += '<p class="push-step-note">REST create or update. Attaches the existing Production query named like the build.</p>';
 html +=
  '<form method="post" action="" class="push-step-form" onsubmit="return confirm(\'Push this automation to Production?\');">' +
  '<input type="hidden" name="journeyId" value="' +
  pbHtmlSafe(jid) +
  '">' +
  '<input type="hidden" name="pushStep" value="automation">' +
  '<input type="hidden" name="confirmStep" value="1">' +
  '<button type="submit" class="btn btn-push btn-step">Push automation</button>' +
  "</form>";
 html += "</li></ol>";
 return html;
}

function pbRunAutomationPush(buildName) {
 var logs = [];
 var name = pbTrim(buildName);
 if (!name) {
  return { ok: false, logs: logs, msg: "Build name missing on analytics." };
 }
 logs.push("Looking up Production query and creating automation for \"" + name + "\".");
 var prodAuth = pbAuthForProd();
 if (!prodAuth.ok) {
  logs.push(prodAuth.msg);
  return { ok: false, logs: logs, msg: prodAuth.msg };
 }
 logs.push("Production (" + prodAuth.userKey + ") authentication OK.");
 var queryObjectId = pbRetrieveQueryObjectId(prodAuth.subdomain, prodAuth.token, name);
 if (!queryObjectId) {
  var qMsg =
   "Production query not found for CustomerKey/Name \"" +
   name +
   "\". Create that QueryDefinition in Production first, then push automation.";
  logs.push(qMsg);
  return { ok: false, logs: logs, msg: qMsg };
 }
 logs.push("Found Production query ObjectID " + queryObjectId + ".");
 var autoResult = pbCreateOrUpdateAutomation(
  prodAuth.token,
  prodAuth.subdomain,
  name,
  name,
  queryObjectId
 );
 logs.push(autoResult.msg);
 return { ok: autoResult.ok, logs: logs, msg: autoResult.msg };
}

var pageStatus = "review";
var confirmStep = false;
var jid = "";
var journeyType = "";
var buildName = "";
var isStack = false;
var stepsHtml = "";
var pushLogHtml = "";
var pushResultBanner = "";
var pushBlockedMsg = "";
try {
 pageStatus = pbTrim(Platform.Variable.GetValue("@pageStatus") || "review");
 confirmStep = Platform.Variable.GetValue("@confirmStep") === "1";
 jid = pbTrim(Platform.Variable.GetValue("@jid") || "");
 journeyType = pbTrim(Platform.Variable.GetValue("@dispType") || "");
 buildName = pbTrim(Platform.Variable.GetValue("@dispName") || "");
 isStack = Platform.Variable.GetValue("@isStackBuild") === "true";
 if (pageStatus === "review" && jid) {
  if (!isStack) {
   pushBlockedMsg = "This page only pushes Journey + Automation builds.";
  } else if (!buildName) {
   pushBlockedMsg = "Build name missing on analytics.";
  } else {
   stepsHtml = pbBuildButtonHtml(jid, buildName);
  }
 }
 if (confirmStep && pageStatus === "review" && jid && isStack) {
  var stepResult = pbRunAutomationPush(buildName);
  var li;
  pushLogHtml = '<ol class="push-log">';
  for (li = 0; li < stepResult.logs.length; li++) {
   pushLogHtml += "<li>" + pbHtmlSafe(pbClip(stepResult.logs[li], 500)) + "</li>";
  }
  pushLogHtml += "</ol>";
  if (stepResult.ok) {
   pushResultBanner = '<div class="banner good">' + pbHtmlSafe(pbClip(stepResult.msg, 500)) + "</div>";
   pageStatus = "step_done";
  } else {
   pushResultBanner = '<div class="banner bad">' + pbHtmlSafe(pbClip(stepResult.msg, 500)) + "</div>";
   pageStatus = "step_failed";
  }
 }
} catch (pageEx) {
 pageStatus = "step_failed";
 pushResultBanner = '<div class="banner bad">Push page error: ' + pbHtmlSafe(pbToStr(pageEx.message || pageEx)) + "</div>";
 pushBlockedMsg = pbToStr(pageEx.message || pageEx);
}

pbSetAmpVar("pageStatus", pageStatus);
pbSetAmpVar("manifestHtml", stepsHtml);
pbSetAmpVar("pushLogHtml", pushLogHtml);
pbSetAmpVar("pushResultBanner", pushResultBanner);
pbSetAmpVar("pushBlockedMsg", pushBlockedMsg);
</script>
