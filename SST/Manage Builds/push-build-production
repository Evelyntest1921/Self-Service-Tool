    return found;
  }
  var deName = usableDeKey(name);
  var lookedUp = lookupDeCustomerKeyByName(deName);
  found = tryPlatform(lookedUp);
  if (found) {
    return found;
  }
  if (deName && deName !== usableDeKey(customerKey) && deName !== usableDeKey(alternateKey) && deName !== lookedUp) {
    try {
      return {
        ok: true,
        count: toWholeNumber(Platform.Function.DataExtensionRowCount(String(deName))),
        customerKey: lookedUp || usableDeKey(customerKey) || usableDeKey(alternateKey),
        capped: false,
        msg: ""
      };
    } catch (nameCountEx) {
      lastMsg = rowCountMessage(nameCountEx);
    }
  }
  var i;
  for (i = 0; i < tried.length; i++) {
    var proxied = countRowsByProxy(tried[i]);
    if (proxied.ok) {
      return proxied;
    }
    if (proxied.msg) {
      lastMsg = proxied.msg;
    }
  }
  for (i = 0; i < tried.length; i++) {
    var rested = countRowsByRest(sub, token, tried[i]);
    if (rested.ok) {
      return rested;
    }
    if (rested.msg) {
      lastMsg = rested.msg;
    }
  }
  return {
    ok: false,
    count: 0,
    customerKey: usableDeKey(customerKey) || lookedUp || usableDeKey(alternateKey),
    capped: false,
    msg: lastMsg
  };
}

function loadEntryContext(sub, token, jObj) {
  var ctx = {
    found: false,
    isDe: false,
    mode: "unknown",
    deName: "",
    deKey: "",
    rowCountOk: false,
    rowCount: 0,
    rowCountCapped: false,
    countError: ""
  };
  var ref = findEntryEventRef(jObj);
  if (!ref || !ref.eventDefId) {
    return ctx;
  }
  var fetched = getEventDefinition(sub, token, ref.eventDefId);
  if (!fetched.ok || !fetched.obj) {
    return ctx;
  }
  var evObj = fetched.obj;
  var args = evObj.arguments || {};
  var watermark = args.useHighWatermark;
  ctx.found = true;
  ctx.mode =
    watermark === false || strTrim(watermark).toLowerCase() === "false" ? "all" : "newOnly";
  ctx.isDe = strTrim(evObj.type).toUpperCase().indexOf("AUDIENCE") >= 0;
  if (!ctx.isDe) {
    return ctx;
  }
  var live = resolveLiveEntryDeFromEvent(evObj);
  ctx.deName = live.name || pageVar("logDeName");
  if (ctx.deName.toUpperCase() === "N/A") {
    ctx.deName = live.name;
  }
  ctx.deKey = live.customerKey || pageVar("logDeId");
  if (ctx.deKey.toUpperCase() === "N/A") {
    ctx.deKey = live.customerKey;
  }
  var counted = countDeRows(live.customerKey, ctx.deName, pageVar("logDeId"), sub, token);
  ctx.rowCountOk = counted.ok;
  ctx.rowCount = counted.count;
  ctx.rowCountCapped = !!counted.capped;
  ctx.countError = counted.msg || "";
  if (counted.customerKey) {
    ctx.deKey = counted.customerKey;
  }
  return ctx;
}

function clearDeByKey(customerKey) {
  var key = strTrim(customerKey);
  if (!key) {
    return { ok: false, msg: "Could not resolve the entry data extension key." };
  }
  try {
    var prox = new Script.Util.WSProxy();
    var result = prox.performItem("DataExtension", { CustomerKey: key }, "ClearData", {});
    if (!result) {
      return { ok: false, msg: "Clear returned no result." };
    }
    var results = result.Results || result.results;
    if (results && typeof results.length == "number" && results.length > 0) {
      var first = results[0];
      if (strTrim(first.StatusCode || first.statusCode).toUpperCase() === "OK") {
        return { ok: true, msg: "" };
      }
      return {
        ok: false,
        msg:
          strTrim(first.StatusMessage || first.ErrorMessage || first.statusMessage) ||
          "Clear failed."
      };
    }
    var overall = strTrim(result.OverallStatus || result.overallStatus || result.Status);
    if (overall.toUpperCase() === "OK") {
      return { ok: true, msg: "" };
    }
    return { ok: false, msg: overall || "Clear failed." };
  } catch (clearEx) {
    return { ok: false, msg: clearEx.message || String(clearEx) };
  }
}

function loadAutomationContext(sub, token) {
  var ctx = {
    found: false,
    msg: "",
    obj: null,
    name: "",
    statusLabel: "",
    active: false,
    running: false
  };
  var guid = normalizeAutomationRef(pageVar("automationGuid"));
  var key = normalizeAutomationRef(pageVar("automationCustomerKey"));
  var name = pageVar("automationName");
  if (!guid && !key && !name) {
    ctx.msg = "This build has no automation recorded on its build log.";
    return ctx;
  }
  var fetched = getAutomation(sub, token, guid, key, name);
  if (!fetched.ok || !fetched.obj) {
    ctx.msg = "Could not load the automation. " + (fetched.msg || "");
    return ctx;
  }
  var obj = fetched.obj;
  var scheduleStatus = strTrim((obj.schedule || {}).scheduleStatus).toLowerCase();
  ctx.found = true;
  ctx.obj = obj;
  ctx.name = strTrim(obj.name) || name;
  ctx.statusLabel = automationStatusLabel(obj);
  ctx.running = isRunningStatus(obj);
  ctx.active =
    isScheduledStatus(obj) ||
    (ctx.running && (scheduleStatus === "scheduled" || scheduleStatus === "active"));
  return ctx;
}

function automationSoapKey(obj) {
  return normalizeAutomationRef(pageVar("automationCustomerKey")) || strTrim(obj.key);
}

function easternFormValueToUtcMs(value) {
  var parts = parseScheduleStartParts(strTrim(value));
  if (!parts) {
    return -1;
  }
  return easternWallPartsToUtcMs(parts);
}

function scheduleDefaultsFromAutomation(obj) {
  var out = {
    freq: "hourly",
    interval: "1",
    weekdays: "mon",
    endMode: "never",
    endDate: "",
    occurrences: "2",
    start: "",
    startIsPast: false
  };
  if (!obj) {
    return out;
  }
  var ical = strTrim((obj.schedule || {}).icalRecur || "");
  var freq = scheduleFrequencyFromObj(obj);
  if (freq) {
    out.freq = freq;
    var endDefaults = scheduleEndDefaultsFromAutomation(obj);
    out.endMode = endDefaults.mode || "never";
    out.endDate = endDefaults.endDate || "";
    out.occurrences = endDefaults.occurrences || "2";
  }
  out.interval = scheduleIntervalFromIcal(ical, out.freq);
  out.weekdays = scheduleWeekdaysFromIcal(ical);
  var start = datetimeLocalValueFromScheduleStart(scheduleStartFromAutomation(obj));
  var startMs = easternFormValueToUtcMs(start);
  if (startMs >= 0) {
    out.start = start;
    out.startIsPast = startMs <= new Date().getTime();
  }
  return out;
}

function readScheduleInput() {
  return {
    freq: pageVar("schedFreq").toLowerCase(),
    start: pageVar("schedStart"),
    interval: pageVar("schedInterval"),
    minute: pageVar("schedMinute"),
    weekdays: pageVar("schedWeekdays").toLowerCase(),
    endMode: pageVar("schedEnd").toLowerCase(),
    endDate: pageVar("schedEndDate"),
    occurrences: pageVar("schedOccurrences")
  };
}

function validateScheduleInput(input, minLeadMs) {
  if (!input.freq || SCHEDULE_FREQUENCIES.indexOf("|" + input.freq + "|") < 0) {
    return { ok: false, scheduleProblem: true, msg: "Choose how often the automation repeats." };
  }
  var startMs = easternFormValueToUtcMs(input.start);
  if (startMs < 0) {
    return { ok: false, scheduleProblem: true, msg: "Choose a start date and time." };
  }
  if (startMs <= new Date().getTime() + minLeadMs) {
    return {
      ok: false,
      scheduleProblem: true,
      msg: "The schedule start time has passed. Go back to Schedule and pick a later start."
    };
  }
  if (input.freq === "weekly" && !input.weekdays) {
    return { ok: false, scheduleProblem: true, msg: "Choose at least one day of the week." };
  }
  if (input.freq !== "once" && input.endMode === "enddate") {
    var endKey = dateKeyFromIsoValue(input.endDate);
    var startKey = dateKeyFromIsoValue(input.start);
    if (!endKey || endKey < startKey) {
      return {
        ok: false,
        scheduleProblem: true,
        msg: "The schedule end date must be on or after the start date."
      };
    }
  }
  return { ok: true, msg: "" };
}

function schedulePayloadFromInput(input) {
  return buildSchedulePayload(
    input.freq,
    input.start,
    input.interval,
    input.minute,
    input.weekdays,
    input.endMode,
    input.endDate,
    input.occurrences
  );
}

function publishErrorsFrom(obj) {
  var out = [];
  if (!obj) {
    return out;
  }
  var errs = obj.errors;
  var i;
  for (i = 0; i < safeArrayLength(errs); i++) {
    var err = safeArrayGet(errs, i);
    if (!err) {
      continue;
    }
    var detail = strTrim(err.errorDetail || err.message || err.errorMessage || err.errorCode);
    var info = err.additionalInfo || {};
    var activityKey = strTrim(info.activityKey);
    if (detail) {
      out.push(clip(detail, 300) + (activityKey ? " (activity " + activityKey + ")" : ""));
    }
  }
  return out;
}

function actionPublish(sub, token, jid) {
  var got = getJourneyObject(sub, token, jid);
  if (!got.ok) {
    return { ok: false, msg: got.msg };
  }
  var status = strTrim(got.obj.status);
  if (journeyStatusIsRunning(status)) {
    Platform.Variable.SetValue("@logJourneyStatus", "Running");
    return { ok: true, alreadyRunning: true, statusId: "", msg: "Journey is already running." };
  }
  var versionNum = got.obj.version || 1;
  var url =
    restBase(sub) +
    "interaction/v1/interactions/publishAsync/" +
    encodeURIComponent(jid) +
    "?versionNumber=" +
    encodeURIComponent(String(versionNum));
  var resp = journeyHttpJson(token, "POST", url, "{}");
  var parsed = parseJsonSafe(resp.body);
  if (resp.status != 200 && resp.status != 201 && resp.status != 202) {
    var errors = publishErrorsFrom(parsed);
    var detail = parsed && parsed.message ? strTrim(parsed.message) : "";
    if (!detail && !errors.length) {
      detail = clip(resp.body, 200);
    }
    return {
      ok: false,
      errors: errors,
      msg:
        "Journey Builder rejected the publish request (HTTP " +
        resp.status +
        ")." +
        (detail ? " " + detail : "")
    };
  }
  return {
    ok: true,
    alreadyRunning: false,
    statusId: parsed && parsed.statusId ? String(parsed.statusId) : "",
    msg: "Publish request accepted."
  };
}

function actionPublishStatus(sub, token, jid, statusId) {
  var out = { ok: true, state: "pending", errors: [], journeyStatus: "", msg: "" };
  var got = getJourneyObject(sub, token, jid);
  if (got.ok && got.obj) {
    out.journeyStatus = strTrim(got.obj.status);
    if (journeyStatusIsRunning(out.journeyStatus)) {
      out.state = "running";
      Platform.Variable.SetValue("@logJourneyStatus", "Running");
      return out;
    }
  }
  if (!statusId) {
    return out;
  }
  var resp = journeyHttpJson(
    token,
    "GET",
    restBase(sub) + "interaction/v1/interactions/publishStatus/" + encodeURIComponent(statusId),
    null
  );
  if (resp.status != 200) {
    return out;
  }
  var parsed = parseJsonSafe(resp.body);
  if (!parsed) {
    return out;
  }
  var publishState = strTrim(parsed.status).toLowerCase();
  var errors = publishErrorsFrom(parsed);
  var inProcess = publishState.indexOf("inprocess") >= 0 || publishState.indexOf("progress") >= 0;
  if (publishState.indexOf("fail") >= 0 || publishState.indexOf("error") >= 0 || (errors.length && !inProcess)) {
    out.state = "failed";
    out.errors = errors;
    out.msg = "Journey Builder could not publish this journey.";
  }
  return out;
}

function actionSaveSchedule(sub, token) {
  var input = readScheduleInput();
  var valid = validateScheduleInput(input, SAVE_SCHEDULE_MIN_LEAD_MS);
  if (!valid.ok) {
    return valid;
  }
  var auto = loadAutomationContext(sub, token);
  if (!auto.found) {
    return { ok: false, msg: auto.msg };
  }
  if (auto.active) {
    return { ok: true, msg: "The automation schedule is already active." };
  }
  if (auto.running) {
    return {
      ok: false,
      msg: "The automation is running right now. Wait for the run to finish, then retry."
    };
  }
  var payload = schedulePayloadFromInput(input);
  var soapKey = automationSoapKey(auto.obj);
  var started = soapSchedule(sub, token, auto.obj.id, soapKey, "start", payload);
  if (!started.ok) {
    return {
      ok: false,
      scheduleProblem: true,
      msg: "Automation Studio rejected the schedule. " + soapFaultText(started.body)
    };
  }
  var paused = soapSchedule(sub, token, auto.obj.id, soapKey, "pause", null);
  if (!paused.ok) {
    return {
      ok: false,
      msg:
        "The schedule was saved but the automation could not be paused again, so it is now scheduled. Pause it on the Automation page if you are not ready to activate. " +
        soapFaultText(paused.body)
    };
  }
  return { ok: true, msg: "Schedule saved." };
}

function actionStartAutomation(sub, token, jid) {
  var got = getJourneyObject(sub, token, jid);
  if (!got.ok) {
    return { ok: false, msg: got.msg };
  }
  if (!journeyStatusIsRunning(strTrim(got.obj.status))) {
    return {
      ok: false,
      msg: "The journey is not running yet, so the automation was not started."
    };
  }
  var auto = loadAutomationContext(sub, token);
  if (!auto.found) {
    return { ok: false, msg: auto.msg };
  }
  if (auto.active) {
    Platform.Variable.SetValue("@logAutomationStatus", "Scheduled");
    return { ok: true, msg: "The automation schedule is already active." };
  }
  if (auto.running) {
    return {
      ok: false,
      msg: "The automation is running right now. Wait for the run to finish, then retry."
    };
  }
  var input = readScheduleInput();
  var valid = validateScheduleInput(input, 0);
  if (!valid.ok) {
    return valid;
  }
  var started = soapSchedule(
    sub,
    token,
    auto.obj.id,
    automationSoapKey(auto.obj),
    "start",
    schedulePayloadFromInput(input)
  );
  if (!started.ok) {
    return {
      ok: false,
      scheduleProblem: true,
      msg: "Automation Studio rejected the schedule. " + soapFaultText(started.body)
    };
  }
  Platform.Variable.SetValue("@logAutomationStatus", "Scheduled");
  return { ok: true, msg: "Automation schedule is active." };
}

function actionSaveAlertEmail(jid) {
  var email = strTrim(Platform.Variable.GetValue("@alertEmail") || "");
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    return { ok: false, msg: "Enter a valid alert email address." };
  }
  try {
    Platform.Function.UpsertData(
      "Bd_journey_analytics",
      ["journeyId"],
      [strTrim(jid)],
      ["alertEmail", "updateDate"],
      [email.substring(0, 254), new Date()]
    );
    return { ok: true, msg: "Alert email saved." };
  } catch (emailEx) {
    return { ok: false, msg: "Could not save the alert email: " + (emailEx.message || String(emailEx)) };
  }
}

function actionAudience(sub, token, jid, clearRequested) {
  var got = getJourneyObject(sub, token, jid);
  if (!got.ok) {
    return { ok: false, msg: got.msg };
  }
  var entry = loadEntryContext(sub, token, got.obj);
  if (!entry.isDe || !entry.deKey) {
    return { ok: false, msg: "Could not resolve the entry data extension for this journey." };
  }
  if (clearRequested) {
    if (pageVar("isStackBuild") !== "true") {
      return {
        ok: false,
        msg: "Clearing is only available for Journey + Automation builds."
      };
    }
    if (journeyStatusIsRunning(strTrim(got.obj.status))) {
      var auto = loadAutomationContext(sub, token);
      if (!auto.found || auto.active || auto.running) {
        return {
          ok: false,
          msg: "This build is active or running. The data extension was not cleared."
        };
      }
    }
    var cleared = clearDeByKey(entry.deKey);
    if (!cleared.ok) {
      return { ok: false, msg: "Could not clear the data extension. " + cleared.msg };
    }
  }
  var counted = countDeRows(entry.deKey, entry.deName, pageVar("logDeId"), sub, token);
  return {
    ok: true,
    rowCountOk: counted.ok,
    rowCount: counted.count,
    rowCountCapped: !!counted.capped,
    countError: counted.msg || "",
    msg: clearRequested ? "Data extension cleared." : ""
  };
}

function runAction(action, sub, token, jid) {
  if (action === "publishstatus") {
    return actionPublishStatus(sub, token, jid, pageVar("actStatusId"));
  }
  if (action === "recount") {
    return actionAudience(sub, token, jid, false);
  }
  if (action === "savealertemail") {
    if (!requestMethodIsPost()) {
      return { ok: false, msg: "This action must be sent as a POST request." };
    }
    return actionSaveAlertEmail(jid);
  }
  if (!requestMethodIsPost()) {
    return { ok: false, msg: "This action must be sent as a POST request." };
  }
  if (action === "clearde") {
    return actionAudience(sub, token, jid, true);
  }
  if (action === "publish") {
    return actionPublish(sub, token, jid);
  }
  if (action === "saveschedule" || action === "startautomation") {
    if (pageVar("isStackBuild") !== "true") {
      return { ok: false, msg: "This build has no automation to schedule." };
    }
    if (action === "saveschedule") {
      return actionSaveSchedule(sub, token);
    }
    return actionStartAutomation(sub, token, jid);
  }
  return { ok: false, msg: "Unknown activation action." };
}

function buildPageView(sub, token, jid) {
  var fetched = getJourneyObject(sub, token, jid);
  if (!fetched.ok || !fetched.obj) {
    return { ok: false, msg: fetched.msg || "Could not load journey." };
  }
  var jObj = fetched.obj;
  var isStack = pageVar("isStackBuild") === "true";
  var journeyStatus = strTrim(jObj.status);
  var journeyVersion =
    jObj.version !== undefined && jObj.version !== null ? String(jObj.version) : "";
  var activities = coerceActivityList(jObj.activities);
  var emailReview = buildEmailReview(activities, buildSenderProfileLookupCache(activities));
  var flowHtml = buildFlowGraphHtml(findFlowStartActivity(activities, jObj), activities);
  var entry = loadEntryContext(sub, token, jObj);
  var automation = { found: false, msg: "", name: "", statusLabel: "", active: false, running: false };
  var schedule = scheduleDefaultsFromAutomation(null);
  if (isStack) {
    var auto = loadAutomationContext(sub, token);
    automation = {
      found: auto.found,
      msg: auto.msg,
      name: auto.name,
      statusLabel: auto.statusLabel,
      active: auto.active,
      running: auto.running
    };
    schedule = scheduleDefaultsFromAutomation(auto.obj);
  }
  var data = {
    jid: jid,
    journeyName: strTrim(jObj.name) || pageVar("dispName"),
    journeyStatus: journeyStatus,
    journeyRunning: journeyStatusIsRunning(journeyStatus),
    journeyStopped: journeyStatus.toLowerCase() === "stopped",
    isStack: isStack,
    alertEmail: pageVar("alertEmail"),
    emails: { count: emailReview.count, issues: emailReview.issues },
    audience: {
      found: entry.found,
      isDe: entry.isDe,
      mode: entry.mode,
      deName: entry.deName || entry.deKey,
      rowCountOk: entry.rowCountOk,
      rowCount: entry.rowCount,
      rowCountCapped: entry.rowCountCapped,
      countError: entry.countError,
      canClear: isStack && entry.isDe && entry.deKey !== ""
    },
    automation: automation,
    schedule: schedule,
    urls: {
      manage: pageVar("manageHref"),
      journey: pageVar("journeyHref"),
      automation: pageVar("automationHref"),
      journeyBuilder: buildJourneyOpenUrl(MC_CLOUD, jid, journeyVersion)
    }
  };
  return { ok: true, msg: "", data: data, emailsHtml: emailReview.html, flowHtml: flowHtml };
}

var pageStatus = pageVar("pageStatus");
var actAction = pageVar("actAction");
var jsonMode = actAction !== "";
var actResult = { ok: false, msg: "" };
var accessToken = "";

try {
  if (pageVar("authPending") === "true") {
    var authObj = parseJsonSafe(Platform.Variable.GetValue("@authResponse") || "");
    accessToken = authObj && authObj.access_token ? String(authObj.access_token) : "";
    if (!accessToken) {
      pageStatus = "authfail";
      Platform.Variable.SetValue("@loadError", "Auth response missing access token.");
    }
  }
  if (jsonMode) {
    if (pageStatus !== "view" || !accessToken) {
      actResult = {
        ok: false,
        msg: pageVar("loadError") || "This build could not be loaded for activation."
      };
    } else {
      actResult = runAction(actAction, pageVar("subdomain"), accessToken, pageVar("jid"));
    }
  } else if (pageStatus === "view" && accessToken) {
    var view = buildPageView(pageVar("subdomain"), accessToken, pageVar("jid"));
    if (view.ok) {
      Platform.Variable.SetValue("@emailsHtml", view.emailsHtml);
      Platform.Variable.SetValue("@flowHtml", view.flowHtml);
      Platform.Variable.SetValue("@pageDataJson", jsonForScript(view.data));
    } else {
      pageStatus = "apifail";
      Platform.Variable.SetValue("@loadError", view.msg);
    }
  }
} catch (pageEx) {
  if (jsonMode) {
    actResult = { ok: false, msg: "Activation error: " + (pageEx.message || String(pageEx)) };
  } else {
    pageStatus = "apifail";
    Platform.Variable.SetValue(
      "@loadError",
      "Could not load this build: " + (pageEx.message || String(pageEx))
    );
  }
}

Platform.Variable.SetValue("@pageStatus", pageStatus);
if (jsonMode) {
  Platform.Variable.SetValue("@actJson", toJsString(Platform.Function.Stringify(actResult)));
}
</script>
