%%[
VAR @HOME_URL, @BUILD_PAGE_SELF, @PUSH_PAGE_SELF, @jid, @confirmPush
VAR @navRows, @navRow, @detailRows, @detailRow, @detailCount
VAR @dispName, @dispType, @dispEmailName, @dispEmailId, @dispDeName, @dispDeId
VAR @dispQueryKey, @dispAutomationGuid, @dispAutomationCustomerKey, @dispAutomationName
VAR @isStackBuild, @pageStatus, @pushBlockedMsg, @pushLogHtml, @pushResultBanner
VAR @manifestHtml, @editSidebarHtml, @buildNavContext, @buildNavActive
VAR @STACK_JOURNEY_TYPE, @AUTH_SOURCE_USER, @AUTH_PROD_USER

SET @STACK_JOURNEY_TYPE = "Journey + Automation"
SET @AUTH_SOURCE_USER = "Admin"
SET @AUTH_PROD_USER = "Admin_Production"
SET @HOME_URL = ""
SET @BUILD_PAGE_SELF = ""
SET @PUSH_PAGE_SELF = ""
SET @jid = Trim(RequestParameter("journeyId"))
IF Empty(@jid) THEN
 SET @jid = Trim(QueryParameter("journeyId"))
ENDIF
SET @confirmPush = IIF(RequestParameter("confirmPush") == "1", "1", "0")
SET @pageStatus = "review"
SET @pushBlockedMsg = ""
SET @pushLogHtml = ""
SET @pushResultBanner = ""
SET @manifestHtml = ""
SET @buildNavContext = "true"
SET @buildNavActive = "manage"
SET @isStackBuild = "false"
SET @dispName = ""
SET @dispType = ""
SET @dispEmailName = ""
SET @dispEmailId = ""
SET @dispDeName = ""
SET @dispDeId = ""
SET @dispQueryKey = ""
SET @dispAutomationGuid = ""
SET @dispAutomationCustomerKey = ""
SET @dispAutomationName = ""
SET @detailCount = 0

SET @navRows = LookupRows("bd_sst_page_navigation","type","cloudpage")
IF RowCount(@navRows) > 0 THEN
 SET @navRow = Row(@navRows,1)
 SET @HOME_URL = Field(@navRow,"ss_home")
 SET @BUILD_PAGE_SELF = Field(@navRow,"ss_edit")
 SET @PUSH_PAGE_SELF = Trim(Field(@navRow,"ss_push_production"))
ENDIF

IF Empty(@jid) THEN
 SET @pageStatus = "nodata"
ELSE
 SET @detailRows = LookupRows("Bd_journey_analytics","journeyId",@jid)
 IF RowCount(@detailRows) == 0 THEN
  SET @detailRows = LookupRows("Bd_journey_analytics","JourneyID",@jid)
 ENDIF
 SET @detailCount = RowCount(@detailRows)
 IF @detailCount == 0 THEN
  SET @pageStatus = "nodata"
 ELSE
  SET @detailRow = Row(@detailRows,1)
  SET @dispName = Field(@detailRow,"journeyName")
  SET @dispType = Field(@detailRow,"journeyType")
  SET @dispEmailName = Field(@detailRow,"emailName")
  SET @dispEmailId = Trim(Field(@detailRow,"emailId"))
  SET @dispDeName = Field(@detailRow,"deName")
  SET @dispDeId = Field(@detailRow,"deId")
  IF Trim(@dispType) == @STACK_JOURNEY_TYPE THEN
   SET @isStackBuild = "true"
   SET @dispQueryKey = Trim(Field(@detailRow,"queryKey"))
   SET @dispAutomationGuid = Trim(Field(@detailRow,"automationGuid"))
   SET @dispAutomationCustomerKey = Trim(Field(@detailRow,"automationCustomerKey"))
   SET @dispAutomationName = Trim(Field(@detailRow,"automationName"))
  ENDIF
 ENDIF
ENDIF

IF @pageStatus != "nodata" AND @isStackBuild != "true" THEN
 SET @pageStatus = "unsupported"
 SET @pushBlockedMsg = "Push to Production is only available for Journey + Automation (stack) builds in this release."
ENDIF
]%%
<script runat="server">
Platform.Load("core", "1");

function pbToStr(v) {
 if (v === null || typeof v === "undefined") {
  return "";
 }
 if (typeof v === "string") {
  return v;
 }
 try {
  return v + "";
 } catch (pbEx) {
  return "";
 }
}

function pbTrim(v) {
 var s = pbToStr(v);
 if (!s) {
  return "";
 }
 var len = s.length;
 if (typeof len !== "number" || isNaN(len) || len < 0) {
  return "";
 }
 var start = 0;
 var end = len;
 while (start < end && (s.charAt(start) === " " || s.charAt(start) === "\t" || s.charAt(start) === "\n" || s.charAt(start) === "\r")) {
  start += 1;
 }
 while (end > start && (s.charAt(end - 1) === " " || s.charAt(end - 1) === "\t" || s.charAt(end - 1) === "\n" || s.charAt(end - 1) === "\r")) {
  end -= 1;
 }
 if (start >= end) {
  return "";
 }
 var out = "";
 var i;
 for (i = start; i < end; i++) {
  out += s.charAt(i);
 }
 return out;
}

function pbHtmlSafe(v) {
 return pbToStr(v)
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;")
  .replace(/"/g, "&quot;");
}

function pbEscJson(s) {
 var text = pbToStr(s);
 var out = "";
 var i;
 for (i = 0; i < text.length; i++) {
  var ch = text.charAt(i);
  if (ch === "\\") {
   out += "\\\\";
  } else if (ch === '"') {
   out += '\\"';
  } else if (ch === "\r") {
   out += "\\r";
  } else if (ch === "\n") {
   out += "\\n";
  } else {
   out += ch;
  }
 }
 return out;
}

function pbHttpOk(statusCode) {
 var code = parseInt(String(statusCode), 10);
 return code === 200 || code === 201;
}

function pbExtractAccessToken(body) {
 var text = pbToStr(body);
 if (!text) {
  return "";
 }
 try {
  var parsed = Platform.Function.ParseJSON(text);
  if (parsed && parsed.access_token) {
   return pbToStr(parsed.access_token);
  }
  if (parsed && parsed.error) {
   return "";
  }
 } catch (parseEx) {}
 var m = text.match(/"access_token"\s*:\s*"([^"]+)"/);
 return m ? m[1] : "";
}

function pbAuthField(row, names) {
 var i;
 for (i = 0; i < names.length; i++) {
  try {
   var v = row[names[i]];
   if (v !== null && v !== undefined && pbTrim(v)) {
    return pbTrim(v);
   }
  } catch (fieldEx) {}
 }
 return "";
}

function pbAuthForUser(userKey) {
 var out = {
  ok: false,
  token: "",
  subdomain: "",
  msg: ""
 };
 try {
  var lookupUser = pbTrim(userKey);
  if (!lookupUser) {
   out.msg = "SFMC_AUTH User key is empty.";
   return out;
  }
  var rows = Platform.Function.LookupRows("SFMC_AUTH", "User", lookupUser);
  if (!rows || rows.length === 0) {
   out.msg = "No SFMC_AUTH row for User=" + lookupUser + ".";
   return out;
  }
  var row = rows[0];
  var clientId = pbAuthField(row, ["clientId", "ClientId"]);
  var clientSecret = pbAuthField(row, ["clientSecret", "ClientSecret"]);
  var subdomain = pbAuthField(row, ["subdomain", "Subdomain"]);
  var accountId = pbAuthField(row, ["accountId", "AccountId"]);
  if (!clientId || !clientSecret || !subdomain) {
   out.msg = "SFMC_AUTH incomplete for User=" + lookupUser + ".";
   return out;
  }
  var authUrl = "https://" + subdomain + ".auth.marketingcloudapis.com/v2/token";
  var payload = '{"grant_type":"client_credentials","client_id":"' + pbEscJson(clientId) + '","client_secret":"' + pbEscJson(clientSecret) + '"';
  if (accountId) {
   payload += ',"account_id":"' + pbEscJson(accountId) + '"';
  }
  payload += "}";
  var req = new Script.Util.HttpRequest(authUrl);
  req.emptyContentHandling = 0;
  req.retries = 1;
  req.continueOnError = true;
  req.method = "POST";
  req.contentType = "application/json";
  req.postData = payload;
  var resp = req.send();
  var body = resp.content ? pbToStr(resp.content) : "";
  if (!pbHttpOk(resp.statusCode)) {
   out.msg =
    "Auth HTTP " +
    resp.statusCode +
    " for User=" +
    lookupUser +
    " — " +
    pbTrim(body).substring(0, 160);
   return out;
  }
  var token = pbExtractAccessToken(body);
  if (!token) {
   out.msg =
    "Auth HTTP " +
    resp.statusCode +
    " for User=" +
    lookupUser +
    " but no access_token — " +
    pbTrim(body).substring(0, 160);
   return out;
  }
  out.ok = true;
  out.token = token;
  out.subdomain = subdomain;
  return out;
 } catch (authEx) {
  out.msg = authEx.message || pbToStr(authEx);
  return out;
 }
}

function pbHttpJson(token, subdomain, method, url, bodyObj) {
 var req = new Script.Util.HttpRequest(url);
 req.emptyContentHandling = 0;
 req.retries = 1;
 req.continueOnError = true;
 req.method = method;
 req.contentType = "application/json";
 req.setHeader("Authorization", "Bearer " + token);
 if (bodyObj !== null && typeof bodyObj !== "undefined") {
  req.postData =
   typeof bodyObj === "string" ? bodyObj : Platform.Function.Stringify(bodyObj);
 }
 var resp = req.send();
 return {
  status: resp.statusCode,
  body: resp.content ? pbToStr(resp.content) : ""
 };
}

function pbLookupQueryText(queryKey) {
 var key = pbTrim(queryKey);
 if (!key) {
  return "";
 }
 try {
  var prox = new Script.Util.WSProxy();
  var r = prox.retrieve("QueryDefinition", ["QueryText", "Name", "CustomerKey"], {
   Property: "CustomerKey",
   SimpleOperator: "equals",
   Value: key
  });
  if (r && r.Results && r.Results.length > 0 && r.Results[0].QueryText) {
   return pbToStr(r.Results[0].QueryText);
  }
 } catch (qEx) {}
 return "";
}

function pbXmlSafe(s) {
 return pbToStr(s)
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/"/g, "&quot;");
}

function pbSoapCall(sub, token, action, bodyXml) {
 var envelope =
  '<?xml version="1.0" encoding="UTF-8"?>' +
  '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing">' +
  "<s:Header>" +
  '<a:Action s:mustUnderstand="1">' +
  action +
  "</a:Action>" +
  '<a:To s:mustUnderstand="1">https://' +
  pbXmlSafe(sub) +
  ".soap.marketingcloudapis.com/Service.asmx</a:To>" +
  '<fueloauth xmlns="http://exacttarget.com">' +
  pbXmlSafe(token) +
  "</fueloauth></s:Header>" +
  '<s:Body xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">' +
  bodyXml +
  "</s:Body></s:Envelope>";
 var req = new Script.Util.HttpRequest("https://" + sub + ".soap.marketingcloudapis.com/Service.asmx");
 req.emptyContentHandling = 0;
 req.retries = 1;
 req.continueOnError = true;
 req.method = "POST";
 req.contentType = "text/xml";
 req.setHeader("SOAPAction", action);
 req.postData = envelope;
 var resp = req.send();
 return { status: resp.statusCode, body: resp.content ? pbToStr(resp.content) : "" };
}

function pbParseSoapObjectId(body) {
 var m = pbToStr(body).match(/<ObjectID>([^<]+)<\/ObjectID>/i);
 return m ? pbTrim(m[1]) : "";
}

function pbParseSoapStatus(body) {
 var m = pbToStr(body).match(/<OverallStatus>([^<]+)<\/OverallStatus>/i);
 return m ? pbTrim(m[1]) : "";
}

function pbStackSchemaFieldXml(fieldDef) {
 var name = fieldDef.name;
 var fieldType = fieldDef.dataType === "EmailAddress" ? "EmailAddress" : "Text";
 var req = fieldDef.name === "MemberId" || fieldDef.name === "ContactId";
 var pk = fieldDef.name === "MemberId";
 var xml =
  '<Field xsi:type="DataExtensionField"><Name>' +
  pbXmlSafe(name) +
  "</Name><FieldType>" +
  fieldType +
  "</FieldType>";
 if (fieldDef.maxLength) {
  xml += "<MaxLength>" + parseInt(String(fieldDef.maxLength), 10) + "</MaxLength>";
 }
 xml += "<IsRequired>" + (req ? "true" : "false") + "</IsRequired>";
 xml += "<IsNillable>" + (req ? "false" : "true") + "</IsNillable>";
 if (pk) {
  xml += "<IsPrimaryKey>true</IsPrimaryKey>";
 }
 if (fieldDef.defaultValue) {
  xml += "<DefaultValue>" + pbXmlSafe(fieldDef.defaultValue) + "</DefaultValue>";
 }
 xml += "</Field>";
 return xml;
}

function pbStackEntryDeFieldsXml() {
 var schema = [
  { name: "MemberId", dataType: "Text", maxLength: "50" },
  { name: "ContactId", dataType: "Text", maxLength: "50" },
  { name: "Email", dataType: "EmailAddress", maxLength: "254" },
  { name: "CampaignId", dataType: "Text", maxLength: "50" },
  { name: "AccountId", dataType: "Text", maxLength: "50" },
  { name: "Account_Owner_Name", dataType: "Text", maxLength: "50" },
  { name: "Account_Owner_Email", dataType: "Text", maxLength: "254" },
  { name: "Status", dataType: "Text", maxLength: "50" },
  { name: "State", dataType: "Text", maxLength: "50" },
  { name: "AccountOwnerId", dataType: "Text", maxLength: "50" },
  { name: "type", dataType: "Text", maxLength: "50", defaultValue: "SST" }
 ];
 var xml = "";
 var i;
 for (i = 0; i < schema.length; i++) {
  xml += pbStackSchemaFieldXml(schema[i]);
 }
 return xml;
}

function pbProdRetrieveDeObjectId(sub, token, customerKey, deName) {
 var ck = pbTrim(customerKey);
 if (ck) {
  var retrieveKey =
   '<RetrieveRequestMsg xmlns="http://exacttarget.com/wsdl/partnerAPI"><RetrieveRequest>' +
   "<ObjectType>DataExtension</ObjectType><Properties>ObjectID</Properties><Properties>CustomerKey</Properties>" +
   '<Filter xsi:type="SimpleFilterPart"><Property>CustomerKey</Property><SimpleOperator>equals</SimpleOperator><Value>' +
   pbXmlSafe(ck) +
   "</Value></Filter></RetrieveRequest></RetrieveRequestMsg>";
  var respKey = pbSoapCall(sub, token, "Retrieve", retrieveKey);
  var oidKey = pbParseSoapObjectId(respKey.body);
  if (oidKey) {
   return { ok: true, objectId: oidKey, customerKey: ck };
  }
 }
 var name = pbTrim(deName);
 if (name) {
  var retrieveName =
   '<RetrieveRequestMsg xmlns="http://exacttarget.com/wsdl/partnerAPI"><RetrieveRequest>' +
   "<ObjectType>DataExtension</ObjectType><Properties>ObjectID</Properties><Properties>CustomerKey</Properties>" +
   '<Filter xsi:type="SimpleFilterPart"><Property>Name</Property><SimpleOperator>equals</SimpleOperator><Value>' +
   pbXmlSafe(name) +
   "</Value></Filter></RetrieveRequest></RetrieveRequestMsg>";
  var respName = pbSoapCall(sub, token, "Retrieve", retrieveName);
  var oidName = pbParseSoapObjectId(respName.body);
  if (oidName) {
   return { ok: true, objectId: oidName, customerKey: ck || name };
  }
 }
 return { ok: false, objectId: "", customerKey: ck };
}

function pbProdEnsureEntryDe(sub, token, customerKey, deName) {
 var ck = pbTrim(customerKey);
 var name = pbTrim(deName) || ck;
 if (!ck) {
  return { ok: false, msg: "Entry DE customer key missing." };
 }
 var existing = pbProdRetrieveDeObjectId(sub, token, ck, name);
 if (existing.ok && existing.objectId) {
  return {
   ok: true,
   objectId: existing.objectId,
   msg: "Entry DE already exists in Production (ObjectID " + existing.objectId + ")."
  };
 }
 var createBody =
  '<CreateRequestMsg xmlns="http://exacttarget.com/wsdl/partnerAPI"><Objects xsi:type="DataExtension">' +
  "<CustomerKey>" +
  pbXmlSafe(ck) +
  "</CustomerKey><Name>" +
  pbXmlSafe(name) +
  "</Name><Description>Pushed from SST</Description><IsSendable>true</IsSendable><IsTestable>true</IsTestable>" +
  "<SendableDataExtensionField><Name>ContactId</Name><FieldType>Text</FieldType></SendableDataExtensionField>" +
  '<SendableSubscriberField><Name>Subscriber Key</Name></SendableSubscriberField><Fields>' +
  pbStackEntryDeFieldsXml() +
  "</Fields></Objects></CreateRequestMsg>";
 var created = pbSoapCall(sub, token, "Create", createBody);
 var status = pbParseSoapStatus(created.body);
 var objectId = pbParseSoapObjectId(created.body);
 if (status === "OK" && objectId) {
  return { ok: true, objectId: objectId, msg: "Entry DE created in Production." };
 }
 if (created.body.indexOf("already exists") >= 0 || created.body.indexOf("AlreadyExist") >= 0) {
  var again = pbProdRetrieveDeObjectId(sub, token, ck, name);
  if (again.ok) {
   return { ok: true, objectId: again.objectId, msg: "Entry DE resolved in Production after duplicate." };
  }
 }
 return {
  ok: false,
  msg: "Entry DE create failed (" + status + "). " + pbTrim(created.body).substring(0, 180)
 };
}

function pbProdUpsertQuery(sub, token, queryKey, queryName, queryText, deCustomerKey, deName) {
 var key = pbTrim(queryKey);
 if (!key || !pbTrim(queryText)) {
  return { ok: false, objectId: "", msg: "Query key or SQL missing." };
 }
 var qName = pbTrim(queryName) || key;
 var retrieveQ =
  '<RetrieveRequestMsg xmlns="http://exacttarget.com/wsdl/partnerAPI"><RetrieveRequest>' +
  "<ObjectType>QueryDefinition</ObjectType><Properties>ObjectID</Properties>" +
  '<Filter xsi:type="SimpleFilterPart"><Property>CustomerKey</Property><SimpleOperator>equals</SimpleOperator><Value>' +
  pbXmlSafe(key) +
  "</Value></Filter></RetrieveRequest></RetrieveRequestMsg>";
 var found = pbSoapCall(sub, token, "Retrieve", retrieveQ);
 var existingId = pbParseSoapObjectId(found.body);
 var action = existingId ? "Update" : "Create";
 var requestTag = existingId ? "UpdateRequestMsg" : "CreateRequestMsg";
 var objectIdXml = existingId ? "<ObjectID>" + pbXmlSafe(existingId) + "</ObjectID>" : "";
 var body =
  "<" +
  requestTag +
  ' xmlns="http://exacttarget.com/wsdl/partnerAPI"><Objects xsi:type="QueryDefinition">' +
  objectIdXml +
  "<CustomerKey>" +
  pbXmlSafe(key) +
  "</CustomerKey><Name>" +
  pbXmlSafe(qName) +
  "</Name><QueryText>" +
  pbXmlSafe(queryText) +
  "</QueryText><TargetType>DE</TargetType><TargetUpdateType>Update</TargetUpdateType>" +
  "<DataExtensionTarget><CustomerKey>" +
  pbXmlSafe(deCustomerKey) +
  "</CustomerKey><Name>" +
  pbXmlSafe(deName) +
  "</Name></DataExtensionTarget></Objects></" +
  requestTag +
  ">";
 var resp = pbSoapCall(sub, token, action, body);
 var status = pbParseSoapStatus(resp.body);
 var objectId = pbParseSoapObjectId(resp.body) || existingId;
 if (status === "OK" && objectId) {
  return {
   ok: true,
   objectId: objectId,
   msg: "Query " + (existingId ? "updated" : "created") + " in Production."
  };
 }
 return {
  ok: false,
  objectId: objectId,
  msg: "Query " + action + " failed (" + status + "). " + pbTrim(resp.body).substring(0, 180)
 };
}

function pbRandomGuid() {
 var tpl = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx";
 return tpl.replace(/[xy]/g, function (c) {
  var r = (Math.random() * 16) | 0;
  var v = c === "x" ? r : (r & 0x3) | 0x8;
  return v.toString(16);
 });
}

function pbExtractLegacyEmailId(assetObj) {
 if (!assetObj || typeof assetObj !== "object") {
  return "";
 }
 var candidates = [
  assetObj.data && assetObj.data.email && assetObj.data.email.legacy && assetObj.data.email.legacy.legacyId,
  assetObj.data && assetObj.data.email && assetObj.data.email.legacyId,
  assetObj.legacyId
 ];
 var i;
 for (i = 0; i < candidates.length; i++) {
  if (candidates[i] !== null && candidates[i] !== undefined && pbTrim(candidates[i])) {
   return pbToStr(candidates[i]);
  }
 }
 return "";
}

function pbFindAutomationByKey(token, sub, automationKey) {
 var endpoint = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/automations";
 var url = endpoint + "/key:" + encodeURIComponent(String(automationKey));
 var got = pbHttpJson(token, sub, "GET", url, null);
 if (got.status === 200 && got.body) {
  try {
   return Platform.Function.ParseJSON(got.body);
  } catch (parseEx) {}
 }
 return null;
}

function pbCreateProdAutomation(token, sub, opts) {
 var automationName = pbTrim(opts.automationName);
 var automationKey = pbTrim(opts.automationKey);
 var queryObjectId = pbTrim(opts.queryObjectId);
 if (!automationKey || !queryObjectId) {
  return { ok: false, automationId: "", msg: "Automation key or query ObjectID missing." };
 }
 var existing = pbFindAutomationByKey(token, sub, automationKey);
 if (existing && existing.id) {
  return { ok: true, automationId: pbToStr(existing.id), msg: "Automation already exists in Production." };
 }
 var now = new Date();
 now.setMinutes(0, 0, 0);
 now.setHours(now.getHours() + 1);
 function pad2(n) {
  return (n < 10 ? "0" : "") + n;
 }
 var startDateLocal =
  now.getFullYear() +
  "-" +
  pad2(now.getMonth() + 1) +
  "-" +
  pad2(now.getDate()) +
  "T" +
  pad2(now.getHours()) +
  ":" +
  pad2(now.getMinutes()) +
  ":00";
 var dUntil = new Date(now.getTime());
 dUntil.setDate(dUntil.getDate() + 365);
 var untilCompact =
  String(dUntil.getFullYear()) + pad2(dUntil.getMonth() + 1) + pad2(dUntil.getDate());
 var recurRule = "FREQ=HOURLY;INTERVAL=1;UNTIL=" + untilCompact;
 var endpoint = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/automations";
 var payload = {
  name: automationName || automationKey,
  description: "Pushed from SST",
  key: automationKey,
  steps: [
   {
    annotation: "",
    stepNumber: 0,
    activities: [
     {
      name: "Query Activity",
      description: "",
      objectTypeId: 300,
      displayOrder: 0,
      activityObjectId: queryObjectId,
      serializedObject: ""
     }
    ]
   }
  ],
  startSource: {
   typeId: 1,
   schedule: {
    icalRecur: recurRule,
    startDateTime: startDateLocal,
    endDateTime: startDateLocal,
    timezoneId: 1
   }
  }
 };
 var posted = pbHttpJson(token, sub, "POST", endpoint, payload);
 if (posted.status !== 200 && posted.status !== 201 && posted.status !== 202) {
  return {
   ok: false,
   automationId: "",
   msg: "Automation POST HTTP " + posted.status + " — " + pbTrim(posted.body).substring(0, 200)
  };
 }
 var automationId = "";
 try {
  var parsed = Platform.Function.ParseJSON(posted.body);
  automationId = parsed && parsed.id ? pbToStr(parsed.id) : "";
 } catch (postEx) {}
 if (!automationId) {
  var recovered = pbFindAutomationByKey(token, sub, automationKey);
  automationId = recovered && recovered.id ? pbToStr(recovered.id) : "";
 }
 if (!automationId) {
  return { ok: false, automationId: "", msg: "Automation created but id not returned." };
 }
 return { ok: true, automationId: automationId, msg: "Automation created in Production." };
}

function pbCreateProdDeAudienceEvent(token, sub, opts) {
 var url = "https://" + sub + ".rest.marketingcloudapis.com/interaction/v1/eventDefinitions";
 var eventKey = pbTrim(opts.eventKey) || "DEAudience-" + pbRandomGuid();
 var payload = {
  name: pbTrim(opts.name),
  description: "",
  type: "AutomationAudience",
  mode: "Production",
  eventDefinitionKey: eventKey,
  dataExtensionId: pbTrim(opts.dataExtensionId),
  dataExtensionName: pbTrim(opts.dataExtensionName),
  AutomationId: pbTrim(opts.automationId),
  isVisibleInPicker: false,
  arguments: {
   AutomationId: pbTrim(opts.automationId),
   DataExtensionId: pbTrim(opts.dataExtensionId),
   EventDefinitionKey: eventKey,
   useHighWatermark: true
  },
  configurationArguments: {},
  metaData: { criteriaDescription: "", scheduleState: "No Schedule" }
 };
 var resp = pbHttpJson(token, sub, "POST", url, payload);
 if (resp.status !== 200 && resp.status !== 201) {
  return {
   ok: false,
   eventDefId: "",
   eventKey: eventKey,
   msg: "Event definition POST HTTP " + resp.status + " — " + pbTrim(resp.body).substring(0, 200)
  };
 }
 var eventDefId = "";
 try {
  var parsed = Platform.Function.ParseJSON(resp.body);
  eventDefId = parsed && parsed.id ? pbToStr(parsed.id) : "";
 } catch (parseEx) {}
 if (!eventDefId) {
  var m = resp.body.match(/"id"\s*:\s*"([^"]+)"/);
  eventDefId = m ? m[1] : "";
 }
 if (!eventDefId) {
  return { ok: false, eventDefId: "", eventKey: eventKey, msg: "Event created but id missing." };
 }
 var trigger = {
  key: "TRIGGER",
  name: "TRIGGER",
  description: "",
  type: "AutomationAudience",
  outcomes: [],
  arguments: {},
  configurationArguments: {},
  metaData: {
   sourceInteractionId: "00000000-0000-0000-0000-000000000000",
   eventDefinitionId: eventDefId,
   eventDefinitionKey: eventKey,
   chainType: "None",
   configurationRequired: false,
   iconUrl: "/images/icon-data-extension.svg",
   title: "Data Extension"
  }
 };
 return {
  ok: true,
  eventDefId: eventDefId,
  eventKey: eventKey,
  trigger: trigger,
  msg: "Entry event definition created in Production."
 };
}

function pbGetJourney(token, sub, journeyId) {
 var url =
  "https://" +
  sub +
  ".rest.marketingcloudapis.com/interaction/v1/interactions/" +
  encodeURIComponent(journeyId) +
  "?extras=all";
 var got = pbHttpJson(token, sub, "GET", url, null);
 if (got.status !== 200 || !got.body) {
  return { ok: false, msg: "Journey GET HTTP " + got.status + ".", obj: null };
 }
 try {
  return { ok: true, msg: "", obj: Platform.Function.ParseJSON(got.body) };
 } catch (parseEx) {
  return { ok: false, msg: "Journey JSON parse failed.", obj: null };
 }
}

function pbPatchEmailActivities(activities, legacyEmailId, assetId) {
 if (!activities || !activities.length) {
  return;
 }
 var i;
 for (i = 0; i < activities.length; i++) {
  var act = activities[i];
  if (!act) {
   continue;
  }
  var type = pbTrim(act.type).toUpperCase();
  if (type.indexOf("EMAIL") < 0 && String(act.objectTypeId) !== "524") {
   continue;
  }
  if (!act.configurationArguments) {
   act.configurationArguments = {};
  }
  if (!act.configurationArguments.triggeredSend) {
   act.configurationArguments.triggeredSend = {};
  }
  if (legacyEmailId) {
   act.configurationArguments.triggeredSend.emailId = legacyEmailId;
  }
  if (assetId) {
   act.configurationArguments.triggeredSend.contentId = assetId;
  }
  if (act.metaData && act.metaData.data && act.metaData.data.email) {
   if (legacyEmailId) {
    act.metaData.data.email.legacyId = legacyEmailId;
   }
   if (assetId) {
    act.metaData.data.email.id = assetId;
   }
  }
 }
}

function pbCloneJourneyToProd(devToken, devSub, prodToken, prodSub, sourceJourneyId, opts) {
 var got = pbGetJourney(devToken, devSub, sourceJourneyId);
 if (!got.ok || !got.obj) {
  return { ok: false, journeyId: "", msg: got.msg || "Could not load source journey." };
 }
 var j = got.obj;
 var newKey = pbRandomGuid();
 j.key = newKey;
 j.name = pbTrim(opts.buildName) || pbTrim(j.name) || "Pushed journey";
 j.version = 1;
 j.status = "Draft";
 delete j.id;
 delete j.definitionId;
 delete j.createdDate;
 delete j.modifiedDate;
 delete j.lastPublishedDate;
 delete j.scheduledStatus;
 pbPatchEmailActivities(j.activities, opts.legacyEmailId, opts.prodEmailAssetId);
 if (opts.trigger) {
  j.triggers = [opts.trigger];
 }
 var postUrl = "https://" + prodSub + ".rest.marketingcloudapis.com/interaction/v1/interactions";
 var posted = pbHttpJson(prodToken, prodSub, "POST", postUrl, j);
 if (posted.status !== 200 && posted.status !== 201) {
  return {
   ok: false,
   journeyId: "",
   msg: "Journey POST HTTP " + posted.status + " — " + pbTrim(posted.body).substring(0, 220)
  };
 }
 var newJid = "";
 try {
  var parsed = Platform.Function.ParseJSON(posted.body);
  newJid = parsed && parsed.id ? pbToStr(parsed.id) : "";
 } catch (parseEx) {}
 if (!newJid) {
  var m = posted.body.match(/"id"\s*:\s*"([^"]+)"/);
  newJid = m ? m[1] : "";
 }
 if (!newJid) {
  return { ok: false, journeyId: "", msg: "Journey created in Production but id missing." };
 }
 return { ok: true, journeyId: newJid, msg: "Journey created in Production (draft) id " + newJid + "." };
}

function pbManifestRows(opts) {
 var o = opts || {};
 var rows = [];
 rows.push({ kind: "Entry data extension", name: o.deName, key: o.deId, note: "Schema + sendable config" });
 rows.push({ kind: "Query activity", name: o.buildName, key: o.queryKey, note: o.queryFound ? "SQL loaded from source BU" : "Query not found in source BU" });
 rows.push({ kind: "Content Builder email", name: o.emailName, key: o.emailId, note: "Email asset copy" });
 rows.push({ kind: "Automation", name: o.automationName, key: o.automationKey || o.automationGuid, note: "Schedule + query step" });
 rows.push({ kind: "Entry event definition", name: o.buildName, key: "", note: "DE-audience trigger wired to automation" });
 rows.push({ kind: "Journey", name: o.buildName, key: o.journeyId, note: "Canvas + email activity references" });
 return rows;
}

function pbBuildManifestHtml(rows) {
 var html = '<ul class="push-manifest">';
 var i;
 for (i = 0; i < rows.length; i++) {
  var row = rows[i];
  html +=
   "<li><strong>" +
   pbHtmlSafe(row.kind) +
   "</strong><span>" +
   pbHtmlSafe(row.name || "—") +
   "</span><code>" +
   pbHtmlSafe(row.key || "—") +
   "</code><em>" +
   pbHtmlSafe(row.note || "") +
   "</em></li>";
 }
 html += "</ul>";
 return html;
}

function pbCopyEmailAsset(sourceToken, sourceSub, targetToken, targetSub, assetId, targetName) {
 var id = pbTrim(assetId);
 if (!id) {
  return { ok: false, msg: "Email asset id missing." };
 }
 var getUrl =
  "https://" + sourceSub + ".rest.marketingcloudapis.com/asset/v1/content/assets/" + encodeURIComponent(id);
 var got = pbHttpJson(sourceToken, sourceSub, "GET", getUrl, null);
 if (got.status !== 200 || !got.body) {
  return { ok: false, msg: "Source email GET HTTP " + got.status + "." };
 }
 var template = null;
 try {
  template = Platform.Function.ParseJSON(got.body);
 } catch (parseEx) {
  return { ok: false, msg: "Source email JSON parse failed." };
 }
 var views = template.views || {};
 var htmlView = views.html || {};
 var subject =
  (views.subjectline && views.subjectline.content) || template.name || targetName || "Email";
 var payload = {
  name: targetName || template.name || "Pushed email",
  assetType: { id: 207, name: "htmlemail" },
  channels: { email: true, web: false },
  views: {
   subjectline: { content: subject },
   preheader: { content: (views.preheader && views.preheader.content) || "" },
   html: {
    content: htmlView.content || template.content || "",
    slots: htmlView.slots || template.slots || {}
   },
   text: { content: (views.text && views.text.content) || "" }
  }
 };
 var postUrl = "https://" + targetSub + ".rest.marketingcloudapis.com/asset/v1/content/assets";
 var posted = pbHttpJson(targetToken, targetSub, "POST", postUrl, payload);
 if (posted.status !== 200 && posted.status !== 201) {
  return {
   ok: false,
   msg: "Production email POST HTTP " + posted.status + " — " + pbTrim(posted.body).substring(0, 220)
  };
 }
 var newId = "";
 try {
  var created = Platform.Function.ParseJSON(posted.body);
  newId = created && created.id ? pbToStr(created.id) : "";
 } catch (postParseEx) {}
 if (!newId) {
  var m = posted.body.match(/"id"\s*:\s*"?([^",}\s]+)"?/);
  newId = m ? m[1] : "";
 }
 if (!newId) {
  return { ok: false, msg: "Production email created but id not returned." };
 }
 var legacyId = "";
 try {
  var gotAsset = pbHttpJson(
   targetToken,
   targetSub,
   "GET",
   "https://" + targetSub + ".rest.marketingcloudapis.com/asset/v1/content/assets/" + encodeURIComponent(newId),
   null
  );
  if (gotAsset.status === 200 && gotAsset.body) {
   legacyId = pbExtractLegacyEmailId(Platform.Function.ParseJSON(gotAsset.body));
  }
 } catch (legacyEx) {}
 return {
  ok: true,
  msg: "Email copied to Production (asset id " + newId + ").",
  prodEmailId: newId,
  legacyEmailId: legacyId
 };
}

function pbPushStackBuild(ctx) {
 var logs = [];
 var failed = false;
 function log(line) {
  logs.push(pbToStr(line));
 }
 function fail(line) {
  failed = true;
  log(line);
 }
 var sourceUser = pbTrim(Platform.Variable.GetValue("@AUTH_SOURCE_USER") || "Admin") || "Admin";
 var prodUser =
  pbTrim(Platform.Variable.GetValue("@AUTH_PROD_USER") || "Admin_Production") || "Admin_Production";
 var devAuth = pbAuthForUser(sourceUser);
 if (!devAuth.ok) {
  return { ok: false, logs: logs, msg: "Source auth failed: " + devAuth.msg };
 }
 log("Source (" + sourceUser + ") authentication OK.");
 var prodAuth = pbAuthForUser(prodUser);
 if (!prodAuth.ok) {
  return { ok: false, logs: logs, msg: "Production auth failed: " + prodAuth.msg };
 }
 log("Production (" + prodUser + ") authentication OK.");
 var deKey = pbTrim(ctx.deId);
 var deName = pbTrim(ctx.deName) || deKey;
 if (!deKey || deKey.toUpperCase() === "N/A") {
  deKey = pbTrim(ctx.buildName);
  deName = pbTrim(ctx.deName) || deKey;
 }
 var queryKey = pbTrim(ctx.queryKey);
 var automationKey = pbTrim(ctx.automationKey) || pbTrim(ctx.automationGuid);
 var automationName = pbTrim(ctx.automationName) || pbTrim(ctx.buildName);
 var queryText = pbLookupQueryText(queryKey);
 if (queryText) {
  log("Loaded query SQL from source (" + queryText.length + " chars).");
 } else {
  fail("Query SQL not found in source BU for key " + queryKey + ".");
 }
 var deResult = pbProdEnsureEntryDe(prodAuth.subdomain, prodAuth.token, deKey, deName);
 if (deResult.ok) {
  log(deResult.msg);
 } else {
  fail("Entry DE FAILED: " + deResult.msg);
 }
 var queryResult = { ok: false, objectId: "" };
 if (queryText && deKey) {
  queryResult = pbProdUpsertQuery(
   prodAuth.subdomain,
   prodAuth.token,
   queryKey,
   pbTrim(ctx.buildName),
   queryText,
   deKey,
   deName
  );
  if (queryResult.ok) {
   log(queryResult.msg);
  } else {
   fail("Query FAILED: " + queryResult.msg);
  }
 }
 var emailCopy = pbCopyEmailAsset(
  devAuth.token,
  devAuth.subdomain,
  prodAuth.token,
  prodAuth.subdomain,
  ctx.emailId,
  ctx.emailName || ctx.buildName
 );
 if (emailCopy.ok) {
  log(emailCopy.msg);
  if (!emailCopy.legacyEmailId) {
   log("WARNING: Production email legacy id not resolved; journey email step may need manual fix.");
  }
 } else {
  fail("Email copy FAILED: " + emailCopy.msg);
 }
 var automationResult = { ok: false, automationId: "" };
 if (queryResult.objectId && automationKey) {
  automationResult = pbCreateProdAutomation(prodAuth.token, prodAuth.subdomain, {
   automationName: automationName,
   automationKey: automationKey,
   queryObjectId: queryResult.objectId
  });
  if (automationResult.ok) {
   log(automationResult.msg);
  } else {
   fail("Automation FAILED: " + automationResult.msg);
  }
 }
 var eventResult = { ok: false, trigger: null };
 if (automationResult.automationId && deResult.objectId) {
  eventResult = pbCreateProdDeAudienceEvent(prodAuth.token, prodAuth.subdomain, {
   name: pbTrim(ctx.buildName),
   eventKey: "DEAudience-" + pbRandomGuid(),
   dataExtensionId: deResult.objectId,
   dataExtensionName: deName,
   automationId: automationResult.automationId
  });
  if (eventResult.ok) {
   log(eventResult.msg);
  } else {
   fail("Entry event FAILED: " + eventResult.msg);
  }
 }
 if (ctx.journeyId && eventResult.ok && emailCopy.ok) {
  var journeyClone = pbCloneJourneyToProd(
   devAuth.token,
   devAuth.subdomain,
   prodAuth.token,
   prodAuth.subdomain,
   ctx.journeyId,
   {
    buildName: pbTrim(ctx.buildName),
    legacyEmailId: emailCopy.legacyEmailId,
    prodEmailAssetId: emailCopy.prodEmailId,
    trigger: eventResult.trigger
   }
  );
  if (journeyClone.ok) {
   log(journeyClone.msg);
  } else {
   fail("Journey FAILED: " + journeyClone.msg);
  }
 } else if (ctx.journeyId && !eventResult.ok) {
  fail("Journey skipped because entry event was not created.");
 }
 if (!failed) {
  log("Review Production Journey Builder and Automation Studio before activating schedules.");
  return { ok: true, logs: logs, msg: "Push to Production completed." };
 }
 return {
  ok: false,
  logs: logs,
  msg: "Push finished with errors. Review the log and fix Production artifacts before go-live."
 };
}

var pageStatus = pbTrim(Platform.Variable.GetValue("@pageStatus") || "review");
var confirmPush = Platform.Variable.GetValue("@confirmPush") === "1";
var isStack = Platform.Variable.GetValue("@isStackBuild") === "true";
var jid = pbTrim(Platform.Variable.GetValue("@jid") || "");
var manifestHtml = "";
var pushLogHtml = "";
var pushResultBanner = "";
var pushBlockedMsg = pbTrim(Platform.Variable.GetValue("@pushBlockedMsg") || "");

if (pageStatus === "review" && isStack && jid) {
 var buildName = pbTrim(Platform.Variable.GetValue("@dispName") || "");
 var queryKey = pbTrim(Platform.Variable.GetValue("@dispQueryKey") || "");
 var queryText = pbLookupQueryText(queryKey);
 var manifest = pbManifestRows({
  buildName: buildName,
  journeyId: jid,
  deName: pbTrim(Platform.Variable.GetValue("@dispDeName") || ""),
  deId: pbTrim(Platform.Variable.GetValue("@dispDeId") || ""),
  queryKey: queryKey,
  queryFound: !!queryText,
  emailName: pbTrim(Platform.Variable.GetValue("@dispEmailName") || ""),
  emailId: pbTrim(Platform.Variable.GetValue("@dispEmailId") || ""),
  automationName: pbTrim(Platform.Variable.GetValue("@dispAutomationName") || ""),
  automationGuid: pbTrim(Platform.Variable.GetValue("@dispAutomationGuid") || ""),
  automationKey: pbTrim(Platform.Variable.GetValue("@dispAutomationCustomerKey") || "")
 });
 manifestHtml = pbBuildManifestHtml(manifest);
}

if (confirmPush && pageStatus === "review" && isStack && jid) {
 pageStatus = "pushing";
 var pushResult = pbPushStackBuild({
  buildName: pbTrim(Platform.Variable.GetValue("@dispName") || ""),
  journeyId: jid,
  queryKey: pbTrim(Platform.Variable.GetValue("@dispQueryKey") || ""),
  emailId: pbTrim(Platform.Variable.GetValue("@dispEmailId") || ""),
  emailName: pbTrim(Platform.Variable.GetValue("@dispEmailName") || ""),
  deId: pbTrim(Platform.Variable.GetValue("@dispDeId") || ""),
  deName: pbTrim(Platform.Variable.GetValue("@dispDeName") || ""),
  automationGuid: pbTrim(Platform.Variable.GetValue("@dispAutomationGuid") || ""),
  automationKey: pbTrim(Platform.Variable.GetValue("@dispAutomationCustomerKey") || "")
 });
 var li;
 pushLogHtml = '<ol class="push-log">';
 for (li = 0; li < pushResult.logs.length; li++) {
  pushLogHtml += "<li>" + pbHtmlSafe(pushResult.logs[li]) + "</li>";
 }
 pushLogHtml += "</ol>";
 if (pushResult.ok) {
  pushResultBanner =
   '<div class="banner good">' + pbHtmlSafe(pushResult.msg) + "</div>";
  pageStatus = "done";
 } else {
  pushResultBanner =
   '<div class="banner bad">' + pbHtmlSafe(pushResult.msg || "Push failed.") + "</div>";
  pageStatus = "failed";
 }
}

Platform.Variable.SetValue("@pageStatus", pageStatus);
Platform.Variable.SetValue("@manifestHtml", manifestHtml);
Platform.Variable.SetValue("@pushLogHtml", pushLogHtml);
Platform.Variable.SetValue("@pushResultBanner", pushResultBanner);
Platform.Variable.SetValue("@pushBlockedMsg", pushBlockedMsg);
</script>
