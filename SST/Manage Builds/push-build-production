function countRowsByProxy(customerKey) {
  var key = usableDeKey(customerKey);
  if (!key) {
    return { ok: false, msg: "" };
  }
  try {
    var prox = new Script.Util.WSProxy();
    var described = prox.describe("DataExtensionObject[" + key + "]");
    var fields = listFrom(described && (described.Results || described.results));
    var fieldName = "";
    var i;
    for (i = 0; i < fields.length; i++) {
      var candidate = strTrim(fields[i].Name || fields[i].name);
      if (candidate && candidate.charAt(0) !== "_") {
        fieldName = candidate;
        break;
      }
    }
    if (!fieldName && fields.length) {
      fieldName = strTrim(fields[0].Name || fields[0].name);
    }
    if (!fieldName) {
      return { ok: false, msg: "Could not read fields for " + key + "." };
    }
    var got = prox.retrieve("DataExtensionObject[" + key + "]", [fieldName]);
    if (!got) {
      return { ok: false, msg: "Row retrieve returned nothing for " + key + "." };
    }
    var status = strTrim(got.Status || got.status).toUpperCase();
    if (status && status !== "OK" && status !== "MOREDATA") {
      var faults = listFrom(got.Results || got.results);
      var detail = faults.length ? strTrim(faults[0].StatusMessage || faults[0].ErrorMessage) : "";
      return { ok: false, msg: detail || status };
    }
    var rows = listFrom(got.Results || got.results);
    var more = got.HasMoreRows === true || strTrim(got.HasMoreRows).toLowerCase() === "true" || status === "MOREDATA";
