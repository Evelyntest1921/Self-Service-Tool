function pbPatchEmailActivities(activities, legacyEmailId, assetId) {
 if (!activities || !activities.length) {
  return;
 }
 var i;
 for (i = 0; i < activities.length; i++) {
  var act = activities[i];
  if (!act) {
   continue;
  }
  var type = pbTrim(act.type).toUpperCase();
  if (type.indexOf("EMAIL") < 0 && String(act.objectTypeId) !== "524") {
   continue;
  }
  if (!act.configurationArguments) {
   act.configurationArguments = {};
  }
  if (!act.configurationArguments.triggeredSend) {
   act.configurationArguments.triggeredSend = {};
  }
  if (legacyEmailId) {
   act.configurationArguments.triggeredSend.emailId = legacyEmailId;
  }
  if (assetId) {
   act.configurationArguments.triggeredSend.contentId = assetId;
  }
  if (act.metaData && act.metaData.data && act.metaData.data.email) {
   if (legacyEmailId) {
    act.metaData.data.email.legacyId = legacyEmailId;
   }
   if (assetId) {
    act.metaData.data.email.id = assetId;
   }
  }
 }
}

