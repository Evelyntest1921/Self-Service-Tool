    var legacyData = Platform.Function.ParseJSON(legacyGot.body);
    var legacyItems = legacyData && legacyData.items ? legacyData.items : [];
    var li;
    for (li = 0; li < legacyItems.length; li++) {
     if (pbIsEmailAsset(legacyItems[li]) && pbExtractLegacyEmailId(legacyItems[li]) === leg) {
      return { ok: true, asset: legacyItems[li], msg: "" };
     }
    }
    if (legacyItems.length === 1 && pbIsEmailAsset(legacyItems[0])) {
     return { ok: true, asset: legacyItems[0], msg: "" };
    }
   } catch (legacyParseEx) {}
  }
 }
 if (allowScan !== true) {
  return { ok: false, asset: null, msg: "No Content Builder asset for legacy email id " + leg + "." };
 }
 var page = 1;
 while (page <= 3) {
  var listUrl =
   "https://" +
   sourceSub +
   ".rest.marketingcloudapis.com/asset/v1/content/assets?$page=" +
   page +
   "&$pagesize=50&$filter=" +
   encodeURIComponent("assetType.id eq 207");
  var listGot = pbHttpJson(sourceToken, sourceSub, "GET", listUrl, null);
  if (!pbHttpOk(listGot.status) || !listGot.body) {
   break;
  }
  try {
   var listData = Platform.Function.ParseJSON(listGot.body);
   var items = listData && listData.items ? listData.items : [];
   var i;
   for (i = 0; i < items.length; i++) {
    if (pbIsEmailAsset(items[i]) && pbExtractLegacyEmailId(items[i]) === leg) {
     return { ok: true, asset: items[i], msg: "" };
    }
   }
   if (!items.length) {
    break;
   }
  } catch (scanEx) {
   break;
  }
  page++;
 }
 return { ok: false, asset: null, msg: "No Content Builder asset for legacy email id " + leg + "." };
}

function pbFetchEmailAssetById(sourceToken, sourceSub, assetId) {
 var id = pbTrim(assetId);
 if (!id) {
  return { ok: false, asset: null, msg: "Email asset id missing." };
 }
 var getUrl =
  "https://" + sourceSub + ".rest.marketingcloudapis.com/asset/v1/content/assets/" + encodeURIComponent(id);
 var got = pbHttpJson(sourceToken, sourceSub, "GET", getUrl, null);
 if (!pbHttpOk(got.status) || !got.body) {
  return { ok: false, asset: null, msg: "Source email GET HTTP " + got.status + "." };
 }
 try {
  var asset = Platform.Function.ParseJSON(got.body);
  if (!pbIsEmailAsset(asset)) {
   return { ok: false, asset: null, msg: "Asset " + id + " is not an email content asset." };
  }
  return { ok: true, asset: asset, msg: "" };
 } catch (parseEx) {
  return { ok: false, asset: null, msg: "Source email JSON parse failed." };
 }
}

function pbFetchEmailAssetByName(sourceToken, sourceSub, emailName) {
 var name = pbTrim(emailName);
 if (!name) {
  return { ok: false, asset: null, msg: "Email name missing." };
 }
 var odataName = name.replace(/'/g, "''");
 var filterExpr = "name eq '" + odataName + "'";
 var listUrl =
  "https://" +
  sourceSub +
  ".rest.marketingcloudapis.com/asset/v1/content/assets?$page=1&$pagesize=50&$filter=" +
  encodeURIComponent(filterExpr);
 var got = pbHttpJson(sourceToken, sourceSub, "GET", listUrl, null);
 if (!pbHttpOk(got.status) || !got.body) {
  return { ok: false, asset: null, msg: "Email search HTTP " + got.status + "." };
 }
 try {
  var data = Platform.Function.ParseJSON(got.body);
  var items = data && data.items ? data.items : [];
  var nameLower = name.toLowerCase();
  var matches = [];
  var i;
  for (i = 0; i < items.length; i++) {
   if (pbIsEmailAsset(items[i]) && pbTrim(items[i].name).toLowerCase() === nameLower) {
    matches.push(items[i]);
   }
  }
  if (matches.length === 1) {
   return { ok: true, asset: matches[0], msg: "" };
  }
  if (matches.length > 1) {
   return { ok: false, asset: null, msg: "Multiple emails named \"" + name + "\"; fix emailId in analytics." };
  }
  return { ok: false, asset: null, msg: "No email named \"" + name + "\" in source BU." };
 } catch (listEx) {
  return { ok: false, asset: null, msg: "Email search parse failed." };
 }
}

function pbResolveSourceEmailAsset(sourceToken, sourceSub, assetId, emailName, legacyEmailId, allowLegacyScan) {
 var id = pbTrim(assetId);
 var legacy = pbTrim(legacyEmailId || "");
 var byLegacy = { ok: false, msg: "" };
 if (legacy && id === legacy) {
  id = "";
 }
 if (id && id.indexOf("-") >= 0) {
  var byGuid = pbFetchEmailAssetById(sourceToken, sourceSub, id);
  if (byGuid.ok) {
   return byGuid;
  }
 }
 if (id && /^\d+$/.test(id)) {
  var byNumeric = pbFetchEmailAssetById(sourceToken, sourceSub, id);
  if (byNumeric.ok) {
   return byNumeric;
  }
  if (!legacy) {
   legacy = id;
   id = "";
  }
 }
 if (id) {
  var byId = pbFetchEmailAssetById(sourceToken, sourceSub, id);
  if (byId.ok) {
   return byId;
  }
 }
 if (legacy) {
  byLegacy = pbFetchEmailAssetByLegacyId(sourceToken, sourceSub, legacy, allowLegacyScan === true);
  if (byLegacy.ok) {
   return byLegacy;
  }
 }
 if (emailName) {
  var byName = pbFetchEmailAssetByName(sourceToken, sourceSub, emailName);
  if (byName.ok) {
   return byName;
  }
  var parts = [];
  if (id) {
   parts.push("Source email GET failed for id " + id + ".");
  }
  if (legacy) {
   parts.push(byLegacy.msg || "Legacy id " + legacy + " not mapped to Content Builder.");
  }
  parts.push(byName.msg || "Name search failed.");
  return { ok: false, asset: null, msg: parts.join(" ") };
 }
 if (id) {
  return pbFetchEmailAssetById(sourceToken, sourceSub, id);
 }
 if (legacy) {
  return pbFetchEmailAssetByLegacyId(sourceToken, sourceSub, legacy, allowLegacyScan === true);
 }
 return { ok: false, asset: null, msg: "Email asset id or name missing." };
}

function pbReuseProdEmailByName(targetToken, targetSub, emailName) {
 var byName = pbFetchEmailAssetByName(targetToken, targetSub, emailName);
 if (!byName.ok || !byName.asset) {
  return { ok: false, prodEmailId: "", legacyEmailId: "", msg: byName.msg || "" };
 }
 var asset = byName.asset;
 return {
  ok: true,
  prodEmailId: pbToStr(asset.id || ""),
  legacyEmailId: pbExtractLegacyEmailId(asset),
  msg: "Production email reused (asset id " + pbToStr(asset.id || "") + ")."
 };
}

function pbCopyEmailAsset(sourceToken, sourceSub, targetToken, targetSub, assetId, targetName, legacyEmailId) {
 var resolved = pbResolveSourceEmailAsset(
  sourceToken,
  sourceSub,
  assetId,
  targetName,
  legacyEmailId || "",
  true
 );
 if (!resolved.ok || !resolved.asset) {
  return { ok: false, msg: resolved.msg || "Could not resolve source email." };
 }
 var template = resolved.asset;
 var prodEmailName = pbTrim(targetName || template.name || "Pushed email");
 var existingProd = pbReuseProdEmailByName(targetToken, targetSub, prodEmailName);
 if (existingProd.ok && existingProd.prodEmailId) {
  return {
   ok: true,
   msg: existingProd.msg,
   prodEmailId: existingProd.prodEmailId,
   legacyEmailId: existingProd.legacyEmailId
  };
 }
 var views = template.views || {};
 var htmlView = views.html || {};
 var subject =
  (views.subjectline && views.subjectline.content) || template.name || targetName || "Email";
 var payload = {
  name: prodEmailName,
  assetType: { id: 207, name: "htmlemail" },
  channels: { email: true, web: false },
  views: {
   subjectline: { content: subject },
   preheader: { content: (views.preheader && views.preheader.content) || "" },
   html: {
    content: htmlView.content || template.content || "",
    slots: htmlView.slots || template.slots || {}
   },
   text: { content: (views.text && views.text.content) || "" }
  }
 };
 var postUrl = "https://" + targetSub + ".rest.marketingcloudapis.com/asset/v1/content/assets";
 var posted = pbHttpJson(targetToken, targetSub, "POST", postUrl, payload);
 if (!pbHttpOk(posted.status)) {
  var postBody = pbTrim(posted.body);
  if (postBody.indexOf("already taken") >= 0 || postBody.indexOf("must be unique") >= 0) {
   var dupReuse = pbReuseProdEmailByName(targetToken, targetSub, prodEmailName);
   if (dupReuse.ok && dupReuse.prodEmailId) {
    return {
     ok: true,
     msg: dupReuse.msg,
     prodEmailId: dupReuse.prodEmailId,
     legacyEmailId: dupReuse.legacyEmailId
    };
   }
  }
  return {
   ok: false,
   msg: "Production email POST HTTP " + posted.status + " — " + postBody.substring(0, 220)
  };
 }
 var newId = "";
 try {
  var created = Platform.Function.ParseJSON(posted.body);
  newId = created && created.id ? pbToStr(created.id) : "";
 } catch (postParseEx) {}
 if (!newId) {
  var m = posted.body.match(/"id"\s*:\s*"?([^",}\s]+)"?/);
  newId = m ? m[1] : "";
 }
 if (!newId) {
  return { ok: false, msg: "Production email created but id not returned." };
 }
 var legacyId = "";
 try {
  var gotAsset = pbHttpJson(
   targetToken,
   targetSub,
   "GET",
   "https://" + targetSub + ".rest.marketingcloudapis.com/asset/v1/content/assets/" + encodeURIComponent(newId),
   null
  );
  if (pbHttpOk(gotAsset.status) && gotAsset.body) {
   legacyId = pbExtractLegacyEmailId(Platform.Function.ParseJSON(gotAsset.body));
  }
 } catch (legacyEx) {}
 return {
  ok: true,
  msg: "Email copied to Production (asset id " + newId + ").",
  prodEmailId: newId,
  legacyEmailId: legacyId
 };
}

function pbPushStackBuild(ctx) {
 var logs = [];
 var failed = false;
 function log(line) {
  logs.push(pbToStr(line));
 }
 function fail(line) {
  failed = true;
  log(line);
 }
 var sourceUser = pbTrim(Platform.Variable.GetValue("@AUTH_SOURCE_USER") || "Admin") || "Admin";
 var prodUser =
  pbTrim(Platform.Variable.GetValue("@AUTH_PROD_USER") || "Admin_Production") || "Admin_Production";
 var prodUserFallbacks = [
  "Admin_production",
  "Admin_Production",
  "Production_Admin",
  "Admin Production"
 ];
 var devAuth = pbAuthForUser(sourceUser, []);
 if (!devAuth.ok) {
  return { ok: false, logs: logs, msg: "Source auth failed: " + devAuth.msg };
 }
 log("Source (" + (devAuth.userKey || sourceUser) + ") authentication OK.");
 var prodAuth = pbAuthForUser(prodUser, prodUserFallbacks);
 if (!prodAuth.ok) {
  return { ok: false, logs: logs, msg: "Production auth failed: " + prodAuth.msg };
 }
 log("Production (" + (prodAuth.userKey || prodUser) + ") authentication OK.");
 var journeyId = pbTrim(ctx.journeyId);
 if (!journeyId) {
  return { ok: false, logs: logs, msg: "Journey id missing." };
 }
 var live = pbResolveLiveStackContext(
  devAuth.token,
  devAuth.subdomain,
  journeyId,
  pbStackAnalyticsFallback(ctx)
 );
 if (!live.ok) {
  fail(live.msg || "Live artifact resolution failed.");
  return {
   ok: false,
   logs: logs,
   msg: "Push stopped: resolve live UAT journey artifacts before using Production."
  };
 }
 log(live.msg);
 var deKey = live.deCustomerKey;
 var deName = live.deName || deKey;
 var queryKey = live.queryKey;
 var queryText = live.queryText;
 var automationKey = live.automationKey;
 var automationName = live.automationName || live.buildName || pbTrim(ctx.buildName);
 var buildName = live.buildName || pbTrim(ctx.buildName);
 log("Entry DE key " + deKey + ", query key " + queryKey + " (" + queryText.length + " chars SQL).");
 log("Email asset id " + live.emailAssetId + ", automation key " + automationKey + ".");
 var deResult = pbProdEnsureEntryDe(prodAuth.subdomain, prodAuth.token, deKey, deName, {
  uatToken: devAuth.token,
  uatSub: devAuth.subdomain,
  deObjectId: live.deObjectId || ""
 });
 if (deResult.ok) {
  log(deResult.msg);
  if (!deResult.objectId) {
   fail("Entry DE FAILED: create OK but no ObjectID — cannot wire entry event.");
  }
 } else {
  fail("Entry DE FAILED: " + deResult.msg);
 }
 var queryResult = { ok: false, objectId: "" };
 if (queryText && deKey) {
  queryResult = pbProdUpsertQuery(
   prodAuth.subdomain,
   prodAuth.token,
   queryKey,
   buildName,
   queryText,
   deKey,
   deName,
   deResult.objectId || "",
   automationKey
  );
  if (queryResult.ok) {
   log(queryResult.msg);
  } else {
   fail("Query FAILED: " + queryResult.msg);
  }
 }
 var emailCopy = pbCopyEmailAsset(
  devAuth.token,
  devAuth.subdomain,
  prodAuth.token,
  prodAuth.subdomain,
  live.emailAssetId,
  live.emailName || buildName,
  live.emailLegacyId || ""
 );
 if (emailCopy.ok) {
  log(emailCopy.msg);
  if (!emailCopy.legacyEmailId) {
   log("WARNING: Production email legacy id not resolved; journey email step may need manual fix.");
  }
 } else {
  fail("Email copy FAILED: " + emailCopy.msg);
 }
 var automationResult = { ok: false, automationId: "" };
 if (queryResult.objectId && automationKey) {
  automationResult = pbCreateProdAutomation(prodAuth.token, prodAuth.subdomain, {
   automationName: automationName,
   automationKey: automationKey,
   queryObjectId: queryResult.objectId
  });
  if (automationResult.ok) {
   log(automationResult.msg);
  } else {
   fail("Automation FAILED: " + automationResult.msg);
  }
 }
 var eventResult = { ok: false, trigger: null };
 if (automationResult.automationId && deResult.objectId) {
  eventResult = pbCreateProdDeAudienceEvent(prodAuth.token, prodAuth.subdomain, {
   name: buildName,
   eventKey: "DEAudience-" + pbRandomGuid(),
   dataExtensionId: deResult.objectId,
   dataExtensionName: deName,
   automationId: automationResult.automationId
  });
  if (eventResult.ok) {
   log(eventResult.msg);
  } else {
   fail("Entry event FAILED: " + eventResult.msg);
  }
 }
 if (journeyId && eventResult.ok && emailCopy.ok) {
  var journeyClone = pbCloneJourneyToProd(
   devAuth.token,
   devAuth.subdomain,
   prodAuth.token,
   prodAuth.subdomain,
   journeyId,
   {
    buildName: buildName,
    legacyEmailId: emailCopy.legacyEmailId,
    prodEmailAssetId: emailCopy.prodEmailId,
    trigger: eventResult.trigger
   }
  );
  if (journeyClone.ok) {
   log(journeyClone.msg);
  } else {
   fail("Journey FAILED: " + journeyClone.msg);
  }
 } else if (journeyId && !eventResult.ok) {
  fail("Journey skipped because entry event was not created.");
 }
 if (!failed) {
  log("Review Production Journey Builder and Automation Studio before activating schedules.");
  return { ok: true, logs: logs, msg: "Push to Production completed." };
 }
 return {
  ok: false,
  logs: logs,
  msg: "Push finished with errors. Review the log and fix Production artifacts before go-live."
 };
}

var pageStatus = pbTrim(Platform.Variable.GetValue("@pageStatus") || "review");
var confirmPush = Platform.Variable.GetValue("@confirmPush") === "1";
var isStack = Platform.Variable.GetValue("@isStackBuild") === "true";
var jid = pbTrim(Platform.Variable.GetValue("@jid") || "");
var manifestHtml = "";
var pushLogHtml = "";
var pushResultBanner = "";
var pushBlockedMsg = pbTrim(Platform.Variable.GetValue("@pushBlockedMsg") || "");

if (pageStatus === "review" && isStack && jid) {
 var reviewFb = pbStackAnalyticsFallback({
  buildName: pbTrim(Platform.Variable.GetValue("@dispName") || ""),
  deId: pbTrim(Platform.Variable.GetValue("@dispDeId") || ""),
  deName: pbTrim(Platform.Variable.GetValue("@dispDeName") || ""),
  queryKey: pbTrim(Platform.Variable.GetValue("@dispQueryKey") || ""),
  emailId: pbTrim(Platform.Variable.GetValue("@dispEmailId") || ""),
  emailName: pbTrim(Platform.Variable.GetValue("@dispEmailName") || ""),
  automationGuid: pbTrim(Platform.Variable.GetValue("@dispAutomationGuid") || ""),
  automationKey: pbTrim(Platform.Variable.GetValue("@dispAutomationCustomerKey") || ""),
  automationName: pbTrim(Platform.Variable.GetValue("@dispAutomationName") || "")
 });
 var reviewLive = { ok: false, msg: "" };
 var reviewAuth = pbAuthForUser(
  pbTrim(Platform.Variable.GetValue("@AUTH_SOURCE_USER") || "Admin") || "Admin",
  []
 );
 if (reviewAuth.ok) {
  reviewLive = pbResolveLiveStackContext(reviewAuth.token, reviewAuth.subdomain, jid, reviewFb);
  if (reviewLive.ok) {
   pushBlockedMsg = "";
  } else {
   pushBlockedMsg =
    "Live artifact resolution failed: " + (reviewLive.msg || "Could not read journey, entry event, automation, or email from UAT.");
  }
 } else {
  pushBlockedMsg = "Source (Admin) auth failed for live manifest: " + reviewAuth.msg;
 }
 var manifest = pbManifestRows({
  buildName: reviewLive.ok ? reviewLive.buildName : reviewFb.buildName,
  journeyId: jid,
  deName: reviewLive.ok ? reviewLive.deName : reviewFb.deName,
  deId: reviewLive.ok ? reviewLive.deCustomerKey : reviewFb.deId,
  queryKey: reviewLive.ok ? reviewLive.queryKey : reviewFb.queryKey,
  queryFound: reviewLive.ok ? !!reviewLive.queryText : !!pbLookupQueryText(reviewFb.queryKey),
  liveResolved: reviewLive.ok,
  emailName: reviewLive.ok ? reviewLive.emailName : reviewFb.emailName,
  emailId: reviewLive.ok ? reviewLive.emailAssetId : reviewFb.emailId,
  automationName: reviewLive.ok ? reviewLive.automationName : reviewFb.automationName,
  automationGuid: reviewLive.ok ? reviewLive.automationRestId : reviewFb.automationGuid,
  automationKey: reviewLive.ok ? reviewLive.automationKey : reviewFb.automationKey
 });
 manifestHtml = pbBuildManifestHtml(manifest);
 if (reviewLive.ok) {
  manifestHtml =
   '<div class="banner good" style="margin-bottom:14px">' +
   pbHtmlSafe(reviewLive.msg) +
   "</div>" +
   manifestHtml;
 }
}

if (confirmPush && pageStatus === "review" && isStack && jid) {
 pageStatus = "pushing";
 var pushResult = pbPushStackBuild({
  journeyId: jid,
  buildName: pbTrim(Platform.Variable.GetValue("@dispName") || ""),
  queryKey: pbTrim(Platform.Variable.GetValue("@dispQueryKey") || ""),
  emailId: pbTrim(Platform.Variable.GetValue("@dispEmailId") || ""),
  emailName: pbTrim(Platform.Variable.GetValue("@dispEmailName") || ""),
  deId: pbTrim(Platform.Variable.GetValue("@dispDeId") || ""),
  deName: pbTrim(Platform.Variable.GetValue("@dispDeName") || ""),
  automationGuid: pbTrim(Platform.Variable.GetValue("@dispAutomationGuid") || ""),
  automationKey: pbTrim(Platform.Variable.GetValue("@dispAutomationCustomerKey") || ""),
  automationName: pbTrim(Platform.Variable.GetValue("@dispAutomationName") || "")
 });
 var li;
 pushLogHtml = '<ol class="push-log">';
 for (li = 0; li < pushResult.logs.length; li++) {
  pushLogHtml += "<li>" + pbHtmlSafe(pushResult.logs[li]) + "</li>";
 }
 pushLogHtml += "</ol>";
 if (pushResult.ok) {
  pushResultBanner =
   '<div class="banner good">' + pbHtmlSafe(pushResult.msg) + "</div>";
  pageStatus = "done";
 } else {
  pushResultBanner =
   '<div class="banner bad">' + pbHtmlSafe(pushResult.msg || "Push failed.") + "</div>";
  pageStatus = "failed";
 }
}

Platform.Variable.SetValue("@pageStatus", pageStatus);
Platform.Variable.SetValue("@manifestHtml", manifestHtml);
Platform.Variable.SetValue("@pushLogHtml", pushLogHtml);
Platform.Variable.SetValue("@pushResultBanner", pushResultBanner);
Platform.Variable.SetValue("@pushBlockedMsg", pushBlockedMsg);
</script>
