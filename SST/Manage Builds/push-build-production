  var list = coerceActivityList(activities);
  var emails = [];
  var i;
  for (i = 0; i < safeArrayLength(list); i++) {
    var act = safeArrayGet(list, i);
    if (act && isEmailActivity(act)) {
      emails.push(act);
    }
  }
  if (!emails.length) {
    return {
      count: 0,
      issues: 0,
      html: '<p class="recent-empty">This journey has no email activities.</p>'
    };
  }
  var issues = 0;
  var parts = ['<div class="contacts-table-wrap"><table class="contacts-table">'];
  parts.push(
    "<thead><tr><th>Email</th><th>Subject line</th><th>Sender profile</th><th>Status</th></tr></thead><tbody>"
