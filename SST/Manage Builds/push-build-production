  return { ok: false, automationId: "", msg: "Automation key or query ObjectID missing." };
 }
 var existing = pbFindAutomationByKey(token, sub, automationKey);
 if (existing && existing.id) {
  return { ok: true, automationId: pbToStr(existing.id), msg: "Automation already exists in Production." };
 }
 var now = new Date();
 now.setMinutes(0, 0, 0);
 now.setHours(now.getHours() + 1);
 function pad2(n) {
  return (n < 10 ? "0" : "") + n;
 }
 var startDateLocal =
  now.getFullYear() +
  "-" +
  pad2(now.getMonth() + 1) +
  "-" +
  pad2(now.getDate()) +
  "T" +
  pad2(now.getHours()) +
  ":" +
  pad2(now.getMinutes()) +
  ":00";
 var dUntil = new Date(now.getTime());
 dUntil.setDate(dUntil.getDate() + 365);
 var untilCompact =
  String(dUntil.getFullYear()) + pad2(dUntil.getMonth() + 1) + pad2(dUntil.getDate());
 var recurRule = "FREQ=HOURLY;INTERVAL=1;UNTIL=" + untilCompact;
 var endpoint = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/automations";
 var payload = {
  name: automationName || automationKey,
  description: "Pushed from SST",
  key: automationKey,
  steps: [
   {
    annotation: "",
    stepNumber: 0,
    activities: [
     {
      name: "Query Activity",
      description: "",
      objectTypeId: 300,
      displayOrder: 0,
      activityObjectId: queryObjectId,
      serializedObject: ""
     }
    ]
   }
  ],
  startSource: {
   typeId: 1,
   schedule: {
    icalRecur: recurRule,
    startDateTime: startDateLocal,
    endDateTime: startDateLocal,
    timezoneId: 1
   }
  }
 };
 var posted = pbHttpJson(token, sub, "POST", endpoint, payload);
 if (!pbHttpAccepted(posted.status)) {
  return {
   ok: false,
   automationId: "",
   msg: "Automation POST HTTP " + posted.status + " — " + pbTrim(posted.body).substring(0, 200)
  };
 }
 var automationId = "";
 try {
  var parsed = Platform.Function.ParseJSON(posted.body);
  automationId = parsed && parsed.id ? pbToStr(parsed.id) : "";
 } catch (postEx) {}
 if (!automationId) {
  var recovered = pbFindAutomationByKey(token, sub, automationKey);
  automationId = recovered && recovered.id ? pbToStr(recovered.id) : "";
 }
 if (!automationId) {
  return { ok: false, automationId: "", msg: "Automation created but id not returned." };
 }
 return { ok: true, automationId: automationId, msg: "Automation created in Production." };
}

