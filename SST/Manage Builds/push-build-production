  }
  var obj = parseJsonSafe(resp.body);
  if (!obj) {
    return { ok: false, msg: "Row count response was not JSON." };
  }
  var items = listFrom(obj.items);
  var reported = toWholeNumber(obj.count);
  var count = reported > items.length ? reported : items.length;
  var capped = count >= 2500 && ((obj.links && obj.links.next) || items.length >= 2500);
  return { ok: true, count: count, capped: capped, customerKey: key, msg: "" };
