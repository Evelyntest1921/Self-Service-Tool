    restBase(sub) +
    "data/v1/customobjectdata/key/" +
    encodeURIComponent(key) +
    "/rowset?$page=1&$pageSize=2500";
  var resp = journeyHttpJson(token, "GET", url, null);
  if (resp.status != 200 && resp.status != 201) {
    return {
      ok: false,
      msg: "Row count HTTP " + resp.status + (resp.body ? " " + clip(resp.body, 120) : "")
