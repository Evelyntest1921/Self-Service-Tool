%%[
VAR @HOME_URL, @BUILD_PAGE_SELF, @PUSH_PAGE_SELF, @jid, @confirmPush
VAR @navRows, @navRow, @detailRows, @detailRow, @detailCount
VAR @dispName, @dispType, @dispEmailName, @dispEmailId, @dispDeName, @dispDeId
VAR @dispQueryKey, @dispAutomationGuid, @dispAutomationCustomerKey, @dispAutomationName
VAR @isStackBuild, @pageStatus, @pushBlockedMsg, @pushLogHtml, @pushResultBanner
VAR @manifestHtml, @editSidebarHtml, @buildNavContext, @buildNavActive
VAR @STACK_JOURNEY_TYPE, @AUTH_SOURCE_USER, @AUTH_PROD_USER

SET @STACK_JOURNEY_TYPE = "Journey + Automation"
SET @AUTH_SOURCE_USER = "Admin"
SET @AUTH_PROD_USER = "Admin_Production"
SET @HOME_URL = ""
SET @BUILD_PAGE_SELF = ""
SET @PUSH_PAGE_SELF = ""
SET @jid = Trim(RequestParameter("journeyId"))
IF Empty(@jid) THEN
 SET @jid = Trim(QueryParameter("journeyId"))
ENDIF
SET @confirmPush = IIF(RequestParameter("confirmPush") == "1", "1", "0")
SET @pageStatus = "review"
SET @pushBlockedMsg = ""
SET @pushLogHtml = ""
SET @pushResultBanner = ""
SET @manifestHtml = ""
SET @buildNavContext = "true"
SET @buildNavActive = "manage"
SET @isStackBuild = "false"
SET @dispName = ""
SET @dispType = ""
SET @dispEmailName = ""
SET @dispEmailId = ""
SET @dispDeName = ""
SET @dispDeId = ""
SET @dispQueryKey = ""
SET @dispAutomationGuid = ""
SET @dispAutomationCustomerKey = ""
SET @dispAutomationName = ""
SET @detailCount = 0

SET @navRows = LookupRows("bd_sst_page_navigation","type","cloudpage")
IF RowCount(@navRows) > 0 THEN
 SET @navRow = Row(@navRows,1)
 SET @HOME_URL = Field(@navRow,"ss_home")
 SET @BUILD_PAGE_SELF = Field(@navRow,"ss_edit")
 SET @PUSH_PAGE_SELF = Trim(Field(@navRow,"ss_push_production"))
ENDIF

IF Empty(@jid) THEN
 SET @pageStatus = "nodata"
ELSE
 SET @detailRows = LookupRows("Bd_journey_analytics","journeyId",@jid)
 IF RowCount(@detailRows) == 0 THEN
  SET @detailRows = LookupRows("Bd_journey_analytics","JourneyID",@jid)
 ENDIF
 SET @detailCount = RowCount(@detailRows)
 IF @detailCount == 0 THEN
  SET @pageStatus = "nodata"
 ELSE
  SET @detailRow = Row(@detailRows,1)
  SET @dispName = Field(@detailRow,"journeyName")
  SET @dispType = Field(@detailRow,"journeyType")
  SET @dispEmailName = Field(@detailRow,"emailName")
  SET @dispEmailId = Trim(Field(@detailRow,"emailId"))
  SET @dispDeName = Field(@detailRow,"deName")
  SET @dispDeId = Field(@detailRow,"deId")
  IF Trim(@dispType) == @STACK_JOURNEY_TYPE THEN
   SET @isStackBuild = "true"
   SET @dispQueryKey = Trim(Field(@detailRow,"queryKey"))
   SET @dispAutomationGuid = Trim(Field(@detailRow,"automationGuid"))
   SET @dispAutomationCustomerKey = Trim(Field(@detailRow,"automationCustomerKey"))
   SET @dispAutomationName = Trim(Field(@detailRow,"automationName"))
  ENDIF
 ENDIF
ENDIF

IF @pageStatus != "nodata" AND @isStackBuild != "true" THEN
 SET @pageStatus = "unsupported"
 SET @pushBlockedMsg = "Push to Production is only available for Journey + Automation (stack) builds in this release."
ENDIF
]%%
<script runat="server">
Platform.Load("core", "1");

function pbToStr(v) {
 if (v === null || typeof v === "undefined") {
  return "";
 }
 if (typeof v === "string") {
  return v;
 }
 try {
  return v + "";
 } catch (pbEx) {
  return "";
 }
}

function pbTrim(v) {
 var s = pbToStr(v);
 if (!s) {
  return "";
 }
 var len = s.length;
 if (typeof len !== "number" || isNaN(len) || len < 0) {
  return "";
 }
 var start = 0;
 var end = len;
 while (start < end && (s.charAt(start) === " " || s.charAt(start) === "\t" || s.charAt(start) === "\n" || s.charAt(start) === "\r")) {
  start += 1;
 }
 while (end > start && (s.charAt(end - 1) === " " || s.charAt(end - 1) === "\t" || s.charAt(end - 1) === "\n" || s.charAt(end - 1) === "\r")) {
  end -= 1;
 }
 if (start >= end) {
  return "";
 }
 var out = "";
 var i;
 for (i = start; i < end; i++) {
  out += s.charAt(i);
 }
 return out;
}

function pbHtmlSafe(v) {
 return pbToStr(v)
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;")
  .replace(/"/g, "&quot;");
}

function pbEscJson(s) {
 var text = pbToStr(s);
 var out = "";
 var i;
 for (i = 0; i < text.length; i++) {
  var ch = text.charAt(i);
  if (ch === "\\") {
   out += "\\\\";
  } else if (ch === '"') {
   out += '\\"';
  } else if (ch === "\r") {
   out += "\\r";
  } else if (ch === "\n") {
   out += "\\n";
  } else {
   out += ch;
  }
 }
 return out;
}

function pbHttpOk(statusCode) {
 var code = parseInt(String(statusCode), 10);
 return code === 200 || code === 201;
}

function pbHttpAccepted(statusCode) {
 var code = parseInt(String(statusCode), 10);
 return code === 200 || code === 201 || code === 202;
}

function pbExtractAccessToken(body) {
 var text = pbToStr(body);
 if (!text) {
  return "";
 }
 try {
  var parsed = Platform.Function.ParseJSON(text);
  if (parsed && parsed.access_token) {
   return pbToStr(parsed.access_token);
  }
  if (parsed && parsed.error) {
   return "";
  }
 } catch (parseEx) {}
 var m = text.match(/"access_token"\s*:\s*"([^"]+)"/);
 return m ? m[1] : "";
}

function pbAuthField(row, names) {
 var i;
 for (i = 0; i < names.length; i++) {
  try {
   var v = row[names[i]];
   if (v !== null && v !== undefined && pbTrim(v)) {
    return pbTrim(v);
   }
  } catch (fieldEx) {}
 }
 return "";
}

function pbAuthResolveRow(userKey, fallbackKeys) {
 var tried = [];
 var keys = [pbTrim(userKey)];
 var fi;
 if (fallbackKeys && fallbackKeys.length) {
  for (fi = 0; fi < fallbackKeys.length; fi++) {
   keys.push(pbTrim(fallbackKeys[fi]));
  }
 }
 var ki;
 for (ki = 0; ki < keys.length; ki++) {
  var candidate = keys[ki];
  if (!candidate) {
   continue;
  }
  var dup = false;
  var ti;
  for (ti = 0; ti < tried.length; ti++) {
   if (tried[ti] === candidate) {
    dup = true;
    break;
   }
  }
  if (dup) {
   continue;
  }
  tried.push(candidate);
  var rows = Platform.Function.LookupRows("SFMC_AUTH", "User", candidate);
  if (rows && rows.length > 0) {
   return { row: rows[0], userKey: candidate, tried: tried };
  }
 }
 return { row: null, userKey: pbTrim(userKey), tried: tried };
}

function pbAuthForUser(userKey, fallbackKeys) {
 var out = {
  ok: false,
  token: "",
  subdomain: "",
  msg: "",
  userKey: ""
 };
 try {
  var resolved = pbAuthResolveRow(userKey, fallbackKeys);
  if (!resolved.row) {
   out.msg =
    "No SFMC_AUTH row for User=" +
    resolved.userKey +
    " (also tried: " +
    (resolved.tried.length ? resolved.tried.join(", ") : "none") +
    ").";
   return out;
  }
  var lookupUser = resolved.userKey;
  out.userKey = lookupUser;
  var row = resolved.row;
  var clientId = pbAuthField(row, ["clientId", "ClientId"]);
  var clientSecret = pbAuthField(row, ["clientSecret", "ClientSecret"]);
  var subdomain = pbAuthField(row, ["subdomain", "Subdomain"]);
  var accountId = pbAuthField(row, ["accountId", "AccountId"]);
  if (!clientId || !clientSecret || !subdomain) {
   out.msg = "SFMC_AUTH incomplete for User=" + lookupUser + ".";
   return out;
  }
  var authUrl = "https://" + subdomain + ".auth.marketingcloudapis.com/v2/token";
  var payload = '{"grant_type":"client_credentials","client_id":"' + pbEscJson(clientId) + '","client_secret":"' + pbEscJson(clientSecret) + '"';
  if (accountId) {
   payload += ',"account_id":"' + pbEscJson(accountId) + '"';
  }
  payload += "}";
  var req = new Script.Util.HttpRequest(authUrl);
  req.emptyContentHandling = 0;
  req.retries = 1;
  req.continueOnError = true;
  req.method = "POST";
  req.contentType = "application/json";
  req.postData = payload;
  var resp = req.send();
  var body = resp.content ? pbToStr(resp.content) : "";
  if (!pbHttpOk(resp.statusCode)) {
   out.msg =
    "Auth HTTP " +
    resp.statusCode +
    " for User=" +
    lookupUser +
    " — " +
    pbTrim(body).substring(0, 160);
   return out;
  }
  var token = pbExtractAccessToken(body);
  if (!token) {
   out.msg =
    "Auth HTTP " +
    resp.statusCode +
    " for User=" +
    lookupUser +
    " but no access_token — " +
    pbTrim(body).substring(0, 160);
   return out;
  }
  out.ok = true;
  out.token = token;
  out.subdomain = subdomain;
  return out;
 } catch (authEx) {
  out.msg = authEx.message || pbToStr(authEx);
  return out;
 }
}

function pbHttpJson(token, subdomain, method, url, bodyObj) {
 var req = new Script.Util.HttpRequest(url);
 req.emptyContentHandling = 0;
 req.retries = 1;
 req.continueOnError = true;
 req.method = method;
 req.contentType = "application/json";
 req.setHeader("Authorization", "Bearer " + token);
 if (bodyObj !== null && typeof bodyObj !== "undefined") {
  req.postData =
   typeof bodyObj === "string" ? bodyObj : Platform.Function.Stringify(bodyObj);
 }
 var resp = req.send();
 return {
  status: resp.statusCode,
  body: resp.content ? pbToStr(resp.content) : ""
 };
}

function pbLookupQueryText(queryKey) {
 var key = pbTrim(queryKey);
 if (!key) {
  return "";
 }
 try {
  var prox = new Script.Util.WSProxy();
  var r = prox.retrieve("QueryDefinition", ["QueryText", "Name", "CustomerKey"], {
   Property: "CustomerKey",
   SimpleOperator: "equals",
   Value: key
  });
  if (r && r.Results && r.Results.length > 0 && r.Results[0].QueryText) {
   return pbToStr(r.Results[0].QueryText);
  }
 } catch (qEx) {}
 return "";
}

function pbWsLookupQueryByObjectId(queryObjectId) {
 var oid = pbTrim(queryObjectId);
 if (!oid) {
  return { customerKey: "", name: "", queryText: "" };
 }
 try {
  var prox = new Script.Util.WSProxy();
  var r = prox.retrieve(
   "QueryDefinition",
   ["CustomerKey", "Name", "QueryText"],
   { Property: "ObjectID", SimpleOperator: "equals", Value: oid }
  );
  if (r && r.Results && r.Results.length > 0) {
   return {
    customerKey: pbToStr(r.Results[0].CustomerKey || ""),
    name: pbToStr(r.Results[0].Name || ""),
    queryText: pbToStr(r.Results[0].QueryText || "")
   };
  }
 } catch (wsQEx) {}
 return { customerKey: "", name: "", queryText: "" };
}

function pbWsLookupDeByObjectId(objectId) {
 var oid = pbTrim(objectId);
 if (!oid) {
  return { customerKey: "", name: "" };
 }
 try {
  var prox = new Script.Util.WSProxy();
  var r = prox.retrieve("DataExtension", ["CustomerKey", "Name"], {
   Property: "ObjectID",
   SimpleOperator: "equals",
   Value: oid
  });
  if (r && r.Results && r.Results.length > 0) {
   return {
    customerKey: pbToStr(r.Results[0].CustomerKey || ""),
    name: pbToStr(r.Results[0].Name || "")
   };
  }
 } catch (wsDeEx) {}
 return { customerKey: "", name: "" };
}

function pbFindEntryEventRef(jObj) {
 var triggers = jObj && jObj.triggers ? jObj.triggers : [];
 var i;
 for (i = 0; i < triggers.length; i++) {
  var tr = triggers[i] || {};
  if (pbTrim(tr.type).toUpperCase() === "EMAILAUDIENCE") {
   var meta = tr.metaData || {};
   var eventDefId = pbTrim(meta.eventDefinitionId);
   if (!eventDefId && tr.arguments) {
    eventDefId = pbTrim(tr.arguments.eventDefinitionId);
   }
   if (eventDefId) {
    return { eventDefId: eventDefId };
   }
  }
 }
 for (i = 0; i < triggers.length; i++) {
  var tr2 = triggers[i] || {};
  var meta2 = tr2.metaData || {};
  var evId = pbTrim(meta2.eventDefinitionId);
  if (!evId && tr2.arguments) {
   evId = pbTrim(tr2.arguments.eventDefinitionId);
  }
  if (evId) {
   return { eventDefId: evId };
  }
 }
 return null;
}

function pbGetEventDefinition(token, sub, eventDefId) {
 var url =
  "https://" +
  sub +
  ".rest.marketingcloudapis.com/interaction/v1/eventDefinitions/" +
  encodeURIComponent(eventDefId);
 var got = pbHttpJson(token, sub, "GET", url, null);
 if (!pbHttpOk(got.status) || !got.body) {
  return { ok: false, msg: "Event GET HTTP " + got.status + ".", obj: null };
 }
 try {
  return { ok: true, msg: "", obj: Platform.Function.ParseJSON(got.body) };
 } catch (parseEx) {
  return { ok: false, msg: "Event JSON parse failed.", obj: null };
 }
}

function pbGetAutomationRest(token, sub, restId, customerKey) {
 var base = "https://" + sub + ".rest.marketingcloudapis.com/automation/v1/automations/";
 var rid = pbTrim(restId);
 var key = pbTrim(customerKey);
 if (rid) {
  var byId = pbHttpJson(token, sub, "GET", base + encodeURIComponent(rid), null);
  if (pbHttpOk(byId.status) && byId.body) {
   try {
    return { ok: true, obj: Platform.Function.ParseJSON(byId.body) };
   } catch (byIdEx) {}
  }
 }
 if (key) {
  var byKey = pbHttpJson(token, sub, "GET", base + "key:" + encodeURIComponent(key), null);
  if (pbHttpOk(byKey.status) && byKey.body) {
   try {
    return { ok: true, obj: Platform.Function.ParseJSON(byKey.body) };
   } catch (byKeyEx) {}
  }
 }
 return { ok: false, obj: null };
}

function pbExtractQueryFromAutomation(autoObj) {
 var steps = autoObj && autoObj.steps ? autoObj.steps : [];
 var si;
 for (si = 0; si < steps.length; si++) {
  var activities = steps[si] && steps[si].activities ? steps[si].activities : [];
  var ai;
  for (ai = 0; ai < activities.length; ai++) {
   var act = activities[ai] || {};
   if (parseInt(String(act.objectTypeId), 10) === 300 && act.activityObjectId) {
    return { queryObjectId: pbToStr(act.activityObjectId) };
   }
  }
 }
 return { queryObjectId: "" };
}

function pbExtractEmailFromJourney(jObj) {
 var acts = jObj && jObj.activities ? jObj.activities : [];
 var i;
 for (i = 0; i < acts.length; i++) {
  var act = acts[i] || {};
  var type = pbTrim(act.type).toUpperCase();
  if (type.indexOf("EMAIL") < 0 && String(act.objectTypeId) !== "524") {
   continue;
  }
  var ts =
   act.configurationArguments && act.configurationArguments.triggeredSend
    ? act.configurationArguments.triggeredSend
    : {};
  var contentAssetId = pbTrim(ts.contentId || "");
  var legacyEmailId = pbTrim(ts.emailId || "");
  if (act.metaData && act.metaData.data && act.metaData.data.email) {
   var metaEmail = act.metaData.data.email;
   var metaId = pbTrim(metaEmail.id || "");
   var metaLegacy = pbTrim(metaEmail.legacyId || "");
   if (!contentAssetId && metaId && metaId !== metaLegacy) {
    contentAssetId = metaId;
   }
   if (!legacyEmailId && metaLegacy) {
    legacyEmailId = metaLegacy;
   }
   if (!contentAssetId && metaId && !metaLegacy) {
    contentAssetId = metaId;
   }
  }
  if (contentAssetId && legacyEmailId && contentAssetId === legacyEmailId) {
   contentAssetId = "";
  }
  var emailName = pbTrim(ts.emailName || act.name || "");
  if (contentAssetId || legacyEmailId || emailName) {
   return {
    contentAssetId: contentAssetId,
    legacyEmailId: legacyEmailId,
    name: emailName
   };
  }
 }
 return { contentAssetId: "", legacyEmailId: "", name: "" };
}

function pbResolveLiveEntryDeFromEvent(evObj) {
 if (!evObj) {
  return { customerKey: "", name: "", objectId: "" };
 }
 var objectId = pbTrim(evObj.dataExtensionId || evObj.dataExtensionID || "");
 var name = pbTrim(evObj.dataExtensionName || "");
 var customerKey = pbTrim(evObj.dataExtensionKey || evObj.dataExtensionCustomerKey || "");
 if (objectId && (!name || !customerKey)) {
  var meta = pbWsLookupDeByObjectId(objectId);
  if (!name) {
   name = meta.name;
  }
  if (!customerKey) {
   customerKey = meta.customerKey;
  }
 }
 return { customerKey: customerKey, name: name, objectId: objectId };
}

function pbResolveLiveStackContext(token, sub, journeyId, fallback) {
 var fb = fallback || {};
 var result = {
  ok: false,
  msg: "",
  buildName: pbTrim(fb.buildName),
  deCustomerKey: "",
  deName: "",
  deObjectId: "",
  queryKey: "",
  queryText: "",
  emailAssetId: "",
  emailLegacyId: "",
  emailName: "",
  automationKey: "",
  automationName: "",
  automationRestId: ""
 };
 var jGot = pbGetJourney(token, sub, journeyId);
 if (!jGot.ok || !jGot.obj) {
  result.msg = jGot.msg || "Could not load live journey.";
  return result;
 }
 var jObj = jGot.obj;
 if (pbTrim(jObj.name)) {
  result.buildName = pbTrim(jObj.name);
 }
 var emailLive = pbExtractEmailFromJourney(jObj);
 if (emailLive.name) {
  result.emailName = emailLive.name;
 }
 result.emailLegacyId = emailLive.legacyEmailId || "";
 var entryRef = pbFindEntryEventRef(jObj);
 if (!entryRef || !entryRef.eventDefId) {
  result.msg = "Live journey has no entry event definition on triggers.";
  return result;
 }
 var evGot = pbGetEventDefinition(token, sub, entryRef.eventDefId);
 if (!evGot.ok || !evGot.obj) {
  result.msg = evGot.msg || "Could not load live entry event.";
  return result;
 }
 var entryDe = pbResolveLiveEntryDeFromEvent(evGot.obj);
 if (entryDe.customerKey) {
  result.deCustomerKey = entryDe.customerKey;
 }
 if (entryDe.name) {
  result.deName = entryDe.name;
 }
 if (entryDe.objectId) {
  result.deObjectId = entryDe.objectId;
 }
 var evArgs = evGot.obj.arguments || {};
 var autoRestId = pbTrim(
  evGot.obj.AutomationId || evArgs.AutomationId || fb.automationGuid || ""
 );
 var autoKeyHint = pbTrim(fb.automationKey || fb.automationGuid || "");
 var autoGot = pbGetAutomationRest(token, sub, autoRestId, autoKeyHint);
 if (autoGot.ok && autoGot.obj) {
  if (autoGot.obj.key) {
   result.automationKey = pbToStr(autoGot.obj.key);
  }
  if (autoGot.obj.name) {
   result.automationName = pbToStr(autoGot.obj.name);
  }
  if (autoGot.obj.id) {
   result.automationRestId = pbToStr(autoGot.obj.id);
  }
  var qRef = pbExtractQueryFromAutomation(autoGot.obj);
  if (qRef.queryObjectId) {
   var qLive = pbWsLookupQueryByObjectId(qRef.queryObjectId);
   if (qLive.customerKey) {
    result.queryKey = qLive.customerKey;
   }
   if (qLive.queryText) {
    result.queryText = qLive.queryText;
   }
   if (!result.queryKey && qLive.name) {
    result.queryKey = qLive.name;
   }
  }
 }
 if (!result.automationKey && autoKeyHint) {
  result.automationKey = autoKeyHint;
 }
 if (!result.automationName && pbTrim(fb.automationName)) {
  result.automationName = pbTrim(fb.automationName);
 }
 if (!result.deCustomerKey) {
  result.msg = "Live entry DE customer key not found on entry event.";
  return result;
 }
 if (!result.queryKey || !result.queryText) {
  result.msg = "Live query not resolved from automation query step (WSProxy).";
  return result;
 }
 if (!result.automationKey) {
  result.msg = "Live automation customer key not resolved.";
  return result;
 }
 if (!emailLive.contentAssetId && !emailLive.legacyEmailId && !emailLive.name) {
  result.msg = "Live email activity not found on journey canvas.";
  return result;
 }
 result.emailAssetId = emailLive.contentAssetId || emailLive.legacyEmailId || "";
 var emailResolved = pbResolveSourceEmailAsset(
  token,
  sub,
  emailLive.contentAssetId,
  emailLive.name,
  emailLive.legacyEmailId,
  false
 );
 if (emailResolved.ok && emailResolved.asset) {
  result.emailAssetId = pbToStr(emailResolved.asset.id || result.emailAssetId);
  if (emailResolved.asset.name) {
   result.emailName = pbTrim(emailResolved.asset.name);
  }
 }
 result.ok = true;
 result.msg = "Live artifacts resolved from journey " + journeyId + ".";
 if (!emailResolved.ok && emailLive.legacyEmailId) {
  result.msg +=
   " Email uses legacy id " +
   emailLive.legacyEmailId +
   "; Content Builder lookup runs on push.";
 }
 return result;
}

function pbStackAnalyticsFallback(ctx) {
 var c = ctx || {};
 return {
  buildName: pbTrim(c.buildName),
  deId: pbTrim(c.deId),
  deName: pbTrim(c.deName),
  queryKey: pbTrim(c.queryKey),
  emailId: pbTrim(c.emailId),
  emailName: pbTrim(c.emailName),
  automationGuid: pbTrim(c.automationGuid),
  automationKey: pbTrim(c.automationKey),
  automationName: pbTrim(c.automationName)
 };
}

function pbXmlSafe(s) {
 return pbToStr(s)
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/"/g, "&quot;");
}

function pbSoapCall(sub, token, action, bodyXml) {
 var envelope =
  '<?xml version="1.0" encoding="UTF-8"?>' +
  '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing">' +
  "<s:Header>" +
  '<a:Action s:mustUnderstand="1">' +
  action +
  "</a:Action>" +
  '<a:To s:mustUnderstand="1">https://' +
  pbXmlSafe(sub) +
  ".soap.marketingcloudapis.com/Service.asmx</a:To>" +
  '<fueloauth xmlns="http://exacttarget.com">' +
  pbXmlSafe(token) +
  "</fueloauth></s:Header>" +
  '<s:Body xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">' +
  bodyXml +
  "</s:Body></s:Envelope>";
 var req = new Script.Util.HttpRequest("https://" + sub + ".soap.marketingcloudapis.com/Service.asmx");
 req.emptyContentHandling = 0;
 req.retries = 1;
 req.continueOnError = true;
 req.method = "POST";
 req.contentType = "text/xml";
 req.setHeader("SOAPAction", action);
 req.postData = envelope;
 var resp = req.send();
 return { status: resp.statusCode, body: resp.content ? pbToStr(resp.content) : "" };
}

function pbSoapResultsSnippet(body) {
 var text = pbToStr(body);
 var m = text.match(/<(?:[\w]+:)?Results\b[\s\S]*?<\/(?:[\w]+:)?Results>/i);
 return m ? m[0] : text;
