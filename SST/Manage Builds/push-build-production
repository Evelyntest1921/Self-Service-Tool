function pbProdStepStatus(stepId, prodAuth, live) {
 var sid = pbTrim(stepId).toLowerCase();
 if (!prodAuth || !prodAuth.ok) {
  return { state: "unknown", note: "Production auth not available for status check." };
 }
 var lv = live || {};
 if (sid === "de") {
  var deKey = pbTrim(lv.deCustomerKey);
  if (!deKey) {
   return { state: "blocked", note: "No entry DE customer key from UAT/analytics." };
  }
  var deHit = pbProdRetrieveDeObjectId(prodAuth.subdomain, prodAuth.token, deKey, lv.deName);
  if (deHit.ok && deHit.objectId) {
   return { state: "done", note: "In Production — ObjectID " + deHit.objectId };
  }
  return { state: "pending", note: "Not found in Production yet." };
 }
 if (sid === "query_automation") {
  var qkCombo = pbTrim(lv.queryKey);
  var akCombo = pbTrim(lv.automationKey);
  if (!qkCombo || !akCombo) {
   return { state: "blocked", note: "No query or automation customer key." };
  }
  var qOidCombo = pbProdRetrieveQueryObjectId(prodAuth.subdomain, prodAuth.token, qkCombo, lv.buildName);
  var autoCombo = pbFindAutomationByKey(prodAuth.token, prodAuth.subdomain, akCombo);
  if (qOidCombo && autoCombo && autoCombo.id) {
   return { state: "done", note: "Query and automation in Production." };
  }
  if (qOidCombo) {
   return { state: "pending", note: "Query in Production; automation not yet." };
  }
  return { state: "pending", note: "Query and automation not in Production yet." };
 }
 if (sid === "query") {
  var qk = pbTrim(lv.queryKey);
  if (!qk) {
   return { state: "blocked", note: "No query customer key." };
  }
  var qOid = pbProdRetrieveQueryObjectId(prodAuth.subdomain, prodAuth.token, qk, lv.buildName);
  if (qOid) {
   return { state: "done", note: "QueryDefinition in Production." };
  }
  return { state: "pending", note: "Query not in Production yet." };
 }
 if (sid === "email") {
  return { state: "pending", note: "Push this step to copy or confirm email in Production." };
 }
 if (sid === "automation") {
  var ak = pbTrim(lv.automationKey);
  if (!ak) {
   return { state: "blocked", note: "No automation customer key." };
  }
  var auto = pbFindAutomationByKey(prodAuth.token, prodAuth.subdomain, ak);
  if (auto && auto.id) {
   return { state: "done", note: "Automation in Production (id " + auto.id + ")." };
  }
  return { state: "pending", note: "Automation not in Production yet." };
 }
 if (sid === "event_journey") {
  return { state: "pending", note: "Push when DE, query/automation, and email are ready." };
 }
 if (sid === "event" || sid === "journey") {
  return { state: "pending", note: "Push when prior steps succeed." };
 }
 return { state: "unknown", note: "" };
}

