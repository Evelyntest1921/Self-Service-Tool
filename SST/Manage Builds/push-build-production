function pbPushAuthPair() {
 var logs = [];
 var sourceUser = pbTrim(Platform.Variable.GetValue("@AUTH_SOURCE_USER") || "Admin") || "Admin";
 var prodUser =
  pbTrim(Platform.Variable.GetValue("@AUTH_PROD_USER") || "Admin_Production") || "Admin_Production";
 var prodUserFallbacks = [
  "Admin_production",
  "Admin_Production",
  "Production_Admin",
  "Admin Production"
 ];
 var devAuth = pbAuthForUser(sourceUser, []);
 if (!devAuth.ok) {
  return { ok: false, logs: logs, msg: "Source auth failed: " + devAuth.msg, devAuth: null, prodAuth: null };
 }
 logs.push("Source (" + (devAuth.userKey || sourceUser) + ") authentication OK.");
 var prodAuth = pbAuthForUser(prodUser, prodUserFallbacks);
 if (!prodAuth.ok) {
  return { ok: false, logs: logs, msg: "Production auth failed: " + prodAuth.msg, devAuth: devAuth, prodAuth: null };
 }
 logs.push("Production (" + (prodAuth.userKey || prodUser) + ") authentication OK.");
 return { ok: true, logs: logs, msg: "", devAuth: devAuth, prodAuth: prodAuth };
}

function pbExecutePushStep(stepId, journeyType, ctx) {
 var logs = [];
 function log(line) {
  logs.push(pbToStr(line));
 }
 var sid = pbTrim(stepId).toLowerCase();
 if (!pbPlanIncludesStep(journeyType, sid)) {
  return {
   ok: false,
   logs: logs,
   msg: "Step \"" + sid + "\" is not part of the push plan for journeyType \"" + journeyType + "\"."
  };
 }
 var authPack = pbPushAuthPair();
 var li;
 for (li = 0; li < authPack.logs.length; li++) {
  log(authPack.logs[li]);
 }
 if (!authPack.ok) {
  return { ok: false, logs: logs, msg: authPack.msg };
 }
 var devAuth = authPack.devAuth;
 var prodAuth = authPack.prodAuth;
 var journeyId = pbTrim(ctx.journeyId);
 if (!journeyId) {
  return { ok: false, logs: logs, msg: "Journey id missing." };
 }
 var fb = pbStackAnalyticsFallback(ctx);
 var resolved = pbResolvePushContext(journeyType, devAuth.token, devAuth.subdomain, journeyId, fb);
 var live = resolved.live;
 if (!live.ok) {
  return { ok: false, logs: logs, msg: live.msg || "Could not resolve build naming." };
 }
 log(live.msg);
 var buildName = live.buildName || pbTrim(ctx.buildName);
 var deKey = live.deCustomerKey;
 var deName = live.deName || deKey;
 if (sid === "de") {
  if (!deKey) {
   return { ok: false, logs: logs, msg: "Entry DE customer key missing." };
  }
  var deResult = pbProdEnsureEntryDe(prodAuth.subdomain, prodAuth.token, deKey, deName, {
   schemaOnly: true
  });
  if (deResult.ok) {
   log(deResult.msg);
   return { ok: true, logs: logs, msg: "Step complete: entry data extension in Production." };
  }
  return { ok: false, logs: logs, msg: "Entry DE FAILED: " + deResult.msg };
 }
 if (sid === "query") {
  if (!deKey) {
   return { ok: false, logs: logs, msg: "Entry DE key missing." };
  }
  var queryKey = live.queryKey || deKey;
  log("Query CustomerKey " + queryKey + " (recreate, target DE " + deKey + ").");
  var deProd = pbProdRetrieveDeObjectId(prodAuth.subdomain, prodAuth.token, deKey, deName);
  if (!deProd.ok || !deProd.objectId) {
   return { ok: false, logs: logs, msg: "Push entry DE first — not found in Production." };
  }
  var navEnv = pbTrim(Platform.Variable.GetValue("@navEnvironment") || "uat");
  var queryBuild = pbBuildQuerySqlForProdPush(
   fb,
   journeyId,
   live.senderProfileId,
   "",
   navEnv
  );
  if (!queryBuild.ok || !queryBuild.sql) {
   return { ok: false, logs: logs, msg: "Query SQL FAILED: " + (queryBuild.msg || "Could not build stack SQL.") };
  }
  log(queryBuild.msg);
  var deTargetMeta = pbProdRetrieveDeTargetMeta(
   prodAuth.subdomain,
   prodAuth.token,
   deKey,
   deName
  );
  var targetDeKey = deKey;
  var targetDeName = deName;
  if (deTargetMeta.ok) {
   targetDeKey = deTargetMeta.customerKey || deKey;
   targetDeName = deTargetMeta.name || deName;
   log(
    "Query target DE — CustomerKey " +
     targetDeKey +
     ", Name " +
     targetDeName +
     ", ObjectID " +
     deTargetMeta.objectId +
     "."
   );
  }
  var queryResult = pbStackCreateQueryDefinitionProd(
   prodAuth.subdomain,
   prodAuth.token,
   queryKey,
   queryKey,
   queryBuild.sql,
   targetDeKey,
   targetDeName
  );
  if (queryResult.ok) {
   log(queryResult.msg);
   return { ok: true, logs: logs, msg: "Step complete: query activity in Production." };
  }
  return { ok: false, logs: logs, msg: "Query FAILED: " + queryResult.msg };
 }
 if (sid === "email") {
  var emailName = live.emailName || buildName;
  var prodEmail = pbProdFindEmailAssetByName(prodAuth.token, prodAuth.subdomain, emailName);
  if (prodEmail.ok && prodEmail.asset) {
   log("Production email found by name \"" + emailName + "\" (id " + pbToStr(prodEmail.asset.id) + ").");
   return {
    ok: true,
    logs: logs,
    msg: "Step complete: email \"" + emailName + "\" exists in Production (not copied from UAT)."
   };
  }
  return {
   ok: false,
   logs: logs,
   msg:
    "Create email \"" +
    emailName +
    "\" in Production Content Builder first (recreate only — no UAT copy on this step)."
  };
 }
 if (sid === "automation") {
  var qk = live.queryKey || deKey;
  var qOid = pbProdRetrieveQueryObjectId(prodAuth.subdomain, prodAuth.token, qk, qk);
  if (!qOid) {
   return { ok: false, logs: logs, msg: "Push query step first — query ObjectID not found in Production." };
  }
  var automationResult = pbStackCreateAutomationProd(prodAuth.token, prodAuth.subdomain, {
   automationName: live.automationName || buildName,
   automationKey: live.automationKey || buildName,
   queryObjectId: qOid,
   frequency: "hourly",
   timezoneId: 1
  });
  if (automationResult.ok) {
   log(automationResult.msg);
   return { ok: true, logs: logs, msg: "Step complete: automation in Production." };
  }
  return { ok: false, logs: logs, msg: "Automation FAILED: " + automationResult.msg };
 }
 if (sid === "query_automation") {
  if (!deKey) {
   return { ok: false, logs: logs, msg: "Entry DE key missing." };
  }
  var queryKeyCombo = live.queryKey || deKey;
  log("Query CustomerKey " + queryKeyCombo + " (recreate, target DE " + deKey + ").");
  var deProdCombo = pbProdRetrieveDeObjectId(prodAuth.subdomain, prodAuth.token, deKey, deName);
  if (!deProdCombo.ok || !deProdCombo.objectId) {
   return { ok: false, logs: logs, msg: "Push entry DE first — not found in Production." };
  }
  var navEnvCombo = pbTrim(Platform.Variable.GetValue("@navEnvironment") || "uat");
  var queryBuildCombo = pbBuildQuerySqlForProdPush(fb, journeyId, live.senderProfileId, "", navEnvCombo);
  if (!queryBuildCombo.ok || !queryBuildCombo.sql) {
   return { ok: false, logs: logs, msg: "Query SQL FAILED: " + (queryBuildCombo.msg || "Could not build stack SQL.") };
  }
  log(queryBuildCombo.msg);
  var deTargetMetaCombo = pbProdRetrieveDeTargetMeta(
   prodAuth.subdomain,
   prodAuth.token,
   deKey,
   deName
  );
  var targetDeKeyCombo = deKey;
  var targetDeNameCombo = deName;
  if (deTargetMetaCombo.ok) {
   targetDeKeyCombo = deTargetMetaCombo.customerKey || deKey;
   targetDeNameCombo = deTargetMetaCombo.name || deName;
   log(
    "Query target DE — CustomerKey " +
     targetDeKeyCombo +
     ", Name " +
     targetDeNameCombo +
     ", ObjectID " +
     deTargetMetaCombo.objectId +
     "."
   );
  }
  var queryResultCombo = pbStackCreateQueryDefinitionProd(
   prodAuth.subdomain,
   prodAuth.token,
   queryKeyCombo,
   queryKeyCombo,
   queryBuildCombo.sql,
   targetDeKeyCombo,
   targetDeNameCombo
  );
  if (!queryResultCombo.ok) {
   return { ok: false, logs: logs, msg: "Query FAILED: " + queryResultCombo.msg };
  }
  log(queryResultCombo.msg);
  var qOidCombo = pbProdRetrieveQueryObjectId(
   prodAuth.subdomain,
   prodAuth.token,
   queryKeyCombo,
   queryKeyCombo
  );
  if (!qOidCombo) {
   return { ok: false, logs: logs, msg: "Query created but ObjectID not found in Production." };
  }
  var automationResultCombo = pbStackCreateAutomationProd(prodAuth.token, prodAuth.subdomain, {
   automationName: live.automationName || buildName,
   automationKey: live.automationKey || buildName,
   queryObjectId: qOidCombo,
   frequency: "hourly",
   timezoneId: 1
  });
  if (automationResultCombo.ok) {
   log(automationResultCombo.msg);
   return { ok: true, logs: logs, msg: "Step complete: query activity and automation in Production." };
  }
  return { ok: false, logs: logs, msg: "Automation FAILED: " + automationResultCombo.msg };
 }
 if (sid === "event") {
  var deForEvent = pbProdRetrieveDeObjectId(prodAuth.subdomain, prodAuth.token, deKey, deName);
  if (!deForEvent.ok || !deForEvent.objectId) {
   return { ok: false, logs: logs, msg: "Push entry DE first." };
  }
  var autoKey = pbTrim(live.automationKey || buildName);
  var autoObj = pbFindAutomationByKey(prodAuth.token, prodAuth.subdomain, autoKey);
  if (!autoObj || !autoObj.id) {
   return { ok: false, logs: logs, msg: "Push automation step first." };
  }
  var eventResult = pbCreateProdDeAudienceEvent(prodAuth.token, prodAuth.subdomain, {
   name: buildName,
   eventKey: "DEAudience-" + pbRandomGuid(),
   dataExtensionId: deForEvent.objectId,
   dataExtensionName: deName,
   automationId: autoObj.id
  });
  if (eventResult.ok) {
   log(eventResult.msg);
   return { ok: true, logs: logs, msg: "Step complete: entry event in Production." };
  }
  return { ok: false, logs: logs, msg: "Entry event FAILED: " + eventResult.msg };
 }
 if (sid === "journey") {
  return {
   ok: false,
   logs: logs,
   msg: "Use the combined entry event + journey step for stack builds."
  };
 }
 if (sid === "event_journey") {
  var deForEventJ = pbProdRetrieveDeObjectId(prodAuth.subdomain, prodAuth.token, deKey, deName);
  if (!deForEventJ.ok || !deForEventJ.objectId) {
   return { ok: false, logs: logs, msg: "Push entry DE first." };
  }
  var autoKeyEj = pbTrim(live.automationKey || buildName);
  var autoObjEj = pbFindAutomationByKey(prodAuth.token, prodAuth.subdomain, autoKeyEj);
  if (!autoObjEj || !autoObjEj.id) {
   return { ok: false, logs: logs, msg: "Push query + automation step first." };
  }
  var emailNameEj = live.emailName || buildName;
  var prodEmailEj = pbProdFindEmailAssetByName(prodAuth.token, prodAuth.subdomain, emailNameEj);
  if (!prodEmailEj.ok || !prodEmailEj.asset) {
   return {
    ok: false,
    logs: logs,
    msg: "Production email \"" + emailNameEj + "\" not found — complete the email step first."
   };
  }
  var prodAssetIdEj = pbToStr(prodEmailEj.asset.id || "");
  var prodLegacyEj = pbExtractLegacyEmailId(prodEmailEj.asset);
  var eventResultEj = pbCreateProdDeAudienceEvent(prodAuth.token, prodAuth.subdomain, {
   name: buildName,
   eventKey: "DEAudience-" + pbRandomGuid(),
   dataExtensionId: deForEventJ.objectId,
   dataExtensionName: deName,
   automationId: autoObjEj.id
  });
  if (!eventResultEj.ok) {
   return { ok: false, logs: logs, msg: "Entry event FAILED: " + eventResultEj.msg };
  }
  log(eventResultEj.msg);
  var journeyCloneEj = pbCloneJourneyToProd(
   devAuth.token,
   devAuth.subdomain,
   prodAuth.token,
   prodAuth.subdomain,
   journeyId,
   {
    buildName: buildName,
    legacyEmailId: prodLegacyEj,
    prodEmailAssetId: prodAssetIdEj,
    trigger: eventResultEj.trigger
   }
  );
  if (journeyCloneEj.ok) {
   log(journeyCloneEj.msg);
   return {
    ok: true,
    logs: logs,
    msg: "Step complete: entry event and journey (draft) in Production."
   };
  }
  return { ok: false, logs: logs, msg: "Journey FAILED: " + journeyCloneEj.msg };
 }
 return { ok: false, logs: logs, msg: "Unknown push step." };
}

function pbIsEmailAsset(assetObj) {
 if (!assetObj || !assetObj.assetType || assetObj.assetType.id === undefined) {
  return false;
 }
 var typeId = parseInt(String(assetObj.assetType.id), 10);
 return typeId === 207 || typeId === 208 || typeId === 4;
}

function pbFetchEmailAssetByLegacyId(sourceToken, sourceSub, legacyId, allowScan) {
 var leg = pbTrim(legacyId);
 if (!leg) {
  return { ok: false, asset: null, msg: "" };
 }
 var legNum = String(parseInt(leg, 10) || leg);
 var filterAttempts = [
  "assetType.id eq 207 and legacyData.legacyId eq " + legNum,
  "assetType.id eq 207 and legacyData.legacyId eq '" + leg.replace(/'/g, "''") + "'"
 ];
 var ai;
 for (ai = 0; ai < filterAttempts.length; ai++) {
  var legacyUrl =
   "https://" +
   sourceSub +
   ".rest.marketingcloudapis.com/asset/v1/content/assets?$page=1&$pagesize=10&$filter=" +
   encodeURIComponent(filterAttempts[ai]);
  var legacyGot = pbHttpJson(sourceToken, sourceSub, "GET", legacyUrl, null);
  if (pbHttpOk(legacyGot.status) && legacyGot.body) {
   try {
    var legacyData = Platform.Function.ParseJSON(legacyGot.body);
    var legacyItems = legacyData && legacyData.items ? legacyData.items : [];
    var li;
    for (li = 0; li < legacyItems.length; li++) {
     if (pbIsEmailAsset(legacyItems[li]) && pbExtractLegacyEmailId(legacyItems[li]) === leg) {
      return { ok: true, asset: legacyItems[li], msg: "" };
     }
    }
    if (legacyItems.length === 1 && pbIsEmailAsset(legacyItems[0])) {
     return { ok: true, asset: legacyItems[0], msg: "" };
    }
   } catch (legacyParseEx) {}
  }
 }
 if (allowScan !== true) {
  return { ok: false, asset: null, msg: "No Content Builder asset for legacy email id " + leg + "." };
 }
 var page = 1;
 while (page <= 3) {
  var listUrl =
   "https://" +
   sourceSub +
   ".rest.marketingcloudapis.com/asset/v1/content/assets?$page=" +
   page +
   "&$pagesize=50&$filter=" +
   encodeURIComponent("assetType.id eq 207");
  var listGot = pbHttpJson(sourceToken, sourceSub, "GET", listUrl, null);
  if (!pbHttpOk(listGot.status) || !listGot.body) {
   break;
  }
  try {
   var listData = Platform.Function.ParseJSON(listGot.body);
   var items = listData && listData.items ? listData.items : [];
   var i;
   for (i = 0; i < items.length; i++) {
    if (pbIsEmailAsset(items[i]) && pbExtractLegacyEmailId(items[i]) === leg) {
     return { ok: true, asset: items[i], msg: "" };
    }
   }
   if (!items.length) {
    break;
   }
  } catch (scanEx) {
   break;
  }
  page++;
 }
 return { ok: false, asset: null, msg: "No Content Builder asset for legacy email id " + leg + "." };
}

function pbFetchEmailAssetById(sourceToken, sourceSub, assetId) {
 var id = pbTrim(assetId);
 if (!id) {
  return { ok: false, asset: null, msg: "Email asset id missing." };
 }
 var getUrl =
  "https://" + sourceSub + ".rest.marketingcloudapis.com/asset/v1/content/assets/" + encodeURIComponent(id);
 var got = pbHttpJson(sourceToken, sourceSub, "GET", getUrl, null);
 if (!pbHttpOk(got.status) || !got.body) {
  return { ok: false, asset: null, msg: "Source email GET HTTP " + got.status + "." };
 }
 try {
  var asset = Platform.Function.ParseJSON(got.body);
  if (!pbIsEmailAsset(asset)) {
   return { ok: false, asset: null, msg: "Asset " + id + " is not an email content asset." };
  }
  return { ok: true, asset: asset, msg: "" };
 } catch (parseEx) {
  return { ok: false, asset: null, msg: "Source email JSON parse failed." };
 }
}

function pbFetchEmailAssetByName(sourceToken, sourceSub, emailName) {
 var name = pbTrim(emailName);
 if (!name) {
  return { ok: false, asset: null, msg: "Email name missing." };
 }
 var odataName = name.replace(/'/g, "''");
 var filterExpr = "name eq '" + odataName + "'";
 var listUrl =
  "https://" +
  sourceSub +
  ".rest.marketingcloudapis.com/asset/v1/content/assets?$page=1&$pagesize=50&$filter=" +
  encodeURIComponent(filterExpr);
 var got = pbHttpJson(sourceToken, sourceSub, "GET", listUrl, null);
 if (!pbHttpOk(got.status) || !got.body) {
  return { ok: false, asset: null, msg: "Email search HTTP " + got.status + "." };
 }
 try {
  var data = Platform.Function.ParseJSON(got.body);
  var items = data && data.items ? data.items : [];
  var nameLower = name.toLowerCase();
  var matches = [];
  var i;
  for (i = 0; i < items.length; i++) {
   if (pbIsEmailAsset(items[i]) && pbTrim(items[i].name).toLowerCase() === nameLower) {
    matches.push(items[i]);
   }
  }
  if (matches.length === 1) {
   return { ok: true, asset: matches[0], msg: "" };
  }
  if (matches.length > 1) {
   return { ok: false, asset: null, msg: "Multiple emails named \"" + name + "\"; fix emailId in analytics." };
  }
  return { ok: false, asset: null, msg: "No email named \"" + name + "\" in source BU." };
 } catch (listEx) {
  return { ok: false, asset: null, msg: "Email search parse failed." };
 }
}

function pbResolveSourceEmailAsset(sourceToken, sourceSub, assetId, emailName, legacyEmailId, allowLegacyScan) {
 var id = pbTrim(assetId);
 var legacy = pbTrim(legacyEmailId || "");
 var byLegacy = { ok: false, msg: "" };
 if (legacy && id === legacy) {
  id = "";
 }
 if (id && id.indexOf("-") >= 0) {
  var byGuid = pbFetchEmailAssetById(sourceToken, sourceSub, id);
  if (byGuid.ok) {
   return byGuid;
  }
 }
 if (id && /^\d+$/.test(id)) {
  var byNumeric = pbFetchEmailAssetById(sourceToken, sourceSub, id);
  if (byNumeric.ok) {
   return byNumeric;
  }
  if (!legacy) {
   legacy = id;
   id = "";
  }
 }
 if (id) {
  var byId = pbFetchEmailAssetById(sourceToken, sourceSub, id);
  if (byId.ok) {
   return byId;
  }
 }
 if (legacy) {
  byLegacy = pbFetchEmailAssetByLegacyId(sourceToken, sourceSub, legacy, allowLegacyScan === true);
  if (byLegacy.ok) {
   return byLegacy;
  }
 }
 if (emailName) {
  var byName = pbFetchEmailAssetByName(sourceToken, sourceSub, emailName);
  if (byName.ok) {
   return byName;
  }
  var parts = [];
  if (id) {
   parts.push("Source email GET failed for id " + id + ".");
  }
  if (legacy) {
   parts.push(byLegacy.msg || "Legacy id " + legacy + " not mapped to Content Builder.");
  }
  parts.push(byName.msg || "Name search failed.");
  return { ok: false, asset: null, msg: parts.join(" ") };
 }
 if (id) {
  return pbFetchEmailAssetById(sourceToken, sourceSub, id);
 }
 if (legacy) {
  return pbFetchEmailAssetByLegacyId(sourceToken, sourceSub, legacy, allowLegacyScan === true);
 }
 return { ok: false, asset: null, msg: "Email asset id or name missing." };
}

function pbReuseProdEmailByName(targetToken, targetSub, emailName) {
 var byName = pbFetchEmailAssetByName(targetToken, targetSub, emailName);
 if (!byName.ok || !byName.asset) {
  return { ok: false, prodEmailId: "", legacyEmailId: "", msg: byName.msg || "" };
 }
 var asset = byName.asset;
 return {
  ok: true,
  prodEmailId: pbToStr(asset.id || ""),
  legacyEmailId: pbExtractLegacyEmailId(asset),
  msg: "Production email reused (asset id " + pbToStr(asset.id || "") + ")."
 };
}

function pbCopyEmailAsset(sourceToken, sourceSub, targetToken, targetSub, assetId, targetName, legacyEmailId) {
 var resolved = pbResolveSourceEmailAsset(
  sourceToken,
  sourceSub,
  assetId,
  targetName,
  legacyEmailId || "",
  true
 );
 if (!resolved.ok || !resolved.asset) {
  return { ok: false, msg: resolved.msg || "Could not resolve source email." };
 }
 var template = resolved.asset;
 var prodEmailName = pbTrim(targetName || template.name || "Pushed email");
 var existingProd = pbReuseProdEmailByName(targetToken, targetSub, prodEmailName);
 if (existingProd.ok && existingProd.prodEmailId) {
  return {
   ok: true,
   msg: existingProd.msg,
   prodEmailId: existingProd.prodEmailId,
   legacyEmailId: existingProd.legacyEmailId
  };
 }
 var views = template.views || {};
 var htmlView = views.html || {};
 var subject =
  (views.subjectline && views.subjectline.content) || template.name || targetName || "Email";
 var payload = {
  name: prodEmailName,
  assetType: { id: 207, name: "htmlemail" },
  channels: { email: true, web: false },
  views: {
   subjectline: { content: subject },
   preheader: { content: (views.preheader && views.preheader.content) || "" },
   html: {
    content: htmlView.content || template.content || "",
    slots: htmlView.slots || template.slots || {}
   },
   text: { content: (views.text && views.text.content) || "" }
  }
 };
 var postUrl = "https://" + targetSub + ".rest.marketingcloudapis.com/asset/v1/content/assets";
 var posted = pbHttpJson(targetToken, targetSub, "POST", postUrl, payload);
 if (!pbHttpOk(posted.status)) {
  var postBody = pbTrim(posted.body);
  if (postBody.indexOf("already taken") >= 0 || postBody.indexOf("must be unique") >= 0) {
   var dupReuse = pbReuseProdEmailByName(targetToken, targetSub, prodEmailName);
   if (dupReuse.ok && dupReuse.prodEmailId) {
    return {
     ok: true,
     msg: dupReuse.msg,
     prodEmailId: dupReuse.prodEmailId,
     legacyEmailId: dupReuse.legacyEmailId
    };
   }
  }
  return {
   ok: false,
   msg: "Production email POST HTTP " + posted.status + " — " + postBody.substring(0, 220)
  };
 }
 var newId = "";
 try {
  var created = Platform.Function.ParseJSON(posted.body);
  newId = created && created.id ? pbToStr(created.id) : "";
 } catch (postParseEx) {}
 if (!newId) {
  var m = posted.body.match(/"id"\s*:\s*"?([^",}\s]+)"?/);
  newId = m ? m[1] : "";
 }
 if (!newId) {
  return { ok: false, msg: "Production email created but id not returned." };
 }
 var legacyId = "";
 try {
  var gotAsset = pbHttpJson(
   targetToken,
   targetSub,
   "GET",
   "https://" + targetSub + ".rest.marketingcloudapis.com/asset/v1/content/assets/" + encodeURIComponent(newId),
   null
  );
  if (pbHttpOk(gotAsset.status) && gotAsset.body) {
   legacyId = pbExtractLegacyEmailId(Platform.Function.ParseJSON(gotAsset.body));
  }
 } catch (legacyEx) {}
 return {
  ok: true,
  msg: "Email copied to Production (asset id " + newId + ").",
  prodEmailId: newId,
  legacyEmailId: legacyId
 };
}

var pageStatus = pbTrim(Platform.Variable.GetValue("@pageStatus") || "review");
var confirmStep = Platform.Variable.GetValue("@confirmStep") === "1";
var pushStep = pbTrim(Platform.Variable.GetValue("@pushStep") || "");
var jid = pbTrim(Platform.Variable.GetValue("@jid") || "");
var journeyType = pbTrim(Platform.Variable.GetValue("@dispType") || "");
var stepsHtml = "";
var pushLogHtml = "";
var pushResultBanner = "";
var pushBlockedMsg = pbTrim(Platform.Variable.GetValue("@pushBlockedMsg") || "");

function pbPushPageCtx() {
 return {
  journeyId: jid,
  buildName: pbTrim(Platform.Variable.GetValue("@dispName") || ""),
  queryKey: pbTrim(Platform.Variable.GetValue("@dispQueryKey") || ""),
  emailId: pbTrim(Platform.Variable.GetValue("@dispEmailId") || ""),
  emailName: pbTrim(Platform.Variable.GetValue("@dispEmailName") || ""),
  deId: pbTrim(Platform.Variable.GetValue("@dispDeId") || ""),
  deName: pbTrim(Platform.Variable.GetValue("@dispDeName") || ""),
  automationGuid: pbTrim(Platform.Variable.GetValue("@dispAutomationGuid") || ""),
  automationKey: pbTrim(Platform.Variable.GetValue("@dispAutomationCustomerKey") || ""),
  automationName: pbTrim(Platform.Variable.GetValue("@dispAutomationName") || ""),
  campaignId: pbTrim(Platform.Variable.GetValue("@pushCampaignId") || Platform.Variable.GetValue("@dispCampaignId") || ""),
  campaignIdSource:
   Platform.Variable.GetValue("@campaignIdFromForm") === "1" ? "page_input" : "analytics"
 };
}

if (pageStatus === "review" && jid && journeyType) {
 var reviewFb = pbStackAnalyticsFallback(pbPushPageCtx());
 var resolved = pbResolvePushContext(journeyType, "", "", jid, reviewFb);
 if (!resolved.live.ok) {
  pushBlockedMsg = resolved.live.msg || "Build name missing on analytics.";
 } else {
  pushBlockedMsg = "";
 }
 var prodAuthPreview = pbAuthForUser(
  pbTrim(Platform.Variable.GetValue("@AUTH_PROD_USER") || "Admin_Production") || "Admin_Production",
  ["Admin_production", "Admin_Production", "Production_Admin", "Admin Production"]
 );
 var plan = pbGetPushPlan(journeyType);
 var liveForUi = resolved.live;
 if (resolved.usesLiveStack && resolved.live.ok) {
  liveForUi = resolved.live;
 } else if (!resolved.usesLiveStack) {
  liveForUi = resolved.live;
 }
 var isStackForUi = Platform.Variable.GetValue("@isStackBuild") === "true";
 stepsHtml = pbBuildStepsHtml(journeyType, plan, liveForUi, prodAuthPreview, jid, {
  showCampaignInput: isStackForUi,
  campaignId: pbTrim(Platform.Variable.GetValue("@pushCampaignId") || "")
 });
 if (resolved.usesLiveStack && resolved.live.ok) {
  stepsHtml =
   '<div class="banner good" style="margin-bottom:14px">' +
   pbHtmlSafe(resolved.live.msg) +
   "</div>" +
   stepsHtml;
 }
}

if (confirmStep && pushStep && pageStatus === "review" && jid && journeyType) {
 var stepResult = pbExecutePushStep(pushStep, journeyType, pbPushPageCtx());
 var li;
 pushLogHtml = '<ol class="push-log">';
 for (li = 0; li < stepResult.logs.length; li++) {
  pushLogHtml += "<li>" + pbHtmlSafe(stepResult.logs[li]) + "</li>";
 }
 pushLogHtml += "</ol>";
 if (stepResult.ok) {
  pushResultBanner = '<div class="banner good">' + pbHtmlSafe(stepResult.msg) + "</div>";
  pageStatus = "step_done";
 } else {
  pushResultBanner = '<div class="banner bad">' + pbHtmlSafe(stepResult.msg || "Step failed.") + "</div>";
  pageStatus = "step_failed";
 }
}

Platform.Variable.SetValue("@pageStatus", pageStatus);
Platform.Variable.SetValue("@manifestHtml", stepsHtml);
Platform.Variable.SetValue("@pushLogHtml", pushLogHtml);
Platform.Variable.SetValue("@pushResultBanner", pushResultBanner);
Platform.Variable.SetValue("@pushBlockedMsg", pushBlockedMsg);
</script>
