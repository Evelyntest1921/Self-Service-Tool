  for (i = 0; i < emails.length; i++) {
    var email = emails[i];
    var ts =
      (email.configurationArguments && email.configurationArguments.triggeredSend) || {};
    var subject = strTrim(ts.emailSubject || ts.dynamicEmailSubject || "");
    var profileId = strTrim(ts.senderProfileId);
    var classificationId = strTrim(ts.sendClassificationId);
