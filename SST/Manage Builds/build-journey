%%[
VAR @HOME_URL, @BUILD_PAGE_SELF, @PERFORMANCE_URL, @JOURNEY_VIEW_URL, @SURVEY_STAGE_URL, @SURVEY_ANALYTICS_URL
VAR @navRows, @navRow, @jid, @detailRows, @detailRow, @detailCount
VAR @dispName, @dispType, @dispSurveyId, @isSurveyBuild, @buildNavContext, @buildNavActive
VAR @surveyUrlRows, @surveyUrlRow, @pageStatus, @loadError, @isRealJourney
VAR @authOk, @accessToken, @subdomain, @clientId, @clientSecret, @authUrl, @authPayload, @authStatus, @authResponse, @authResponseHeader, @tokenPattern, @accountId, @authR, @authRow
VAR @MC_CLOUD
VAR @journeyFlowHtml, @journeyActivitiesHtml, @journeyEmailsHtml, @journeyMetaHtml, @journeyBuilderUrl
VAR @apiJourneyName, @apiJourneyStatus, @apiJourneyVersion, @apiActivityCount, @editSidebarHtml
VAR @saveScheduleRequested, @schedulePanelVisible, @scheduleEventDefId, @scheduleSaveMsg, @scheduleEditorOpen, @scheduleSummary
VAR @entryScheduleType, @entryScheduleRepeat, @entryScheduleInterval, @entryScheduleOccurrences
VAR @entryScheduleEnd, @entryScheduleEndDate
VAR @entryScheduleWeekdays, @entryContactEvaluation, @entryScheduleStart

SET @saveScheduleRequested = "0"
SET @schedulePanelVisible = "false"
SET @scheduleEventDefId = ""
SET @scheduleSaveMsg = ""
SET @scheduleEditorOpen = "false"
SET @scheduleSummary = ""
SET @entryScheduleType = "runOnce"
SET @entryScheduleRepeat = "daily"
SET @entryScheduleInterval = "1"
SET @entryScheduleOccurrences = "2"
SET @entryScheduleEnd = "occurrences"
SET @entryScheduleEndDate = ""
SET @entryScheduleWeekdays = ""
SET @entryContactEvaluation = "newOnly"
SET @entryScheduleStart = ""
IF RequestParameter("saveSchedule") == "1" THEN
 SET @saveScheduleRequested = "1"
 SET @entryScheduleType = Trim(RequestParameter("entryScheduleType"))
 SET @entryScheduleRepeat = Trim(RequestParameter("entryScheduleRepeat"))
 SET @entryScheduleInterval = Trim(RequestParameter("entryScheduleInterval"))
 SET @entryScheduleOccurrences = Trim(RequestParameter("entryScheduleOccurrences"))
 SET @entryScheduleEnd = Trim(RequestParameter("entryScheduleEnd"))
 SET @entryScheduleEndDate = Trim(RequestParameter("entryScheduleEndDate"))
 SET @entryScheduleWeekdays = Trim(RequestParameter("entryScheduleWeekdays"))
 SET @entryContactEvaluation = Trim(RequestParameter("entryContactEvaluation"))
 SET @entryScheduleStart = Trim(RequestParameter("entryScheduleStart"))
 SET @scheduleEventDefId = Trim(RequestParameter("scheduleEventDefId"))
 SET @scheduleEditorOpen = "true"
ENDIF
IF Empty(@entryScheduleType) OR (@entryScheduleType != "runOnce" AND @entryScheduleType != "recurring") THEN
 SET @entryScheduleType = "runOnce"
ENDIF
IF Empty(@entryScheduleRepeat) THEN
 SET @entryScheduleRepeat = "daily"
ENDIF
IF @entryScheduleRepeat != "hourly" AND @entryScheduleRepeat != "daily" AND @entryScheduleRepeat != "weekdays" AND @entryScheduleRepeat != "weekly" AND @entryScheduleRepeat != "monthly" AND @entryScheduleRepeat != "yearly" THEN
 SET @entryScheduleRepeat = "daily"
ENDIF
IF Empty(@entryScheduleInterval) THEN
 SET @entryScheduleInterval = "1"
ENDIF
IF Empty(@entryScheduleOccurrences) THEN
 SET @entryScheduleOccurrences = "2"
ENDIF
IF Empty(@entryScheduleEnd) OR (@entryScheduleEnd != "occurrences" AND @entryScheduleEnd != "endDate" AND @entryScheduleEnd != "never") THEN
 SET @entryScheduleEnd = "occurrences"
ENDIF
IF Empty(@entryContactEvaluation) OR (@entryContactEvaluation != "all" AND @entryContactEvaluation != "newOnly") THEN
 SET @entryContactEvaluation = "newOnly"
ENDIF

SET @HOME_URL = ""
SET @BUILD_PAGE_SELF = ""
SET @PERFORMANCE_URL = ""
SET @JOURNEY_VIEW_URL = ""
SET @SURVEY_STAGE_URL = ""
SET @SURVEY_ANALYTICS_URL = ""
SET @navRows = LookupRows("bd_sst_page_navigation","type","cloudpage")
IF RowCount(@navRows) > 0 THEN
 SET @navRow = Row(@navRows,1)
 SET @HOME_URL = Field(@navRow,"ss_home")
 SET @BUILD_PAGE_SELF = Field(@navRow,"ss_edit")
 SET @PERFORMANCE_URL = Field(@navRow,"ss_performance")
 SET @JOURNEY_VIEW_URL = Field(@navRow,"ss_build_journey")
ENDIF
SET @surveyUrlRows = LookupRows("SST_SP_Survey_Url_DE","user","admin")
IF RowCount(@surveyUrlRows) > 0 THEN
 SET @surveyUrlRow = Row(@surveyUrlRows,1)
 SET @SURVEY_STAGE_URL = Field(@surveyUrlRow,"create")
 SET @SURVEY_ANALYTICS_URL = Field(@surveyUrlRow,"analytics")
ENDIF
SET @MC_CLOUD = "https://mc.s13.exacttarget.com/cloud/"
SET @jid = Trim(RequestParameter("journeyId"))
SET @dispName = ""
SET @dispType = ""
SET @dispSurveyId = ""
SET @isSurveyBuild = "false"
SET @buildNavContext = "false"
SET @buildNavActive = "journey"
SET @pageStatus = "view"
SET @loadError = ""
SET @isRealJourney = "false"
SET @authOk = "false"
SET @accessToken = ""
SET @subdomain = ""
SET @detailCount = 0
SET @journeyFlowHtml = ""
SET @journeyActivitiesHtml = ""
SET @journeyEmailsHtml = ""
SET @journeyMetaHtml = ""
SET @journeyBuilderUrl = ""
SET @apiJourneyName = ""
SET @apiJourneyStatus = ""
SET @apiJourneyVersion = ""
SET @apiActivityCount = "0"

IF Empty(@jid) THEN
 SET @pageStatus = "nodata"
ELSE
 SET @buildNavContext = "true"
 IF Substring(Lowercase(@jid),1,6) == "email:" THEN
  SET @pageStatus = "emailonly"
 ELSE
  SET @isRealJourney = "true"
  SET @detailRows = LookupRows("Bd_journey_analytics","journeyId",@jid)
  SET @detailCount = RowCount(@detailRows)
  IF @detailCount > 0 THEN
   SET @detailRow = Row(@detailRows,1)
   SET @dispName = Trim(Field(@detailRow,"journeyName"))
   SET @dispType = Trim(Field(@detailRow,"journeyType"))
   SET @dispSurveyId = Trim(Field(@detailRow,"surveyId"))
   IF IndexOf(@dispType,"Survey") > 0 THEN
    SET @isSurveyBuild = "true"
   ENDIF
  ENDIF
  SET @authRow = LookupRows("SFMC_AUTH","User","Admin")
  IF RowCount(@authRow) > 0 THEN
   SET @authR = Row(@authRow,1)
   SET @clientId = Field(@authR,"clientId")
   SET @clientSecret = Field(@authR,"clientSecret")
   SET @subdomain = Field(@authR,"subdomain")
   IF NOT Empty(@clientId) AND NOT Empty(@clientSecret) AND NOT Empty(@subdomain) THEN
    SET @authUrl = Concat("https://",@subdomain,".auth.marketingcloudapis.com/v2/token")
    SET @accountId = Trim(Field(@authR,"accountId"))
    SET @authPayload = Concat('{"grant_type":"client_credentials","client_id":"',@clientId,'","client_secret":"',@clientSecret,'"')
    IF NOT Empty(@accountId) THEN
     SET @authPayload = Concat(@authPayload,',"account_id":"',@accountId,'"')
    ENDIF
    SET @authPayload = Concat(@authPayload,'}')
    SET @authStatus = HTTPPost2(@authUrl,"application/json",@authPayload,false,@authResponse,@authResponseHeader)
    IF @authStatus == 200 THEN
     SET @accessToken = ""
     SET @tokPos = IndexOf(@authResponse, '"access_token":"')
     IF @tokPos > 0 THEN
      SET @tokRest = Substring(@authResponse, Add(@tokPos, 16), 800)
      SET @tokEndPos = IndexOf(@tokRest, '"')
      IF @tokEndPos > 1 THEN
       SET @accessToken = Substring(@tokRest, 1, Subtract(@tokEndPos, 1))
      ENDIF
     ENDIF
     IF NOT Empty(@accessToken) THEN
      SET @authOk = "true"
     ELSE
      SET @loadError = "Auth response missing access token."
      SET @pageStatus = "authfail"
     ENDIF
    ELSE
     SET @loadError = Concat("Auth HTTP ",@authStatus)
     SET @pageStatus = "authfail"
    ENDIF
   ELSE
    SET @loadError = "SFMC_AUTH incomplete for subdomain or credentials."
    SET @pageStatus = "authfail"
   ENDIF
  ELSE
   SET @loadError = "SFMC_AUTH has no Admin row."
   SET @pageStatus = "authfail"
  ENDIF
 ENDIF
ENDIF
]%%
<script runat="server" language="javascript">
Platform.Load("core", "1");

var MC_CLOUD = "https://mc.s13.exacttarget.com/cloud/";
var journeyFlowHtml = "";
var journeyActivitiesHtml = "";
var journeyEmailsHtml = "";
var journeyMetaHtml = "";
var journeyBuilderUrl = "";
var apiJourneyName = "";
var apiJourneyStatus = "";
var apiJourneyVersion = "";
var apiActivityCount = "0";
var loadErrorMsg = "";

function isWsChar(c) {
  return c === " " || c === "\t" || c === "\n" || c === "\r";
}

function toJsString(v) {
  if (v === null || typeof v === "undefined") {
    return "";
  }
  if (typeof v === "string") {
    return v;
  }
  if (typeof v === "number" || typeof v === "boolean") {
    return v + "";
  }
  try {
    var s = v + "";
    if (s && s.indexOf("[object") !== 0) {
      return s;
    }
  } catch (coerceEx) {}
  return "";
}

function strTrim(v) {
  var s = toJsString(v);
  var start = 0;
  var end = s.length;
  while (start < end && isWsChar(s.charAt(start))) {
    start += 1;
  }
  while (end > start && isWsChar(s.charAt(end - 1))) {
    end -= 1;
  }
  if (start === 0 && end === s.length) {
    return s;
  }
  return s.substring(start, end);
}

function strReplaceAll(s, find, repl) {
  var text = toJsString(s);
  if (!find || text.indexOf(find) < 0) {
    return text;
  }
  return text.split(find).join(repl);
}

function htmlSafe(v) {
  var s = strTrim(v);
  s = strReplaceAll(s, "&", "&amp;");
  s = strReplaceAll(s, "<", "&lt;");
  s = strReplaceAll(s, ">", "&gt;");
  s = strReplaceAll(s, '"', "&quot;");
  return s;
}

function parseJsonSafe(text) {
  var raw = toJsString(text);
  if (!raw) {
    return null;
  }
  try {
    return Platform.Function.ParseJSON(raw);
  } catch (parseEx1) {}
  try {
    if (typeof Script.Util.JSON !== "undefined" && Script.Util.JSON.parse) {
      return Script.Util.JSON.parse(raw);
    }
  } catch (parseEx2) {}
  return null;
}

function journeyHttpJson(token, method, url, bodyStr) {
  try {
    var req = new Script.Util.HttpRequest(url);
    req.emptyContentHandling = 0;
    req.retries = 2;
    req.continueOnError = true;
    req.setHeader("Authorization", "Bearer " + token);
    req.method = method;
    if (bodyStr) {
      req.contentType = "application/json";
      req.postData = bodyStr;
    }
    var resp = req.send();
    return {
      status: resp.statusCode,
      body: resp.content ? String(resp.content) : ""
    };
  } catch (httpEx) {
    return { status: 0, body: httpEx.message || String(httpEx) };
  }
}

function getJourneyObject(sub, token, jid) {
  var url =
    "https://" +
    sub +
    ".rest.marketingcloudapis.com/interaction/v1/interactions/" +
    encodeURIComponent(jid) +
    "?extras=all";
  var resp = journeyHttpJson(token, "GET", url, null);
  if (resp.status != 200 && resp.status != 201) {
    var detail = resp.body ? resp.body.substring(0, 220) : "";
    return {
      ok: false,
      msg: "Journey GET HTTP " + resp.status + (detail ? " - " + detail : "."),
      obj: null
    };
  }
  var jObj = parseJsonSafe(resp.body);
  if (!jObj) {
    return { ok: false, msg: "Could not parse journey response.", obj: null };
  }
  return { ok: true, msg: "", obj: jObj };
}

function pickFlowSvgByType(typeUpper) {
  var svgStart =
    '<svg class="journey-flow-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">';
  var svgEnd = "</svg>";
  if (typeUpper === "EMAILV2" || typeUpper === "EMAIL") {
    return (
      svgStart +
      '<rect x="2" y="4" width="20" height="16" rx="2"/>' +
      '<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>' +
      svgEnd
    );
  }
  if (typeUpper.indexOf("WAIT") >= 0) {
    return svgStart + '<circle cx="12" cy="12" r="10"/>' + '<path d="M12 6v6l4 2"/>' + svgEnd;
  }
  if (
    typeUpper === "MULTISTEPBRANCH" ||
    typeUpper === "RANDOMSPLIT" ||
    typeUpper.indexOf("SPLIT") >= 0 ||
    typeUpper.indexOf("CRITERIA") >= 0 ||
    typeUpper.indexOf("DECISION") >= 0
  ) {
    return (
      svgStart +
      '<circle cx="18" cy="5" r="3"/>' +
      '<circle cx="6" cy="12" r="3"/>' +
      '<circle cx="18" cy="19" r="3"/>' +
      '<path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"/>' +
      svgEnd
    );
  }
  if (
    typeUpper.indexOf("ENTRY") >= 0 ||
    typeUpper === "EVENT" ||
    typeUpper.indexOf("SALES") >= 0 ||
    typeUpper.indexOf("CRM") >= 0
  ) {
    return (
      svgStart +
      '<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>' +
      '<polyline points="10 17 15 12 10 7"/>' +
      '<line x1="15" y1="12" x2="3" y2="12"/>' +
      svgEnd
    );
  }
  if (typeUpper === "REST") {
    return (
      svgStart +
      '<polyline points="16 18 22 12 16 6"/>' +
      '<polyline points="8 6 2 12 8 18"/>' +
      svgEnd
    );
  }
  return (
    svgStart +
    '<circle cx="12" cy="12" r="10"/>' +
    '<path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>' +
    '<line x1="12" y1="17" x2="12.01" y2="17"/>' +
    svgEnd
  );
}

function flowStepIconHtml(act) {
  var t = strTrim(act && act.type ? act.type : "").toUpperCase();
  return (
    '<div class="journey-flow-icon-wrap" aria-hidden="true">' +
    pickFlowSvgByType(t) +
    "</div>"
  );
}

function buildJourneyOpenUrl(cloudBase, journeyId, versionNumber) {
  var jid = strTrim(journeyId);
  if (!jid) {
    return "";
  }
  var base = strTrim(cloudBase) || MC_CLOUD;
  if (base.charAt(base.length - 1) !== "/") {
    base += "/";
  }
  var ver = strTrim(versionNumber);
  if (!ver) {
    ver = "live";
  }
  return base + "#app/Journey%20Builder/%23" + jid + "/" + ver;
}

function formatActivityType(type) {
  var t = strTrim(type).toUpperCase();
  if (!t) {
    return "Activity";
  }
  if (t === "EMAILV2" || t === "EMAIL") {
    return "Email";
  }
  if (t.indexOf("WAIT") >= 0) {
    return "Wait";
  }
  if (t === "REST") {
    return "Custom";
  }
  if (t === "MULTISTEPBRANCH" || t === "RANDOMSPLIT") {
    return "Split";
  }
  if (t.indexOf("CRITERIA") >= 0 || t.indexOf("DECISION") >= 0) {
    return "Decision";
  }
  if (t.indexOf("ENTRY") >= 0 || t === "EVENT") {
    return "Entry";
  }
  if (t.indexOf("SALES") >= 0 || t.indexOf("CRM") >= 0) {
    return "Sales Cloud";
  }
  return strTrim(type) || "Activity";
}

function activityDetailLine(act) {
  if (!act) {
    return "";
  }
  var type = strTrim(act.type).toUpperCase();
  var cfg = act.configurationArguments || {};
  if (type === "EMAILV2" || type === "EMAIL") {
    var ts = cfg.triggeredSend || {};
    if (ts.emailName) {
      return strTrim(ts.emailName);
    }
    if (ts.emailId) {
      return "Email ID " + strTrim(ts.emailId);
    }
  }
  if (act.name && strTrim(act.name) !== strTrim(act.key)) {
    return strTrim(act.name);
  }
  if (act.metaData && act.metaData.description) {
    return strTrim(act.metaData.description);
  }
  return strTrim(act.key);
}

function lookupSenderProfile(profileId) {
  if (!profileId) {
    return null;
  }
  try {
    var prox = new Script.Util.WSProxy();
    var props = ["Name", "FromName", "FromAddress", "CustomerKey", "ObjectID"];
    var byKey = prox.retrieve("SenderProfile", props, {
      Property: "CustomerKey",
      SimpleOperator: "equals",
      Value: String(profileId)
    });
    if (byKey && byKey.Results && byKey.Results.length > 0) {
      return byKey.Results[0];
    }
    var byObj = prox.retrieve("SenderProfile", props, {
      Property: "ObjectID",
      SimpleOperator: "equals",
      Value: String(profileId)
    });
    if (byObj && byObj.Results && byObj.Results.length > 0) {
      return byObj.Results[0];
    }
  } catch (spErr) {}
  return null;
}

function formatSenderProfileDisplay(spRow, profileId) {
  if (spRow) {
    var spName = strTrim(spRow.Name || "");
    var spFrom = strTrim(spRow.FromName || "");
    var spAddr = strTrim(spRow.FromAddress || "");
    if (spFrom && spAddr) {
      return spFrom + " <" + spAddr + ">";
    }
    if (spAddr) {
      return spAddr;
    }
    if (spFrom) {
      return spFrom;
    }
    if (spName) {
      return spName;
    }
  }
  if (profileId) {
    return "Sender profile " + profileId;
  }
  return "";
}

function buildSenderProfileLookupCache(activities) {
  var cache = {};
  var ids = {};
  var normalized = coerceActivityList(activities);
  var i;
  for (i = 0; i < safeArrayLength(normalized); i++) {
    var act = safeArrayGet(normalized, i);
    if (!act) {
      continue;
    }
    var type = strTrim(act.type).toUpperCase();
    if (type !== "EMAILV2" && type !== "EMAIL") {
      continue;
    }
    var ts =
      (act.configurationArguments && act.configurationArguments.triggeredSend) || {};
    var pid = strTrim(ts.senderProfileId);
    if (pid) {
      ids[pid] = true;
    }
  }
  for (var idKey in ids) {
    if (ids.hasOwnProperty(idKey)) {
      cache[idKey] = formatSenderProfileDisplay(lookupSenderProfile(idKey), idKey);
    }
  }
  return cache;
}

function emailActivitySenderProfile(act, senderCache) {
  var type = strTrim(act && act.type ? act.type : "").toUpperCase();
  if (type !== "EMAILV2" && type !== "EMAIL") {
    return "—";
  }
  var ts =
    (act.configurationArguments && act.configurationArguments.triggeredSend) || {};
  var pid = strTrim(ts.senderProfileId);
  if (!pid) {
    return "—";
  }
  if (senderCache && senderCache[pid]) {
    return senderCache[pid];
  }
  return formatSenderProfileDisplay(lookupSenderProfile(pid), pid) || "—";
}

function emailActivitySubject(act) {
  var type = strTrim(act && act.type ? act.type : "").toUpperCase();
  if (type !== "EMAILV2" && type !== "EMAIL") {
    return "—";
  }
  var ts =
    (act.configurationArguments && act.configurationArguments.triggeredSend) || {};
  var subject = strTrim(ts.emailSubject || ts.dynamicEmailSubject || "");
  return subject || "—";
}

function emailActivityListName(act) {
  var type = strTrim(act && act.type ? act.type : "").toUpperCase();
  if (type !== "EMAILV2" && type !== "EMAIL") {
    return "—";
  }
  var ts =
    (act.configurationArguments && act.configurationArguments.triggeredSend) || {};
  if (ts.emailName) {
    return strTrim(ts.emailName);
  }
  var stepName = activityDisplayName(act);
  return stepName || "—";
}

function isEmailActivity(act) {
  var type = strTrim(act && act.type ? act.type : "").toUpperCase();
  return type === "EMAILV2" || type === "EMAIL";
}

function activityDisplayName(act) {
  if (!act) {
    return "Untitled";
  }
  if (act.name) {
    return strTrim(act.name) || "Untitled";
  }
  if (act.key) {
    return strTrim(act.key);
  }
  return "Untitled";
}

function findEntryActivity(activities, jObj) {
  var list = coerceActivityList(activities);
  var entryKey = jObj.entrySourceGroupKey ? String(jObj.entrySourceGroupKey) : "";
  var i;
  var act;
  if (entryKey) {
    for (i = 0; i < safeArrayLength(list); i++) {
      act = safeArrayGet(list, i);
      if (!act) {
        continue;
      }
      if (act.key === entryKey || act.id === entryKey) {
        return act;
      }
    }
  }
  for (i = 0; i < safeArrayLength(list); i++) {
    act = safeArrayGet(list, i);
    if (!act || !act.type) {
      continue;
    }
    var t = toJsString(act.type).toUpperCase();
    if (t === "EVENT" || t.indexOf("ENTRY") >= 0) {
      return act;
    }
  }
  return safeArrayGet(list, 0);
}

function buildActivityLookup(list) {
  var byId = {};
  var byKey = {};
  var i;
  var act;
  var len;
  len = safeArrayLength(list);
  for (i = 0; i < len; i++) {
    act = safeArrayGet(list, i);
    if (!act) {
      continue;
    }
    if (act.id) {
      byId[toJsString(act.id)] = act;
    }
    if (act.key) {
      byKey[toJsString(act.key)] = act;
    }
  }
  return { byId: byId, byKey: byKey };
}

function resolveActivityRef(nextRef, lookup) {
  var ref = strTrim(nextRef);
  if (!ref || !lookup) {
    return null;
  }
  if (lookup.byKey[ref]) {
    return lookup.byKey[ref];
  }
  if (lookup.byId[ref]) {
    return lookup.byId[ref];
  }
  return null;
}

function safeArrayLength(arr) {
  if (!arr) {
    return 0;
  }
  try {
    var len = Number(arr.length);
    if (isNaN(len) || len < 0) {
      return 0;
    }
    if (len > 500) {
      return 500;
    }
    return len;
  } catch (lenEx) {
    return 0;
  }
}

function safeArrayGet(arr, index) {
  var idx;
  var len;
  if (!arr) {
    return null;
  }
  idx = Number(index);
  if (isNaN(idx) || idx < 0) {
    return null;
  }
  len = safeArrayLength(arr);
  if (idx >= len) {
    return null;
  }
  try {
    return arr[idx];
  } catch (getEx) {
    return null;
  }
}

function copyStringStack(stack) {
  var out = [];
  var i;
  var len;
  if (!stack) {
    return out;
  }
  len = safeArrayLength(stack);
  for (i = 0; i < len; i++) {
    try {
      out.push(toJsString(safeArrayGet(stack, i)));
    } catch (copyEx) {}
  }
  return out;
}

function activityOutcomesList(act) {
  if (!act || !act.outcomes) {
    return [];
  }
  return coerceActivityList(act.outcomes);
}

function outcomeNextRef(outcome) {
  if (!outcome || outcome.next === undefined || outcome.next === null) {
    return "";
  }
  return strTrim(outcome.next);
}

function outcomeBranchLabel(outcome, index) {
  var md = outcome && outcome.metaData ? outcome.metaData : {};
  if (md.name) {
    return strTrim(md.name);
  }
  if (md.label) {
    return strTrim(md.label);
  }
  return "Path " + String(index + 1);
}

function activityBranchKey(act) {
  if (!act) {
    return "";
  }
  if (act.key) {
    return toJsString(act.key);
  }
  if (act.id) {
    return toJsString(act.id);
  }
  return "";
}

function stackHasKey(stack, key) {
  var i;
  var len;
  if (!key || !stack) {
    return false;
  }
  len = safeArrayLength(stack);
  for (i = 0; i < len; i++) {
    if (toJsString(safeArrayGet(stack, i)) === key) {
      return true;
    }
  }
  return false;
}

function findFlowStartActivity(activities, jObj) {
  var list = coerceActivityList(activities);
  var entry;
  var hasIncoming;
  var i;
  var oi;
  var act;
  var outcomes;
  var nextRef;
  var k;
  if (!list.length) {
    return null;
  }
  entry = findEntryActivity(activities, jObj);
  if (entry) {
    return entry;
  }
  hasIncoming = {};
  for (i = 0; i < safeArrayLength(list); i++) {
    act = safeArrayGet(list, i);
    outcomes = activityOutcomesList(act);
    for (oi = 0; oi < safeArrayLength(outcomes); oi++) {
      nextRef = outcomeNextRef(safeArrayGet(outcomes, oi));
      if (nextRef) {
        hasIncoming[nextRef] = true;
      }
    }
  }
  for (i = 0; i < safeArrayLength(list); i++) {
    act = safeArrayGet(list, i);
    k = activityBranchKey(act);
    if (k && !hasIncoming[k]) {
      return act;
    }
  }
  return safeArrayGet(list, 0);
}

function flowPathClass(pathColor) {
  var n = Number(pathColor);
  if (isNaN(n) || n < 0) {
    return "journey-path-trunk";
