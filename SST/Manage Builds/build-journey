.panel{background:#fff;border:1px solid var(--border-color);border-radius:var(--radius-lg);padding:26px 30px;margin-bottom:20px}
.panel-title{font-size:1rem;font-weight:700;margin:0 0 16px 0}
.banner{padding:14px 16px;border-radius:10px;margin-bottom:16px;font-size:14px;border:1px solid var(--border-color)}
.banner.bad{border-color:#fecaca;background:var(--dangerbg);color:var(--danger)}
.recent-empty{color:var(--text-secondary);font-size:14px}
.journey-meta-dl{margin:0}
.journey-meta-dl dt{font-size:11px;color:var(--gray-600);text-transform:uppercase;font-weight:600;letter-spacing:0.05em;margin:16px 0 4px 0}
.journey-meta-dl dt:first-child{margin-top:0}
.journey-meta-dl dd{font-weight:600;font-size:1rem;margin:0;padding:0;color:var(--gray-900);word-break:break-word}
.journey-flow-scroll{width:100%;overflow-x:auto;overflow-y:hidden;padding:8px 4px 16px;-webkit-overflow-scrolling:touch}
.journey-flow{display:flex;flex-direction:row;align-items:center;flex-wrap:nowrap;width:max-content;min-width:100%;padding:4px 8px}
.journey-flow-lane{display:flex;flex-direction:row;align-items:center;flex-wrap:nowrap;flex-shrink:0}
.journey-flow-split-v{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:14px;flex-shrink:0;padding:4px 0}
.journey-flow-branch-row{display:flex;flex-direction:row;align-items:center;flex-wrap:nowrap;flex-shrink:0;padding:6px 0 6px 10px;border-left:4px solid var(--path-color, #64748b);border-radius:4px}
.journey-flow-branch-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--path-color, #64748b);margin:0 10px 0 0;white-space:nowrap;flex-shrink:0;max-width:120px;line-height:1.3}
.journey-flow-merge{font-size:11px;color:var(--text-secondary);padding:8px 10px;border:1px dashed var(--path-color, #cbd5e1);border-radius:8px;background:#fafafa;white-space:nowrap;flex-shrink:0}
.journey-flow-node{border:2px solid var(--path-color, #cbd5e1);border-radius:10px;background:#fff;padding:12px 14px;min-width:150px;max-width:200px;width:180px;text-align:center;box-shadow:var(--shadow-sm);flex-shrink:0;overflow:hidden;box-sizing:border-box}
.journey-flow-icon-wrap{width:36px;height:36px;margin:0 auto 8px auto;display:flex;align-items:center;justify-content:center;border-radius:8px;background:var(--path-bg, #f1f5f9);border:1px solid var(--path-color, #cbd5e1);color:var(--path-color, #64748b);flex-shrink:0}
.journey-flow-svg{display:block}
.journey-flow-type{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;color:var(--text-secondary);margin-bottom:4px;overflow-wrap:anywhere;word-break:break-word;line-height:1.3}
.journey-flow-name{font-size:14px;font-weight:700;color:var(--gray-900);margin-bottom:4px;line-height:1.25;overflow-wrap:anywhere;word-break:break-word;max-width:100%}
.journey-flow-detail{font-size:12px;color:var(--text-secondary);overflow-wrap:anywhere;word-break:break-word;line-height:1.35;max-width:100%}
.journey-flow-arrow-h{color:var(--path-color, #94a3b8);font-size:22px;line-height:1;padding:0 6px;flex-shrink:0;font-weight:600}
.journey-path-trunk{--path-color:#64748b;--path-bg:#f1f5f9}
.journey-path-0{--path-color:#4f46e5;--path-bg:#eef2ff}
.journey-path-1{--path-color:#059669;--path-bg:#ecfdf5}
.journey-path-2{--path-color:#d97706;--path-bg:#fffbeb}
.journey-path-3{--path-color:#db2777;--path-bg:#fdf2f8}
.journey-path-4{--path-color:#0284c7;--path-bg:#f0f9ff}
.journey-path-5{--path-color:#7c3aed;--path-bg:#f5f3ff}
.contacts-table-wrap{overflow-x:auto;border:1px solid var(--border-color);border-radius:8px;background:#fff}
.contacts-table{width:100%;border-collapse:collapse;font-size:14px}
.contacts-table th,.contacts-table td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--border-color);vertical-align:top}
.contacts-table th{font-size:11px;text-transform:uppercase;letter-spacing:0.05em;color:var(--gray-600);background:#fafafa}
.contacts-table tbody tr:last-child td{border-bottom:none}
.contacts-mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;word-break:break-all}
.flow-hint{font-size:13px;color:var(--text-secondary);margin:0 0 14px 0}
.schedule-form{margin:0}
.schedule-radio-group{display:flex;flex-direction:column;gap:10px;margin:12px 0}
.schedule-radio-option{display:flex;align-items:flex-start;gap:10px;padding:12px 14px;border:1px solid var(--border-color);border-radius:8px;cursor:pointer}
.schedule-radio-option input{margin-top:3px}
.schedule-radio-title{font-weight:600;font-size:0.9375rem;display:block}
.schedule-radio-hint{font-size:0.8125rem;color:var(--text-secondary);display:block;margin-top:2px}
.schedule-field{margin-bottom:16px}
.schedule-field label{display:block;font-size:0.8125rem;font-weight:600;color:var(--text-secondary);margin-bottom:6px}
.schedule-control{width:100%;padding:10px 12px;border:1px solid var(--border-color);border-radius:8px;font:inherit}
.schedule-eastern-note{font-size:0.8125rem;color:var(--text-secondary);margin:6px 0 0}
.schedule-weekday-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
.schedule-weekday-chip{display:inline-flex;align-items:center;gap:6px;padding:6px 10px;border:1px solid var(--border-color);border-radius:8px;font-size:0.8125rem;cursor:pointer}
.schedule-weekday-panel{display:none;margin-bottom:16px}
.schedule-weekday-panel.is-visible{display:block}
.schedule-save-msg{font-size:14px;margin:0 0 14px 0;padding:10px 12px;border-radius:8px;border:1px solid #bbf7d0;background:#f0fdf4;color:#166534}
.schedule-save-msg.is-error{border-color:#fecaca;background:#fef2f2;color:#b91c1c}
.btn-save-schedule{display:inline-flex;align-items:center;justify-content:center;padding:10px 18px;font-size:14px;font-weight:600;border-radius:8px;border:none;background:var(--primary-color);color:#fff;cursor:pointer;font-family:inherit}
.btn-save-schedule:hover{background:var(--primary-dark)}
@media (max-width:768px){
.dashboard-layout{flex-direction:column;height:auto;overflow:visible}
.maker-sidebar{width:100%;flex-direction:row;overflow-x:auto;height:auto;padding:12px 0}
.maker-sidebar .sidebar-nav{display:flex;flex-direction:row;gap:4px;padding:8px 0;flex:1;flex-wrap:nowrap}
.maker-sidebar .nav-section-title{display:none}
.maker-sidebar .nav-link{white-space:nowrap;padding:8px 16px;border-right:none;border-radius:8px}
.maker-main{height:auto;overflow:visible}
.maker-main-inner{padding:16px}
}
</style>
</head>
<body>
%%[ SET @editSidebarHtml = ContentBlockByName("sst_shell_edit_sidebar") ]%%
<div class="dashboard-layout">
%%[ IF NOT Empty(@editSidebarHtml) THEN ]%%
%%=TreatAsContent(@editSidebarHtml)=%%
%%[ ELSE ]%%
<aside class="maker-sidebar sidebar" aria-label="Primary">
  <div class="sidebar-logo">
    <a href="%%=v(@HOME_URL)=%%"><img src="https://www.magmutual.com/_next/image?url=%2Fmagmutual-egg.svg&amp;w=640&amp;q=75" alt="MagMutual" style="filter: invert(1);"></a>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section"><span class="nav-section-title">MENU</span></div>
    <a class="nav-link" href="%%=IIF(NOT Empty(@jid), Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid), @BUILD_PAGE_SELF)=%%">Manage build</a>
    <span class="nav-link active" role="presentation">Journey</span>
    %%[ IF NOT Empty(@PERFORMANCE_URL) AND NOT Empty(@jid) THEN ]%%
    <a class="nav-link" href="%%=Concat(@PERFORMANCE_URL,"?journeyId=",@jid)=%%">Performance</a>
    %%[ ENDIF ]%%
  </nav>
</aside>
%%[ ENDIF ]%%
<main class="maker-main">
<div class="maker-main-inner">
%%[ IF Empty(@editSidebarHtml) THEN ]%%
<div class="banner bad">Publish Content Block <strong>sst_shell_edit_sidebar</strong> in Content Builder.</div>
%%[ ENDIF ]%%
%%[ IF @pageStatus == "nodata" THEN ]%%
<h1>Journey view</h1>
<p class="sub">Open this page from <strong>Manage build</strong> with a <strong>journeyId</strong> in the URL.</p>
%%[ ELSEIF @pageStatus == "emailonly" THEN ]%%
<h1>No Journey Builder canvas</h1>
<p class="sub">This build is email-only. There is no journey to visualize.</p>
<p class="sub"><a class="breadcrumb-link" href="%%=Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid)=%%">Back to manage build</a></p>
%%[ ELSEIF @pageStatus == "authfail" THEN ]%%
<h1>Could not authorize</h1>
<div class="banner bad">%%=v(@loadError)=%%</div>
%%[ ELSEIF @pageStatus == "apifail" THEN ]%%
<h1>Could not load journey</h1>
<div class="banner bad">%%=v(@loadError)=%%</div>
<p class="sub"><a class="breadcrumb-link" href="%%=Concat(@BUILD_PAGE_SELF,"?journeyId=",@jid)=%%">Back to manage build</a></p>
%%[ ELSE ]%%
<h1>%%[ IF NOT Empty(@apiJourneyName) THEN ]%%%%=v(@apiJourneyName)=%%%%[ ELSEIF NOT Empty(@dispName) THEN ]%%%%=v(@dispName)=%%%%[ ELSE ]%%Journey%%[ ENDIF ]%%</h1>
<p class="sub">Check the journey setup from the first entry, through email sends, waits, and splits—using the same live view that Journey Builder uses. Use this view to make sure paths and branches are set up right when you're reviewing a build, showing a teammate how it works, or figuring out why a send happened the way it did.</p>
<div class="panel">%%[ IF NOT Empty(@journeyMetaHtml) THEN ]%%%%=TreatAsContent(@journeyMetaHtml)=%%%%[ ENDIF ]%%</div>
%%[ IF @schedulePanelVisible == "true" THEN ]%%
<div class="panel">
  <h2 class="panel-title">Entry schedule</h2>
  <p class="flow-hint">Data extension entry schedule (Eastern Time, 12:00 AM start). Matches Journey Builder repeat options.</p>
%%[ IF NOT Empty(@scheduleSaveMsg) THEN ]%%
  <p class="schedule-save-msg%%[ IF IndexOf(@scheduleSaveMsg,"Could not") > 0 THEN ]%% is-error%%[ ENDIF ]%%">%%=v(@scheduleSaveMsg)=%%</p>
%%[ ENDIF ]%%
  <form method="post" action="" class="schedule-form" id="scheduleEditForm">
    <input type="hidden" name="journeyId" value="%%=v(@jid)=%%">
    <input type="hidden" name="scheduleEventDefId" value="%%=v(@scheduleEventDefId)=%%">
    <input type="hidden" name="entryScheduleWeekdays" id="entryScheduleWeekdays" value="%%=v(@entryScheduleWeekdays)=%%">
    <div class="schedule-field">
      <span class="schedule-radio-title">Schedule mode</span>
      <div class="schedule-radio-group">
        <label class="schedule-radio-option">
          <input type="radio" name="entryScheduleType" value="runOnce" %%[ IF @entryScheduleType != "recurring" THEN ]%%checked%%[ ENDIF ]%%>
          <span><span class="schedule-radio-title">Run once</span><span class="schedule-radio-hint">One-time entry (On activation or specific start in Journey Builder).</span></span>
        </label>
        <label class="schedule-radio-option">
          <input type="radio" name="entryScheduleType" value="recurring" %%[ IF @entryScheduleType == "recurring" THEN ]%%checked%%[ ENDIF ]%%>
          <span><span class="schedule-radio-title">Recurring</span><span class="schedule-radio-hint">Hourly, Daily, Weekdays, Weekly, Monthly, or Yearly.</span></span>
        </label>
      </div>
    </div>
    <div id="recurringScheduleFields">
      <div class="schedule-field">
        <label for="entryScheduleRepeat">Repeat</label>
        <select class="schedule-control" name="entryScheduleRepeat" id="entryScheduleRepeat">
          <option value="hourly" %%[ IF @entryScheduleRepeat == "hourly" THEN ]%%selected%%[ ENDIF ]%%>Hourly</option>
          <option value="daily" %%[ IF @entryScheduleRepeat == "daily" THEN ]%%selected%%[ ENDIF ]%%>Daily</option>
          <option value="weekdays" %%[ IF @entryScheduleRepeat == "weekdays" THEN ]%%selected%%[ ENDIF ]%%>Weekdays</option>
          <option value="weekly" %%[ IF @entryScheduleRepeat == "weekly" THEN ]%%selected%%[ ENDIF ]%%>Weekly</option>
          <option value="monthly" %%[ IF @entryScheduleRepeat == "monthly" THEN ]%%selected%%[ ENDIF ]%%>Monthly</option>
          <option value="yearly" %%[ IF @entryScheduleRepeat == "yearly" THEN ]%%selected%%[ ENDIF ]%%>Yearly</option>
        </select>
      </div>
      <div class="schedule-field">
        <label for="entryScheduleInterval">Every</label>
        <input type="number" min="1" max="999" class="schedule-control" name="entryScheduleInterval" id="entryScheduleInterval" value="%%=v(@entryScheduleInterval)=%%">
      </div>
      <div id="weeklyDayPanel" class="schedule-weekday-panel">
        <label>On the selected days</label>
        <div class="schedule-weekday-row">
          <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="sun"> Sun</label>
          <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="mon"> Mon</label>
          <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="tue"> Tue</label>
          <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="wed"> Wed</label>
          <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="thu"> Thu</label>
          <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="fri"> Fri</label>
          <label class="schedule-weekday-chip"><input type="checkbox" class="schedule-weekday-cb" value="sat"> Sat</label>
        </div>
      </div>
      <div class="schedule-field">
        <label for="entryScheduleStart">Start date</label>
        <input type="date" class="schedule-control" name="entryScheduleStart" id="entryScheduleStart" value="%%=IIF(Length(@entryScheduleStart)>=10,Substring(@entryScheduleStart,1,10),@entryScheduleStart)=%%">
        <p class="schedule-eastern-note">Start time is 12:00 AM Eastern Time (US &amp; Canada).</p>
      </div>
      <div class="schedule-field">
        <label for="entryScheduleOccurrences">End after (occurrences)</label>
        <input type="number" min="1" max="9999" class="schedule-control" name="entryScheduleOccurrences" id="entryScheduleOccurrences" value="%%=v(@entryScheduleOccurrences)=%%">
      </div>
      <div class="schedule-field">
        <span class="schedule-radio-title">Contact evaluation</span>
        <div class="schedule-radio-group">
          <label class="schedule-radio-option">
            <input type="radio" name="entryContactEvaluation" value="newOnly" %%[ IF @entryContactEvaluation != "all" THEN ]%%checked%%[ ENDIF ]%%>
            <span><span class="schedule-radio-title">Evaluate new records only</span></span>
          </label>
          <label class="schedule-radio-option">
            <input type="radio" name="entryContactEvaluation" value="all" %%[ IF @entryContactEvaluation == "all" THEN ]%%checked%%[ ENDIF ]%%>
            <span><span class="schedule-radio-title">Evaluate all records</span></span>
          </label>
        </div>
      </div>
    </div>
    <button type="submit" name="saveSchedule" value="1" class="btn-save-schedule">Save schedule</button>
  </form>
</div>
%%[ ENDIF ]%%
<div class="panel">
  <h2 class="panel-title">Flow</h2>
  <p class="flow-hint">%%=v(@apiActivityCount)=%% activities in definition. Use Journey Builder for the full canvas.</p>
  %%[ IF NOT Empty(@journeyFlowHtml) THEN ]%%
  %%=TreatAsContent(@journeyFlowHtml)=%%
  %%[ ELSE ]%%
  <p class="recent-empty">No flow diagram available.</p>
  %%[ ENDIF ]%%
</div>
<div class="panel">
  <h2 class="panel-title">All activities</h2>
  %%[ IF NOT Empty(@journeyActivitiesHtml) THEN ]%%
  %%=TreatAsContent(@journeyActivitiesHtml)=%%
  %%[ ELSE ]%%
  <p class="recent-empty">No activities available.</p>
  %%[ ENDIF ]%%
</div>
%%[ ENDIF ]%%
</div>
</main>
</div>
<script>
(function(){
var scheduleForm = document.getElementById("scheduleEditForm");
if (!scheduleForm) {
  return;
}
var repeatSelect = document.getElementById("entryScheduleRepeat");
var weeklyDayPanel = document.getElementById("weeklyDayPanel");
var weekdayHidden = document.getElementById("entryScheduleWeekdays");
var weekdayChecks = document.querySelectorAll(".schedule-weekday-cb");
var typeRadios = document.querySelectorAll('input[name="entryScheduleType"]');
var recurringFields = document.getElementById("recurringScheduleFields");

function padLocal(n) {
  return n < 10 ? "0" + n : String(n);
}

function futureDateString(daysAhead) {
  var d = new Date();
  d.setDate(d.getDate() + daysAhead);
  return d.getFullYear() + "-" + padLocal(d.getMonth() + 1) + "-" + padLocal(d.getDate());
}

function syncWeekdayHidden() {
  if (!weekdayHidden) {
    return;
  }
  var parts = [];
  for (var i = 0; i < weekdayChecks.length; i++) {
    if (weekdayChecks[i].checked) {
      parts.push(weekdayChecks[i].value);
    }
  }
  weekdayHidden.value = parts.join(",");
}

function loadWeekdayChecksFromHidden() {
  if (!weekdayHidden || !weekdayHidden.value) {
    return;
  }
  var set = {};
  var tokens = String(weekdayHidden.value).toLowerCase().split(/[,;\s]+/);
  for (var t = 0; t < tokens.length; t++) {
    if (tokens[t]) {
      set[tokens[t]] = true;
    }
  }
  for (var i = 0; i < weekdayChecks.length; i++) {
    weekdayChecks[i].checked = !!set[weekdayChecks[i].value];
  }
}

function isRecurringSelected() {
  for (var i = 0; i < typeRadios.length; i++) {
    if (typeRadios[i].checked && typeRadios[i].value === "recurring") {
      return true;
    }
  }
  return false;
}

function syncScheduleUi() {
  var recurring = isRecurringSelected();
  if (recurringFields) {
    recurringFields.style.display = recurring ? "block" : "none";
  }
  var weekly = recurring && repeatSelect && repeatSelect.value === "weekly";
  if (weeklyDayPanel) {
    weeklyDayPanel.classList.toggle("is-visible", weekly);
  }
  var startInput = document.getElementById("entryScheduleStart");
  if (startInput && !startInput.value) {
    startInput.min = futureDateString(0);
    startInput.value = futureDateString(2);
  }
  syncWeekdayHidden();
}

for (var r = 0; r < typeRadios.length; r++) {
  typeRadios[r].addEventListener("change", syncScheduleUi);
}
if (repeatSelect) {
  repeatSelect.addEventListener("change", syncScheduleUi);
}
for (var w = 0; w < weekdayChecks.length; w++) {
  weekdayChecks[w].addEventListener("change", syncWeekdayHidden);
}
loadWeekdayChecksFromHidden();
syncScheduleUi();
scheduleForm.addEventListener("submit", function() {
  syncWeekdayHidden();
});
})();
</script>
</body>
</html>
