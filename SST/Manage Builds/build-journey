function journeyStatusBusinessDescription(status, lastPublishedIso) {
  var s = strTrim(status).toLowerCase();
  var hadPublish =
    strTrim(lastPublishedIso).length > 0 &&
    String(lastPublishedIso).indexOf("0001-01-01") < 0;
  if (!s || s === "—") {
    return "Status could not be read from Journey Builder.";
  }
  if (s === "draft") {
    if (hadPublish) {
      return "Not live right now. You can edit the journey and publish again when you want contacts to enter.";
    }
    return "Still in setup. Contacts are not entering until you publish or activate the journey.";
  }
  if (s === "published" || s === "running") {
    return "Live. Contacts can enter when your entry source and schedule allow it.";
  }
  if (s === "stopped") {
    return "Paused. New contacts are not entering; people already in the journey may still finish remaining steps.";
  }
  if (s === "scheduled") {
    return "Scheduled to go live. Contacts will start entering when the scheduled start time is reached.";
  }
  if (s === "deleted") {
    return "No longer active in Journey Builder.";
  }
  return "Current state from Journey Builder. Use Journey Builder if you need to change whether the journey is live.";
}

