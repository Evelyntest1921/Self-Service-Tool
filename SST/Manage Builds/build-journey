function renderFlowSubtree(act, lookup, stack, depth, pathColor) {
  var html;
  var outcomes;
  var branchActs;
  var branchOutcomes;
  var oi;
  var outcome;
  var nextRef;
  var child;
  var ak;
  var childStack;
  var ck;
  var branchLen;
  var singleChild;
  var pathClass;
  var branchColor;
  var branchClass;
  if (!act || depth > 40) {
    return "";
  }
  pathClass = flowPathClass(pathColor);
  ak = activityBranchKey(act);
  if (ak && stackHasKey(stack, ak)) {
    return (
      '<div class="journey-flow-merge ' +
      pathClass +
      '" role="note">↔ rejoins earlier step</div>'
    );
  }
  childStack = copyStringStack(stack);
  if (ak) {
    childStack.push(ak);
  }
  html =
    '<div class="journey-flow-lane ' +
    pathClass +
    '">' +
    buildFlowNodeHtml(act, pathClass);
  outcomes = activityOutcomesList(act);
  branchActs = [];
  branchOutcomes = [];
  for (oi = 0; oi < safeArrayLength(outcomes); oi++) {
    outcome = safeArrayGet(outcomes, oi);
    nextRef = outcomeNextRef(outcome);
    if (!nextRef) {
      continue;
    }
    child = resolveActivityRef(nextRef, lookup);
    if (child) {
      branchActs.push(child);
      branchOutcomes.push(outcome);
    }
  }
  branchLen = safeArrayLength(branchActs);
  if (!branchLen) {
    html += "</div>";
    return html;
  }
  if (branchLen === 1) {
    html += flowArrowHtml(pathClass);
    singleChild = safeArrayGet(branchActs, 0);
    html += renderFlowSubtree(singleChild, lookup, childStack, depth + 1, pathColor);
    html += "</div>";
    return html;
  }
  html += flowArrowHtml(pathClass);
  html += '<div class="journey-flow-split-v" role="group">';
  for (oi = 0; oi < branchLen; oi++) {
    child = safeArrayGet(branchActs, oi);
    outcome = safeArrayGet(branchOutcomes, oi);
    ck = activityBranchKey(child);
    if (pathColor >= 0) {
      branchColor = (Number(pathColor) + oi) % 6;
    } else {
      branchColor = oi % 6;
    }
    branchClass = flowPathClass(branchColor);
    html += '<div class="journey-flow-branch-row ' + branchClass + '">';
    html +=
      '<div class="journey-flow-branch-label">' +
      htmlSafe(outcomeBranchLabel(outcome, oi)) +
      "</div>";
    if (ck && stackHasKey(childStack, ck)) {
      html +=
        '<div class="journey-flow-merge ' +
        branchClass +
        '" role="note">↔ rejoins earlier step</div>';
    } else {
      html += renderFlowSubtree(child, lookup, childStack, depth + 1, branchColor);
    }
    html += "</div>";
  }
  html += "</div></div>";
  return html;
}

function buildFlowGraphHtml(startAct, activities) {
  var list;
