      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  .demo-icon {
    font-size: 20px;
  }
  .demo-content {
    flex: 1;
    font-size: 14px;
    color: #92400e;
  }
  .demo-content strong {
    color: #78350f;
  }
