<script>
  function openBrowseJourneys() {
    var dataEl = document.getElementById('homeHubUrlData');
    var base = dataEl ? (dataEl.getAttribute('data-url') || '') : '';
    if (!base) base = window.location.pathname;
    var sep = base.indexOf('?') >= 0 ? '&' : '?';
    window.location.href = base + sep + 'browseJourneys=1';
  }
  // Journey roster search
  function searchJourneys() {
    const searchInput = document.getElementById('journeySearch');
    const searchTerm = searchInput.value.toLowerCase();
    const journeyCards = document.querySelectorAll('.survey-card');
    let visibleCount = 0;
    journeyCards.forEach(card => {
      const journeyTitle = card.querySelector('.survey-title').textContent.toLowerCase();
      const journeyId = card.querySelector('.survey-id').textContent.toLowerCase();
      const journeyStatus = card.querySelector('.survey-status').textContent.toLowerCase();
      const isMatch = journeyTitle.includes(searchTerm) || 
            journeyId.includes(searchTerm) || 
            journeyStatus.includes(searchTerm);
      if (isMatch) {
        card.style.display = 'block';
        visibleCount++;
      }
      else {
        card.style.display = 'none';
      }
    }
                        );
    toggleNoResultsMessage(visibleCount === 0 && searchTerm !== '');
  }
  function toggleFilter() {
    alert('Filter is not available yet. Use search to find journeys by name, ID, or status.');
  }
  function toggleNoResultsMessage(show) {
    let noResultsMsg = document.querySelector('.no-search-results');
    if (show && !noResultsMsg) {
      const grid = document.querySelector('.surveys-grid');
      noResultsMsg = document.createElement('div');
      noResultsMsg.className = 'no-search-results';
      noResultsMsg.innerHTML = `
<div class="empty-state">
<svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
<circle cx="11" cy="11" r="8"></circle>
<path d="m21 21-4.35-4.35"></path>
  </svg>
<h3>No journeys found</h3>
<p>Adjust your search or clear it to see the full list.</p>
<button class="btn-primary" onclick="clearSearch()">Clear search</button>
  </div>
`;
      grid.appendChild(noResultsMsg);
    }
    else if (!show && noResultsMsg) {
      noResultsMsg.remove();
    }
  }
  function clearSearch() {
    var searchInput = document.getElementById('journeySearch');
    if (searchInput) {
      searchInput.value = '';
    }
    searchJourneys();
  }
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('journeySearch');
    if (searchInput) {
      searchInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          searchJourneys();
        }
      }
                                  );
    }
    initializeActivityChart();
  }
                           );
  function toggleJourneyBuilderPanel(ev) {
    if (ev) ev.stopPropagation();
    const wrap = document.getElementById('journeyBuilderPanel');
    if (!wrap) return;
    const next = !wrap.classList.contains('is-open');
    wrap.classList.toggle('is-open', next);
    wrap.setAttribute('aria-hidden', next ? 'false' : 'true');
    if (next) wrap.scrollIntoView({
      behavior: 'smooth', block: 'nearest' }
                                 );
  }
  function closeJourneyBuilderPanel() {
    const wrap = document.getElementById('journeyBuilderPanel');
    if (!wrap) return;
    wrap.classList.remove('is-open');
    wrap.setAttribute('aria-hidden', 'true');
  }
  function applyBuildTypeIcons() {
    var nodes = document.querySelectorAll('.survey-icon[data-build-icon], .stat-icon[data-build-icon]');
    var i, el, key, tpl, svg;
    for (i = 0; i < nodes.length; i++) {
      el = nodes[i];
      key = el.getAttribute('data-build-icon');
      tpl = document.getElementById('build-icon-' + key);
      if (!tpl || !tpl.content || !tpl.content.firstElementChild) {
        continue;
      }
      svg = tpl.content.firstElementChild.cloneNode(true);
      el.innerHTML = '';
      el.appendChild(svg);
    }
  }
  document.addEventListener('click', function(e) {
    const wrap = document.getElementById('journeyBuilderPanel');
    const btn = document.getElementById('heroOpenBuilderBtn');
    if (!wrap || !wrap.classList.contains('is-open')) return;
    if (btn && btn.contains(e.target)) return;
    if (wrap.contains(e.target)) return;
    closeJourneyBuilderPanel();
  }
                           );
  document.addEventListener('DOMContentLoaded', function () {
    applyBuildTypeIcons();
    %%[ IF @browseMode == "1" THEN ]%%
    showAllJourneys();
    %%[ ENDIF ]%%
  }
                           );
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeJourneyBuilderPanel();
  }
