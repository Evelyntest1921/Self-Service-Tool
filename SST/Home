          }
          catch (listParseEx) {
            setV("jaBrowseError", "Journey API returned invalid JSON.");
            parsed = null;
          }
          var items = parseJourneyListItems(parsed);
          var totalCount = parsed && parsed.count != null ? Number(parsed.count) : items.length;
          if (isNaN(totalCount) || totalCount < 0) {
            totalCount = items.length;
          }
          var totalPages = Math.ceil(totalCount / BROWSE_PAGE_SIZE);
          if (totalPages < 1) {
            totalPages = 1;
          }
          if (browsePage > totalPages) {
            browsePage = totalPages;
            setV("browsePage", String(browsePage));
          }
          setV(
            "jaBrowseHint",
            "Page " +
            browsePage +
            " of " +
            totalPages +
            ". Search filters journeys on this page."
          );
          if (parsed && !items.length) {
            setV("jaBrowseError", "No journeys returned from Journey Builder.");
          }
          else if (items.length) {
            var existing = loadExistingJourneyIds();
            var hubUrl = getAmpVar("hubUrl");
            setV("jaBrowseMarkup", renderBrowseJourneyCards(items, existing, hubUrl));
            setV(
              "jaBrowsePagination",
              renderBrowsePagination(hubUrl, browsePage, totalPages, totalCount)
            );
          }
        }
      }
      catch (browseEx) {
        setV("jaBrowseError", browseEx.message != null ? String(browseEx.message) : String(browseEx));
      }
    }
  }
</script>
<script runat="server" language="javascript">
  Platform.Load("Core", "1.1");
  function escJsonSendLog(v) {
    if (v == null || v === undefined) return "";
    return String(v).replace(/\\/g, "\\\\").replace(/"/g, "\\\"");
  }
  function rowHasDeFields(row) {
    if (row == null || typeof row !== "object") return false;
    return (
      fieldValSendLog(row, ["Specialty", "SpecialtyName", "MonthIndex", "MonthLabel", "Responses"]) != null
    );
  }
  function fieldValSendLog(row, names) {
    var i, n, k, rowKeys, target, v;
    if (row == null) return null;
    for (i = 0; i < names.length; i++) {
      n = names[i];
      v = row[n];
      if (v != null && v !== "") return v;
      if (v === 0 || v === "0") return v;
    }
    rowKeys = [];
    for (k in row) {
      if (Object.prototype.hasOwnProperty.call(row, k)) rowKeys.push(k);
    }
    for (i = 0; i < names.length; i++) {
      target = String(names[i]).toLowerCase();
      for (k = 0; k < rowKeys.length; k++) {
        if (String(rowKeys[k]).toLowerCase() === target) {
          v = row[rowKeys[k]];
          if (v != null && v !== "") return v;
          if (v === 0 || v === "0") return v;
        }
      }
    }
    return null;
  }
  function coerceSendLogRows(raw) {
    if (raw == null) return [];
    var r = raw;
    if (r.Results) r = r.Results;
    if (r.rows && typeof r.rows.length === "number") r = r.rows;
    if (r.Rows && typeof r.Rows.length === "number") r = r.Rows;
    if (typeof r.length === "number") {
      var out = [];
      var i;
      for (i = 0; i < r.length; i++) out.push(r[i]);
      return out;
    }
    if (typeof r === "object" && rowHasDeFields(r)) return [r];
    return [];
  }
  function retrieveDeRows(deKey) {
    var keys = [];
    var seen = {
    };
    var variants = [deKey, String(deKey).toLowerCase(), String(deKey).toUpperCase()];
    var i, k, rows;
    for (i = 0; i < variants.length; i++) {
      k = variants[i];
      if (!k || seen[k]) continue;
      seen[k] = true;
      keys.push(k);
    }
    for (i = 0; i < keys.length; i++) {
      try {
        rows = coerceSendLogRows(DataExtension.Init(keys[i]).Rows.Retrieve());
        if (rows.length) return rows;
      }
      catch (e0) {
      }
    }
    for (i = 0; i < keys.length; i++) {
      try {
        rows = coerceSendLogRows(
          (new Script.Util.WSProxy()).retrieve(
            "DataExtensionObject[" + keys[i] + "]",
            ["MonthIndex", "MonthStart", "Specialty", "Responses", "Clicks", "Opens", "Bounces", "Unsubscribed", "DidNotOpen", "MonthLabel"],
            {
              Property: "Specialty",
              SimpleOperator: "isNotNull"
            }
          )
        );
        if (rows.length) return rows;
      }
      catch (e1) {
      }
    }
    return [];
  }
  function setChartVar(key, val) {
    try {
      Platform.Variable.SetValue("@" + key, val);
    }
    catch (e0) {
    }
    try {
      Platform.Variable.SetValue(key, val);
    }
    catch (e1) {
    }
  }
  function loadSendLogSeries(deKey) {
    var out = {
      labels: [], responses: [], hasData: false };
    try {
      var rows = retrieveDeRows(deKey);
      rows.sort(function (a, b) {
        var ai = parseInt(fieldValSendLog(a, ["MonthIndex", "monthIndex"]), 10) || 0;
        var bi = parseInt(fieldValSendLog(b, ["MonthIndex", "monthIndex"]), 10) || 0;
        if (ai < bi) return -1;
        if (ai > bi) return 1;
        return 0;
      }
               );
      var i, label, resp, respNum;
      for (i = 0; i < rows.length; i++) {
        label = fieldValSendLog(rows[i], ["MonthLabel", "monthLabel"]);
        resp = fieldValSendLog(rows[i], ["Responses", "responses"]);
        respNum = parseInt(resp, 10);
        if (isNaN(respNum)) respNum = 0;
        out.labels.push(label != null ? String(label) : "");
        out.responses.push(respNum);
        if (respNum > 0) out.hasData = true;
      }
    }
    catch (e0) {
    }
    return out;
  }
  function seriesToJsonKey(series, keyName) {
    var labels = [];
    var i;
    for (i = 0; i < series.labels.length; i++) {
      labels.push('"' + escJsonSendLog(series.labels[i]) + '"');
    }
    return (
      '  "' + keyName + '": {\n' +
      '    "labels": [' + labels.join(", ") + '],\n' +
      '    "responses": [' + series.responses.join(", ") + '],\n' +
      '    "hasData": ' + (series.hasData ? "true" : "false") + '\n' +
      '  }'
    );
  }
  var s12 = loadSendLogSeries("sst_de_send_log_12_months");
  var s6 = loadSendLogSeries("sst_de_send_log_6_months");
  var s30 = loadSendLogSeries("sst_de_send_log_30_days");
  var chartJson =
      "{\n" +
      seriesToJsonKey(s12, "12months") + ",\n" +
      seriesToJsonKey(s6, "6months") + ",\n" +
      seriesToJsonKey(s30, "30days") + "\n" +
      "}";
  setChartVar("sendLogChartJson", chartJson);
</script>
