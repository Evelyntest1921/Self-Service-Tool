  function esc(s) {
    if (s == null || s === undefined) return "";
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/"/g, "&quot;");
  }
  function wrapTitle(s, size) {
    var text, i, chunk, parts;
    size = size || 30;
    text = String(s == null ? "" : s);
    if (!text) return "";
    parts = [];
    for (i = 0; i < text.length; i += size) {
      chunk = text.substring(i, i + size);
      parts.push(esc(chunk));
    }
    return parts.join("<br>");
  }
  function resolveJourneyProgress(statusRaw) {
    var status, label;
    status = String(statusRaw == null ? "" : statusRaw).replace(/^\s+|\s+$/g, "").toLowerCase();
    if (status === "draft") {
      return {
        label: "Draft",
        width: "25%",
        fillClass: "progress-fill--draft",
        labelClass: "progress-percentage--draft"
      };
    }
    if (status === "running") {
      return {
        label: "Running",
        width: "100%",
        fillClass: "progress-fill--running",
        labelClass: "progress-percentage--running"
      };
    }
    if (status === "stopped") {
      return {
        label: "Stopped",
        width: "100%",
        fillClass: "progress-fill--stopped",
        labelClass: "progress-percentage--stopped"
      };
    }
    if (status) {
      label = String(statusRaw).replace(/^\s+|\s+$/g, "");
      return {
        label: label,
        width: "35%",
        fillClass: "progress-fill--ready",
        labelClass: "progress-percentage--ready"
      };
    }
    return {
      label: "Ready",
      width: "35%",
      fillClass: "progress-fill--ready",
      labelClass: "progress-percentage--ready"
    };
  }
  function fieldFromPropertyList(props, names) {
    var pi, i, pname, v;
    if (!props || typeof props.length !== "number") {
      return "";
    }
    for (pi = 0; pi < props.length; pi++) {
      pname = props[pi].Name != null ? props[pi].Name : props[pi].name;
      if (!pname) {
        continue;
      }
      for (i = 0; i < names.length; i++) {
        if (String(pname).toLowerCase() === String(names[i]).toLowerCase()) {
          v = props[pi].Value != null ? props[pi].Value : props[pi].value;
          if (v !== null && v !== undefined && v !== "") {
            return v;
          }
        }
      }
    }
    return "";
  }
  function fieldFromRow(r, names) {
    var i, n, v;
    if (r == null) return "";
    for (i = 0; i < names.length; i++) {
      n = names[i];
      v = null;
      try {
        v = Platform.Function.Field(r, n);
      }
      catch (fe0) {
      }
      if (v === null || v === undefined || v === "") {
        v = r[n];
      }
      if (v !== null && v !== undefined && v !== "") return v;
    }
    v = fieldFromPropertyList(r.Properties, names);
    if (v !== "") return v;
    v = fieldFromPropertyList(r.Property, names);
    if (v !== "") return v;
    return "";
  }
  function coerceDeRows(raw) {
    if (raw == null) {
