  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--gray-50);
    color: var(--gray-900);
    line-height: 1.6;
    margin: 0;
  }
  /* Layout */
  .dashboard-layout {
    display: flex;
    height: 100vh;
    min-height: 100vh;
    overflow: hidden;
  }
  /* Sidebar */
  .sidebar {
    width: 280px;
    flex-shrink: 0;
    height: 100vh;
    overflow: hidden;
    background: white;
    border-right: 1px solid var(--gray-200);
    display: flex;
    flex-direction: column;
    padding: 32px 0 0 0;
    box-shadow: var(--shadow-sm);
  }
  .sidebar-logo {
    padding: 0 20px;
    margin-bottom: 40px;
    border-bottom: 1px solid #ded5d563;
    padding-bottom: 25px;
  }
  .nav-section-title {
    font-size: 11px;
    font-weight: 600;
    color: var(--gray-400);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0 32px;
    margin-bottom: 16px;
  }
  .sidebar-nav {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 32px;
    color: var(--gray-600);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
    border-right: 3px solid transparent;
  }
  .nav-link:hover {
    background: var(--gray-50);
    color: var(--gray-900);
  }
  .nav-link.active {
    background: linear-gradient(90deg, rgb(119 120 196 / 10%) 0%, rgb(2 3 22 / 5%) 100%);
    color: #000000;
    border-right-color: #2c2c31;
  }
  .nav-icon {
    width: 20px;
    height: 20px;
    opacity: 0.7;
  }
  .nav-link.active .nav-icon {
    opacity: 1;
  }
  .sidebar-footer {
    flex-shrink: 0;
    padding: 24px 32px 20px;
    border-top: 1px solid var(--gray-200);
    background: #fff;
  }
  .sidebar-user {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .user-avatar {
    width: 40px;
    height: 40px;
    background: #000000;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 16px;
  }
  .user-name {
    font-weight: 600;
    color: var(--gray-900);
    font-size: 14px;
  }
  .user-email {
    color: var(--gray-500);
    font-size: 12px;
  }
