IF NOT Empty(@newEmailId) THEN
SET @resultText = Concat(@resultText," Email ID: ",@newEmailId)
ENDIF
IF NOT Empty(@journeyEmailId) THEN
SET @resultText = Concat(@resultText," Journey Email ID: ",@journeyEmailId)
ENDIF
]%%
