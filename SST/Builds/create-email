              SET @cardEmailId = Trim(Field(@templateRow,"email_id"))
              SET @cardTemplateId = Trim(Field(@templateRow,"template_id"))
              SET @cardEmailName = Field(@templateRow,"email_name")
              SET @cardEmailPreview = Field(@templateRow,"email_preview")
              SET @cardPreviewRenderer = Trim(Field(@templateRow,"preview_renderer"))
              SET @cardBodySlotKey = Trim(Field(@templateRow,"body_slot_key"))
              SET @cardHeaderSlotKey = Trim(Field(@templateRow,"header_slot_key"))
              SET @cardButtonSlotKey = Trim(Field(@templateRow,"button_slot_key"))
              SET @cardSignatureSlotKey = Trim(Field(@templateRow,"signature_slot_key"))
              SET @cardHasPreviewFlow = "false"
              IF NOT Empty(@cardTemplateId) THEN
                SET @cardHasPreviewFlow = "true"
              ENDIF
              SET @cardDisplayId = @cardEmailId
              IF NOT Empty(@cardTemplateId) THEN
                SET @cardDisplayId = @cardTemplateId
              ENDIF
              SET @cardEmailNameLower = Lowercase(Trim(@cardEmailName))
              IF Empty(@cardPreviewRenderer) THEN
                IF @cardEmailNameLower == "no_header" OR @cardEmailNameLower == "dm_quick_send" THEN
                  SET @cardPreviewRenderer = "quick_send"
                ELSEIF @cardEmailNameLower == "small_header" THEN
                  SET @cardPreviewRenderer = "small_header"
                ELSEIF @cardEmailNameLower == "survey" OR @cardEmailNameLower == "large_header" OR IndexOf(@cardEmailNameLower,"header") > 0 THEN
                  SET @cardPreviewRenderer = "bg_header"
                ELSE
                  SET @cardPreviewRenderer = "quick_send"
                ENDIF
              ENDIF
              SET @cardLabel = @cardEmailName
              IF Length(@cardLabel) > 18 THEN
                SET @cardLabel = Concat(Substring(@cardLabel,1,18),"...")
              ENDIF
