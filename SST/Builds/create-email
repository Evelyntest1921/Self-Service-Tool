    SET @resultText = "Enter a Name for the email asset."
  ELSE
    SET @authRow = LookupRows("SFMC_AUTH","User","Admin")
    SET @rowCount = RowCount(@authRow)
    IF @rowCount > 0 THEN
      SET @row = Row(@authRow,1)
      SET @clientId = Field(@row,"clientId")
      SET @clientSecret = Field(@row,"clientSecret")
      SET @subdomain = Field(@row,"subdomain")
      SET @sourceEmailId = @emailId
      IF NOT Empty(@clientId) AND NOT Empty(@clientSecret) AND NOT Empty(@subdomain) THEN
        SET @authUrl = Concat("https://",@subdomain,".auth.marketingcloudapis.com/v2/token")
        SET @accountId = Trim(Field(@row,"accountId"))
        SET @authPayload = Concat('{"grant_type":"client_credentials","client_id":"',@clientId,'","client_secret":"',@clientSecret,'"')
        IF NOT Empty(@accountId) THEN
          SET @authPayload = Concat(@authPayload,',"account_id":"',@accountId,'"')
        ENDIF
        SET @authPayload = Concat(@authPayload,'}')
        SET @authStatus = HTTPPost2(@authUrl,"application/json",@authPayload,false,@authResponse,@authResponseHeader)
        IF @authStatus == 200 THEN
          SET @tokenPattern = '"access_token":"([^"]+)"'
          SET @accessToken = RegExMatch(@authResponse,@tokenPattern,1)
          IF NOT Empty(@accessToken) THEN
            SET @resultText = Concat("Step 1 OK. Step 2 OK - Auth success.")
            SET @authOk = "true"
          ELSE
            SET @resultText = "Step 2 FAILED: No access token."
          ENDIF
        ELSE
          SET @resultText = Concat("Step 2 FAILED: Auth HTTP ",@authStatus," - ",@authResponse)
        ENDIF
      ELSE
        SET @resultText = "Step 1 FAILED: Missing clientId, clientSecret, or subdomain in SFMC_AUTH."
      ENDIF
    ELSE
      SET @resultText = "Step 1 FAILED: No SFMC_AUTH row for User=Admin."
    ENDIF
  ENDIF
ENDIF
ENDIF
]%%
<script runat="server">
Platform.Load("core","1");
var authOk = Variable.GetValue("authOk");
var accessToken = Variable.GetValue("accessToken");
var subdomain = Variable.GetValue("subdomain");
var emailName = Variable.GetValue("emailName");
var sourceEmailId = Variable.GetValue("sourceEmailId");
var deleteRequested = Variable.GetValue("deleteRequested");
var deleteEmailId = Variable.GetValue("deleteEmailId");
var resultText = Variable.GetValue("resultText");
var newEmailId = "";
var journeyEmailId = "";
var step3bResult = " Step 3b SKIP - Email not duplicated: Template fetch failed.";
function cloneObject(obj) {
if (!obj || typeof obj !== "object") return null;
var json = Platform.Function.Stringify(obj);
return json ? Platform.Function.ParseJSON(json) : null;
}
function objectKeys(obj) {
var keys = [];
if (!obj || typeof obj !== "object") return keys;
for (var key in obj) {
  if (obj.hasOwnProperty(key)) {
    keys.push(key);
  }
}
return keys;
}
function safeLength(value) {
if (value === null || value === undefined) return 0;
return String(value).length;
}
function truncateString(value, maxLength) {
var str = value ? String(value) : "";
if (str.length <= maxLength) return str;
return str.substring(0, maxLength) + "...[truncated]";
}
function htmlSafe(value) {
return String(value || "")
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;")
  .replace(/"/g, "&quot;");
}
function textBodyParagraph(value) {
var safeValue = htmlSafe(value).replace(/\r\n|\r|\n/g, "<br>");
return "<p style=\"margin:0 0 18px;\">" + safeValue + "</p>";
}
function wrapBodyHtmlForSlot(text) {
var lines = String(text || "").split(/\r\n|\r|\n/);
var html = "";
var i;
for (i = 0; i < lines.length; i++) {
  if (lines[i] === "" && i === lines.length - 1) {
    continue;
  }
  html += textBodyParagraph(lines[i]);
}
if (!html) {
  html = textBodyParagraph("");
}
return html;
}
function findBlockKeyInSlot(slots, slotKey) {
var slot;
var keys;
if (!slots || !slotKey) {
  return "";
}
slot = slots[slotKey];
if (!slot || !slot.blocks || typeof slot.blocks !== "object") {
  return "";
}
keys = objectKeys(slot.blocks);
if (!keys.length) {
  return "";
}
return keys[0];
}
function applyBodyToSlot(payload, slotKey, blockKey, bodyHtml) {
var htmlView;
var slots;
var slot;
if (!payload.views) {
  payload.views = {};
}
if (!payload.views.html) {
  payload.views.html = {};
}
htmlView = payload.views.html;
if (!htmlView.slots || typeof htmlView.slots !== "object") {
  htmlView.slots = {};
}
slots = htmlView.slots;
if (!slots[slotKey] || typeof slots[slotKey] !== "object") {
  slots[slotKey] = { content: "", blocks: {} };
}
slot = slots[slotKey];
if (!slot.blocks || typeof slot.blocks !== "object") {
  slot.blocks = {};
}
if (!slot.blocks[blockKey] || typeof slot.blocks[blockKey] !== "object") {
  slot.blocks[blockKey] = {
    assetType: { id: 196, name: "textblock" }
  };
}
slot.blocks[blockKey].content = bodyHtml;
if (!slot.content) {
  slot.content = '<div data-type="block" data-key="' + blockKey + '"></div>';
}
}
function applyCreateEmailContent(payload) {
if (Platform.Variable.GetValue("@previewFlow") != "1") {
  return;
}
var bodySlotKey = Platform.Variable.GetValue("@bodySlotKey") || "";
var emailBodyText = Platform.Variable.GetValue("@emailBodyText") || "";
var emailPreheader = Platform.Variable.GetValue("@emailPreheader") || "";
var headerSlotKey = Platform.Variable.GetValue("@headerSlotKey") || "";
var buttonSlotKey = Platform.Variable.GetValue("@buttonSlotKey") || "";
var emailHeadline = Platform.Variable.GetValue("@emailHeadline") || "";
var surveyId = Platform.Variable.GetValue("@surveyId") || "";
var templateEmailName = normalizeTemplateEmailName(Platform.Variable.GetValue("@templateEmailName"));
if (!payload || !payload.views) {
  return;
}
if (emailPreheader) {
  payload.views.preheader = { content: String(emailPreheader) };
}
if (bodySlotKey && emailBodyText) {
  applySlotHtmlContent(payload, bodySlotKey, wrapBodyHtmlForSlot(emailBodyText));
}
if (
  headerSlotKey &&
  emailHeadline &&
  (templateEmailName === "large_header" || templateEmailName === "survey")
) {
  applySlotHtmlContent(payload, headerSlotKey, wrapHeadlineHtmlForSlot(emailHeadline));
}
if (buttonSlotKey && surveyId && templateEmailName === "survey") {
  applySlotHtmlContent(payload, buttonSlotKey, wrapSurveyButtonHtmlForSlot(surveyId));
}
var signatureSlotKey = Platform.Variable.GetValue("@signatureSlotKey") || "";
var signatureChoice = Platform.Variable.GetValue("@signatureChoice") || "";
var showBookingLinkParam = Platform.Variable.GetValue("@showBookingLinkParam") || "false";
if (
  signatureSlotKey &&
  signatureChoice !== "none" &&
  signatureChoice !== ""
) {
  applySlotHtmlContent(
    payload,
    signatureSlotKey,
    buildSignatureSlotAmpContent(signatureChoice, showBookingLinkParam)
  );
}
}
function signatureToggleStrings(choice, showBookingLink) {
var key = String(choice || "").replace(/^\s+|\s+$/g, "").toLowerCase();
if (key !== "standard" && key !== "dm") {
  return null;
}
var bookingOn =
  showBookingLink === "true" ||
  showBookingLink === true ||
  showBookingLink === "1" ||
  showBookingLink === "on";
return {
  dmSignature: key === "dm" ? "true" : "false",
  customSender: "",
  showBookingLink: bookingOn ? "true" : "false"
};
}
function buildSignatureSlotAmpContent(signatureChoice, showBookingLink) {
var toggles = signatureToggleStrings(signatureChoice, showBookingLink);
if (!toggles) {
  return "";
}
return (
  "%%[" +
  'SET @dmSignature = "' +
  toggles.dmSignature +
  '" ' +
  'SET @customSender = "' +
  toggles.customSender +
  '" ' +
  'SET @showBookingLink = "' +
  toggles.showBookingLink +
  '" ' +
  "]%%" +
  '%%=ContentBlockByName("sst_signature_slot")=%%'
);
}
function normalizeTemplateEmailName(value) {
return String(value || "").replace(/^\s+|\s+$/g, "").toLowerCase();
}
function wrapHeadlineHtmlForSlot(text) {
return "<div style=\"font-size:32px;line-height:36px;margin:0;color:#ffffff;\">" + htmlSafe(text) + "</div>";
}
function wrapSurveyButtonHtmlForSlot(surveyId) {
var href =
  "https://cloud.go.magmutual.com/MH1Fdf3gkpiWmvpt?id=" +
  encodeURIComponent(surveyId || "SURV_20260612_102301") +
  "&contact=%%=v(@SubscriberKey)=%%";
return (
  "<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#0060F5\" style=\"background:#0060F5;\"><a href=\"" +
  href +
  "\" target=\"_blank\" style=\"display:block;padding:10px 99px 10px 10px;color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;text-decoration:none;\">Take Survey</a></td></tr></table>"
);
}
function applySlotHtmlContent(payload, slotKey, htmlContent) {
var slotsForBlock;
var blockKey;
if (!slotKey || !htmlContent || !payload.views || !payload.views.html) {
  return;
}
slotsForBlock = payload.views.html.slots;
if (!slotsForBlock || typeof slotsForBlock !== "object") {
  return;
}
blockKey = findBlockKeyInSlot(slotsForBlock, slotKey) || "bodyblock1";
applyBodyToSlot(payload, slotKey, blockKey, htmlContent);
}
function summarizeTemplateRef(templateRef) {
if (!templateRef || typeof templateRef !== "object") return null;
return {
  id: templateRef.id || "",
  assetTypeId: (templateRef.assetType && templateRef.assetType.id) ? templateRef.assetType.id : "",
  assetTypeName: (templateRef.assetType && templateRef.assetType.name) ? templateRef.assetType.name : "",
  contentLength: safeLength(templateRef.content),
  slotKeys: objectKeys(templateRef.slots)
};
}
function summarizeHtmlView(htmlView) {
if (!htmlView || typeof htmlView !== "object") return null;
return {
  contentLength: safeLength(htmlView.content),
  slotKeys: objectKeys(htmlView.slots),
  template: summarizeTemplateRef(htmlView.template)
};
}
function summarizeEmailOptions(dataObj) {
if (!dataObj || !dataObj.email || !dataObj.email.options) return null;
return cloneObject(dataObj.email.options);
}
function fetchAssetById(assetId, subdomainValue, accessTokenValue) {
var result = {
  ok: false,
  statusCode: 0,
  responseText: "",
  asset: null
};
var parsedId = parseInt(assetId, 10);
if (isNaN(parsedId) || !subdomainValue || !accessTokenValue) {
  return result;
}
try {
  var assetUrl = "https://" + subdomainValue + ".rest.marketingcloudapis.com/asset/v1/content/assets/" + parsedId;
  var req = new Script.Util.HttpRequest(assetUrl);
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.setHeader("Authorization", "Bearer " + accessTokenValue);
  req.method = "GET";
  req.contentType = "application/json";
  var resp = req.send();
  result.statusCode = resp.statusCode;
  result.responseText = resp.content ? String(resp.content) : "";
  if ((resp.statusCode == 200 || resp.statusCode == 201) && result.responseText) {
    result.asset = Platform.Function.ParseJSON(result.responseText);
    result.ok = true;
  }
} catch (e) {
  result.responseText = e.message || String(e);
}
return result;
}
function extractLegacyEmailId(assetObj) {
if (!assetObj || typeof assetObj !== "object") return "";
var candidates = [
  assetObj.data && assetObj.data.email && assetObj.data.email.legacy && assetObj.data.email.legacy.legacyId,
  assetObj.data && assetObj.data.email && assetObj.data.email.legacy && assetObj.data.email.legacy.id,
  assetObj.data && assetObj.data.email && assetObj.data.email.legacyId,
  assetObj.data && assetObj.data.legacy && assetObj.data.legacy.legacyId,
  assetObj.legacyData && assetObj.legacyData.legacyId,
  assetObj.legacy && assetObj.legacy.legacyId,
  assetObj.legacyId
];
for (var i = 0; i < candidates.length; i++) {
  var candidate = candidates[i];
  if (candidate !== null && candidate !== undefined && String(candidate) !== "") {
    return String(candidate);
  }
}
return "";
}
function buildTemplateReference(source, fallbackContent, fallbackSlots) {
if (!source || typeof source !== "object") return null;
var ref = {
  assetType: { id: 4 }
};
var sourceId = parseInt(source.id, 10);
if (!isNaN(sourceId)) {
  ref.id = sourceId;
}
if (source.assetType && source.assetType.id) {
  ref.assetType.id = parseInt(source.assetType.id, 10);
