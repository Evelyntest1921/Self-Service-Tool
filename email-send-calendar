  border-bottom: 1px solid var(--border-color);
}
.recent-item:last-child { border-bottom: 0; padding-bottom: 0; }
.recent-item--clickable {
  cursor: pointer;
  margin: 0 -10px;
  padding-left: 10px;
  padding-right: 10px;
  transition: background 0.15s ease;
}
.recent-item--clickable:hover { background: var(--bg-secondary); }
.recent-item--clickable.is-selected {
  background: #eef2ff;
  border-left: 3px solid var(--primary-color);
  padding: 10px 10px;
}
.recent-journey {
  font-weight: 600;
  font-size: 14px;
  color: var(--gray-900);
  margin-bottom: 6px;
}
.recent-detail {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 12px;
  color: var(--gray-500);
  margin-bottom: 4px;
}
.recent-detail:last-child { margin-bottom: 0; }
.recent-label { font-weight: 600; color: var(--gray-900); }
.recent-value { color: var(--gray-500); }
.recent-empty { font-size: 13px; color: var(--gray-500); margin: 0; }
@media (max-width: 980px) {
  .exit-workspace { flex-direction: column; }
  .exit-side { max-width: none; width: 100%; }
}
</style>
</head>
<body>
<div class="dashboard-layout">
  %%=ContentBlockByKey("sst_shell_sidebar")=%%
  <main class="main-content">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="%%=v(@hubUrl)=%%" class="breadcrumb-link"><svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>Back</a>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      <span class="breadcrumb-current">Send Calendar</span>
    </nav>

    <div class="exit-workspace">
      <div class="exit-main">
        <div class="card">
          <div class="page-heading-row">
            <h1>Send Calendar</h1>
            <svg class="page-heading-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M16 15.2V16.8875L16.9 17.9M9 11H4M20 9V7C20 5.89543 19.1046 5 18 5H6C4.89543 5 4 5.89543 4 7V19C4 20.1046 4.89543 21 6 21H9M15 3V7M9 3V7M20.5 17C20.5 19.4853 18.4853 21.5 16 21.5C13.5147 21.5 11.5 19.4853 11.5 17C11.5 14.5147 13.5147 12.5 16 12.5C18.4853 12.5 20.5 14.5147 20.5 17Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <p class="sub">Emails that went out on the selected day. You can open the journey that sent the email by clicking on the journey in the list below.</p>

          <script runat="server">
            function bodySafe(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            var loadErr = Platform.Variable.GetValue("@calLoadError");
            if (loadErr) {
              Write('<div class="notice warn"><strong>Could not load send calendar.</strong><br>' + bodySafe(loadErr) + '</div>');
            }
          </script>

          <form method="get" id="calendarForm">
            <div class="form-group">
              <label class="form-label" for="date">Date</label>
              <div class="form-group-row">
                <input
                  class="form-input form-input--date"
                  type="date"
                  id="date"
                  name="date"
                  value="%%=v(@calSelectedDate)=%%"
                >
                <input
                  class="form-input form-input--search"
                  type="search"
                  id="sendSearch"
                  placeholder="Search email or journey name"
                  autocomplete="off"
                  aria-label="Search email or journey name"
                >
              </div>
              <p class="hint">Choose a date to load sends, or pick a recent day on the right.</p>
            </div>
          </form>

          <h2 style="font-size:1.125rem;margin:28px 0 12px;">%%=v(@calSelectedDateDisplay)=%%</h2>
          <div class="contacts-summary" id="sendsSummary">
            <span>
              <span class="contacts-summary-label">
                <svg class="contacts-summary-icon" viewBox="0 0 1920 1920" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M0 1694.235h1920V226H0v1468.235ZM112.941 376.664V338.94H1807.06v37.723L960 1111.233l-847.059-734.57ZM1807.06 526.198v950.513l-351.134-438.89-88.32 70.475 378.353 472.998H174.042l378.353-472.998-88.32-70.475-351.134 438.89V526.198L960 1260.768l847.059-734.57Z" fill="currentColor" fill-rule="evenodd"></path>
                </svg>
                Emails sent
              </span>
              <span id="sendCountDisplay" style="    background: #f9fafb;
    padding: 5px;
    border: 1px solid #c0c3c8;">%%=v(@calSendsCount)=%%</span>
            </span>
            <span>
              <span class="contacts-summary-label">
                <svg class="contacts-summary-icon" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M23.313 26.102l-6.296-3.488c2.34-1.841 2.976-5.459 2.976-7.488v-4.223c0-2.796-3.715-5.91-7.447-5.91-3.73 0-7.544 3.114-7.544 5.91v4.223c0 1.845 0.78 5.576 3.144 7.472l-6.458 3.503s-1.688 0.752-1.688 1.689v2.534c0 0.933 0.757 1.689 1.688 1.689h21.625c0.931 0 1.688-0.757 1.688-1.689v-2.534c0-0.994-1.689-1.689-1.689-1.689zM23.001 30.015h-21.001v-1.788c0.143-0.105 0.344-0.226 0.502-0.298 0.047-0.021 0.094-0.044 0.139-0.070l6.459-3.503c0.589-0.32 0.979-0.912 1.039-1.579s-0.219-1.32-0.741-1.739c-1.677-1.345-2.396-4.322-2.396-5.911v-4.223c0-1.437 2.708-3.91 5.544-3.91 2.889 0 5.447 2.44 5.447 3.91v4.223c0 1.566-0.486 4.557-2.212 5.915-0.528 0.416-0.813 1.070-0.757 1.739s0.446 1.267 1.035 1.589l6.296 3.488c0.055 0.030 0.126 0.063 0.184 0.089 0.148 0.063 0.329 0.167 0.462 0.259v1.809zM30.312 21.123l-6.39-3.488c2.34-1.841 3.070-5.459 3.070-7.488v-4.223c0-2.796-3.808-5.941-7.54-5.941-2.425 0-4.904 1.319-6.347 3.007 0.823 0.051 1.73 0.052 2.514 0.302 1.054-0.821 2.386-1.308 3.833-1.308 2.889 0 5.54 2.47 5.54 3.941v4.223c0 1.566-0.58 4.557-2.305 5.915-0.529 0.416-0.813 1.070-0.757 1.739 0.056 0.67 0.445 1.267 1.035 1.589l6.39 3.488c0.055 0.030 0.126 0.063 0.184 0.089 0.148 0.063 0.329 0.167 0.462 0.259v1.779h-4.037c0.61 0.46 0.794 1.118 1.031 2h3.319c0.931 0 1.688-0.757 1.688-1.689v-2.503c-0.001-0.995-1.689-1.691-1.689-1.691z" fill="currentColor"></path>
                </svg>
                Total recipients
              </span>
              <span id="recipientTotalDisplay" style="    background: #f9fafb;
    padding: 5px;
    border: 1px solid #c0c3c8;">%%=v(@calRecipientsTotal)=%%</span>
            </span>
          </div>
          <p class="recent-empty" id="sendFilterEmpty" hidden>No sends match your search.</p>
          <div id="sendsResults">
            <script runat="server">
              Write(
                Platform.Variable.GetValue("@calSendsHtml") ||
                  '<p class="recent-empty">No email sends recorded for this date.</p>'
              );
            </script>
          </div>
        </div>
      </div>

      <aside class="exit-side" aria-label="Recent send days">
        <div class="card card-side">
          <h2 class="side-title">Recent days</h2>
          <p class="side-sub">Last 5 days. Click one to view sends.</p>
          <script runat="server">
            Write(Platform.Variable.GetValue("@calRecentDaysHtml") || '<p class="recent-empty">No recent days yet.</p>');
          </script>
        </div>
      </aside>
    </div>
  </main>
</div>
<script>
(function () {
  var dateInput = document.getElementById("date");
  if (dateInput) {
    dateInput.addEventListener("change", function () {
      var form = document.getElementById("calendarForm");
      if (form) {
        form.submit();
      }
    });
  }
  var recentItems = document.querySelectorAll(".recent-item--clickable");
  var i;
  for (i = 0; i < recentItems.length; i++) {
    recentItems[i].addEventListener("click", function () {
      var day = this.getAttribute("data-date");
      if (!day) {
        return;
      }
      window.location.href =
        window.location.pathname + "?date=" + encodeURIComponent(day);
    });
    recentItems[i].addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        this.click();
      }
    });
  }

  var searchInput = document.getElementById("sendSearch");
  var sendCountDisplay = document.getElementById("sendCountDisplay");
  var recipientTotalDisplay = document.getElementById("recipientTotalDisplay");
  var sendFilterEmpty = document.getElementById("sendFilterEmpty");
  var sendsSummary = document.getElementById("sendsSummary");
  var allSendRows = document.querySelectorAll(".sends-table tbody .send-row");

  function filterSends() {
    if (!allSendRows.length) {
      return;
    }
    var query = (searchInput && searchInput.value ? searchInput.value : "")
      .replace(/^\s+|\s+$/g, "")
      .toLowerCase();
    var visibleCount = 0;
    var visibleRecipients = 0;
    var ri;
    for (ri = 0; ri < allSendRows.length; ri++) {
      var row = allSendRows[ri];
      var emailName = row.getAttribute("data-email-name") || "";
      var journeyName = row.getAttribute("data-journey-name") || "";
      var matches =
        !query ||
        emailName.indexOf(query) !== -1 ||
        journeyName.indexOf(query) !== -1;
      row.style.display = matches ? "" : "none";
      if (matches) {
        visibleCount += 1;
        visibleRecipients += parseInt(row.getAttribute("data-recipients"), 10) || 0;
      }
    }
    if (sendCountDisplay) {
      sendCountDisplay.textContent = String(visibleCount);
    }
    if (recipientTotalDisplay) {
      recipientTotalDisplay.textContent = String(visibleRecipients);
    }
    if (sendFilterEmpty) {
      sendFilterEmpty.hidden = !query || visibleCount > 0;
    }
    if (sendsSummary) {
      sendsSummary.hidden = !!query && visibleCount === 0;
    }
  }

  if (searchInput) {
    searchInput.addEventListener("input", filterSends);
    searchInput.addEventListener("search", filterSends);
  }
})();
</script>
</body>
</html>
