<script runat="server">
Platform.Load("core", "1");

var CALENDAR_DE = "bd_sst_email_send_calendar";
var RECENT_DAYS_LIMIT = 5;

var hubUrl = "";
var journeyExitUrl = "";
var calendarUrl = "";
var envDisplayName = "";
var envDisplayEmail = "";
var envAvatarLetter = "";
var environment = "";
var selectedDate = "";
var selectedDateDisplay = "";
var sendsHtml = "";
var recentDaysHtml = "";
var calendarLoadError = "";
var sendsCount = 0;
var recipientsTotal = 0;
var mcCloudUrl = "";

function queryValue(name) {
  var value = "";
  try {
    value = Platform.Request.GetQueryStringParameter(name);
  } catch (e) {}
  return value || "";
}

function asStr(value) {
  if (value === null || typeof value === "undefined") {
    return "";
  }
  try {
    return (value + "").replace(/^\s+|\s+$/g, "");
  } catch (e) {
    return "";
  }
}

function clean(value) {
  return asStr(value);
}

function htmlSafe(value) {
  return asStr(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function lookupValue(deName, returnField, lookupField, lookupValueIn) {
  try {
    return clean(
      Platform.Function.Lookup(deName, returnField, lookupField, lookupValueIn)
    );
  } catch (e) {}
  return "";
}

function coerceRows(raw) {
  if (raw === null || typeof raw === "undefined") {
    return [];
  }
  var rows = raw;
  if (rows.Results) {
    rows = rows.Results;
  }
  if (typeof rows.length === "number") {
    var out = [];
    var i;
    for (i = 0; i < rows.length; i++) {
      out.push(rows[i]);
    }
    return out;
  }
  if (typeof rows === "object") {
    return [rows];
  }
  return [];
}

function field(row, name) {
  if (!row) {
    return "";
  }
  var direct = row[name];
  if (direct !== undefined && direct !== null && String(direct) !== "") {
    return direct;
  }
  try {
    var props = row.Properties;
    if (props && typeof props.length === "number") {
      var want = asStr(name).toLowerCase();
      var i;
      for (i = 0; i < props.length; i++) {
        var pname = props[i].Name || props[i].name;
        if (asStr(pname).toLowerCase() !== want) {
          continue;
        }
        var pval = props[i].Value;
        if (pval === undefined || pval === null) {
          pval = props[i].value;
        }
        if (pval !== undefined && pval !== null && String(pval) !== "") {
          return pval;
        }
      }
    }
  } catch (propEx) {}
  return "";
}

function fieldAny(row, names) {
  var i;
  for (i = 0; i < names.length; i++) {
    var val = field(row, names[i]);
    if (asStr(val)) {
      return val;
    }
  }
  return "";
}

function parseDateMs(value) {
  if (value === null || typeof value === "undefined" || value === "") {
    return 0;
  }
  try {
    if (value.getTime) {
      var msObj = value.getTime();
      if (!isNaN(msObj)) {
        return msObj;
      }
    }
  } catch (dateObjEx) {}
  var text = asStr(value);
  if (!text) {
    return 0;
  }
  try {
    var parsed = Date.parse(text);
    if (!isNaN(parsed)) {
      return parsed;
    }
  } catch (parseEx) {}
  try {
    var p = Platform.Function.ParseDate(text);
    if (p && p.getTime) {
      var ms = p.getTime();
      if (!isNaN(ms)) {
        return ms;
      }
    }
  } catch (ampEx) {}
  return 0;
}

function formatIsoDate(value) {
  var ms = parseDateMs(value);
  var d = ms ? new Date(ms) : new Date();
  var month = d.getMonth() + 1;
  var day = d.getDate();
  return (
    d.getFullYear() +
    "-" +
    (month < 10 ? "0" + month : String(month)) +
    "-" +
    (day < 10 ? "0" + day : String(day))
  );
}

function normalizeDateKey(value) {
  var iso = formatIsoDate(value);
  if (/^\d{4}-\d{2}-\d{2}$/.test(iso)) {
    return iso;
  }
  var text = asStr(value);
  if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
    return text.substring(0, 10);
  }
  return "";
}

function parseSelectedDate(value) {
  var text = clean(value);
  if (/^\d{4}-\d{2}-\d{2}$/.test(text)) {
    return text;
  }
  return formatIsoDate(new Date());
}

function formatDisplayDate(value) {
  var ms = parseDateMs(value);
  if (!ms) {
    return asStr(value) || "—";
  }
  try {
    var d = new Date(ms);
    var months = [
      "Jan", "Feb", "Mar", "Apr", "May", "Jun",
      "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    ];
    var month = months[d.getMonth()] || "";
    var day = d.getDate();
    var year = d.getFullYear();
    var hour = d.getHours();
    var min = d.getMinutes();
    var ampm = hour >= 12 ? "PM" : "AM";
    var h12 = hour % 12;
    if (!h12) {
      h12 = 12;
    }
    var minText = min < 10 ? "0" + min : String(min);
    return month + " " + day + ", " + year + " " + h12 + ":" + minText + " " + ampm;
  } catch (fmtEx) {
    return asStr(value) || "—";
  }
}

function formatDisplayDay(value) {
  var ms = parseDateMs(value);
  if (!ms) {
    return asStr(value) || "—";
  }
  try {
    var d = new Date(ms);
    var months = [
      "Jan", "Feb", "Mar", "Apr", "May", "Jun",
      "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
    ];
    var weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    return (
      weekdays[d.getDay()] +
      ", " +
      (months[d.getMonth()] || "") +
      " " +
      d.getDate() +
      ", " +
      d.getFullYear()
    );
  } catch (dayEx) {
    return asStr(value) || "—";
  }
}

function todayDateKey() {
  return formatIsoDate(new Date());
}

function formatRecentDayLabel(sendDate, sendDateKey) {
  var key = sendDateKey || normalizeDateKey(sendDate);
  if (key === todayDateKey()) {
    return "Today";
  }
  return formatDisplayDay(sendDate || sendDateKey);
}

function buildJourneyOpenUrl(mcCloudBase, journeyId, versionNumber) {
  var jid = clean(journeyId);
  if (!jid) {
    return "";
  }
  var base = clean(mcCloudBase) || "https://mc.s13.exacttarget.com/cloud/";
  if (base.charAt(base.length - 1) !== "/") {
    base += "/";
  }
  var ver = clean(versionNumber);
  if (!ver) {
    ver = "live";
  }
  return base + "#app/Journey%20Builder/%23" + jid + "/" + ver;
}

function normalizeCalendarRow(row) {
  var sendDate = fieldAny(row, ["sendDate", "SendDate"]);
  var journeyId = asStr(fieldAny(row, ["journeyId", "JourneyID", "JourneyId"]));
  var journeyName = asStr(fieldAny(row, ["journeyName", "JourneyName"]));
  var versionNumber = asStr(fieldAny(row, ["versionNumber", "VersionNumber"]));
  return {
    calendarKey: asStr(fieldAny(row, ["calendarKey", "CalendarKey"])),
    sendDate: sendDate,
    sendDateKey: normalizeDateKey(sendDate),
    sendDateMs: parseDateMs(sendDate),
    jobId: asStr(fieldAny(row, ["jobId", "JobID", "JobId"])),
    emailName: asStr(fieldAny(row, ["emailName", "EmailName"])) || "Untitled email",
    emailSubject: asStr(fieldAny(row, ["emailSubject", "EmailSubject"])) || "—",
    sendTime: fieldAny(row, ["sendTime", "SendTime"]),
    sendTimeMs: parseDateMs(fieldAny(row, ["sendTime", "SendTime"])),
    recipients: asStr(fieldAny(row, ["recipients", "Recipients"])) || "0",
    journeyId: journeyId,
    journeyName: journeyName,
    versionNumber: versionNumber,
    isJourneySend: !!journeyId
  };
}

function loadCalendarRows() {
  var errors = [];
  var keyVariants = [CALENDAR_DE, String(CALENDAR_DE).toLowerCase()];
  var props = [
    "calendarKey",
    "sendDate",
    "jobId",
    "emailName",
    "emailSubject",
    "sendTime",
    "recipients",
    "journeyId",
    "journeyName",
    "versionNumber"
  ];
  var v;
  for (v = 0; v < keyVariants.length; v++) {
    try {
      var de = DataExtension.Init(keyVariants[v]);
      var rows = coerceRows(de.Rows.Retrieve());
      if (rows.length) {
        return { ok: true, rows: rows, error: "" };
      }
    } catch (deEx) {
      errors.push(
        "DataExtension.Init(" + keyVariants[v] + "): " + (deEx.message || String(deEx))
      );
    }
  }
  try {
    var prox = new Script.Util.WSProxy();
    for (v = 0; v < keyVariants.length; v++) {
      try {
        var wsResp = prox.retrieve(
          "DataExtensionObject[" + keyVariants[v] + "]",
          props,
          { Property: "calendarKey", SimpleOperator: "isNotNull" }
        );
        var wsRows = coerceRows(wsResp && wsResp.Results ? wsResp.Results : []);
        if (wsRows.length) {
          return { ok: true, rows: wsRows, error: "" };
        }
      } catch (wsEx) {
        errors.push(
          "WSProxy " + keyVariants[v] + ": " + (wsEx.message || String(wsEx))
        );
      }
    }
  } catch (proxEx) {
    errors.push(proxEx.message || String(proxEx));
  }
  return {
    ok: false,
    rows: [],
    error:
      errors.join(" | ") ||
      "Could not read " + CALENDAR_DE + ". Create the DE and schedule query-email-send-calendar.sql."
  };
}

function buildSendsHtml(rows, dateKey, cloudBase) {
  var filtered = [];
  var i;
  for (i = 0; i < rows.length; i++) {
    var item = normalizeCalendarRow(rows[i]);
    if (item.sendDateKey === dateKey) {
      filtered.push(item);
    }
  }
  filtered.sort(function (a, b) {
    return (b.sendTimeMs || 0) - (a.sendTimeMs || 0);
  });
  sendsCount = filtered.length;
  recipientsTotal = 0;
  for (i = 0; i < filtered.length; i++) {
    recipientsTotal += parseInt(filtered[i].recipients, 10) || 0;
  }
  if (!filtered.length) {
    return '<p class="recent-empty">No email sends recorded for this date.</p>';
  }
  var parts = ['<div class="contacts-table-wrap"><table class="contacts-table sends-table">'];
  parts.push(
    "<thead><tr>" +
      "<th>Email</th>" +
      "<th>Subject</th>" +
      "<th>Send time</th>" +
      "<th>Recipients</th>" +
      "<th>Job ID</th>" +
      "</tr></thead><tbody>"
  );
  for (i = 0; i < filtered.length; i++) {
    var send = filtered[i];
    var rowClass = send.isJourneySend ? "send-row send-row--journey" : "send-row";
    var rowAttrs =
      ' class="' +
      rowClass +
      '"' +
      ' data-email-name="' +
      htmlSafe(send.emailName.toLowerCase()) +
      '"' +
      ' data-journey-name="' +
      htmlSafe(send.journeyName.toLowerCase()) +
      '"' +
      ' data-recipients="' +
      htmlSafe(send.recipients) +
      '"' +
      (send.isJourneySend
        ? ' tabindex="0" role="button" aria-expanded="false"'
        : "");
    parts.push("<tr" + rowAttrs + ">");
    parts.push('<td colspan="5" class="send-row-wrap">');
    parts.push('<div class="send-row-grid">');
    parts.push('<div class="send-col">' + htmlSafe(send.emailName) + "</div>");
    parts.push('<div class="send-col">' + htmlSafe(send.emailSubject) + "</div>");
    parts.push(
      '<div class="send-col">' + htmlSafe(formatDisplayDate(send.sendTime)) + "</div>"
    );
    parts.push('<div class="send-col">' + htmlSafe(send.recipients) + "</div>");
    parts.push(
      '<div class="send-col contacts-mono">' + htmlSafe(send.jobId || "—") + "</div>"
    );
    parts.push("</div>");
    if (send.isJourneySend) {
      var journeyUrl = buildJourneyOpenUrl(
        cloudBase,
        send.journeyId,
        send.versionNumber
      );
      parts.push('<div class="send-expand-panel" hidden>');
      if (send.journeyName) {
        parts.push(
          '<span class="send-expand-journey">' +
            htmlSafe(send.journeyName) +
            "</span>"
        );
      }
      if (journeyUrl) {
        parts.push(
          '<a class="btn btn-open-journey" href="' +
            htmlSafe(journeyUrl) +
            '" target="_blank" rel="noopener noreferrer">Open Journey</a>'
        );
      }
      parts.push("</div>");
    }
    parts.push("</td></tr>");
  }
  parts.push("</tbody></table></div>");
  return parts.join("");
}

function buildRecentDaysHtml(rows, selectedDateKey) {
  var byDate = {};
  var todayKey = todayDateKey();
  var i;
  for (i = 0; i < rows.length; i++) {
    var item = normalizeCalendarRow(rows[i]);
    var key = item.sendDateKey;
    if (!key) {
      continue;
    }
    if (!byDate[key]) {
      byDate[key] = {
        sendDate: item.sendDate,
        sendDateKey: key,
        sendDateMs: item.sendDateMs || parseDateMs(key),
        emailCount: 0,
        recipients: 0
      };
    }
    byDate[key].emailCount++;
    byDate[key].recipients += parseInt(item.recipients, 10) || 0;
  }
  if (!byDate[todayKey]) {
    byDate[todayKey] = {
      sendDate: todayKey,
      sendDateKey: todayKey,
      sendDateMs: parseDateMs(todayKey),
      emailCount: 0,
      recipients: 0
    };
  }
  var otherKeys = [];
  for (var dateKey in byDate) {
    if (byDate.hasOwnProperty(dateKey) && dateKey !== todayKey) {
      otherKeys.push(dateKey);
    }
  }
  otherKeys.sort(function (a, b) {
    return (byDate[b].sendDateMs || 0) - (byDate[a].sendDateMs || 0);
  });
  var order = [todayKey].concat(otherKeys);
  if (order.length > RECENT_DAYS_LIMIT) {
    order = order.slice(0, RECENT_DAYS_LIMIT);
  }
  var parts = ['<ul class="recent-list">'];
  for (i = 0; i < order.length; i++) {
    var day = byDate[order[i]];
    var selected =
      selectedDateKey && day.sendDateKey === selectedDateKey ? " is-selected" : "";
    var dayLabel = formatRecentDayLabel(day.sendDate, day.sendDateKey);
    parts.push(
      '<li class="recent-item recent-item--clickable' +
        selected +
        '" data-date="' +
        htmlSafe(day.sendDateKey) +
        '" role="button" tabindex="0" aria-label="View sends for ' +
        htmlSafe(dayLabel) +
        '">' +
        '<div class="recent-journey">' +
        htmlSafe(dayLabel) +
        "</div>" +
        '<div class="recent-details">' +
        '<div class="recent-detail">' +
        '<span class="recent-label">Emails</span> ' +
        htmlSafe(String(day.emailCount)) +
        "</div>" +
        '<div class="recent-detail">' +
        '<span class="recent-label">Recipients</span> ' +
        htmlSafe(String(day.recipients)) +
        "</div>" +
        "</div>" +
        "</li>"
    );
  }
  parts.push("</ul>");
  return parts.join("");
}

hubUrl = lookupValue("bd_sst_page_navigation", "ss_home", "type", "cloudpage") || "#";
journeyExitUrl = lookupValue("bd_sst_page_navigation", "ss_journey_exit", "type", "cloudpage") || "";
calendarUrl = lookupValue("bd_sst_page_navigation", "ss_email_calendar", "type", "cloudpage") || "";
mcCloudUrl = "https://mc.s13.exacttarget.com/cloud/";
environment = asStr(lookupValue("bd_sst_page_navigation", "environment", "type", "cloudpage")).toLowerCase();
if (environment === "uat") {
  envDisplayName = "UAT";
  envDisplayEmail = "UAT+admin@magmutual.com";
  envAvatarLetter = "U";
} else if (environment === "prod") {
  envDisplayName = "PROD";
  envDisplayEmail = "admin@magmutual.com";
  envAvatarLetter = "P";
}

selectedDate = parseSelectedDate(queryValue("date"));
selectedDateDisplay = formatRecentDayLabel(selectedDate, selectedDate);

try {
  var calendarFetch = loadCalendarRows();
  if (calendarFetch.ok) {
    sendsHtml = buildSendsHtml(calendarFetch.rows, selectedDate, mcCloudUrl);
    recentDaysHtml = buildRecentDaysHtml(calendarFetch.rows, selectedDate);
  } else {
    calendarLoadError = calendarFetch.error || "Could not load send calendar.";
    sendsHtml = '<p class="recent-empty">No send data available.</p>';
    recentDaysHtml = buildRecentDaysHtml([], selectedDate);
  }
} catch (loadEx) {
  calendarLoadError = asStr(loadEx && loadEx.message ? loadEx.message : loadEx);
  sendsHtml = '<p class="recent-empty">No send data available.</p>';
  recentDaysHtml = buildRecentDaysHtml([], selectedDate);
}

Platform.Variable.SetValue("@hubUrl", hubUrl || "#");
Platform.Variable.SetValue("@journeyExitUrl", journeyExitUrl || "");
Platform.Variable.SetValue("@calendarUrl", calendarUrl || "");
Platform.Variable.SetValue("@activeNav", "email_calendar");
Platform.Variable.SetValue("@envDisplayName", envDisplayName);
Platform.Variable.SetValue("@envDisplayEmail", envDisplayEmail);
Platform.Variable.SetValue("@envAvatarLetter", envAvatarLetter);
Platform.Variable.SetValue("@calSelectedDate", selectedDate);
Platform.Variable.SetValue("@calSelectedDateDisplay", selectedDateDisplay);
Platform.Variable.SetValue("@calSendsHtml", sendsHtml);
Platform.Variable.SetValue("@calRecentDaysHtml", recentDaysHtml);
Platform.Variable.SetValue("@calLoadError", calendarLoadError);
Platform.Variable.SetValue("@calSendsCount", String(sendsCount));
Platform.Variable.SetValue("@calRecipientsTotal", String(recipientsTotal));
</script>
