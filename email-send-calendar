}
.btn {
  border: 0;
  border-radius: 0;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  padding: 10px 18px;
  min-height: 40px;
  line-height: 1.2;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-decoration: none;
}
.btn-open-journey {
  background: #000;
  color: #fff;
}
.btn-open-journey:hover {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}
.contacts-mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  word-break: break-all;
}
.recent-list {
  list-style: none;
  margin: 0;
  padding: 5px 10px;
  border-top: 1px solid #e5e7eb;
}
.recent-item {
  padding: 12px 0;
  border-bottom: 1px solid var(--border-color);
}
.recent-item:last-child { border-bottom: 0; padding-bottom: 0; }
.recent-item--clickable {
  cursor: pointer;
  margin: 0 -10px;
  padding-left: 10px;
  padding-right: 10px;
  transition: background 0.15s ease;
}
.recent-item--clickable:hover { background: var(--bg-secondary); }
.recent-item--clickable.is-selected {
  background: #eef2ff;
  border-left: 3px solid var(--primary-color);
  padding: 10px 10px;
}
.recent-journey {
  font-weight: 600;
  font-size: 14px;
  color: var(--gray-900);
  margin-bottom: 6px;
}
.recent-details {
  display: flex;
  justify-content: space-between;
  gap: 8px;
}
.recent-detail { font-size: 12px; color: var(--gray-500); margin-bottom: 0; }
.recent-label { font-weight: 600; color: var(--gray-900); }
.recent-empty { font-size: 13px; color: var(--gray-500); margin: 0; }
@media (max-width: 980px) {
  .exit-workspace { flex-direction: column; }
  .exit-side { max-width: none; width: 100%; }
}
</style>
</head>
<body>
<div class="dashboard-layout">
  %%=ContentBlockByKey("sst_shell_sidebar")=%%
  <main class="main-content">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <a href="%%=v(@hubUrl)=%%" class="breadcrumb-link"><svg width="35" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>Back</a>
      <span class="breadcrumb-separator" aria-hidden="true">/</span>
      <span class="breadcrumb-current">Send Calendar</span>
    </nav>

    <div class="exit-workspace">
      <div class="exit-main">
        <div class="card">
          <h1>Send Calendar</h1>
          <p class="sub">Emails that went out on the selected day. Data comes from <code>bd_sst_email_send_calendar</code>, refreshed by the calendar query automation.</p>

          <script runat="server">
            function bodySafe(value) {
              return String(value || "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
            }
            var loadErr = Platform.Variable.GetValue("@calLoadError");
            if (loadErr) {
              Write('<div class="notice warn"><strong>Could not load send calendar.</strong><br>' + bodySafe(loadErr) + '</div>');
            }
          </script>

          <form method="get" id="calendarForm">
            <div class="form-group">
              <label class="form-label" for="date">Date</label>
              <div class="form-group-row">
                <script runat="server">
                  Write(
                    '<input class="form-input form-input--date" type="date" id="date" name="date" value="' +
                      bodySafe(Platform.Variable.GetValue("@calSelectedDate") || "") +
                      '">'
                  );
                </script>
                <input
                  class="form-input form-input--search"
                  type="search"
                  id="sendSearch"
                  placeholder="Search email or journey name"
                  autocomplete="off"
                  aria-label="Search email or journey name"
                >
              </div>
              <p class="hint">Choose a date to load sends, or pick a recent day on the right.</p>
            </div>
          </form>

          <script runat="server">
            var dayLabel = Platform.Variable.GetValue("@calSelectedDateDisplay");
            var sendCount = Platform.Variable.GetValue("@calSendsCount");
            var recipientTotal = Platform.Variable.GetValue("@calRecipientsTotal");
            Write('<h2 style="font-size:1.125rem;margin:28px 0 12px;">' + bodySafe(dayLabel) + '</h2>');
            Write('<div class="contacts-summary" id="sendsSummary">');
            Write('<span><span class="contacts-summary-label">Emails sent</span> <span id="sendCountDisplay">' + bodySafe(sendCount || "0") + '</span></span>');
            Write('<span><span class="contacts-summary-label">Total recipients</span> <span id="recipientTotalDisplay">' + bodySafe(recipientTotal || "0") + '</span></span>');
            Write('</div>');
            Write('<p class="recent-empty" id="sendFilterEmpty" hidden>No sends match your search.</p>');
            Write('<div id="sendsResults">');
            Write(Platform.Variable.GetValue("@calSendsHtml") || '<p class="recent-empty">No email sends recorded for this date.</p>');
            Write('</div>');
          </script>
        </div>
      </div>

      <aside class="exit-side" aria-label="Recent send days">
        <div class="card card-side">
          <h2 class="side-title">Recent days</h2>
          <p class="side-sub">Last 5 days. Click one to view sends.</p>
          <script runat="server">
            Write(Platform.Variable.GetValue("@calRecentDaysHtml") || '<p class="recent-empty">No recent days yet.</p>');
          </script>
        </div>
      </aside>
    </div>
  </main>
</div>
<script>
(function () {
  var dateInput = document.getElementById("date");
  if (dateInput) {
    dateInput.addEventListener("change", function () {
      var form = document.getElementById("calendarForm");
      if (form) {
        form.submit();
      }
    });
  }
  var recentItems = document.querySelectorAll(".recent-item--clickable");
  var i;
  for (i = 0; i < recentItems.length; i++) {
    recentItems[i].addEventListener("click", function () {
      var day = this.getAttribute("data-date");
      if (!day) {
        return;
      }
      window.location.href =
        window.location.pathname + "?date=" + encodeURIComponent(day);
    });
    recentItems[i].addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        this.click();
      }
    });
  }

  function closeSendExpands() {
    var openRows = document.querySelectorAll(".send-row--journey.is-open");
    var ri;
    for (ri = 0; ri < openRows.length; ri++) {
      var panel = openRows[ri].querySelector(".send-expand-panel");
      openRows[ri].className = "send-row send-row--journey";
      openRows[ri].setAttribute("aria-expanded", "false");
      if (panel) {
        panel.hidden = true;
      }
    }
  }

  function toggleSendExpand(row) {
    var panel = row.querySelector(".send-expand-panel");
    if (!panel) {
      return;
    }
    var isOpen = !panel.hidden;
    closeSendExpands();
    if (!isOpen) {
      panel.hidden = false;
      row.className = "send-row send-row--journey is-open";
      row.setAttribute("aria-expanded", "true");
    }
  }

  var sendRows = document.querySelectorAll(".send-row--journey");
  for (i = 0; i < sendRows.length; i++) {
    sendRows[i].addEventListener("click", function (e) {
      if (e.target.closest(".btn-open-journey")) {
        return;
      }
      toggleSendExpand(this);
    });
    sendRows[i].addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        toggleSendExpand(this);
      }
    });
  }

  var searchInput = document.getElementById("sendSearch");
  var sendCountDisplay = document.getElementById("sendCountDisplay");
  var recipientTotalDisplay = document.getElementById("recipientTotalDisplay");
  var sendFilterEmpty = document.getElementById("sendFilterEmpty");
  var sendsSummary = document.getElementById("sendsSummary");
  var allSendRows = document.querySelectorAll(".sends-table tbody .send-row");

  function filterSends() {
    if (!allSendRows.length) {
      return;
    }
    var query = (searchInput && searchInput.value ? searchInput.value : "")
      .replace(/^\s+|\s+$/g, "")
      .toLowerCase();
    var visibleCount = 0;
    var visibleRecipients = 0;
    var ri;
    for (ri = 0; ri < allSendRows.length; ri++) {
      var row = allSendRows[ri];
      var emailName = row.getAttribute("data-email-name") || "";
      var journeyName = row.getAttribute("data-journey-name") || "";
      var matches =
        !query ||
        emailName.indexOf(query) !== -1 ||
        journeyName.indexOf(query) !== -1;
      row.style.display = matches ? "" : "none";
      if (matches) {
        visibleCount += 1;
        visibleRecipients += parseInt(row.getAttribute("data-recipients"), 10) || 0;
      }
    }
    if (sendCountDisplay) {
      sendCountDisplay.textContent = String(visibleCount);
    }
    if (recipientTotalDisplay) {
      recipientTotalDisplay.textContent = String(visibleRecipients);
    }
    if (sendFilterEmpty) {
      sendFilterEmpty.hidden = !query || visibleCount > 0;
    }
    if (sendsSummary) {
      sendsSummary.hidden = !!query && visibleCount === 0;
    }
  }

  if (searchInput) {
    searchInput.addEventListener("input", filterSends);
    searchInput.addEventListener("search", filterSends);
  }
})();
</script>
</body>
</html>
