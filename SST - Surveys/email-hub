              <div class="preview-message-meta">
                <div class="preview-message-copy">
                  <strong id="previewSubject">Recommended Learning Center resources</strong>
                  <span id="previewPreheader">Helpful educational resources selected for your practice.</span>
                </div>
                <div class="preview-date" id="previewDate"></div>
              </div>
            </div>
            <div class="preview-contact-panel" id="previewContactPanel">
              <div class="form-group">
                <label class="form-label" for="previewContactId">Preview Contact ID</label>
                <script runat="server">
                  function previewFormSafe(value) {
                    return String(value || "")
                      .replace(/&/g, "&amp;")
                      .replace(/</g, "&lt;")
                      .replace(/>/g, "&gt;")
                      .replace(/"/g, "&quot;");
                  }
                  Write('<input class="form-input" id="previewContactId" name="previewContactId" value="' + previewFormSafe(Platform.Variable.GetValue("@quickSendEmailPreviewContactId") || "0033l000037NLyuAAG") + '">');
                </script>
              </div>
              <div class="preview-contact-actions">
                <button class="btn btn-create" id="refreshPreviewData" type="button">Refresh Preview</button>
              </div>
            </div>
            <iframe class="preview-frame" id="emailPreviewFrame" title="Email preview"></iframe>
          </section>
        </div>
      </div>
    </div>
