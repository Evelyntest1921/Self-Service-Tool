<script runat="server">
Platform.Load("core", "1");

var resultStatus = "";
var resultMessage = "";
var createdAssetId = "";
var createdCustomerKey = "";
var hubUrl = "";

function formValue(name) {
  var value = "";
  try {
    value = Platform.Request.GetFormField(name);
  } catch (e) {}
  return value || "";
}

function queryValue(name) {
  var value = "";
  try {
    value = Platform.Request.GetQueryStringParameter(name);
  } catch (e) {}
  if (!value) {
    try {
      value = Request.GetQueryStringParameter(name);
    } catch (ex) {}
  }
  return value || "";
}

function requestValue(name) {
  return formValue(name) || queryValue(name);
}

function clean(value) {
  return String(value || "").replace(/^\s+|\s+$/g, "");
}

function htmlSafe(value) {
  return String(value || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function textBodyParagraph(value) {
  var safeValue = htmlSafe(value).replace(/\r\n|\r|\n/g, "<br>");
  return "<p style=\"margin:0 0 18px;\">" + safeValue + "</p>";
}

function asJson(value) {
  return Platform.Function.Stringify(value);
}

function fromJson(value) {
  return Platform.Function.ParseJSON(String(value || "{}"));
}

function guidKey() {
  return String(Platform.Function.GUID()).replace(/-/g, "");
}

function field(row, name) {
  if (!row) return "";
  return row[name] || row[String(name)] || "";
}

function lookupValue(deName, returnField, lookupField, lookupValue) {
  try {
    return clean(Platform.Function.Lookup(deName, returnField, lookupField, lookupValue));
  } catch (e) {}
  return "";
}

hubUrl = lookupValue("bd_sst_page_navigation", "ss_home", "type", "cloudpage");

function getAuthConfig() {
  var rows = Platform.Function.LookupRows("SFMC_AUTH", "User", "Admin");
  if (!rows || rows.length < 1) {
    throw "Missing SFMC_AUTH row for User=Admin.";
  }
  var row = rows[0];
  var clientId = clean(field(row, "clientId"));
  var clientSecret = clean(field(row, "clientSecret"));
  var subdomain = clean(field(row, "subdomain"));
  var accountId = clean(field(row, "accountId"));
  if (!clientId || !clientSecret || !subdomain) {
    throw "SFMC_AUTH must include clientId, clientSecret, and subdomain.";
  }
  return {
    clientId: clientId,
    clientSecret: clientSecret,
    subdomain: subdomain,
    accountId: accountId
  };
}

function getAccessToken(auth) {
  var payload = {
    grant_type: "client_credentials",
    client_id: auth.clientId,
    client_secret: auth.clientSecret
  };
  if (auth.accountId) {
    payload.account_id = auth.accountId;
  }
  var req = new Script.Util.HttpRequest("https://" + auth.subdomain + ".auth.marketingcloudapis.com/v2/token");
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.contentType = "application/json";
  req.method = "POST";
  req.postData = asJson(payload);
  var resp = req.send();
  var body = String(resp.content || "");
  if (resp.statusCode != 200) {
    throw "Auth HTTP " + resp.statusCode + ": " + body;
  }
  var parsed = fromJson(body);
  if (!parsed.access_token) {
    throw "Auth response did not include access_token.";
  }
  return parsed.access_token;
}

function createAsset(auth, token, payload) {
  var req = new Script.Util.HttpRequest("https://" + auth.subdomain + ".rest.marketingcloudapis.com/asset/v1/content/assets");
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.contentType = "application/json";
  req.setHeader("Authorization", "Bearer " + token);
  req.method = "POST";
  req.postData = asJson(payload);
  var resp = req.send();
  var body = String(resp.content || "");
  if (resp.statusCode != 200 && resp.statusCode != 201) {
    throw "Asset create HTTP " + resp.statusCode + ": " + body;
  }
  return fromJson(body);
}

var TEMPLATE_BODY_SLOT_KEY = "1s336usuarz";
var DEFAULT_TEMPLATE_SOURCE_ID = "56657";

function cloneObject(obj) {
  if (!obj || typeof obj !== "object") {
    return null;
  }
  try {
    return fromJson(asJson(obj));
  } catch (cloneEx) {
    return null;
  }
}

function objectKeys(obj) {
  var keys = [];
  var key;
  if (!obj || typeof obj !== "object") {
    return keys;
  }
  try {
    for (key in obj) {
      try {
        if (obj[key] !== undefined) {
          keys.push(String(key));
        }
      } catch (keyEx) {}
    }
  } catch (loopEx) {}
  return keys;
}

function truncateMessage(value, maxLen) {
  var str = String(value || "");
  var max = maxLen || 900;
  if (str.length <= max) {
    return str;
  }
  return str.substring(0, max) + "...[truncated]";
}

function fetchAssetById(assetId, subdomainValue, accessTokenValue) {
  var result = { ok: false, statusCode: 0, responseText: "", asset: null };
  var parsedId = parseInt(assetId, 10);
  if (isNaN(parsedId) || !subdomainValue || !accessTokenValue) {
    return result;
  }
  try {
    var assetUrl =
      "https://" +
      subdomainValue +
      ".rest.marketingcloudapis.com/asset/v1/content/assets/" +
      parsedId;
    var req = new Script.Util.HttpRequest(assetUrl);
    req.emptyContentHandling = 0;
    req.retries = 2;
    req.continueOnError = true;
    req.setHeader("Authorization", "Bearer " + accessTokenValue);
    req.method = "GET";
    req.contentType = "application/json";
    var resp = req.send();
    result.statusCode = resp.statusCode;
    result.responseText = String(resp.content || "");
    if ((resp.statusCode == 200 || resp.statusCode == 201) && result.responseText) {
      result.asset = fromJson(result.responseText);
      result.ok = true;
    }
  } catch (fetchEx) {
    result.responseText = fetchEx.message || String(fetchEx);
  }
  return result;
}

function getTemplateSourceAssetId() {
  var override = clean(formValue("sourceTemplateId"));
  if (override) {
    return override;
  }
  var fromDe = lookupValue("SFMC_TEMPLATES", "LG_BG_Header_Email_BD_Template", "User", "Admin");
  if (!fromDe) {
    fromDe = lookupValue("SFMC_TEMPLATES", "SM_BG_Header_Email_BD_Template", "User", "Admin");
  }
  if (fromDe) {
    return fromDe;
  }
  return DEFAULT_TEMPLATE_SOURCE_ID;
}

function buildTemplateReference(source, fallbackContent, fallbackSlots) {
  if (!source || typeof source !== "object") {
    return null;
  }
  var ref = { assetType: { id: 4 } };
  var sourceId = parseInt(source.id, 10);
  if (!isNaN(sourceId)) {
    ref.id = sourceId;
  }
  if (source.assetType && source.assetType.id) {
    ref.assetType.id = parseInt(source.assetType.id, 10);
  }
  if (source.assetType && source.assetType.name) {
    ref.assetType.name = source.assetType.name;
  }
  ref.content = source.content || fallbackContent || "";
  ref.slots =
    source.slots && typeof source.slots === "object"
      ? cloneObject(source.slots)
      : cloneObject(fallbackSlots || {});
  return ref;
}

function buildCloned207Payload(
  sourceAsset,
  targetName,
  subjectlineContent,
  preheaderContent,
  sourceTemplate,
  resolvedTemplateAsset,
  sourceSlots
) {
  var templateSource = resolvedTemplateAsset || sourceTemplate;
  var templateContent = templateSource && templateSource.content ? templateSource.content : "";
  var templateSlots =
    templateSource && templateSource.slots && typeof templateSource.slots === "object"
      ? cloneObject(templateSource.slots)
      : {};
  var sourceHtmlContent =
    sourceAsset && sourceAsset.views && sourceAsset.views.html && sourceAsset.views.html.content
      ? sourceAsset.views.html.content
      : sourceAsset.content || templateContent;
  var emailSlots = sourceSlots && typeof sourceSlots === "object" ? cloneObject(sourceSlots) : {};
  var payload = {
    name: targetName,
    assetType: { id: 207, name: "htmlemail" },
    channels:
      sourceAsset.channels && typeof sourceAsset.channels === "object"
        ? cloneObject(sourceAsset.channels)
        : { email: true, web: false },
    views: {
      subjectline: { content: subjectlineContent || "Recommended Learning Center resources" },
      preheader: { content: preheaderContent || "" },
      html: {
        content: sourceHtmlContent,
        slots: emailSlots,
        template: {
          id: parseInt(sourceTemplate.id, 10),
          assetType: { id: 4, name: "template" },
          content: templateContent,
          slots: templateSlots
        }
      },
      text: { content: "" }
    },
    data: { email: { options: { characterEncoding: "utf-8" } } }
  };
  if (sourceAsset.category && sourceAsset.category.id) {
    payload.category = { id: sourceAsset.category.id };
  }
  return payload;
}

function findBlockKeyInSlot(slots, slotKey) {
  var slot;
  var keys;
  if (!slots || !slotKey) {
    return "";
  }
  slot = slots[slotKey];
  if (!slot || !slot.blocks || typeof slot.blocks !== "object") {
    return "";
  }
  keys = objectKeys(slot.blocks);
  if (!keys.length) {
    return "";
  }
  return keys[0];
}

function applyBodyToSlot(payload, slotKey, blockKey, bodyHtml) {
  var htmlView;
  var slots;
  var slot;
  if (!payload.views) {
    payload.views = {};
  }
  if (!payload.views.html) {
    payload.views.html = {};
  }
  htmlView = payload.views.html;
  if (!htmlView.slots || typeof htmlView.slots !== "object") {
    htmlView.slots = {};
  }
  slots = htmlView.slots;
  if (!slots[slotKey] || typeof slots[slotKey] !== "object") {
    slots[slotKey] = { content: "", blocks: {} };
  }
  slot = slots[slotKey];
  if (!slot.blocks || typeof slot.blocks !== "object") {
    slot.blocks = {};
  }
  if (!slot.blocks[blockKey] || typeof slot.blocks[blockKey] !== "object") {
    slot.blocks[blockKey] = {
      assetType: { id: 196, name: "textblock" }
    };
  }
  slot.blocks[blockKey].content = bodyHtml;
  if (!slot.content) {
    slot.content = '<div data-type="block" data-key="' + blockKey + '"></div>';
  }
}

function buildPayloadFromSource(template, emailName, subjectLine, preheaderLine, subdomainValue, accessTokenValue) {
  var sourceViews = template.views || {};
  var htmlView = sourceViews.html || {};
  var subjectlineContent =
    subjectLine ||
    (sourceViews.subjectline && sourceViews.subjectline.content
      ? sourceViews.subjectline.content
      : "Recommended Learning Center resources");
  var preheaderContent =
    preheaderLine ||
    (sourceViews.preheader && sourceViews.preheader.content ? sourceViews.preheader.content : "");
  var htmlContent = htmlView.content || template.content || "";
  var htmlSlots =
    htmlView.slots && typeof htmlView.slots === "object"
      ? htmlView.slots
      : template.slots && typeof template.slots === "object"
        ? template.slots
        : {};
  var sourceTemplate =
    htmlView.template && typeof htmlView.template === "object" ? htmlView.template : null;
  var assetTypeId =
    template.assetType && template.assetType.id ? parseInt(template.assetType.id, 10) : 207;
  var payload = null;
  var fetchedTemplate;

  if (assetTypeId === 4) {
    var templateRef = buildTemplateReference(
      template,
      template.content || htmlContent,
      template.slots || htmlSlots
    );
    var templateSlots =
      template.slots && typeof template.slots === "object"
        ? cloneObject(template.slots)
        : cloneObject(htmlSlots || {});
    payload = {
      name: emailName,
      assetType: { name: "htmlemail", id: 207 },
      channels:
        template.channels && typeof template.channels === "object"
          ? cloneObject(template.channels)
          : { email: true, web: false },
      views: {
        subjectline: { content: subjectlineContent },
        preheader: { content: preheaderContent },
        html: {
          template: templateRef,
          content: template.content || htmlContent || "",
          slots: templateSlots || {}
        },
        text: { content: "" }
      },
      data: { email: { options: { characterEncoding: "utf-8" } } }
    };
    if (template.category && template.category.id) {
      payload.category = { id: template.category.id };
    }
  } else if (assetTypeId === 207) {
    if (!sourceTemplate) {
      throw "Template source is 207 but views.html.template is missing.";
    }
    fetchedTemplate = fetchAssetById(sourceTemplate.id, subdomainValue, accessTokenValue);
    if (!fetchedTemplate.ok || !fetchedTemplate.asset) {
      throw (
        "Nested template GET failed HTTP " +
        fetchedTemplate.statusCode +
        ": " +
        truncateMessage(fetchedTemplate.responseText, 600)
      );
    }
    payload = buildCloned207Payload(
      template,
      emailName,
      subjectlineContent,
      preheaderContent,
      sourceTemplate,
      fetchedTemplate.asset,
      htmlSlots
    );
  } else {
    throw "Unsupported template source asset type " + assetTypeId + ".";
  }
  return payload;
}

function createEmailFromTemplate(auth, token, options) {
  var sourceTemplateId = options.sourceTemplateId;
  var emailName = options.emailName;
  var subject = options.subject;
  var preheader = options.preheader;
  var bodyHtml = options.bodyHtml;
  var customerKey = options.customerKey;
  var sourceFetch = fetchAssetById(sourceTemplateId, auth.subdomain, token);
  if (!sourceFetch.ok || !sourceFetch.asset) {
    throw (
      "GET template source " +
      sourceTemplateId +
      " failed HTTP " +
      sourceFetch.statusCode +
      ": " +
      truncateMessage(sourceFetch.responseText, 600)
    );
  }
  var payload = buildPayloadFromSource(
    sourceFetch.asset,
    emailName,
    subject,
    preheader,
    auth.subdomain,
    token
  );
  if (!payload || !payload.views || !payload.views.html) {
    throw "Could not build email payload from template source.";
  }
  var slots = payload.views.html.slots || {};
  var blockKey = findBlockKeyInSlot(slots, TEMPLATE_BODY_SLOT_KEY);
  if (!blockKey) {
    blockKey = "bodyblock1";
  }
  applyBodyToSlot(payload, TEMPLATE_BODY_SLOT_KEY, blockKey, bodyHtml);
  if (customerKey) {
    payload.customerKey = customerKey;
  }
  return createAsset(auth, token, payload);
}

function previewTables(environment) {
  if (String(environment || "").toLowerCase() == "uat") {
    return {
      contact: "ENT.Contact_Salesforce_1",
      account: "ENT.Account_Salesforce_1",
      user: "ENT.User_Salesforce_1",
      label: "UAT"
    };
  }
  return {
    contact: "Contact_Salesforce",
    account: "Account_Salesforce",
    user: "User_Salesforce",
    label: "Production"
  };
}

function firstLookupRow(deName, lookupField, lookupFieldValue) {
  if (!lookupFieldValue) return null;
  try {
    var rows = Platform.Function.LookupRows(deName, lookupField, lookupFieldValue);
    if (rows && rows.length > 0) {
      return rows[0];
    }
  } catch (e) {}
  return null;
}

function buildGreeting(firstName, lastName, salutation) {
  if (salutation && lastName) {
    return "Hello " + salutation + " " + lastName + ",";
  }
  if (firstName) {
    return "Hello " + firstName + ",";
  }
  if (lastName) {
    return "Hello Mr./Mrs. " + lastName + ",";
  }
  return "Hello,";
}

function senderFirstName(sendfromName) {
  var name = clean(sendfromName);
  var spaceIndex = name.indexOf(" ");
  if (spaceIndex > 0) {
    return name.substring(0, spaceIndex);
  }
  return name || "MagMutual";
}

function buildPreviewSignature(row) {
  var sendfromName = clean(field(row, "Name")) || "MagMutual";
  var sendFromEmail = clean(field(row, "Email")) || "info@magmutual.com";
  var senderTitle = clean(field(row, "Title"));
  var signaturePhone = clean(field(row, "Phone")) || "(800) 282-4882";
  var senderSalesLicenseNumber = clean(field(row, "Sales_License_Number__c"));
  var senderAppointmentLink = clean(field(row, "Appointment_Link__c"));
  var parts = [
    "<p style=\"margin:20px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;color:#161616;\">"
  ];
  if (senderAppointmentLink) {
    parts.push("<a href=\"https://cloud.go.magmutual.com/go-redirect-to-uat-link?url=" + htmlSafe(senderAppointmentLink) + "\" target=\"_blank\" style=\"text-decoration:underline;\">Book time to meet with me</a><br><br>");
  }
  parts.push("Best regards,<br>");
  parts.push("<span style=\"font-style:italic;font-family:serif;font-size:20px;\">" + htmlSafe(senderFirstName(sendfromName)) + "</span><br>");
  if (senderTitle) {
    parts.push(htmlSafe(senderTitle) + "<br>");
  }
  parts.push(htmlSafe(sendfromName) + "<br>");
  parts.push(htmlSafe(sendFromEmail) + "<br>");
  parts.push(htmlSafe(signaturePhone) + "<br>");
  if (senderSalesLicenseNumber) {
    parts.push("License #: " + htmlSafe(senderSalesLicenseNumber) + "<br>");
  }
  parts.push(" MagMutual Insurance</p>");
  return parts.join("");
}

function buildPreviewData(contactId, environment) {
  var tables = previewTables(environment);
  var requestedContactId = clean(contactId) || "0033l000037NLyuAAG";
  var contactRow = null;
  var accountRow = null;
  var userRow = null;
  var firstName = "";
  var lastName = "";
  var salutation = "";
  var contactAccountId = "";
  var ownerId = "";
  if (requestedContactId.indexOf("@") > 0) {
    contactRow = firstLookupRow(tables.contact, "Email", requestedContactId);
  }
  if (!contactRow) {
    contactRow = firstLookupRow(tables.contact, "Id", requestedContactId);
  }
  if (contactRow) {
    requestedContactId = clean(field(contactRow, "Id")) || requestedContactId;
    firstName = clean(field(contactRow, "FirstName"));
    lastName = clean(field(contactRow, "LastName"));
    salutation = clean(field(contactRow, "Salutation"));
    contactAccountId = clean(field(contactRow, "AccountId"));
    ownerId = clean(field(contactRow, "OwnerId")) || clean(field(contactRow, "Account_Owner__c"));
  }
  if (!ownerId && contactAccountId) {
    accountRow = firstLookupRow(tables.account, "Id", contactAccountId);
    if (accountRow) {
      ownerId = clean(field(accountRow, "OwnerId"));
    }
  }
  if (ownerId) {
    userRow = firstLookupRow(tables.user, "Id", ownerId);
  }
  return {
    contactId: requestedContactId,
    dataSource: tables.label,
    contactTable: tables.contact,
    accountTable: tables.account,
    userTable: tables.user,
    contactFound: contactRow ? true : false,
    ownerFound: userRow ? true : false,
    fullGreeting: buildGreeting(firstName, lastName, salutation),
    signatureHtml: buildPreviewSignature(userRow)
  };
}

if (formValue("createEmail") == "1") {
  try {
    var emailName = clean(formValue("emailName"));
    if (!emailName) {
      emailName = "SST Quick Send Email " + guidKey().substring(0, 8);
    }
    var subject = clean(formValue("subject"));
    if (!subject) {
      subject = "Recommended Learning Center resources";
    }
    var preheader = clean(formValue("preheader"));
    if (!preheader) {
      preheader = "Helpful educational resources selected for your practice.";
    }
    var introBody = clean(formValue("introBody"));
    if (!introBody) {
      introBody = "Thank you for your recent visit to our Learning Center. We hope you found our educational resources helpful in your practice of medicine. Based on your specialty, we thought you might be interested in more of our content.\n\nWith our upgraded Learning Center, you can access educational content, including an extensive library offering CME credits, and manage your learning activities more effectively. We are committed to being your trusted partner for professional development and risk management advice.";
    }
    createdCustomerKey = "sst-" + guidKey();
    var auth = getAuthConfig();
    var token = getAccessToken(auth);
    var sourceTemplateId = getTemplateSourceAssetId();
    var bodyHtml = textBodyParagraph(introBody);
    var created = createEmailFromTemplate(auth, token, {
      sourceTemplateId: sourceTemplateId,
      emailName: emailName,
      subject: subject,
      preheader: preheader,
      bodyHtml: bodyHtml,
      customerKey: createdCustomerKey
    });
    createdAssetId = String(created.id || "");
    resultStatus = "success";
    resultMessage =
      "Quick Send email created from Content Builder template (source asset " +
      sourceTemplateId +
      ").";
  } catch (ex) {
    resultStatus = "error";
    resultMessage = String(ex);
  }
}

var previewContactId = clean(requestValue("previewContactId")) || "0033l000037NLyuAAG";
var navigationEnvironment = clean(lookupValue("bd_sst_page_navigation", "environment", "type", "cloudpage")).toLowerCase();
var previewEnvironment = navigationEnvironment == "uat" ? "uat" : "prod";
var previewData = buildPreviewData(previewContactId, previewEnvironment);

Platform.Variable.SetValue("@quickSendEmailResultStatus", resultStatus);
Platform.Variable.SetValue("@quickSendEmailResultMessage", resultMessage);
Platform.Variable.SetValue("@quickSendEmailAssetId", createdAssetId);
Platform.Variable.SetValue("@quickSendEmailCustomerKey", createdCustomerKey);
Platform.Variable.SetValue("@quickSendEmailHubUrl", hubUrl);
Platform.Variable.SetValue("@quickSendEmailPreviewContactId", previewContactId);
Platform.Variable.SetValue("@quickSendEmailPreviewDataJson", asJson(previewData));
</script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
  :root {
    --primary-color: #6366f1;
    --primary-dark: #4f46e5;
    --gray-100: #f3f4f6;
    --gray-200: #e5e7eb;
    --gray-500: #6b7280;
    --gray-700: #374151;
    --gray-900: #111827;
    --bg-primary: #ffffff;
    --bg-secondary: #f9fafb;
    --border-color: #e5e7eb;
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    --radius-md: 0.5rem;
    --text-primary: #111827;
    --text-secondary: #6b7280;
  }
  * {
    box-sizing: border-box;
  }
  body {
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    margin: 0;
  }
  .dashboard-layout {
    display: flex;
    min-height: 100vh;
  }
  .maker-sidebar {
    background: #ffffff;
    border-right: 1px solid var(--gray-200);
    flex: 0 0 260px;
    min-height: 100vh;
  }
  .sidebar-logo {
    align-items: center;
    display: flex;
    height: 80px;
    padding: 0 24px;
  }
  .sidebar-logo img {
    filter: invert(1);
    height: 40px;
    width: auto;
  }
  .sidebar-nav {
    padding: 8px 16px 24px;
  }
  .nav-section-title {
    color: var(--gray-500);
    display: block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 18px 8px 8px;
  }
  .nav-link {
    align-items: center;
    border-radius: var(--radius-md);
    color: var(--gray-700);
    display: flex;
    font-size: 14px;
    font-weight: 600;
    gap: 12px;
    padding: 10px 12px;
  }
  .nav-link.active {
    background: var(--gray-100);
    color: var(--gray-900);
  }
  .nav-icon {
    flex: 0 0 auto;
  }
  .main-content {
    flex: 1;
    height: 100vh;
    overflow: auto;
    padding: 25px 40px 48px;
  }
  .page {
    width: 100%;
  }
  .breadcrumb-section {
    margin-bottom: 24px;
  }
  .breadcrumb-nav {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    font-size: 14px;
    gap: 8px;
  }
  .breadcrumb-link {
    align-items: center;
    color: var(--primary-color);
    display: inline-flex;
    font-weight: 500;
    text-decoration: none;
  }
  .breadcrumb-current {
    color: var(--gray-900);
    font-weight: 600;
  }
  .card {
    background: #ffffff;
