    flex: 0 0 40px;
    font-size: 16px;
    font-weight: 700;
    height: 40px;
    justify-content: center;
    padding: 0;
    width: 40px;
  }
  .preview-avatar:hover {
    background: var(--gray-200);
  }
  .preview-message-meta {
    align-items: center;
    display: flex;
    flex: 1;
    gap: 12px;
    justify-content: space-between;
    min-width: 0;
  }
  .preview-message-copy {
    min-width: 0;
  }
  .preview-header strong,
  .preview-header span {
    display: block;
  }
  .preview-header strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .preview-header span {
    color: #525252;
    font-size: 13px;
    line-height: 18px;
    margin-top: 4px;
  }
  .preview-date {
    color: var(--gray-500);
    flex: 0 0 auto;
    font-size: 13px;
    line-height: 18px;
    white-space: nowrap;
  }
  .preview-frame {
