        // Generate chart data from actual response timestamps
        function generateChartData() {
            console.log('Generating chart data from real responses...');


            // Get response data from AMPscript
            const totalResponsesElement = document.getElementById('totalResponses');
            const completedResponsesElement = document.getElementById('completedResponses');
            const responseDatesElement = document.getElementById('responseDates');


            const totalResponses = totalResponsesElement ? parseInt(totalResponsesElement.textContent) || 0 : 0;
            const completedResponses = completedResponsesElement ? parseInt(completedResponsesElement.textContent) || 0 : 0;
            const responseDates = responseDatesElement ? responseDatesElement.textContent : '';


            console.log('Response data:', { totalResponses, completedResponses, responseDates });


            // Parse actual response dates
            const actualDates = responseDates ? responseDates.split('|').filter(date => date.trim()) : [];
            console.log('Actual response dates:', actualDates);


            // Generate chart data based on actual response dates
            const now = new Date();
            const labels = [];
            const data = [];


            // Generate last 6 months of data
            for (let i = 5; i >= 0; i--) {
                const date = new Date(now.getFullYear(), now.getMonth() - i, 1);
