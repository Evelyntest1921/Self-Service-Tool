                    <div class="metric-card">
                        <div class="metric-icon responses">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                <path
                                    d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10 2 10 2 10 2 9 3 8.18 4H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2z" />
                            </svg>
                        </div>
                        <div class="metric-content">
                            <div class="metric-value">%%=v(@count)=%%</div>
                            <div class="metric-label">Total Responses</div>
                            <div class="metric-trend">All question responses</div>
                        </div>
                    </div>
                </div>










                <!-- Question Analysis Section -->
                %%[ IF @count > 0 THEN ]%%
                <div class="questions-section">
                    <div class="section-header">
                        <h2>Question Analysis</h2>
                    </div>


                    %%[
                    /* Get questions from SST_SP_Survey_Questions_DE */
                    VAR @questions, @questionCount
                    SET @questions = LookupRows("SST_SP_Survey_Questions_DE", "SurveyID", @surveyId)
                    SET @questionCount = RowCount(@questions)


                    /* Debug: Check if questions exist */
                    IF @questionCount == 0 THEN
                    SET @debugMessage = "No questions found in SST_SP_Survey_Questions_DE for SurveyID: " + @surveyId
                    ELSE
                    SET @debugMessage = "Found " + @questionCount + " questions"
                    ENDIF
                    ]%%


                    %%[ IF @questionCount > 0 THEN ]%%


                    <!-- Debug Info 
      <div style="background: #f0f0f0; padding: 10px; margin: 10px 0; border-radius: 5px; font-family: monospace; font-size: 12px;">
        <strong>Debug Info:</strong><br>
        Survey ID: %%=v(@surveyId)=%%<br>
        Questions Found: %%=v(@questionCount)=%%<br>
        Responses Found: %%=v(@count)=%%<br>
        Debug Message: %%=v(@debugMessage)=%%<br>
        <br>
        <strong>Questions in SST_SP_Survey_Questions_DE:</strong><br>
        %%[ FOR @i = 1 TO @questionCount DO
          SET @debugRow = Row(@questions, @i)
          SET @debugText = Field(@debugRow, "QuestionText")
          SET @debugId = Field(@debugRow, "QuestionID")
        ]%%
        %%=v(@i)=%%. %%=v(@debugText)=%% (ID: %%=v(@debugId)=%%)<br>
        %%[ NEXT @i ]%%
      </div> 
-->


                    %%[ FOR @q = 1 TO @questionCount DO
                    SET @questionRow = Row(@questions, @q)
                    SET @questionText = Field(@questionRow, "QuestionText")
                    SET @questionId = Field(@questionRow, "QuestionID")
                    SET @questionType = Field(@questionRow, "QuestionType")


                    /* Count responses for this question */
                    VAR @responseCount, @yesCount, @noCount, @textResponses, @otherResponses
                    SET @responseCount = 0
                    SET @yesCount = 0
                    SET @noCount = 0
                    SET @textResponses = ""
                    SET @otherResponses = ""


                    FOR @i = 1 TO @count DO
                    SET @responseRow = Row(@responses, @i)
                    SET @responseQuestionID = Field(@responseRow, "QuestionID")
                    SET @response = Field(@responseRow, "Response")


                    IF @responseQuestionID == @questionId AND NOT EMPTY(@response) THEN
                    SET @responseCount = Add(@responseCount, 1)


                    /* Count by response type */
                    IF @response == "Yes" THEN
                    SET @yesCount = Add(@yesCount, 1)
                    ELSEIF @response == "No" THEN
                    SET @noCount = Add(@noCount, 1)
                    ELSE
                    /* Store text responses for text-type questions */
                    IF @questionType == "text" THEN
                    SET @textResponses = Concat(@textResponses, "|", @response)
                    ELSE
                    /* Store other responses for multiple choice questions */
                    SET @otherResponses = Concat(@otherResponses, "|", @response)
                    ENDIF
                    ENDIF
                    ENDIF
                    NEXT
                    ]%%


                    <div class="question-card">
                        <div class="question-header">
                            <span class="question-number">%%=Format(@q, "00")=%%</span>
                            <div class="question-content">
                                <!-- <h3>%%=v(@questionText)=%%</h3> -->
                                <h3>
                                    %%=v(@questionText)=%%
                                </h3>
                                <!-- Debug: Question Text = "%%=v(@questionText)=%%" -->
                            </div>
                        </div>


                        <div class="question-stats">
                            <div class="stat-summary">
                                <div class="stat-item">
                                    <span class="stat-label">Total Responses</span>
                                    <span class="stat-value">%%=v(@responseCount)=%%</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Response Rate</span>
                                    <span class="stat-value">%%=IIF(@uniqueContacts > 0,
                                        FormatNumber(Multiply(Divide(@responseCount, @uniqueContacts), 100), 0),
                                        0)=%%%</span>
                                </div>
                                <div class="stat-item">
                                    <span class="stat-label">Question Type</span>
                                    <span class="stat-value">
                                        <span
                                            class="question-type-badge type-%%=v(@questionType)=%%">%%=v(@questionType)=%%</span>
                                    </span>
                                </div>
                            </div>
                        </div>


                        %%[ IF @responseCount > 0 THEN ]%%
                        <div class="answer-bars">
                            %%[ IF @questionType == "yesno" AND (@yesCount > 0 OR @noCount > 0) THEN ]%%
                            <!-- Yes/No Questions -->
                            %%[ IF @yesCount > 0 THEN ]%%
                            <div class="answer-option">
                                <div class="option-info">
                                    <span class="option-label">Yes</span>
                                    <span class="option-stats">%%=v(@yesCount)=%% responses
                                        (%%=FormatNumber(Multiply(Divide(@yesCount, @responseCount), 100), 0)=%%)</span>
                                </div>
                                <div class="progress-bar-modern">
                                    <div class="progress-fill-modern yes"
                                        style="width: %%=FormatNumber(Multiply(Divide(@yesCount, @responseCount), 100), 0)=%%%;">
                                    </div>
                                </div>
                            </div>
                            %%[ ENDIF ]%%


                            %%[ IF @noCount > 0 THEN ]%%
                            <div class="answer-option">
                                <div class="option-info">
                                    <span class="option-label">No</span>
                                    <span class="option-stats">%%=v(@noCount)=%% responses
                                        (%%=FormatNumber(Multiply(Divide(@noCount, @responseCount), 100), 0)=%%)</span>
                                </div>
                                <div class="progress-bar-modern">
                                    <div class="progress-fill-modern no"
                                        style="width: %%=FormatNumber(Multiply(Divide(@noCount, @responseCount), 100), 0)=%%%;">
                                    </div>
                                </div>
                            </div>
                            %%[ ENDIF ]%%


                            %%[ ELSEIF @questionType == "text" THEN ]%%
                            <!-- Text Questions - Show actual responses -->
                            <div class="text-responses-section">
                                <h4>Text Responses (%%=v(@responseCount)=%%)</h4>
                                %%[ IF NOT EMPTY(@textResponses) THEN
                                VAR @textArray, @textCount, @k
                                SET @textArray = BuildRowSetFromString(@textResponses, "|")
                                SET @textCount = RowCount(@textArray)


                                /* Render first 5 responses lazily */
                                FOR @k = 1 TO @textCount DO
                                IF @k <= 5 THEN SET @textResponse=Field(Row(@textArray, @k), 1) IF NOT
                                    EMPTY(@textResponse) THEN ]%% <div class="text-response-item">
                                    <div class="text-response-content">
                                        <span class="text-response-text">"%%=v(@textResponse)=%%"</span>
                                    </div>
                            </div>
                            %%[ ENDIF
                            ENDIF
                            NEXT @k ]%%


                            <!-- Hidden raw data for modal population -->
                            <span id="text-raw-%%=v(@questionId)=%%" class="text-responses-raw"
                                style="display:none;">%%=v(@textResponses)=%%</span>


                            %%[ IF @textCount > 5 THEN ]%%
                            <div style="margin-top:12px;">
                                <button class="btn-secondary"
                                    onclick="openTextResponsesModal('%%=v(@questionId)=%%', %%=v(@textCount)=%%)">View
                                    all responses (%%=v(@textCount)=%%)</button>
                            </div>
                            %%[ ENDIF ]%%


                            %%[ ELSE ]%%
                            <div class="text-response-item">
                                <div class="text-response-content">
                                    <span class="text-response-text">No text responses recorded</span>
                                </div>
                            </div>
                            %%[ ENDIF ]%%
                        </div>


                        %%[ ELSEIF @questionType == "likert" OR @questionType == "rating" OR @questionType ==
                        "multiple" THEN ]%%
                        <!-- Multiple Choice Questions - Aggregate by defined options -->
                        %%[
                        /* Fetch defined options for this question */
                        VAR @optString, @optRows, @optCount, @o
                        SET @optString = Lookup("SST_SP_Survey_Questions_DE", "Options", "QuestionID", @questionId)


                        IF NOT EMPTY(@optString) THEN
                        SET @optRows = BuildRowSetFromString(@optString, "|")
                        SET @optCount = RowCount(@optRows)
                        ELSE
                        SET @optCount = 0
                        ENDIF
                        ]%%


                        %%[ IF @optCount > 0 THEN ]%%
                        %%[
                        VAR @maxCount, @o2, @optVal2, @optResponses2, @ri2
                        SET @maxCount = 0
                        FOR @o2 = 1 TO @optCount DO
                        SET @optVal2 = Field(Row(@optRows, @o2), 1)
                        SET @optResponses2 = 0
                        FOR @ri2 = 1 TO @count DO
                        SET @row = Row(@responses, @ri2)
                        IF Field(@row, "QuestionID") == @questionId THEN
                        IF Field(@row, "Response") == @optVal2 THEN
                        SET @optResponses2 = Add(@optResponses2, 1)
                        ENDIF
                        ENDIF
                        NEXT @ri2
                        IF @optResponses2 > @maxCount THEN
                        SET @maxCount = @optResponses2
                        ENDIF
                        NEXT @o2
                        ]%%
                        %%[ FOR @o = 1 TO @optCount DO
                        VAR @optVal, @optResponses
                        SET @optVal = Field(Row(@optRows, @o), 1)
                        SET @optResponses = 0


                        /* Count matches in responses for this option */
                        VAR @ri
                        FOR @ri = 1 TO @count DO
                        SET @row = Row(@responses, @ri)
                        IF Field(@row, "QuestionID") == @questionId THEN
                        IF Field(@row, "Response") == @optVal THEN
                        SET @optResponses = Add(@optResponses, 1)
                        ENDIF
                        ENDIF
                        NEXT @ri


                        /* Render only options that have at least one response */
                        IF @optResponses > 0 THEN
                        SET @barClass = IIF(@optResponses == @maxCount, "yes", "multiple-choice")
                        ]%%
                        <div class="answer-option">
                            <div class="option-info">
                                <span class="option-label">%%=v(@optVal)=%%</span>
                                <span class="option-stats">%%=v(@optResponses)=%% responses
                                    (%%=FormatNumber(Multiply(Divide(@optResponses, @responseCount), 100),
                                    0)=%%)</span>
                            </div>
                            <div class="progress-bar-modern">
                                <div class="progress-fill-modern %%=v(@barClass)=%%"
                                    style="width: %%=FormatNumber(Multiply(Divide(@optResponses, @responseCount), 100), 0)=%%%;">
                                </div>
                            </div>
                        </div>
                        %%[ ENDIF ]%%
                        %%[ NEXT @o ]%%
                        %%[ ELSE ]%%
                        <!-- No defined options; show total only -->
                        <div class="answer-option">
                            <div class="option-info">
                                <span class="option-label">Responses Received</span>
