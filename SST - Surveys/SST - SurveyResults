                // Show all pages if 7 or fewer
                for (let i = 1; i <= totalPages; i++) {
                    pageNumbers += `<span class="page-number ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</span>`;
                }
            } else {
                // Show first page
                pageNumbers += `<span class="page-number ${1 === currentPage ? 'active' : ''}" onclick="goToPage(1)">1</span>`;
                
                if (currentPage > 4) {
                    pageNumbers += '<span class="page-ellipsis">...</span>';
                }
                
                // Show pages around current page
                const startPage = Math.max(2, currentPage - 1);
                const endPage = Math.min(totalPages - 1, currentPage + 1);
                
                for (let i = startPage; i <= endPage; i++) {
                    pageNumbers += `<span class="page-number ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</span>`;
                }
                
                if (currentPage < totalPages - 3) {
                    pageNumbers += '<span class="page-ellipsis">...</span>';
                }
                
                // Show last page
                if (totalPages > 1) {
                    pageNumbers += `<span class="page-number ${totalPages === currentPage ? 'active' : ''}" onclick="goToPage(${totalPages})">${totalPages}</span>`;
                }
            }

            paginationPages.innerHTML = pageNumbers;
        }

        // Go to specific page
        function goToPage(page) {
            const totalPages = Math.ceil(totalRows / rowsPerPage);
            if (page >= 1 && page <= totalPages) {
                showPage(page);
            }
        }

        // Change page (Previous/Next)
        function changePage(direction) {
            const totalPages = Math.ceil(totalRows / rowsPerPage);
            const newPage = currentPage + direction;
            
            if (newPage >= 1 && newPage <= totalPages) {
                showPage(newPage);
            }
        }

        // Enhanced search functionality
        function initializeSearch() {
            const searchInput = document.querySelector('.search-input');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const searchTerm = this.value.toLowerCase();
                    const table = document.querySelector('.modern-table tbody');
                    const rows = Array.from(table.querySelectorAll('tr'));
                    
                    // Get the current course filter
                    const currentFilter = window.currentCourseFilter || 'All';
                    
                    // Filter rows based on both search term and course filter
                    const visibleRows = rows.filter(row => {
                        // First apply course filter
                        let passesCourseFilter = true;
                        if (currentFilter !== 'All') {
                            const courseCell = row.querySelector('.course-name-cell');
                            if (courseCell) {
                                const cellCourseName = courseCell.textContent.trim();
                                passesCourseFilter = cellCourseName === currentFilter;
                            } else {
                                passesCourseFilter = false;
                            }
                        }
                        
                        // Then apply search filter
                        const text = row.textContent.toLowerCase();
                        const passesSearchFilter = text.includes(searchTerm);
                        
                        return passesCourseFilter && passesSearchFilter;
                    });
                    
                    // Update total rows for pagination
                    totalRows = visibleRows.length;
                    
                    // Reset to first page and update pagination
                    currentPage = 1;
                    updatePaginationInfo();
                    updatePaginationControls();
                    showPage(1);
                });
            }
        }

        // Initialize page based on URL parameters
        document.addEventListener('DOMContentLoaded', function () {
            const urlParams = new URLSearchParams(window.location.search);
            const view = urlParams.get('view');

            if (view === 'reports') {
                showReports();
            } else if (view === 'responses') {
                showResponses();
            } else {
                // Default to survey analytics view
                showSurveyAnalytics();
            }
            
            // Initialize search functionality
            initializeSearch();
            initializeAnalyticsViewToggle();
        });
    </script>


