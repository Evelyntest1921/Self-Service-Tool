<script runat="server">
Platform.Load("core", "1");

var EXIT_QUEUE_DE = "bd_sst_journey_exit";
var BATCH_DE = "bd_sst_journey_exit_batch";
var LOG_DE = "sst_de_journey_exit_log";
var LOG_FIELD = "log";
var LOG_MAX_LEN = 4000;
var EXIT_BATCH_SIZE = 50;
var CM_STATUS_TO = "Responded";

var resultLines = [];
var debugLines = [];
var batchMetaCache = {};
var cmUpdatePairs = [];
var batchExitStats = {};

function strTrim(v) {
  if (v === null || typeof v === "undefined") {
    return "";
  }
  try {
    return (v + "").replace(/^\s+|\s+$/g, "");
  } catch (e) {
    return "";
  }
}

function asLower(v) {
  var s = strTrim(v);
  try {
    return s.toLowerCase();
  } catch (e) {
    return s;
  }
}

function writeExitLog(text) {
  var msg = text === null || typeof text === "undefined" ? "" : text + "";
  if (msg.length > LOG_MAX_LEN) {
    msg = msg.substring(0, LOG_MAX_LEN - 3) + "...";
  }
  try {
    Platform.Function.InsertData(LOG_DE, [LOG_FIELD], [msg]);
    return { ok: true };
  } catch (logEx) {
    return { ok: false, error: logEx.message || String(logEx) };
  }
}

function queueField(row, names) {
  if (!row) {
    return "";
  }
  var i;
  for (i = 0; i < names.length; i++) {
    var val = row[names[i]];
    if (val !== undefined && val !== null && String(val) !== "") {
      return String(val);
    }
  }
  try {
    var props = row.Properties;
    if (props && typeof props.length === "number") {
      var want = {};
      for (i = 0; i < names.length; i++) {
        want[asLower(names[i])] = true;
      }
      for (i = 0; i < props.length; i++) {
        var pname = props[i].Name || props[i].name;
        var pval = props[i].Value;
        if (pval === undefined || pval === null) {
          pval = props[i].value;
        }
        if (want[asLower(pname)] && pval !== undefined && pval !== null && String(pval) !== "") {
          return String(pval);
        }
      }
    }
  } catch (propEx) {}
  return "";
}

function coerceQueueRows(raw) {
  if (raw === null || typeof raw === "undefined") {
    return [];
  }
  var rows = raw;
  if (rows.Results) {
    rows = rows.Results;
  }
  if (typeof rows.length === "number") {
    var out = [];
    for (var i = 0; i < rows.length; i++) {
      out.push(rows[i]);
    }
    return out;
  }
  if (
    typeof rows === "object" &&
    (queueField(rows, ["subscriberKey", "SubscriberKey"]) ||
      queueField(rows, ["journeyId", "journeyID", "JourneyID"]) ||
      queueField(rows, ["key", "Key"]))
  ) {
    return [rows];
  }
  return [];
}

function normalizeQueueRows(rawRows) {
  var rows = coerceQueueRows(rawRows);
  if (!rows.length) {
    return [];
  }
  var out = [];
  for (var j = 0; j < rows.length; j++) {
    var row = rows[j];
    var subscriberKey = strTrim(
      queueField(row, ["subscriberKey", "SubscriberKey"])
    );
    var journeyId = strTrim(
      queueField(row, ["journeyId", "journeyID", "JourneyID", "JourneyId"])
    );
    var batchId = strTrim(
      queueField(row, ["batchID", "batchId", "BatchId", "BATCHID"])
    );
    var rowKey = strTrim(queueField(row, ["key", "Key"]));
    if (!rowKey && batchId && subscriberKey) {
      rowKey = batchId + "|" + subscriberKey;
    }
    if (!rowKey && subscriberKey && journeyId) {
      rowKey = subscriberKey + "|" + journeyId;
    }
    out.push({
      key: rowKey,
      batchId: batchId,
      subscriberKey: subscriberKey,
      journeyName: strTrim(
        queueField(row, ["journeyName", "JourneyName", "Name"])
      ),
      journeyId: journeyId,
      status: strTrim(queueField(row, ["Status", "status"]))
    });
  }
  return out;
}

function isWorkableExitStatus(status) {
  var s = asLower(status);
  if (!s) {
    return true;
  }
  return s === "pending" || s === "queued" || s === "failed";
}

function filterWorkableExitRows(rows) {
  var out = [];
  var i;
  for (i = 0; i < rows.length; i++) {
    if (!strTrim(rows[i].subscriberKey) || !strTrim(rows[i].journeyId)) {
      continue;
    }
    if (!isWorkableExitStatus(rows[i].status)) {
      continue;
    }
    out.push(rows[i]);
  }
  return out;
}

function fetchExitQueueRows(prox) {
  var errors = [];
  var notes = [];
  var keyVariants = [EXIT_QUEUE_DE, String(EXIT_QUEUE_DE).toLowerCase()];
  var propSets = [
    ["key", "subscriberKey", "journeyName", "journeyId", "batchID", "Status"],
    ["key", "subscriberKey", "journeyName", "journeyId", "batchId", "status"],
    ["key", "subscriberKey", "journeyName", "journeyID", "batchID", "Status"],
    ["key", "subscriberKey", "journeyName", "journeyID", "batchId", "Status"],
    ["Key", "subscriberKey", "journeyName", "journeyId", "batchID", "Status"]
  ];
  var filters = [
    { Property: "Status", SimpleOperator: "equals", Value: "Pending" },
    { Property: "status", SimpleOperator: "equals", Value: "Pending" },
    { Property: "Status", SimpleOperator: "equals", Value: "Failed" },
    { Property: "status", SimpleOperator: "equals", Value: "Failed" },
    { Property: "Status", SimpleOperator: "equals", Value: "Queued" },
    { Property: "batchID", SimpleOperator: "isNotNull" },
    { Property: "batchId", SimpleOperator: "isNotNull" }
  ];
  var initSucceeded = false;
  var collected = [];
  var seen = {};

  function addNormalized(rows, sourceLabel) {
    var list = filterWorkableExitRows(normalizeQueueRows(rows));
    notes.push(sourceLabel + " workable=" + list.length);
    var i;
    for (i = 0; i < list.length; i++) {
      var id = asLower(list[i].key || list[i].subscriberKey + "|" + list[i].journeyId);
      if (!id || seen[id]) {
        continue;
      }
      seen[id] = true;
      collected.push(list[i]);
    }
  }

  for (var v = 0; v < keyVariants.length; v++) {
    var deKey = keyVariants[v];
    if (!deKey) {
      continue;
    }
    try {
      var de = DataExtension.Init(deKey);
      var deRows = de.Rows.Retrieve();
      initSucceeded = true;
      addNormalized(deRows, "Init(" + deKey + ")");
      if (collected.length) {
        return { rows: collected, error: "", notes: notes.join(" | ") };
      }
    } catch (deEx) {
      errors.push(
        "DataExtension.Init(" + deKey + "): " + (deEx.message || String(deEx))
      );
    }
  }

  for (var f = 0; f < filters.length; f++) {
    for (var k = 0; k < keyVariants.length; k++) {
      for (var p = 0; p < propSets.length; p++) {
        try {
          var wsResp = prox.retrieve(
            "DataExtensionObject[" + keyVariants[k] + "]",
            propSets[p],
            filters[f]
          );
          var topStatus = wsResp && wsResp.Status ? String(wsResp.Status) : "";
          if (topStatus && topStatus !== "OK") {
            var msg = topStatus;
            try {
              if (wsResp.Results && wsResp.Results.length && wsResp.Results[0].StatusMessage) {
                msg = String(wsResp.Results[0].StatusMessage);
              }
            } catch (msgEx) {}
            errors.push(
              "WSProxy " +
                keyVariants[k] +
                " " +
                filters[f].Property +
                "=" +
                filters[f].Value +
                ": " +
                msg
            );
            continue;
          }
          addNormalized(
            wsResp && wsResp.Results ? wsResp.Results : [],
            "WSProxy[" +
              keyVariants[k] +
              "]/" +
              filters[f].Property +
              "=" +
              (filters[f].Value || "isNotNull")
          );
          if (collected.length) {
            return { rows: collected, error: "", notes: notes.join(" | ") };
          }
        } catch (wsEx) {
          errors.push(
            "WSProxy " +
              keyVariants[k] +
              " " +
              filters[f].Property +
              ": " +
              (wsEx.message || String(wsEx))
          );
        }
      }
    }
  }

  if (collected.length) {
    return { rows: collected, error: "", notes: notes.join(" | ") };
  }

  if (initSucceeded) {
    return {
      rows: [],
      error: "",
      notes:
        (notes.length ? notes.join(" | ") + " | " : "") +
        "No Pending/Failed/Queued exit rows." +
        (errors.length ? " WSProxy notes: " + errors.join(" | ") : "")
    };
  }

  return {
    rows: [],
    error: errors.join(" | ") || "Could not open " + EXIT_QUEUE_DE + ".",
    notes: notes.join(" | ")
  };
}

function markExitQueueStatus(rowKey, subscriberKey, journeyId, batchId, status) {
  var key = strTrim(rowKey);
  if (!key && strTrim(batchId) && strTrim(subscriberKey)) {
    key = strTrim(batchId) + "|" + strTrim(subscriberKey);
  }
  if (!key && strTrim(subscriberKey) && strTrim(journeyId)) {
    key = strTrim(subscriberKey) + "|" + strTrim(journeyId);
  }
  if (!key) {
    return {
      ok: false,
      error: "Need key (or batchId + subscriberKey) to update queue Status."
    };
  }
  var st = strTrim(status) || "Done";
  var attempts = [
    { keys: ["key"], fields: ["Status"], values: [st] },
    { keys: ["Key"], fields: ["Status"], values: [st] },
    { keys: ["key"], fields: ["status"], values: [st] },
    { keys: ["Key"], fields: ["status"], values: [st] }
  ];
  var errors = [];
  var a;
  for (a = 0; a < attempts.length; a++) {
    try {
      Platform.Function.UpdateData(
        EXIT_QUEUE_DE,
        attempts[a].keys,
        [key],
        attempts[a].fields,
        attempts[a].values
      );
      return { ok: true, key: key, status: st };
    } catch (upEx) {
      errors.push(
        attempts[a].keys.join("/") +
          ":" +
          attempts[a].fields.join("/") +
          " " +
          (upEx.message || String(upEx))
      );
    }
  }
  return { ok: false, error: errors.join(" | "), key: key };
}

function isAlreadyExitedError(message) {
  var msg = asLower(message);
  if (!msg) {
    return false;
  }
  return (
    msg.indexOf("already") >= 0 ||
    msg.indexOf("not currently in") >= 0 ||
    msg.indexOf("not in the journey") >= 0 ||
    msg.indexOf("not active") >= 0 ||
    msg.indexOf("has already exited") >= 0
  );
}

function field(row, name) {
  if (!row) {
    return "";
  }
  return row[name] || row[String(name)] || "";
}

function getAuthConfig() {
  var rows = Platform.Function.LookupRows("SFMC_AUTH", "User", "Admin");
  if (!rows || rows.length < 1) {
    throw "Missing SFMC_AUTH row for User=Admin.";
  }
  var row = rows[0];
  var clientId = strTrim(field(row, "clientId"));
  var clientSecret = strTrim(field(row, "clientSecret"));
  var subdomain = strTrim(field(row, "subdomain"));
  var accountId = strTrim(field(row, "accountId"));
  if (!clientId || !clientSecret || !subdomain) {
    throw "SFMC_AUTH must include clientId, clientSecret, and subdomain.";
  }
  return {
    clientId: clientId,
    clientSecret: clientSecret,
    subdomain: subdomain,
    accountId: accountId
  };
}

function getAccessToken(auth) {
  var payload = {
    grant_type: "client_credentials",
    client_id: auth.clientId,
    client_secret: auth.clientSecret
  };
  if (auth.accountId) {
    payload.account_id = auth.accountId;
  }
  var req = new Script.Util.HttpRequest(
    "https://" + auth.subdomain + ".auth.marketingcloudapis.com/v2/token"
  );
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.contentType = "application/json";
  req.method = "POST";
  req.postData = Platform.Function.Stringify(payload);
  var resp = req.send();
  var body = resp.content ? String(resp.content) : "";
  if (resp.statusCode != 200) {
    throw "Auth HTTP " + resp.statusCode + ": " + body;
  }
  var parsed = Platform.Function.ParseJSON(body);
  if (!parsed || !parsed.access_token) {
    throw "Auth response did not include access_token.";
  }
  return String(parsed.access_token);
}

function httpJson(auth, token, method, path, payload) {
  var req = new Script.Util.HttpRequest(
    "https://" + auth.subdomain + ".rest.marketingcloudapis.com" + path
  );
  req.emptyContentHandling = 0;
  req.retries = 2;
  req.continueOnError = true;
  req.contentType = "application/json";
  req.setHeader("Authorization", "Bearer " + token);
  req.method = method;
  if (payload !== null && typeof payload !== "undefined") {
    req.postData = Platform.Function.Stringify(payload);
  }
  var resp = req.send();
  return {
    status: resp.statusCode,
    body: resp.content ? String(resp.content) : ""
  };
}

function parseJsonSafe(body) {
  try {
    return Platform.Function.ParseJSON(body || "{}");
  } catch (e) {
    return null;
  }
}

function resolveDefinitionKey(auth, token, journeyID, cache) {
  var id = strTrim(journeyID);
  if (!id) {
    return { ok: false, key: "", error: "Empty journeyID." };
  }
  var cacheKey = asLower(id);
  if (cache[cacheKey]) {
    return cache[cacheKey];
  }

  var byId = httpJson(
    auth,
    token,
    "GET",
    "/interaction/v1/interactions/" + encodeURIComponent(id) + "?extras=",
    null
  );
  if (byId.status == 200) {
    var parsedId = parseJsonSafe(byId.body);
    var keyFromId = strTrim(parsedId && parsedId.key ? parsedId.key : "");
    if (keyFromId) {
      cache[cacheKey] = {
        ok: true,
        key: keyFromId,
        name: strTrim(parsedId.name || ""),
        error: ""
      };
      return cache[cacheKey];
    }
  }

  var byKey = httpJson(
    auth,
    token,
    "GET",
    "/interaction/v1/interactions?key=" + encodeURIComponent(id),
    null
  );
  if (byKey.status == 200) {
    var parsedKey = parseJsonSafe(byKey.body);
    var items =
      parsedKey && parsedKey.items
        ? parsedKey.items
        : parsedKey && typeof parsedKey.length === "number"
          ? parsedKey
          : parsedKey
            ? [parsedKey]
            : [];
    if (items && items.length) {
      var first = items[0] || {};
      var keyFromQuery = strTrim(first.key || id);
      cache[cacheKey] = {
        ok: true,
        key: keyFromQuery,
        name: strTrim(first.name || ""),
        error: ""
      };
      return cache[cacheKey];
    }
  }

  cache[cacheKey] = {
    ok: false,
    key: "",
    name: "",
    error:
      "Could not resolve DefinitionKey from journeyID=" +
      id +
      " (id HTTP " +
      byId.status +
      ", key HTTP " +
      byKey.status +
      ")."
  };
  return cache[cacheKey];
}

function groupQueueByJourney(rows) {
  var groups = {};
  var order = [];
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    var jid = strTrim(row.journeyId);
    var sk = strTrim(row.subscriberKey);
    if (!jid || !sk) {
      continue;
    }
    var gkey = asLower(jid);
    if (!groups[gkey]) {
      groups[gkey] = {
        journeyId: jid,
        journeyName: strTrim(row.journeyName),
        contacts: []
      };
      order.push(gkey);
    } else if (!groups[gkey].journeyName && row.journeyName) {
      groups[gkey].journeyName = strTrim(row.journeyName);
    }
    groups[gkey].contacts.push({
      key: strTrim(row.key) || (strTrim(row.batchId) ? strTrim(row.batchId) + "|" + sk : sk + "|" + jid),
      batchId: strTrim(row.batchId),
      subscriberKey: sk,
      journeyName: strTrim(row.journeyName),
      journeyId: jid
    });
  }
  return { groups: groups, order: order };
}

function chunkContacts(contacts, size) {
  var chunks = [];
  var i = 0;
  while (i < contacts.length) {
    chunks.push(contacts.slice(i, i + size));
    i += size;
  }
  return chunks;
}

function exitErrorMap(body) {
  var map = {};
  var parsed = parseJsonSafe(body);
  if (!parsed || !parsed.errors) {
    return map;
  }
  var errors = parsed.errors;
  var n = typeof errors.length === "number" ? errors.length : 0;
  for (var i = 0; i < n; i++) {
    var err = errors[i] || {};
    var ck = strTrim(err.contactKey || err.ContactKey);
    if (!ck) {
      continue;
    }
    var statuses = err.status || [];
    var messages = [];
    var sn = typeof statuses.length === "number" ? statuses.length : 0;
    for (var s = 0; s < sn; s++) {
      if (statuses[s] && statuses[s].message) {
        messages.push(String(statuses[s].message));
      }
    }
    map[asLower(ck)] = messages.length
      ? messages.join("; ")
      : "exit request reported an error";
  }
  return map;
}

function lookupBatchMeta(batchId) {
  var bid = strTrim(batchId);
  if (!bid) {
    return { ok: false, sourceType: "", campaignId: "" };
  }
  var cacheKey = asLower(bid);
  if (batchMetaCache[cacheKey]) {
    return batchMetaCache[cacheKey];
  }
  var meta = { ok: false, sourceType: "", campaignId: "", batchId: bid };
  try {
    var rows = Platform.Function.LookupRows(BATCH_DE, "batchId", bid);
    if (rows && rows.length) {
      var row = rows[0];
      meta.ok = true;
      meta.sourceType = asLower(
        strTrim(row.sourceType || row.SourceType || "")
      );
      meta.campaignId = strTrim(
        row.campaignId || row.CampaignId || row.CAMPAIGNID || ""
      );
    }
  } catch (lookEx) {
    meta.error = lookEx.message || String(lookEx);
  }
  if (!meta.ok) {
    try {
      var rows2 = Platform.Function.LookupRows(BATCH_DE, "BatchId", bid);
      if (rows2 && rows2.length) {
        var row2 = rows2[0];
        meta.ok = true;
        meta.sourceType = asLower(
          strTrim(row2.sourceType || row2.SourceType || "")
        );
        meta.campaignId = strTrim(
          row2.campaignId || row2.CampaignId || row2.CAMPAIGNID || ""
        );
      }
    } catch (lookEx2) {
      meta.error = lookEx2.message || String(lookEx2);
    }
  }
  batchMetaCache[cacheKey] = meta;
  return meta;
}

function queueCampaignMemberResponded(campaignId, subscriberKey) {
  var camp = strTrim(campaignId);
  var sk = strTrim(subscriberKey);
  if (!camp || !sk) {
    return false;
  }
  cmUpdatePairs.push(camp + "^" + sk);
  return true;
}

function recordBatchExitResult(batchId, accepted) {
  var bid = strTrim(batchId);
  if (!bid) {
    return;
  }
  var key = asLower(bid);
  if (!batchExitStats[key]) {
    batchExitStats[key] = { batchId: bid, accepted: 0, failed: 0 };
  }
  if (accepted) {
    batchExitStats[key].accepted++;
  } else {
    batchExitStats[key].failed++;
  }
}

function updateBatchRow(batchId, status, message, contactsProcessed) {
  var id = strTrim(batchId);
  if (!id) {
    return { ok: false, error: "Missing batchId." };
  }
  var msg = strTrim(message).substring(0, 3900);
  var countVal =
    contactsProcessed === null || typeof contactsProcessed === "undefined"
      ? ""
      : String(contactsProcessed);
  try {
    if (countVal !== "") {
      Platform.Function.UpdateData(
        BATCH_DE,
        ["batchId"],
        [id],
        ["status", "processedAt", "message", "contactsProcessed"],
        [status, new Date(), msg, countVal]
      );
    } else {
      Platform.Function.UpdateData(
        BATCH_DE,
        ["batchId"],
        [id],
        ["status", "processedAt", "message"],
        [status, new Date(), msg]
      );
    }
    return { ok: true };
  } catch (upEx) {
    try {
      if (countVal !== "") {
        Platform.Function.UpdateData(
          BATCH_DE,
          ["batchId"],
          [id],
          ["status", "message", "contactsProcessed"],
          [status, msg, countVal]
        );
      } else {
        Platform.Function.UpdateData(
          BATCH_DE,
          ["batchId"],
          [id],
          ["status", "message"],
          [status, msg]
        );
      }
      return { ok: true };
    } catch (upEx2) {
      return {
        ok: false,
        error:
          (upEx.message || String(upEx)) +
          " | " +
          (upEx2.message || String(upEx2))
      };
    }
  }
}

function flushBatchStatusUpdates() {
  var lines = [];
  for (var key in batchExitStats) {
    if (!batchExitStats.hasOwnProperty(key)) {
      continue;
    }
    var stat = batchExitStats[key];
    var status =
      stat.accepted > 0 ? "Done" : "Failed";
    var message =
      "Exit worker finished: accepted=" +
      stat.accepted +
      ", failed=" +
      stat.failed +
      ".";
    var updated = updateBatchRow(
      stat.batchId,
      status,
      message,
      stat.accepted
    );
    if (updated.ok) {
      lines.push(
        "Batch " +
          stat.batchId +
          " → " +
          status +
          " contactsProcessed=" +
          stat.accepted
      );
    } else {
      lines.push(
        "Batch " +
          stat.batchId +
          " status update FAILED: " +
          (updated.error || "unknown")
      );
    }
  }
  return lines;
}

function flushCampaignMemberStatusUpdates() {
  if (!cmUpdatePairs.length) {
    return { ok: true, skipped: true, count: 0 };
  }
  var pairs = cmUpdatePairs.join("|");
  try {
    Platform.Variable.SetValue("@sfCmUpdatePairs", pairs);
    Platform.Variable.SetValue("@sfToStatus", CM_STATUS_TO);
    Platform.Variable.SetValue("@sfCampaignId", "");
    Platform.Variable.SetValue("@sfFromStatus", "");
    Platform.Variable.SetValue("@sfSubscriberKey", "");
    var rendered = Platform.Function.TreatAsContent(
      '\%\%=ContentBlockByName("sst_sf_update_cm_status")=\%\%'
    );
    return {
      ok: true,
      count: cmUpdatePairs.length,
      result: strTrim(rendered)
    };
  } catch (sfEx) {
    var detail = "";
    try {
      detail = Stringify(sfEx);
    } catch (syEx) {
      detail = sfEx.message || String(sfEx);
    }
    return {
      ok: false,
      count: cmUpdatePairs.length,
      error: detail
    };
  }
}

function processJourneyGroup(auth, token, group, definition) {
  var label =
    (group.journeyName || definition.name || "(no name)") +
    " / " +
    group.journeyId;
  if (!definition.ok || !definition.key) {
    return [
      label +
        " — SKIP " +
        group.contacts.length +
        " contact(s): " +
        (definition.error || "no DefinitionKey")
    ];
  }

  var lines = [];
  var chunks = chunkContacts(group.contacts, EXIT_BATCH_SIZE);
  for (var c = 0; c < chunks.length; c++) {
    var chunk = chunks[c];
    var payload = [];
    for (var p2 = 0; p2 < chunk.length; p2++) {
      payload.push({
        ContactKey: chunk[p2].subscriberKey,
        DefinitionKey: definition.key
      });
    }
    var exitResp = httpJson(
      auth,
      token,
      "POST",
      "/interaction/v1/interactions/contactexit",
      payload
    );
    if (!(exitResp.status == 202 || exitResp.status == 200)) {
      lines.push(
        label +
          " — batch " +
          (c + 1) +
          "/" +
          chunks.length +
          " FAILED HTTP " +
          exitResp.status +
          ": " +
          exitResp.body
      );
      continue;
    }

    var errMap = exitErrorMap(exitResp.body);
    var okCount = 0;
    var failCount = 0;
    for (var i = 0; i < chunk.length; i++) {
      var contact = chunk[i];
      var err = errMap[asLower(contact.subscriberKey)];
      if (err) {
        if (isAlreadyExitedError(err)) {
          var markedDone = markExitQueueStatus(
            contact.key,
            contact.subscriberKey,
            contact.journeyId,
            contact.batchId,
            "Done"
          );
          if (markedDone.ok) {
            okCount++;
            recordBatchExitResult(contact.batchId, true);
            lines.push(
              contact.subscriberKey +
                " @ " +
                label +
                " — already exited; Status→Done."
            );
          } else {
            failCount++;
            recordBatchExitResult(contact.batchId, false);
            lines.push(
              contact.subscriberKey +
                " @ " +
                label +
                " — already exited, Status update FAILED: " +
                (markedDone.error || "unknown")
            );
          }
          continue;
        }
        var markedFail = markExitQueueStatus(
          contact.key,
          contact.subscriberKey,
          contact.journeyId,
          contact.batchId,
          "Failed"
        );
        failCount++;
        recordBatchExitResult(contact.batchId, false);
        lines.push(
          contact.subscriberKey +
            " @ " +
            label +
            " — EXIT ERROR: " +
            err +
            " (Status→" +
            (markedFail.ok ? "Failed" : "update failed") +
            ")"
        );
        continue;
      }
      var marked = markExitQueueStatus(
        contact.key,
        contact.subscriberKey,
        contact.journeyId,
        contact.batchId,
        "Done"
      );
      if (!marked.ok) {
        failCount++;
        recordBatchExitResult(contact.batchId, false);
        lines.push(
          contact.subscriberKey +
            " @ " +
            label +
            " — EXIT ACCEPTED, Status→Done FAILED: " +
            (marked.error || "unknown")
        );
        continue;
      }
      okCount++;
      recordBatchExitResult(contact.batchId, true);
      var cmNote = "";
      var batchMeta = lookupBatchMeta(contact.batchId);
      if (
        batchMeta.ok &&
        batchMeta.sourceType === "campaign" &&
        batchMeta.campaignId
      ) {
        if (
          queueCampaignMemberResponded(
            batchMeta.campaignId,
            contact.subscriberKey
          )
        ) {
          cmNote = " CM Status→" + CM_STATUS_TO + " queued.";
        }
      }
      lines.push(
        contact.subscriberKey +
          " @ " +
          label +
          " — EXIT ACCEPTED, Status→Done." +
          cmNote
      );
    }
    lines.push(
      label +
        " — batch " +
        (c + 1) +
        "/" +
        chunks.length +
        " done: accepted=" +
        okCount +
        ", errors/kept=" +
        failCount +
        ", definitionKey=" +
        definition.key
    );
  }
  return lines;
}

try {
  var auth = getAuthConfig();
  var token = getAccessToken(auth);
  var prox = new Script.Util.WSProxy();
  var queueFetch = fetchExitQueueRows(prox);
  var queueRows = queueFetch.rows || [];

  if (!queueRows.length) {
    Write(
      "bd_sst_journey_exit worker — no Pending/Failed/Queued rows to process."
    );
  } else {
    resultLines.push(
      "bd_sst_journey_exit worker — " + queueRows.length + " row(s)."
    );
    if (queueFetch.notes) {
      debugLines.push("Retrieve notes: " + queueFetch.notes);
    }
    if (queueFetch.error) {
      debugLines.push("Retrieve errors: " + queueFetch.error);
    }

    var grouped = groupQueueByJourney(queueRows);
    var keyCache = {};
    var skipped = 0;
    for (var s = 0; s < queueRows.length; s++) {
      if (
        !strTrim(queueRows[s].subscriberKey) ||
        !strTrim(queueRows[s].journeyId)
      ) {
        skipped++;
        debugLines.push(
          "SKIP incomplete row subscriberKey=" +
            (queueRows[s].subscriberKey || "(empty)") +
            " journeyId=" +
            (queueRows[s].journeyId || "(empty)")
        );
      }
    }
    if (skipped) {
      resultLines.push("Skipped incomplete rows: " + skipped);
    }
    resultLines.push(
      "Grouped into " + grouped.order.length + " journey(s)."
    );

    for (var g = 0; g < grouped.order.length; g++) {
      var group = grouped.groups[grouped.order[g]];
      var definition = resolveDefinitionKey(
        auth,
        token,
        group.journeyId,
        keyCache
      );
      var groupLines = processJourneyGroup(auth, token, group, definition);
      for (var gl = 0; gl < groupLines.length; gl++) {
        debugLines.push(groupLines[gl]);
      }
    }

    var cmFlush = flushCampaignMemberStatusUpdates();
    if (cmFlush.skipped) {
      resultLines.push("CM Status update: none queued.");
    } else if (cmFlush.ok) {
      resultLines.push(
        "CM Status update TreatAsContent OK pairs=" +
          cmFlush.count +
          (cmFlush.result ? " result=" + cmFlush.result : "")
      );
    } else {
      resultLines.push(
        "CM Status update TreatAsContent FAILED pairs=" +
          cmFlush.count +
          " detail=" +
          (cmFlush.error || "unknown")
      );
    }

    var batchFlushLines = flushBatchStatusUpdates();
    for (var bf = 0; bf < batchFlushLines.length; bf++) {
      resultLines.push(batchFlushLines[bf]);
    }

    var output = resultLines.join("\n");
    if (debugLines.length) {
      output += "\n\n" + debugLines.join("\n");
    }
    var logResult = writeExitLog(output);
    if (!logResult.ok) {
      output += "\n\n[sst_de_journey_exit_log insert FAILED] " + logResult.error;
    }
    Write(output);
  }
} catch (runEx) {
  var errOut = "ERROR: " + (runEx.message || String(runEx));
  writeExitLog(errOut);
  Write(errOut);
}
</script>
